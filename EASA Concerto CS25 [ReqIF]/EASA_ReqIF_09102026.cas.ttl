	a o:idSpecObject1 ;
	rdfs:label "CS 25.335(e)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If an automatic wing-flap positioning or load limiting device is used, the speeds and corresponding wing-flap positions programmed or allowed by the device may be used.</div>" ;
