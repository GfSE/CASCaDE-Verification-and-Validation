	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-2055202981_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.203(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Approximately 90° in the original direction of the turn, or 60° in the opposite direction, for deceleration rates in excess of 0.5 m/s2 (1 knot per second).</div>" ;
