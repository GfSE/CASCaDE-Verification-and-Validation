	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(a).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Criteria for Acceptance. Each seat cushion must meet the following criteria: </div>" ;
