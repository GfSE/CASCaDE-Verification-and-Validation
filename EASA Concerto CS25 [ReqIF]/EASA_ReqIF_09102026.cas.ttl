	a o:idSpecObject1 ;
	rdfs:label "CS 25.981(b)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Except as provided in sub-paragraph (4) of this paragraph, no fuel tank Fleet Average Flammability Exposure level may exceed the greater of:</div>" ;
