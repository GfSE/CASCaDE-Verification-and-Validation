	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Except as provided in sub-paragraphs (d) and (e) of this paragraph compliance with the provisions of sub-paragraph (a) of this paragraph must be demonstrated in flight over the acceleration range – </div>" ;
