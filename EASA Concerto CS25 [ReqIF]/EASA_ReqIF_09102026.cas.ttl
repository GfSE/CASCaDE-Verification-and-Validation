d:idSpecObject_1575056278_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) An attitude in which the main wheels are assumed to contact the ground with the nose wheel just clear of the ground; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
