	a o:idSpecObject1 ;
	rdfs:label "CS 25.101(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) The aeroplane configurations may vary with weight, altitude, and temperature, to the extent they are compatible with the operating procedures required by sub-paragraph (f) of this paragraph.</div>" ;
