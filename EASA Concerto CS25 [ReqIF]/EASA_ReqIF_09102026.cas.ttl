d:idSpecObject_1943935478_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1701(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Electrical wiring interconnection system (EWIS) means any wire, wiring device, or combination of these, including termination devices, installed in any area of the aeroplane for the purpose of transmitting electrical energy, including data and signals between two or more intended termination points. Except as provided for in subparagraph (c) of this paragraph, this includes:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
