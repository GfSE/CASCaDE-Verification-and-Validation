d:idSpecObject_-792266652_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The specimen to be tested is injected into an environmental chamber through which a constant flow of air passes. The specimen’s exposure is determined by a radiant heat source adjusted to produce the desired total heat flux on the specimen of 3·5 Watts/cm2, using a calibrated calorimeter. The specimen is tested so that the exposed surface is vertical. Combustion is initiated by piloted ignition. The combustion products leaving the chamber are monitored in order to calculate the release rate of heat. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part IV" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Test Method to Determine the Heat Release Rate from Cabin Materials Exposed to Radiant Heat" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10161" ;
