	a o:idSpecObject1 ;
	rdfs:label "CS 25.787(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) If cargo compartment lamps are installed, each lamp must be installed so as to prevent contact between lamp bulb and cargo.</div>" ;
