d:idSpecObject_-1860930604_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1019.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Where there is a filter in the APU lubrication system through which all the oil flows, it must be constructed and installed so that oil may flow at an acceptable rate through the rest of the system with the filter element completely blocked. An impending filter by-pass indication is required.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
