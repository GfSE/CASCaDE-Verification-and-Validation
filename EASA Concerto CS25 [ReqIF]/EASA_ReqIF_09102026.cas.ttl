	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(5)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) accurately state or illustrate the proper method of opening the exit, including the correct use of controls, handles, handholds etc.;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
