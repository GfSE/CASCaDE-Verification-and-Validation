	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "PERFORMANCE" ;
	o:ideRules1 "ERULES-1963177438-9980" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_552252819_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(5)(i).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) With the most critical of the “Take-off Ice” accretion(s) defined in Appendices C and O, as applicable, in accordance with CS 25.21(g), from a height of 11 m (35 ft) above the take-off surface up to the point where the aeroplane is 122 m (400 ft) above the take-off surface; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "111" ;
	o:idSubref1 "(c)(5)(i)" ;
	o:idTitle1 "Take-off path" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "PERFORMANCE" ;
	o:ideRules1 "ERULES-1963177438-9980" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_552252819_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(5)(ii).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) With the most critical of the “Final Take-off Ice” accretion(s) defined in Appendices C and O, as applicable, in accordance with CS 25.21(g), from the point where the aeroplane is 122 m (400 ft) above the take-off surface to the end of the take-off path.</div>" ;
