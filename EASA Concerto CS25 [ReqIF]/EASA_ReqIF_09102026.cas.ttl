	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(A).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(A) The calibration method must be by comparison to a like standardized transducer.</div>" ;
