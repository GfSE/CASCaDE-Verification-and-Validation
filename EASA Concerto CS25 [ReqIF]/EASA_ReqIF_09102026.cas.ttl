	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(H).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(H) The range used in calibration must be at least 0–3.9 Watts/cm2 (0–3.5 BTUs/ft2 sec) and no greater than 0–6.4 Watts/cm2 (0–5.7 BTUs/ft2 sec). </div>" ;
