	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(6).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) It must not be possible to unlatch the latches with the locks in the locked position. Locks must be designed to withstand the limit loads resulting from:</div>" ;
