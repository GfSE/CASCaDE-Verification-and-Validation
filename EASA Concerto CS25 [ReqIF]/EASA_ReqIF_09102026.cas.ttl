	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The landing gear extending and retracting mechanisms, wheel well doors, and supporting structure, must be designed for –:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a)(1)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) the loads occurring in the flight conditions when the gear is in the retracted position;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(a)(1)(i)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a)(1)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) the combination of friction loads, inertia loads, brake torque loads, air loads, and gyroscopic loads resulting from the wheels rotating at a peripheral speed equal to 1·23 VSR (with the flaps in takeoff position at design take-off weight), occurring during retraction and extension at any airspeed up to 1·5 VSR1 with the wing-flaps in the approach position at design landing weight, and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(a)(1)(ii)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a)(1)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) any load factor up to those specified in CS 25.345(a) for the wing-flaps extended condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(a)(1)(iii)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Unless there are other means to decelerate the aeroplane in flight at this speed, the landing gear, the extending and retracting mechanisms, and the aeroplane structure (including wheel well doors) must be designed to withstand the flight loads occurring with the landing gear in the extended position at any speed up to 0·67 VC.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Landing gear doors, their operating mechanism, and their supporting structures must be designed for the yawing manoeuvres prescribed for the aeroplane in addition to the conditions of airspeed and load factor prescribed in sub-paragraphs (a)(1) and (2) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(a)(3)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Landing gear lock. There must be positive means to keep the landing gear extended in flight and on the ground. There must be positive means to keep the landing gear and doors in the correct retracted position in flight, unless it can be shown that lowering of the landing gear or doors, or flight with the landing gear or doors extended, at any speed, is not hazardous. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Extending and retracting mechanisms" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10105" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Emergency operation. There must be an emergency means for extending the landing gear in the event of – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
