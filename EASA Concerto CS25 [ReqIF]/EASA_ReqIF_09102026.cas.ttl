	o:idApplicabilityDate1 "2006-10-02T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2006-10-02T00:00:00Z" .

d:idSpecObject_-1702518332_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1435(b)(4).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Meet the applicable requirements of CS 25.863, 25.1183, 25.1185 and 25.1189 if a flammable hydraulic fluid is used; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
