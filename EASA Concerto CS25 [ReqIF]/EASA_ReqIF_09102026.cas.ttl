	a o:idSpecObject1 ;
	rdfs:label "CS 25.855(h)(3).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The dissipation of the extinguishing agent in Class C compartment or, if applicable, in Class F compartment.</div>" ;
