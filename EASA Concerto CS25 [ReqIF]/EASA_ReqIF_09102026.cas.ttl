d:idSpecObject_-125199643_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(j).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) If storage batteries are used as the energy supply for the emergency lighting system, they may be recharged from the aeroplane’s main electric power system: Provided, that the charging circuit is designed to preclude inadvertent battery discharge into charging circuit faults. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
