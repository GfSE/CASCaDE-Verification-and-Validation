d:idSpecObject_-1092025642_38
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(7)(viii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(viii) An alert is provided to the flight crew when the flight recorder is no longer attached to the aeroplane.</div>" ;
