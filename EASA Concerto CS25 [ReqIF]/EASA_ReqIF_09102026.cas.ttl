d:idSpecObject_-829075061_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.337(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) May not be less than –1·0 at speeds up to VC; and</div>" ;
