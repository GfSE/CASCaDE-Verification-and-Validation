	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(d)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) 70% of the dry runway braking coefficient of friction used to determine the dry runway accelerate-stop distance; or</div>" ;
