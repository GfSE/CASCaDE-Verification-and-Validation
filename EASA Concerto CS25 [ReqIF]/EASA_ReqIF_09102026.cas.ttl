	a o:idSpecObject1 ;
	rdfs:label "CS 25.471(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Loads and equilibrium. For limit ground loads – </div>" ;
