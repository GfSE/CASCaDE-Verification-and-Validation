	o:idSubsection1 "Appendix Q – Additional airworthiness requirements for approval of a Steep Approach Landing (SAL) capabilityED Decision 2016/010/R(See )" ;
	o:ideRules1 "ERULES-1963177438-10265" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2018/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix Q – Additional airworthiness requirements for approval of a Steep Approach Landing (SAL) capability" ;
	o:idApplicabilityDate1 "2018-03-28T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-03-28T00:00:00Z" .

