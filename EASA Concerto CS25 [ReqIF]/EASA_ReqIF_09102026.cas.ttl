d:idSpecObject_-749083209_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h)(5).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Either forward or rearward facing with an energy absorbing rest that is designed to support the arms, shoulders, head and spine.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
