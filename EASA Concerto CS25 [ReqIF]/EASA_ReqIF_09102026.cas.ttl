d:idSpecObject_106172684_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.679(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Limit the operation of the aeroplane so that the pilot receives unmistakable warning at the start of take-off. (See AMC 25.679(a)(2).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
