	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(e).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) If the recorder is not deployable, the container of the recording medium must be located and mounted so as to minimise the probability of the container rupturing, the recording medium being destroyed, or the underwater locating device failing as a result of any possible combinations of:</div>" ;
