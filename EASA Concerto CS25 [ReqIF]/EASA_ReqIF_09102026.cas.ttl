d:idSpecObject_1444542175_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305(b)(3).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The methods and assumptions used are sufficient to cover the effects of these deformations.</div>" ;
