	a o:idSpecObject1 ;
	rdfs:label "AMC 25.111.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.111 Take-off path ED Decision 2003/2/RM The height references in CS 25.111 should be interpreted as geometrical heights. </div>" ;
