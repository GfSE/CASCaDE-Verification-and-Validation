	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1203(e).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Wiring and other components of each fire or overheat detector system in a fire zone must be at least fire-resistant.</div>" ;
