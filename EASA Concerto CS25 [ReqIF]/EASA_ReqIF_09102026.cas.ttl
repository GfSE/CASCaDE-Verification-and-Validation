	a o:idSpecObject1 ;
	rdfs:label "CS 25.1583(a)(3).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The manoeuvring speed established under CS 25.1507 and statements, as applicable to the particular design, explaining that:</div>" ;
