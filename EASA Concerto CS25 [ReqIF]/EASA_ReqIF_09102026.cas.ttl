	a o:idSpecObject1 ;
	rdfs:label "CS 25.1103(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Fire-resistant if it is in any fire zone for which a fire extinguishing system is required.</div>" ;
