d:idSpecObject_-1548625723_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1155(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) A positive lock or stop which requires a separate and distinct operation by the flight crew to displace the control from the flight regime (forward thrust regime for turbo-jet powered aeroplanes), and it must only be possible to make this separate and distinct operation once the control has reached the flight idle position.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1155" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Reverse thrust and propeller pitch settings below the flight regime" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT CONTROLS AND ACCESSORIES" ;
	o:ideRules1 "ERULES-1963177438-10079" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1548625723_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1155(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) A means to prevent both inadvertent and intentional selection or activation of propeller pitch settings below the flight regime (reverse thrust for turbo-jet powered aeroplanes) when out of the approved in-flight operating envelope for that function, and override of that means is prohibited.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1155" ;
	o:idSubref1 "(b)" ;
