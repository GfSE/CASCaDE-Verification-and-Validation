d:idSpecObject_1101519729_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1460(b).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each data link recorder must be installed so that:</div>" ;
