	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_937626481_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1729.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The applicant must prepare Instructions for Continued Airworthiness applicable to EWIS in accordance with the requirements of CS 25.1529 and Appendix H paragraphs H25.4 and H25.5. </div>" ;
