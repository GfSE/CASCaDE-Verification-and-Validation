	a o:idSpecObject1 ;
	rdfs:label "CS 25.335(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) At altitudes where VD is limited by Mach number, VC may be limited to a selected Mach number. (See CS 25.1505.)</div>" ;
