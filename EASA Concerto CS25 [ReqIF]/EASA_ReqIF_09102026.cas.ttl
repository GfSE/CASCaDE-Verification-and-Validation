	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1931415354_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1549(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each normal operating range must be marked with a green arc or green line, not extending beyond the maximum and minimum safe limits;</div>" ;
