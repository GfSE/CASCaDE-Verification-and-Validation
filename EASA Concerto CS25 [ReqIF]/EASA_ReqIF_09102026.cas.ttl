d:idSpecObject_1651683409_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(2)(i).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Be a modified gun type.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(2)(i)" ;
