d:idSpecObject_552252819_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(d)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The weight of the aeroplane, the configuration, and the power or thrust must be constant throughout each segment and must correspond to the most critical condition prevailing in the segment;</div>" ;
