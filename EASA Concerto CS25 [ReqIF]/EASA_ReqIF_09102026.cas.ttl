d:idSpecObject_-615295197_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.772.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">For an aeroplane that has a lockable door installed between the pilot compartment and the passenger compartment: -</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
