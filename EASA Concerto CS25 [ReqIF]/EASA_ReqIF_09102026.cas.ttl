d:idSpecObject_-1744053042_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(l).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(l) Standard deviation is a statistical measure of the dispersion or variation in a distribution, equal to the square root of the arithmetic mean of the squares of the deviations from the arithmetic means.</div>" ;
