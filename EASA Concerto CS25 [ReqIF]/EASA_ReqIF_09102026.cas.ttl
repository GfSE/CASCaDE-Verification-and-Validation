d:idSpecObject_1829045085_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) each door is open before entering any of the taxiing, take-off, and landing phases;</div>" ;
