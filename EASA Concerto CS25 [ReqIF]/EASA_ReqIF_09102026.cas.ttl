d:idSpecObject_-1359237463_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1187(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) No ventilation opening may be where it would allow the entry of flammable fluids, vapours, or flame from other zones.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1187" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Drainage and ventilation of fire zones" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8558" ;
