	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(b)(1)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) No extinguishing agent likely to enter personnel compartments will be hazardous to the occupants; and</div>" ;
