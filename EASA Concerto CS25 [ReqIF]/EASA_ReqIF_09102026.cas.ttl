	a o:idSpecObject1 ;
	rdfs:label "CS 25.562(c)(7).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) The seat must remain attached at all points of attachment, although the structure may have yielded.</div>" ;
