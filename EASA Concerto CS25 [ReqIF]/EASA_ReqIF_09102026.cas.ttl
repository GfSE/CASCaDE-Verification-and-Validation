	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(e)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) a distance of more than 18.29 m (60 ft) between adjacent remaining emergency exits is created only once per side of the fuselage on each deck (See AMC to Appendix S, S25.10(d) and (e)).</div>" ;
