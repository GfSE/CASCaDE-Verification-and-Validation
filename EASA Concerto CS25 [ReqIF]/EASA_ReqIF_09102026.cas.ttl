d:idSpecObject_2021291266_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 30(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Width of Aisle: for low-occupancy aeroplanes that have a passenger seating configuration of 19 or less, and for non-commercially operated aeroplanes, the design must be such that the dimensional requirements of CS 25.815 can be achieved during all flight phases, except that the width of aisle may be reduced to 0 m during in-flight operations provided that compliance with the following additional requirements is shown (See AMC to Appendix S, S25.30(a)):</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx S 30" ;
	o:idSubref1 "(a)" ;
