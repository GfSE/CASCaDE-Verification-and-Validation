d:idSpecObject_-16180447_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.117.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Compliance with the requirements of CS 25.119 and 25.121 must be shown at each weight, altitude, and ambient temperature within the operational limits established for the aeroplane and with the most unfavourable centre of gravity for each configuration. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
