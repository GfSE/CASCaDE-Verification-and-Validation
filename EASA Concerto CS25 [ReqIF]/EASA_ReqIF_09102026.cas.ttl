	a o:idSpecObject1 ;
	rdfs:label "CS 25.1363(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The equipment must simulate the electrical characteristics of the distribution wiring and connected loads to the extent necessary for valid test results; and</div>" ;
