		d:idSpecObject_874429002_5 .

d:idSpecObject_178944266_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.409(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Trim tabs. Trim tabs must be designed to withstand loads arising from all likely combinations of tab setting, primary control position, and aeroplane speed (obtainable without exceeding the flight load conditions prescribed for the aeroplane as a whole), when the effect of the tab is opposed by pilot effort forces up to those specified in CS 25.397(b). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "409" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Tabs" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "CONTROL SURFACE AND SYSTEM LOADS" ;
	o:ideRules1 "ERULES-1963177438-8435" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_178944266_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.409(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Balancing tabs. Balancing tabs must be designed for deflections consistent with the primary control surface loading conditions. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
