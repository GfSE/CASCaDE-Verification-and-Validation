	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-66702698_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.703(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Wing spoilers (except lateral control spoilers meeting the requirements of CS 25.671), speed brakes, or longitudinal trim devices are in a position that would not allow a safe take-off.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
