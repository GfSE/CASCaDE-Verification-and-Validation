	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(a)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) the static pressure system performance is least affected by airflow variation, or by moisture or other foreign matter, and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(a)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) the correlation between air pressure in the static pressure system and true ambient atmospheric static pressure is not changed when the aeroplane is exposed to icing conditions. The static pressure system shall comply with CS 25.1324. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(c).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (c) The design and installation of the static pressure system must be such that –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(c)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Positive drainage of moisture is provided; chafing of the tubing and excessive distortion or restriction at bends in the tubing is avoided; and the materials used are durable, suitable for the purpose intended, and protected against corrosion; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(c)(1)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(c)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) It is airtight except for the port into the atmosphere. A proof test must be conducted to demonstrate the integrity of the static pressure system in the following manner:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(c)(2)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(c)(2)(i).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Unpressurised aeroplanes. Evacuate the static pressure system to a pressure differential of approximately 33.86 HPa, (1 inch of mercury) or to a reading on the altimeter, 305 m (1 000 ft) above the aeroplane elevation at the time of the test. Without additional pumping for a period of 1 minute, the loss of indicated altitude must not exceed 30 m (100 ft) on the altimeter. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(c)(2)(i)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(c)(2)(ii).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Pressurised aeroplanes. Evacuate the static pressure system until pressure differential equivalent to the maximum cabin pressure differential for which the aeroplane is type certificated is achieved. Without additional pumping for a period of 1 minute, the loss of indicated altitude must not exceed 2% of the equivalent altitude of the maximum cabin differential pressure or 30 m (100 ft), whichever is greater. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(c)(2)(ii)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(d).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each pressure altimeter must be approved and must be calibrated to indicate pressure altitude in a standard atmosphere, with a minimum practicable calibration error when the corresponding static pressures are applied.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(e).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Each system must be designed and installed so that the error in indicated pressure altitude, at sea-level, with a standard atmosphere, excluding instrument calibration error, does not result in an error of more than ±9 m (±30 ft) per 185 km/hr (100 knots) speed for the appropriate configuration in the speed range between 1·23 VSR0 with wing-flaps extended and 1·7 VSR1 with wing-flaps retracted. However, the error need not be less than ±9 m (±30 ft).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(f).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) If an altimeter system is fitted with a device that provides corrections to the altimeter indication, the device must be designed and installed in such manner that it can be bypassed when it malfunctions, unless an alternate altimeter system is provided. Each correction device must be fitted with a means for indicating the occurrence of reasonably probable malfunctions, including power failure, to the flight crew. The indicating means must be effective for any cockpit lighting condition likely to occur.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 "Static pressure systems" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9996" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1777977512_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(g).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Except as provided in sub-paragraph (h) of this paragraph, if the static pressure system incorporates both a primary and an alternate static pressure source, the means for selecting one or the other source must be designed so that –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1325" ;
	o:idSubref1 "(g)" ;
