d:idSpecObject_-749083209_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) A seat (or berth for a non-ambulant person) must be provided for each occupant who has reached his or her second birthday.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
