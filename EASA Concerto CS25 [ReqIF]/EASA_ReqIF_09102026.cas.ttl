	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1203(f).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) No fire or overheat detector system component for any fire zone may pass through another fire zone, unless:</div>" ;
