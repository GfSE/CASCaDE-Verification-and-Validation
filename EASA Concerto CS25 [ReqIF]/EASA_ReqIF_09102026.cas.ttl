	o:ideRules1 "ERULES-1963177438-8669" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-783279111_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each fuel quantity indicator must be calibrated to read ‘zero’ during level flight when the quantity of fuel remaining in the tank is equal to the unusable fuel supply determined under CS 25.959;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
