d:idSpecObject_676843940_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1203(b)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (2) There is a means to warn the crew in the event that the sensor or associated wiring within a designated fire zone is severed at one point, unless the system continues to function as a satisfactory detection system after the severing; and</div>" ;
