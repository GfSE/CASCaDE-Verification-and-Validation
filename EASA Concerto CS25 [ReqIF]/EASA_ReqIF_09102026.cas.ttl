d:idSpecObject_-1194292592_46
	a o:idSpecObject1 ;
	rdfs:label "CS 25.335(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Design drag device speeds, VDD. The selected design speed for each drag device must be sufficiently greater than the speed recommended for the operation of the device to allow for probable variations in speed control. For drag devices intended for use in high speed descents, VDD may not be less than VD. When an automatic drag device positioning or load limiting means is used, the speeds and corresponding drag device positions programmed or allowed by the automatic means must be used for design.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
