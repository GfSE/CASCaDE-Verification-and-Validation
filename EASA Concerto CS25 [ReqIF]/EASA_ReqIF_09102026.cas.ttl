	o:idApplicabilityDate1 "2020-01-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_-1674997375_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.934.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Thrust reversers installed on turbo-jet engines must meet the requirements of CS-E 890. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
