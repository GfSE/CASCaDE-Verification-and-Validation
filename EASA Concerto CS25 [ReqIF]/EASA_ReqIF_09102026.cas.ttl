d:idSpecObject_1789991084_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII.Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Use the following test method to evaluate the burnthrough resistance characteristics of aircraft thermal/acoustic insulation materials when exposed to a high intensity open flame. Figure 1 – Burnthrough Test Apparatus Specimen Holder Figure 2 – Burnthrough Test Apparatus Figure 3 – Burner Draft Tube Extension Cone Diagram Figure 4 – Calorimeter Position Relative to Burner Cone Figure 5 – Thermocouple Rake Position Relative to Burner Cone Figure 6 – Position of Backface Calorimeters Relative to Test Specimen Frame Figure 7 – Test Specimen Installation on Test Frame Figure 8 – Burner Information and Calibration Settings</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
