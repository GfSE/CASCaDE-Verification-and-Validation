d:idSpecObject_-1958403998_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1717.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1717)EWIS components must be designed and installed so they are compatible with the circuit protection devices required by CS 25.1357, so that a fire or smoke hazard cannot be created under temporary or continuous fault conditions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
