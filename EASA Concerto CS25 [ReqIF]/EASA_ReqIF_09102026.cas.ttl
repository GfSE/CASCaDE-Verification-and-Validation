d:idSpecObject_856115233_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J994.Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Fuel system components in an APU compartment or in the fuselage must be protected from damage which could result in spillage of enough fuel to constitute a fire hazard as a result of a wheels-up landing on a paved runway under each of the conditions prescribed in CS 25.721(b).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J994" ;
	o:idTitle1 "Fuel system components" ;
	o:idAmendedBy1 "Amendment 3;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "FUEL SYSTEM COMPONENTS" ;
	o:ideRules1 "ERULES-1963177438-9485" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.J994.Amendment 3;" ;
	o:idApplicabilityDate1 "2007-09-19T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

d:idSpecObject_-160630500_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J995.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">In addition to the requirements of CS 25J1189 for shut-off means, each fuel valve must be supported so that no loads resulting from their operation or from accelerated flight conditions are transmitted to the lines attached to the valve, unless adequate strength margins under all loading conditions are provided in the lines and connections. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J995" ;
	o:idTitle1 "Fuel valves" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "FUEL SYSTEM COMPONENTS" ;
	o:ideRules1 "ERULES-1963177438-9339" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.J995.Amendment 1;" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-1425357657_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J997(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Be accessible for draining and cleaning and must incorporate a screen or element which is easily removable;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
