	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(e)(2)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Be self-illuminated with an initial brightness of at least 0.51 candela/m2 (160 microlamberts), or</div>" ;
