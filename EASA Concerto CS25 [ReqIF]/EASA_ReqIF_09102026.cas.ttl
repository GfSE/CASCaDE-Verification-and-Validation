d:idSpecObject_-1856839938_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Ventilating air ducts. Each ventilating air duct passing through any fire zone must be fireproof. In addition – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "859" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Combustion heater fire protection" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8246" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1856839938_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Unless isolation is provided by fireproof valves or by equally effective means, the ventilating air duct downstream of each heater must be fireproof for a distance great enough to ensure that any fire originating in the heater can be contained in the duct; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "859" ;
	o:idSubref1 "(b)(1)" ;
	o:idTitle1 "Combustion heater fire protection" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8246" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1856839938_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each part of any ventilating duct passing through any region having a flammable fluid system must be constructed or isolated from that system so that the malfunctioning of any component of that system cannot introduce flammable fluids or vapours into the ventilating airstream.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "859" ;
	o:idSubref1 "(b)(2)" ;
	o:idTitle1 "Combustion heater fire protection" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8246" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1856839938_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Combustion air ducts. Each combustion air duct must be fireproof for a distance great enough to prevent damage from backfiring or reverse flame propagation. In addition – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "859" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Combustion heater fire protection" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8246" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1856839938_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) No combustion air duct may have a common opening with the ventilating airstream unless flames from backfires or reverse burning cannot enter the ventilating airstream under any operating condition, including reverse flow or malfunctioning of the heater or its associated components; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "859" ;
	o:idSubref1 "(c)(1)" ;
	o:idTitle1 "Combustion heater fire protection" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8246" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1856839938_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) No combustion air duct may restrict the prompt relief of any backfire that, if so restricted, could cause heater failure.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
