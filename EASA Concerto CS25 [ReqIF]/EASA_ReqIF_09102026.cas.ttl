d:idSpecObject_-278040378_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(d)(6).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) If an inerting system FRM is used, the effects of any air that may enter the fuel tank following the last flight of the day due to changes in ambient temperature, as defined in Table 4, during a 12-hour overnight period.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
