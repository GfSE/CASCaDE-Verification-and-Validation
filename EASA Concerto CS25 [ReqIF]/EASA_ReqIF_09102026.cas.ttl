d:idSpecObject_286963373_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Automatic protective devices must be used to minimise distress to the electrical system and hazard to the aeroplane in the event of wiring faults or serious malfunction of the system or connected equipment. (See AMC 25.1357(a).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The protective and control devices in the generating system must be designed to de-energise and disconnect faulty power sources and power transmission equipment from their associated busses with sufficient rapidity to provide protection from hazardous over-voltage and other malfunctioning.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each re-settable circuit protective device must be designed so that, when an overload or circuit fault exists, it will open the circuit irrespective of the position of the operating control.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) If the ability to reset a circuit breaker or replace a fuse is essential to safety in flight, that circuit breaker or fuse must be located and identified so that it can be readily reset or replaced in flight. Where fuses are used, there must be spare fuses for use in-flight equal to at least 50% of the number of fuses of each rating required for complete circuit protection.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Each circuit for essential loads must have individual circuit protection. However, individual protection for each circuit in an essential load system (such as each position light circuit in a system) is not required.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) For aeroplane systems for which the ability to remove or reset power during normal operations is necessary, the system must be designed so that circuit breakers are not the primary means to remove or reset system power, unless specifically designed for use as a switch. (see AMC 25.1357(f)).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(g).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Automatic reset circuit breakers may be used as integral protectors for electrical equipment (such as thermal cutouts) if there is circuit protection to protect the cable to the equipment.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
