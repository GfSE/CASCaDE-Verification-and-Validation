d:idSpecObject_711042303_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.105(a)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) In icing conditions, if in the configuration used to show compliance with CS 25.121(b), and with the most critical of the “Take-off Ice” accretion(s) defined in Appendices C and O, as applicable, in accordance with CS 25.21(g):</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "105" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Take-off" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "PERFORMANCE" ;
	o:ideRules1 "ERULES-1963177438-9979" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_711042303_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.105(a)(2)(i).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The stall speed at maximum take-off weight exceeds that in non-icing conditions by more than the greater of 5.6 km/h (3 knots) CAS or 3% of VSR; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
