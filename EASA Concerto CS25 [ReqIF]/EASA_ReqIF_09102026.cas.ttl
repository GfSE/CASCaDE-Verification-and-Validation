	o:idReqIfChapterName1 "CS 25.934.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1937312321_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.937.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Turbo-propeller powered aeroplane propeller-drag limiting systems must be designed so that no single failure or malfunction of any of the systems during normal or emergency operation results in propeller drag in excess of that for which the aeroplane was designed under CS 25.367. Failure of structural elements of the drag limiting systems need not be considered if the probability of this kind of failure is extremely remote. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "937" ;
	o:idTitle1 "Turbo-propeller-drag limiting systems" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-8314" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.937.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-403515511_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.939(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Turbine engine operating characteristics must be investigated in flight to determine that no adverse characteristics (such as stall, surge, or flame-out) are present, to a hazardous degree, during normal and emergency operation within the range of operation limitations of the aeroplane and of the engine. (See AMC 25.939(a).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
