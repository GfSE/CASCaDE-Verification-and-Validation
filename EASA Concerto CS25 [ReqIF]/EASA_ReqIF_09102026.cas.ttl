d:idSpecObject_1062517513_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.843(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Strength test. The complete pressurised cabin, including doors, windows, and valves, must be tested as a pressure vessel for the pressure differential specified in CS 25.365(d). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "843" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Tests for pressurised cabins" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-8218" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1062517513_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.843(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Tests of the functioning and capacity of the positive and negative pressure differential valves, and of the emergency release valve, to simulate the effects of closed regulator valves.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "843" ;
	o:idSubref1 "(b)(1)" ;
	o:idTitle1 "Tests for pressurised cabins" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-8218" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1062517513_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.843(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Tests of the pressurisation system to show proper functioning under each possible condition of pressure, temperature, and moisture, up to the maximum altitude for which certification is requested.</div>" ;
