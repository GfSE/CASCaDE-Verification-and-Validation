d:idSpecObject_-2012264952_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(l).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(l) The autopilot must not create an unsafe condition when the flight crew applies an override force to the flight controls.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1329" ;
	o:idSubref1 "(l)" ;
