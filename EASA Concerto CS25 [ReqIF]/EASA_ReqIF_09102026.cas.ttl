	o:idSubsection1 "FLIGHT LOADS" ;
	o:ideRules1 "ERULES-1963177438-8344" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_779656215_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.321(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) At each weight from the design minimum weight to the design maximum weight appropriate to each particular flight load condition; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "321" ;
	o:idSubref1 "(b)(2)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT LOADS" ;
	o:ideRules1 "ERULES-1963177438-8344" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_779656215_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.321(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) For each required altitude and weight, for any practicable distribution of disposable load within the operating limitations recorded in the Aeroplane Flight Manual.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
