	rdfs:label "CS 25.855(e).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) No compartment may contain any controls, lines, equipment, or accessories whose damage or failure would affect safe operation, unless those items are protected so that –</div>" ;
