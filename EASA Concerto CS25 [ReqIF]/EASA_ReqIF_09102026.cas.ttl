	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a)(2)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Buffeting that would impair the pilot’s ability to read the instruments or control the aeroplane for recovery.</div>" ;
