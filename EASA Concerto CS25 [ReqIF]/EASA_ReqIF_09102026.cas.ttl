d:idSpecObject_-1282142559_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.471(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Limit ground loads obtained under this Subpart are considered to be external forces applied to the aeroplane structure; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
