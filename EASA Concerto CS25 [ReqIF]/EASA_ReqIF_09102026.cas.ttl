	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325.Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b)Each static port must be designed and located so that:</div>" ;
