	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1744053042_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(g).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Hazardous atmosphere. An atmosphere that may expose maintenance personnel, passengers or flight crew to the risk of death, incapacitation, impairment of ability to self-rescue (that is, escape unaided from a confined space), injury, or acute illness.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx N 2" ;
	o:idSubref1 "(g)" ;
	o:idTitle1 "Definitions" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix N – Fuel Tank Flammability ExposureED Decision 2016/010/R(See )" ;
	o:ideRules1 "ERULES-1963177438-9597" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix N – Fuel Tank Flammability Exposure" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1744053042_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(h).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Inert. For the purpose of this appendix, the tank is considered inert when the bulk average oxygen concentration within each compartment of the tank is 12 percent or less from sea level up to 10,000 feet altitude, then linearly increasing from 12 percent at 10,000 feet to 14.5 percent at 40,000 feet altitude, and extrapolated linearly above that altitude.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx N 2" ;
	o:idSubref1 "(h)" ;
	o:idTitle1 "Definitions" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix N – Fuel Tank Flammability ExposureED Decision 2016/010/R(See )" ;
