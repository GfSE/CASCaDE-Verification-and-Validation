d:idSpecObject_-1280868577_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1195(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There must be a fire extinguisher system serving the APU compartment.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J1195" ;
