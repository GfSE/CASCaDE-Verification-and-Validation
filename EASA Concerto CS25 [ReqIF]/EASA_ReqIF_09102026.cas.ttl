	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1439567751_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Operating conditions and characteristics likely to cause inadvertent speed increases (including upsets in pitch and roll) must be simulated with the aeroplane trimmed at any likely cruise speed up to VMO/MMO. These conditions and characteristics include gust upsets, inadvertent control movements, low stick force gradient in relation to control friction, passenger movement, levelling off from climb, and descent from Mach to air speed limit altitudes.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "253" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "High-speed characteristics" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10129" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1439567751_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Allowing for pilot reaction time after effective inherent or artificial speed warning occurs, it must be shown that the aeroplane can be recovered to a normal attitude and its speed reduced to VMO/MMO, without –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
