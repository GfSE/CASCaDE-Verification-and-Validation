	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1955781191_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.349(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) At VC, the aileron deflection must be that required to produce a rate of roll not less than that obtained in sub-paragraph (a)(2) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
