d:idSpecObject_1994393186_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1533(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Prohibit intentional flight, including take-off and landing, into icing conditions defined in Appendix O for which the aeroplane has not been certified to safely operate; and </div>" ;
