	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(a)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) validate the parameters used in the analysis required by paragraph M25.1; </div>" ;
