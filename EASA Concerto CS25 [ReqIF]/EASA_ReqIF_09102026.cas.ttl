d:idSpecObject_459389398_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1711(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) EWIS components must be labelled or otherwise identified using a consistent method that facilitates identification of the EWIS component, its function, and its design limitations, if any.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
