d:idSpecObject_-786188817_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The capacity of each required built-in fire extinguishing system must be adequate for any fire likely to occur anywhere in the compartment where used, considering the volume of the compartment and the ventilation rate. (see AMC 25.851(b)). (c) Fire-extinguishing agents (See AMC 25.851(c))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
