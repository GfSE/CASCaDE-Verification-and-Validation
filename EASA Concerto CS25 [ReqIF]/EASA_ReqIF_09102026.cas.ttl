d:idSpecObject_1267322594_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1121.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1121)For powerplant installations the following apply: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1121" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "EXHAUST SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10078" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1121.Amendment 18;" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1267322594_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1121(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each exhaust system must ensure safe disposal of exhaust gases without fire hazard or carbon monoxide contamination in any personnel compartment. For test purposes, any acceptable carbon monoxide detection method may be used to show the absence of carbon monoxide. (See AMC 25.1121(a).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1121" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "EXHAUST SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10078" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1267322594_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1121(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each exhaust system part with a surface hot enough to ignite flammable fluids or vapours must be located or shielded so that leakage from any system carrying flammable fluids or vapours will not result in a fire caused by impingement of the fluids or vapours on any part of the exhaust system including shields for the exhaust system. (See AMC 25.1121(b).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1121" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "EXHAUST SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10078" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1267322594_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1121(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each component that hot exhaust gases could strike, or that could be subjected to high temperatures from exhaust system parts, must be fireproof. All exhaust system components must be separated by fireproof shields from adjacent parts of the aeroplane that are outside the engine compartment.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
