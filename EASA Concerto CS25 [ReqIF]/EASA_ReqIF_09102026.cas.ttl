d:idSpecObject_2122803792_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.955(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Fuel must be delivered to each engine at a pressure within the limits specified in the engine type certificate.</div>" ;
