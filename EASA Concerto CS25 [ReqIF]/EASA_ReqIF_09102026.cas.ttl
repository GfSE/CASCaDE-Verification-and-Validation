d:idSpecObject_779656215_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.321(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Flight load factors represent the ratio of the aerodynamic force component (acting normal to the assumed longitudinal axis of the aeroplane) to the weight of the aeroplane. A positive load factor is one in which the aerodynamic force acts upward with respect to the aeroplane.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
