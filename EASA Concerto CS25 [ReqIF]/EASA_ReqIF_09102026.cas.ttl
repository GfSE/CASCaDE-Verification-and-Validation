	a o:idSpecObject1 ;
	rdfs:label "CS 25.975(a).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Fuel tank vents. Each fuel tank must be vented from the top part of the expansion space so that venting is effective under any normal flight condition. In addition – </div>" ;
