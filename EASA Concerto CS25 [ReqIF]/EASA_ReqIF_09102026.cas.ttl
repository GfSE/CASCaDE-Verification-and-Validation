	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(f).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Air intakes. Each combustion and ventilating air intake must be located so that no flammable fluids or vapours can enter the heater system under any operating condition – </div>" ;
