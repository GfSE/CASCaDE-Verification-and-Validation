	o:idEntryIntoForceDate1 "2018-03-28T00:00:00Z" .

d:idSpecObject_-977006163_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.145(f)(1).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Starting with the aeroplane in each approved approach and landing configuration, trimmed longitudinally and with the thrust or power setting per CS 25.161(c)(2), perform a go-around, transition to the next flight phase and level off at the desired altitude: </div>" ;
