d:idSpecObject_-192061252_4_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(a)(0).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. Pneumatic systems which are powered by, and/or used for distributing or storing, air or nitrogen, must comply with the requirements of this paragraph. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1436" ;
	o:idSubref1 "(a)(0)" ;
	o:idTitle1 "Pneumatic systems – high pressure" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10128" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-192061252_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Compliance with CS 25.1309 for pneumatic systems must be shown by functional tests, endurance tests and analysis. Any part of a pneumatic system which is an engine accessory must comply with the relevant requirements of CS 25.1163.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1436" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Pneumatic systems – high pressure" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10128" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-192061252_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) No element of the pneumatic system which would be liable to cause hazardous effects by exploding, if subject to a fire, may be mounted within an engine bay or other designated fire zone, or in the same compartment as a combustion heater.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1436" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Pneumatic systems – high pressure" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10128" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-192061252_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) When the system is operating no hazardous blockage due to freezing must occur. If such blockage is liable to occur when the aeroplane is stationary on the ground, a pressure relieving device must be installed adjacent to each pressure source.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
