d:idSpecObject_1163835908_2
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1319(a).Amendment 25;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Aeroplane equipment, systems and networks, considered separately and in relation to other systems, must be protected from intentional unauthorised electronic interactions (IUEIs) that may result in adverse effects on the safety of the aeroplane. Protection must be ensured by showing that the security risks have been identified, assessed and mitigated as necessary.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1319" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Equipment, systems and network information protection" ;
	o:idAmendedBy1 "Amendment 25;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-18404" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-01-01T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-07-02T00:00:00Z" .

d:idSpecObject_1163835908_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1319(b).Amendment 25;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) When required by paragraph (a), the applicant must make procedures and Instructions for Continued Airworthiness (ICA) available that ensure that the security protections of the aeroplane’s equipment, systems and networks are maintained.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
