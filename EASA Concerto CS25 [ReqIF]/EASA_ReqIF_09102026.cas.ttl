	a o:idSpecObject1 ;
	rdfs:label "CS 25.509(c).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The towing loads specified in sub-paragraph (d) of this paragraph must be reacted as follows:</div>" ;
