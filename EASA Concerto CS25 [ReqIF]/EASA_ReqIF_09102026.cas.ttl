d:idSpecObject_388814335_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.341(a)(5).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The following reference gust velocities apply:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
