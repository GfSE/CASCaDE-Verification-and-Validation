	a o:idSpecObject1 ;
	rdfs:label ".J(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each oil line must meet the requirements of CS 25J993 and each oil line and fitting in any designated fire zone must meet the requirements of CS 25J1183.(b) Breather lines must be arranged so that:</div>" ;
