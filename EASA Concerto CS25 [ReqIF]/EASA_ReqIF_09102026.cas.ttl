d:idSpecObject_-1744053042_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(j).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) Monte Carlo Analysis. The analytical method that is specified in this appendix as the compliance means for assessing the fleet average flammability exposure time for a fuel tank.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
