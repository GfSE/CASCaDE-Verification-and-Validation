d:idSpecObject_-1070920956_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(4).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) There is an aural or visual means for pre-flight checking of the recorder for proper recording of data in the storage medium;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
