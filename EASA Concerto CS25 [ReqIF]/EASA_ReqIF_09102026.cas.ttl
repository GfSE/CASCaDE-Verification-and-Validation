	a o:idSpecObject1 ;
	rdfs:label "CS 25.J953(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Through a system independent of each part of the system supplying fuel to the main engines; or</div>" ;
