d:idSpecObject_-961563324_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(g)(3).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) There must be a hatch capable of being used for evacuating persons from the lift that is openable from inside and outside the lift without tools, with the lift in any position.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
