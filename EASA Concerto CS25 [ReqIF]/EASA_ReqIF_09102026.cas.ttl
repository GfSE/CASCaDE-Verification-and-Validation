	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(e)(1).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The flight-crew compartment.</div>" ;
