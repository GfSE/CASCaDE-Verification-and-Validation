d:idSpecObject_387969350_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.832(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) 0·25 parts per million by volume, sea level equivalent, at any time above flight level 320; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
