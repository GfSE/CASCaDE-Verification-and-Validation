	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Performs a function that is essential for continued safe flight and landing; or</div>" ;
