d:idSpecObject_-1028631822_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1713(c).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Insulation on electrical wire and electrical cable, including materials used to provide additional protection for the wire and cable installed in any area of the aeroplane, must be self-extinguishing when tested in accordance with the applicable portions of Part I of Appendix F.</div>" ;
