d:idSpecObject_-1386680868_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.1323(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.1323(e) Airspeed indicating system ED Decision 2003/2/RM An acceptable means of compliance when demonstrating a perceptible speed change between VMO to VMO + 2/3 (VDF - VMO) is for the rate of change of IAS with CAS to be not less than 0.50.\" </div>" ;
