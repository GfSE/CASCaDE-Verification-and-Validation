	a o:idSpecObject1 ;
	rdfs:label "CS 25.1025(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each oil shut-off must meet the requirements of CS 25.1189. </div>" ;
