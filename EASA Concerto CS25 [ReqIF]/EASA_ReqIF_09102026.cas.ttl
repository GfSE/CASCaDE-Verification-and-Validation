	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_19531905_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.395(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The system limit loads of paragraph (a) need not exceed the loads that can be produced by the pilot (or pilots) and by automatic or power devices operating the controls.</div>" ;
