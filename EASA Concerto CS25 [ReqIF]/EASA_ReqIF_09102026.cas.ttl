d:idSpecObject_204633158_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.951(c).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each fuel system must be capable of sustained operation throughout its flow and pressure range with fuel initially saturated with water at 26.7°C (80°F) and having 0.20 cm3 of free water per litre (0.75 cm3 per US gallon) added and cooled to the most critical condition for icing likely to be encountered in operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
