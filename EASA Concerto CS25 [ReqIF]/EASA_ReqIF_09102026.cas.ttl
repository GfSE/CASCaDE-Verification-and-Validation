	a o:idSpecObject1 ;
	rdfs:label "CS 25.1093(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Turbine engines Each engine, with all icing protection systems operating, must:</div>" ;
