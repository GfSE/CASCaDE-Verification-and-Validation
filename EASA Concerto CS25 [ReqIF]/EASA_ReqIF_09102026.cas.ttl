	a o:idSpecObject1 ;
	rdfs:label "CS 25.773(b)(1)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Heavy rain at speeds up to 1·5 VSR1, with lift and drag devices retracted; and </div>" ;
