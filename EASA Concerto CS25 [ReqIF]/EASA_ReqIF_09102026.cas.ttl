	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(f).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) If the cockpit voice recorder has an erasure device or function, the installation must be designed to minimise the probability of inadvertent operation and actuation of the erasure device or function during crash impact.</div>" ;
