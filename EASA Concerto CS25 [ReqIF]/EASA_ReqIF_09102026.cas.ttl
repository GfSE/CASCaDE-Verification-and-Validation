	o:idApplicabilityDate1 "2011-07-04T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2011-07-04T00:00:00Z" .

d:idSpecObject_1995393275_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(c)(3).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) permit each occurrence of the attention-getting cues required by sub-paragraph (c)(2) to be acknowledged and suppressed, unless they are required to be continuous.</div>" ;
