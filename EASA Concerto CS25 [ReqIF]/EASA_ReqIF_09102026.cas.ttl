	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1575056278_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) VL2, equal to VS0(TAS) at the appropriate landing weight and altitudes in a hot day temperature of 22.8°C (41°F) above standard.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
