d:idSpecObject_-1495751849_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 1.Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
