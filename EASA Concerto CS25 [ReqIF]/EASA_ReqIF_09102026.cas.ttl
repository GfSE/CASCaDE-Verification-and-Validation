d:idSpecObject_1879502793_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 6(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) In addition to the requirements of CS 25.1141, no single failure or malfunction, or probable combination thereof, of the ATTCS system, including associated systems, may cause the failure of any powerplant function necessary for safety.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
