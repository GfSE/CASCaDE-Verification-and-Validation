d:idSpecObject_1959871857_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) with failures or malfunctions in the latching mechanism, it need not latch after closing, and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
