	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(i).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) When demonstrating compliance with CS 25.143 in icing conditions -</div>" ;
