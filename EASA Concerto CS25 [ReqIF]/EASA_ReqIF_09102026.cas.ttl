	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_1242372907_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.705(b).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The ROAAS shall at least accommodate dry and wet runway conditions for normal landing configurations.</div>" ;
