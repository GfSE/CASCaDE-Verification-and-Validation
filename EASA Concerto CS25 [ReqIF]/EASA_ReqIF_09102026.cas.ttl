d:idSpecObject_-442894939_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(j).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) Where duplicate airspeed indicators are required, their respective pitot tubes must be far enough apart to avoid damage to both tubes in a collision with a bird.</div>" ;
