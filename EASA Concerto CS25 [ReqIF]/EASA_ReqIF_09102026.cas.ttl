	a o:idSpecObject1 ;
	rdfs:label "CS 25.123(b)(2)(ii).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) The degradation of the gradient of climb is greater than one-half of the applicable actual-to-net flight path reduction defined in sub-paragraph (b) of this paragraph.</div>" ;
