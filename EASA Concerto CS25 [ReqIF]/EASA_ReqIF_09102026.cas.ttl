d:idSpecObject_-1302882791_46
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(C).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(C) Calibrate the standard transducer against a primary standard traceable to the National Institute of Standards and Technology (NIST).</div>" ;
