d:idSpecObject_-1440164610_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1317(a).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each electrical and electronic system that performs a function whose failure would prevent the continued safe flight and landing of the aeroplane must be designed and installed so that:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1317" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "High-Intensity Radiated Fields (HIRF) protection" ;
	o:idAmendedBy1 "Amendment 17;" ;
