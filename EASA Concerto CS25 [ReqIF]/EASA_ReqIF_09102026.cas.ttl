	a o:idSpecObject1 ;
	rdfs:label "CS 25.1533(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The extremes for variable factors (such as altitude, temperature, wind, runway gradients) are those at which compliance with the applicable provisions of this CS-25 is shown.</div>" ;
