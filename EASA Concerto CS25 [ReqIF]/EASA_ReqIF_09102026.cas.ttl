	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(f).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Flexible oil tank liners. Each flexible oil tank liner must be approved or must be shown to be suitable for the particular application. </div>" ;
