	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The stick force vs. g curve must have a positive slope at any speed up to and including VFC/MFC; and</div>" ;
