	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(g)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Report the flame propagation distance. If this distance is less than 51 mm (2 inches), report this as a pass (no measurement required). </div>" ;
