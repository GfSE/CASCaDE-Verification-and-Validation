	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

d:idSpecObject_-177099195_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1302.Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1302.) This paragraph applies to installed equipment intended for flight-crew members’ use in the operation of the aeroplane from their normally seated positions on the flight deck. This installed equipment must be shown, individually and in combination with other such equipment, to be designed so that qualified flight-crew members trained in its use can safely perform their tasks associated with its intended function by meeting the following requirements: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
