	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-125199643_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(g)(1)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Not less than 0.3 lux (0.03 foot candle) (measured normal to the direction of the incident light) on a 0.186 m2 (two-square-foot) area where an evacuee is likely to make his first step outside the cabin;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "812" ;
	o:idSubref1 "(g)(1)(i)" ;
	o:idTitle1 "Emergency lighting" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10201" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-125199643_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(g)(1)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Not less than 0.5 lux (0.05 foot-candle) (measured normal to the direction of the incident light) for a minimum width of 1.07 m (42 inches) for a Type A over-wing exit and 61 cm (24 inches) for all other over-wing emergency exits along the 30 % of the slip-resistant portion of the escape route required in CS 25.810(c) that is farthest from the exit; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "812" ;
	o:idSubref1 "(g)(1)(ii)" ;
	o:idTitle1 "Emergency lighting" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10201" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-125199643_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(g)(1)(iii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Not less than 0.3 lux (0.03 foot candle) on the ground surface with the landing gear extended (measured normal to the direction of the incident light) where an evacuee using the established escape route would normally make first contact with the ground.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
