	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-888623629_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1513.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The minimum control speed VMC determined under CS 25.149 must be established as an operating limitation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1513" ;
	o:idTitle1 "Minimum control speed" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART G – OPERATING LIMITATIONS AND INFORMATION" ;
	o:idSubsection1 "OPERATING LIMITATIONS" ;
	o:ideRules1 "ERULES-1963177438-8259" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
