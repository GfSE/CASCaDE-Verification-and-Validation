	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(2)(ii).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Have an 80-degree spray angle nozzle nominally rated for 8.5 l/hr (2·25 US gallons/hour) at 690 KPa (100 psi);</div>" ;
