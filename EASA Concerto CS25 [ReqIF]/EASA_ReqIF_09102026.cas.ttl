d:idSpecObject_-2106828640_4
	a o:idSpecObject1 ;
	rdfs:label "CS25.J1011(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The usable oil capacity may not be less than the product of the endurance of the aeroplane and the maximum allowable oil consumption of the APU plus a suitable margin to ensure system circulation. </div>" ;
