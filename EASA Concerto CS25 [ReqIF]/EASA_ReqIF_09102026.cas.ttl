d:idSpecObject_-278040378_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(d).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Fuel Tank FRM Model. If FRM is used, an Agency approved Monte Carlo program must be used to show compliance with the flammability requirements of CS 25.981 and Appendix M of this part. The program must determine the time periods during each flight phase when the fuel tank or compartment with the FRM would be flammable. The following factors must be considered in establishing these time periods: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx N 3" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Fuel tank flammability exposure analysis " ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix N – Fuel Tank Flammability ExposureED Decision 2016/010/R(See )" ;
	o:ideRules1 "ERULES-1963177438-9598" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix N – Fuel Tank Flammability Exposure" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-278040378_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(d)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Any time periods throughout the flammability exposure evaluation time and under the full range of expected operating conditions, when the FRM is operating properly but fails to maintain a non-flammable fuel tank because of the effects of the fuel tank vent system or other causes,</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
