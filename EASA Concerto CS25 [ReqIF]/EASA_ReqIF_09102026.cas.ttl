	rdfs:label "CS 25.101(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) 34%, at and above standard temperatures plus 28°C (50°F). Between these two temperatures, the relative humidity must vary linearly. </div>" ;
