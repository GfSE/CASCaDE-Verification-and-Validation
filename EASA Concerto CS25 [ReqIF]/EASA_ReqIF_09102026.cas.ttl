d:idSpecObject_39662269_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1019(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each turbine engine installation must incorporate an oil strainer or filter through which all of the engine oil flows and which meets the following requirements:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1019" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Oil strainer or filter" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8450" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_39662269_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1019(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each oil strainer or filter that has a bypass, must be constructed and installed so that oil will flow at the normal rate through the rest of the system with the strainer or filter completely blocked.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1019" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Oil strainer or filter" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8450" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_39662269_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1019(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The oil strainer or filter must have the capacity (with respect to operating limitations established for the engine) to ensure that engine oil system functioning is not impaired when the oil is contaminated to a degree (with respect to particle size and density) that is greater than that established for the engine under CS-E.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1019" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Oil strainer or filter" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8450" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_39662269_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1019(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The oil strainer or filter, unless it is installed at an oil tank outlet, must incorporate an indicator that will indicate contamination before it reaches the capacity established in accordance with sub-paragraph (a)(2) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
