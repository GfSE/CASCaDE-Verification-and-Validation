	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "SAFETY EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-8154" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-351018849_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1415(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each raft must have a trailing line, and must have a static line designed to hold the raft near the aeroplane but to release it if the aeroplane becomes totally submerged.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
