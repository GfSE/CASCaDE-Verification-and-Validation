	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_1789991084_48
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(b)(8)(i).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Ventilation hood. Provide the test chamber with an exhaust system capable of removing the products of combustion expelled during tests. </div>" ;
