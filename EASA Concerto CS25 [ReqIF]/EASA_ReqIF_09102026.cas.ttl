	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-8198" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1775445018_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1443(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) If portable oxygen equipment is installed for use by crew members, the minimum mass flow of supplemental oxygen is the same as specified in sub-paragraph (a) or (b) of this paragraph, whichever is applicable.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
