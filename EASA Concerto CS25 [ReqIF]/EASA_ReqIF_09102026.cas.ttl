	o:idReqIfChapterName1 "CS 25.853.Amendment 23;" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1350743459_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(a).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Materials (including finishes or decorative surfaces applied to the materials) must meet the applicable test criteria prescribed in Part I of Appendix F or other approved equivalent methods, regardless of the passenger capacity of the aeroplane.</div>" ;
