	a o:idSpecObject1 ;
	rdfs:label "CS 25.1303(b)(1).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) An airspeed indicator. If airspeed limitations vary with altitude, the indicator must have a maximum allowable airspeed indicator showing the variation of VMO with altitude.</div>" ;
