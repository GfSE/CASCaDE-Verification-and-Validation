d:idSpecObject_874429002_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.407(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For elevator trim tabs, those required to trim the aeroplane at any point within the positive portion of the pertinent flight envelope in CS 25.333(b), except as limited by the stops; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
