	o:idApplicabilityDate1 "2007-09-19T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

d:idSpecObject_217569270_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.858(a).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The detection system must provide a visual indication to the flight crew within one minute after the start of a fire.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
