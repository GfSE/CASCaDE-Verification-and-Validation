d:idSpecObject_1152054989_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1189(g).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Each tank to APU shut-off valve must be located so that the operation of the valve will not be affected by the APU mount structural failure.</div>" ;
