d:idSpecObject_1805953230_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(d)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The ice accretion starts at the end of the take-off distance;</div>" ;
