	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(f)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Must not be included as an additional means of deceleration when determining the accelerate-stop distance on a dry runway; and</div>" ;
