	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(e)(1)(ii).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) An altitude and airspeed envelope must be established and demonstrated for APU in-flight starting.</div>" ;
