	a o:idSpecObject1 ;
	rdfs:label "CS 25.561(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The aeroplane, although it may be damaged in emergency landing conditions on land or water, must be designed as prescribed in this paragraph to protect each occupant under those conditions.</div>" ;
