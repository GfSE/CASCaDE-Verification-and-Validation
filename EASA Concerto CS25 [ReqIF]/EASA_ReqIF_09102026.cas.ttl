d:idSpecObject_-1070920956_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(5).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) If the recorder has a recording duration of less than 25 hours, there is an automatic means to stop the recording within 10 minutes after crash impact. This requirement does not apply to recorders that are powered solely by the engine-driven electrical generator system;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
