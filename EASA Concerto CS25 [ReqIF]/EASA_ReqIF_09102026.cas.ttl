d:idSpecObject_387969350_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.832(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The aeroplane cabin ozone concentration during flight must be shown not to exceed –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
