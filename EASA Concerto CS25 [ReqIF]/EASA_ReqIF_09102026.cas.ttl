d:idSpecObject_1586589071_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 3(b)(ii).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Limit the degradation of performance in the event of a critical engine failure combined with failure of the ATTCS system to operate as designed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
