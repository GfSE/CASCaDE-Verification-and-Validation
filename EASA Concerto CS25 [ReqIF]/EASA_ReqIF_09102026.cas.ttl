	a o:idSpecObject1 ;
	rdfs:label "CS 25.149(h)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The rudder force may not exceed 667 N (150 lbf);</div>" ;
