d:idSpecObject_-792266652_36
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Calculations</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
