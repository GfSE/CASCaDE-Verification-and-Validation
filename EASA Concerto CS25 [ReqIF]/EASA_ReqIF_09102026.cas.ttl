d:idSpecObject_1054426491_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1153(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There must be a separate propeller feathering control for each propeller. The control must have means to prevent its inadvertent operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
