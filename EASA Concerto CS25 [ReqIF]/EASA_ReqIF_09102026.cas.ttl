d:idSpecObject_-626282916_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.697(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each lift device control must be designed so that the pilots can place the device in any takeoff, en-route, approach, or landing position established under CS 25.101(d). Lift and drag devices must maintain the selected positions, except for movement produced by an automatic positioning or load limiting device, without further attention by the pilots. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "697" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Lift and drag devices, controls" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-8659" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-626282916_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.697(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each lift and drag device control must be designed and located to make inadvertent operation improbable. Lift and drag devices intended for ground operation only must have means to prevent the inadvertent operation of their controls in flight if that operation could be hazardous.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "697" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Lift and drag devices, controls" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-8659" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-626282916_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.697(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The rate of motion of the surfaces in response to the operation of the control and the characteristics of the automatic positioning or load limiting device must give satisfactory flight and performance characteristics under steady or changing conditions of airspeed, engine power, and aeroplane attitude.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
