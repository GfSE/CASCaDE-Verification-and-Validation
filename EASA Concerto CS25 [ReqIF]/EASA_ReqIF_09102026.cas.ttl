d:idSpecObject_1783419709_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Operation test. The proper functioning of the extending and retracting mechanisms must be shown by operation tests. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "729" ;
