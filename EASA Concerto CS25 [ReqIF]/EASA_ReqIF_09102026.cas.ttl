d:idSpecObject_1748508159_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(f)(1).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The total volume of the flight-crew and passenger compartments is 22.65m3 (800 cubic ft) or less.</div>" ;
