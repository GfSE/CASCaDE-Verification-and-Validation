d:idSpecObject_1045854938_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.509(b).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For towing points not on the landing gear but near the plane of symmetry of the aeroplane, the drag and side tow load components specified for the auxiliary gear apply. For towing points located outboard of the main gear, the drag and side tow load components specified for the main gear apply. Where the specified angle of swivel cannot be reached, the maximum obtainable angle must be used.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "509" ;
