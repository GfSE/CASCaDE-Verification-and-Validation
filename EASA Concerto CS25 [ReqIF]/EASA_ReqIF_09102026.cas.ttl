d:idSpecObject_506950409_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(b)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) There are means accessible where necessary, in flight, to appropriate crew members for the individual and rapid disconnection of each electrical power source (see AMC 25.1351(b)(5)); and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
