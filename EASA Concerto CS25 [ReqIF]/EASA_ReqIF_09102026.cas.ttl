d:idSpecObject_-2072346087_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1001(c)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Level flight at 1·3 VSR1, if the results of the tests in the condition specified in sub-paragraphs (c)(1) and (2) of this paragraph show that this condition could be critical.</div>" ;
