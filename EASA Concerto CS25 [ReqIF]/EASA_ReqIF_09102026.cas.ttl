	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(a)(1)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Accelerate the aeroplane from a standing start with all engines operating to VEF for take-off from a dry runway; </div>" ;
