d:idSpecObject_-1744053042_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(n).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(n) Ullage. The volume within the fuel tank not occupied by liquid fuel.</div>" ;
