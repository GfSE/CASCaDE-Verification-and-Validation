d:idSpecObject_1477179654_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1106(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Where the airflow delivery from the APU and main engine is delivered to a common manifold system, precautions must be taken to minimise the possibility of a hazardous condition due to reverse airflow through the APU resulting from malfunctions of any component in the system. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
