	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(a)(2).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) substantiate that the FRM is effective at limiting flammability exposure in all compartments of each tank for which the FRM is used to show compliance with paragraph M25.1; and</div>" ;
