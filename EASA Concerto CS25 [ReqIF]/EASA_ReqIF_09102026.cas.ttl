	o:idRegulatorySource1 "ED Decision 2007/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-09-19T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

d:idSpecObject_-227518127_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.907(b).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The determined vibration stresses may not exceed values that have been shown to be safe for continuous operation.</div>" ;
