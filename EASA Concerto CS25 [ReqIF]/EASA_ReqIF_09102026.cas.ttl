	a o:idSpecObject1 ;
	rdfs:label "CS 25.967(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The location of each tank must meet the requirements of CS 25.1185(a).</div>" ;
