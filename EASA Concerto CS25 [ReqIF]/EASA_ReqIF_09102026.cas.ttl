d:idSpecObject_-1954884424_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1387(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Dihedral angle L (left) is formed by two intersecting vertical planes, the first parallel to the longitudinal axis of the aeroplane, and the other at 110° to the left of the first, as viewed when looking forward along the longitudinal axis.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
