	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 6(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) System Control and Monitoring. The ATTCS system must be designed to provide – </div>" ;
