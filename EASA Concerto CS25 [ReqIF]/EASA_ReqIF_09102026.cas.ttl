d:idSpecObject_441843313_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.233.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "233" ;
	o:idTitle1 "Directional stability and control" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "GROUND HANDLING CHARACTERISTICS" ;
	o:ideRules1 "ERULES-1963177438-8304" ;
