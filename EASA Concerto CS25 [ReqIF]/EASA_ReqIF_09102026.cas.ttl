	a o:idSpecObject1 ;
	rdfs:label "CS 25.1703(a)(4).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Be designed and installed in a way that will minimise mechanical strain.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
