	a o:idSpecObject1 ;
	rdfs:label "CS 25.1001(d)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The fuel jettisoning system and its operation are free from fire hazard;</div>" ;
