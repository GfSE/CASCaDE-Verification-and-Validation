d:idSpecObject_-1383213079_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Distribution of limit loads to wheels; tyres inflated. The distribution of the limit loads among the wheels of the landing gear must be established for each landing, taxying, and ground handling condition, taking into account the effects of the following factors: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "511" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Ground load: unsymmetrical loads on multiple-wheel units" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8526" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1383213079_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The number of wheels and their physical arrangements. For truck type landing gear units, the effects of any see-saw motion of the truck during the landing impact must be considered in determining the maximum design loads for the fore and aft wheel pairs.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "511" ;
	o:idSubref1 "(b)(1)" ;
	o:idTitle1 "Ground load: unsymmetrical loads on multiple-wheel units" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8526" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1383213079_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Any differentials in tyre diameters resulting from a combination of manufacturing tolerances, tyre growth, and tyre wear. A maximum tyre-diameter differential equal to two-thirds of the most unfavourable combination of diameter variations that is obtained when taking into account manufacturing tolerances, tyre growth and tyre wear, may be assumed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "511" ;
	o:idSubref1 "(b)(2)" ;
	o:idTitle1 "Ground load: unsymmetrical loads on multiple-wheel units" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8526" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1383213079_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Any unequal tyre inflation pressure, assuming the maximum variation to be ±5% of the nominal tyre inflation pressure.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
