	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(b)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Need not be used with respect to the bearing surfaces of a part whose bearing factor is larger than the applicable casting factor. </div>" ;
