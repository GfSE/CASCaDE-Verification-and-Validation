d:idSpecObject_-2011277872_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.856.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "856" ;
	o:idTitle1 "Thermal/acoustic insulation materials" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-10169" ;
