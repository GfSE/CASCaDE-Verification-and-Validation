	a o:idSpecObject1 ;
	rdfs:label "CS 25.967(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) If a flexible tank liner is used, it must be supported so that it is not required to withstand fluid loads (see AMC 25.967(a)(3)); and</div>" ;
