d:idSpecObject_-1167862034_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Allow checking for proper shut-off operation before each fuelling of the tank; and</div>" ;
