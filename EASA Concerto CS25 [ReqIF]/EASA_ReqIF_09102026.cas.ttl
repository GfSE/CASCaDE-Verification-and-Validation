d:idSpecObject_-1518766152_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J955(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each fuel system must provide at least 100 percent of the fuel flow required by the APU under each intended operating condition and manoeuvre. Compliance must be shown as follows:</div>" ;
