	a o:idSpecObject1 ;
	rdfs:label "CS 25.1309(b)(5)(iii).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) the sum of the probabilities of the latent failures which are combined with each evident failure does not exceed 1/1 000.</div>" ;
