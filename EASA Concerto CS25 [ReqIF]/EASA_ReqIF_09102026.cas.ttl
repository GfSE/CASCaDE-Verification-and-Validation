	a o:idSpecObject1 ;
	rdfs:label "CS 25.1324(c).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) For aeroplanes certificated in accordance with CS 25.1420(a)(3), all icing conditions. Table 1 – Rain test conditions </div>" ;
