d:idSpecObject_2021291266_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 30(a)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) placard instructions for restoring the aisle to the taxiing, take-off, and landing configuration must be provided at the locations where the width of the cabin aisle is reduced; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
