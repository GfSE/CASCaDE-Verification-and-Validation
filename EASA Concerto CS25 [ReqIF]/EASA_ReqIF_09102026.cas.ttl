	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-361980801_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.493.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) An aeroplane with a tail wheel is assumed to be in the level attitude with the load on the main wheels, in accordance with Figure 6 of Appendix A. The limit vertical load factor is 1·2 at the design landing weight, and 1·0 at the design ramp weight. A drag reaction equal to the vertical reaction multiplied by a coefficient of friction of 0·8, must be combined with the vertical ground reaction and applied at the ground contact point.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For an aeroplane with a nose wheel, the limit vertical load factor is 1·2 at the design landing weight, and 1·0 at the design ramp weight. A drag reaction equal to the vertical reaction, multiplied by a coefficient of friction of 0·8, must be combined with the vertical reaction and applied at the ground contact point of each wheel with brakes. The following two attitudes, in accordance with Figure 6 of Appendix A, must be considered:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The level attitude with the wheels contacting the ground and the loads distributed between the main and nose gear. Zero pitching acceleration is assumed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(b)(1)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The level attitude with only the main gear contacting the ground and with the pitching moment resisted by angular acceleration.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(b)(2)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) A drag reaction lower than that prescribed in this paragraph may be used if it is substantiated that an effective drag force of 0·8 times the vertical reaction cannot be attained under any likely loading condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) An aeroplane equipped with a nose gear must be designed to withstand the loads arising from the dynamic pitching motion of the aeroplane due to sudden application of maximum braking force. The aeroplane is considered to be at design takeoff weight with the nose and main gears in contact with the ground, and with a steady state vertical load factor of 1·0. The steady state nose gear reaction must be combined with the maximum incremental nose gear vertical reaction caused by sudden application of maximum braking force as described in sub-paragraphs (b) and (c) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-361980801_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.493(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) In the absence of a more rational analysis, the nose gear vertical reaction prescribed in subparagraph (d) of this paragraph must be calculated in accordance with the following formula: <object data=\"images/CS-25_27_-361980801-10.jpg\" type=\"image/jpg\"></object> Where: VN = Nose gear vertical reaction WT = Design take-off weight A = Horizontal distance between the c.g. of the aeroplane and the nose wheel. B = Horizontal distance between the c.g. of the aeroplane and the line joining the centres of the main wheels. E = Vertical height of the c.g. of the aeroplane above the ground in the 1·0 g static condition. µ = Coefficient of friction of 0·8. f = Dynamic response factor; 2·0 is to be used unless a lower factor is substantiated. In the absence of other information, the dynamic response factor f may be defined by the equation. <object xmlns:reqif-xhtml=\"http://www.w3.org/1999/xhtml\" data=\"images/CS-25_27_-361980801-20.jpg\" type=\"image/jpg\"></object></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "493" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Braked roll conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8499" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_2001251463_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.495.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">In the static position, in accordance with Figure 7 of Appendix A, the aeroplane is assumed to execute a steady turn by nose gear steering, or by application of sufficient differential power, so that the limit load factors applied at the centre of gravity are 1·0 vertically and 0·5 laterally. The side ground reaction of each wheel must be 0·5 of the vertical reaction.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "495" ;
	o:idTitle1 "Turning" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8503" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.495.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1493038484_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.497.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
