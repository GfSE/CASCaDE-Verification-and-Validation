	a o:idSpecObject1 ;
	rdfs:label "CS 25.145(b)(2).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Repeat sub-paragraph (b)(1) of this paragraph except initially extend the wing-flaps and then retract them as rapidly as possible. (See AMC 25.145(b)(2) and AMC 25.145(b)(1), (b)(2) and (b)(3).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
