	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(a)(1)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Allow the aeroplane to accelerate from VEF to the highest speed reached during the rejected take-off, assuming the critical engine fails at VEF and the pilot takes the first action to reject the take-off at the V1 for take-off from a dry runway; and</div>" ;
