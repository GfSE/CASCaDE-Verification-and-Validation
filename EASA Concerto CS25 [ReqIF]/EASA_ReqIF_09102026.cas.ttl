	a o:idSpecObject1 ;
	rdfs:label "CS 25.1321(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The instrument that most effectively indicates attitude must be on the panel in the top centre position;</div>" ;
