d:idSpecObject_-761577566_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.361(a)(1)(ii).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) A limit engine torque corresponding to the maximum continuous power/thrust and, if applicable, corresponding propeller speed acting simultaneously with the limit loads from flight condition A of CS 25.333(b); and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
