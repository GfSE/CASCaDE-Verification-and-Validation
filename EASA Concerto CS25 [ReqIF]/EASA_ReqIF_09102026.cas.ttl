	a o:idSpecObject1 ;
	rdfs:label "CS 25.337(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Must vary linearly with speed from the value at VC to zero at VD.</div>" ;
