d:idSpecObject_-862454206_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The controllability, stability, trim, and stalling characteristics of the aeroplane must be shown for each altitude up to the maximum expected in operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
