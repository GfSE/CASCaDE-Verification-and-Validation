d:idSpecObject_1812057083_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1385(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. Each part of each position light system must meet the applicable requirements of this paragraph and each system as a whole must meet the requirements of CS 25.1387 to 25.1397.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1385" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Position light system installation" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8713" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1812057083_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1385(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Forward position lights. Forward position lights must consist of a red and a green light spaced laterally as far apart as practicable and installed forward on the aeroplane so that, with the aeroplane in the normal flying position, the red light is on the left side, and the green light is on the right side. Each light must be approved. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1385" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Position light system installation" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8713" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1812057083_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1385(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Rear position light. The rear position light must be a white light mounted as far aft as practicable on the tail or on each wing tip, and must be approved. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
