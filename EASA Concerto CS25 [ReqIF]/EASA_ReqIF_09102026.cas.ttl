	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(g)(3).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Position the burner so that flames will not impinge on the specimen, turn the burner on, and allow it to run for 2 minutes. Rotate the burner to apply the flame to the specimen and simultaneously start the timing device.</div>" ;
