	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 5(a)(1).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The selected approach path angle at VREF(SAL) or VREF(SAL)-1 as appropriate; </div>" ;
