d:idSpecObject_-2062423000_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(a).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The applicant must provide data from analysis, ground testing, and flight testing, or any combination of these, that:</div>" ;
