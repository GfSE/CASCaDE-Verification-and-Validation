d:idSpecObject_1829045085_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Interior Doors on Non-Commercially Operated Aeroplanes (See AMC to Appendix S, S25.10(a)): For a non-commercially operated aeroplane, installation of doors that results in non-compliance with CS 25.813(e) is acceptable provided that it is ensured by design and procedure that:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
