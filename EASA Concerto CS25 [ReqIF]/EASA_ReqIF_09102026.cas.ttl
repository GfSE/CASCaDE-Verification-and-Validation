	o:idSubsection1 "FATIGUE EVALUATION" ;
	o:ideRules1 "ERULES-1963177438-10206" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
