d:idSpecObject_552252819_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(3).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) At each point along the take-off path, starting at the point at which the aeroplane reaches 122 m (400 ft) above the take-off surface, the available gradient of climb may not be less than –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
