d:idSpecObject_2093360209_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(g)(1).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Allow one life line to be attached to each side of the fuselage; and</div>" ;
