d:idSpecObject_73235294_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.1717.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.1717 Circuit protective devices: EWIS ED Decision 2008/006/R CS 25.1717 requires that all applicable EWIS components (for example wires, connector pins, terminal blocks, relays, splices) be compatible with the circuit protective devices required by CS 25.1357. This means that when selecting the EWIS components to be used for a specific application, care must be taken to ensure that the proper type and rating of the circuit protective device (e.g., circuit breaker) is selected so that the wire and cables are adequately protected from over-current situations. [Amdt 25/5]</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
