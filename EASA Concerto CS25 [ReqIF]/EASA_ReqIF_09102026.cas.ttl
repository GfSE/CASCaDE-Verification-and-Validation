	a o:idSpecObject1 ;
	rdfs:label "CS 25.1707(j).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) Electrical wiring interconnection systems must be designed and installed with adequate physical separation between the EWIS components and heated equipment, hot air ducts, and lines such that;</div>" ;
