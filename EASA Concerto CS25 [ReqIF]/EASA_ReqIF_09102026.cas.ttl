	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(c)(2).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The specimens must be conditioned at 70°F ± 5oF (21°C ± 2°C) and 55% ± 5% humidity for at least 24 hours before testing.</div>" ;
