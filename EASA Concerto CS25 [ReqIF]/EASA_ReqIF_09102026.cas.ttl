	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(c).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) No fire or overheat detector may be affected by any oil, water, other fluids, or fumes that might be present.</div>" ;
