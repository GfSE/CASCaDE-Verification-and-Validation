	a o:idSpecObject1 ;
	rdfs:label "CS 25.1551.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Each oil quantity indicating means must be marked to indicate the quantity of oil readily and accurately. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
