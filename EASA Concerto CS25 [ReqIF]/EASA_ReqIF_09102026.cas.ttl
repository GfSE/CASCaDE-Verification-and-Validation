d:idSpecObject_473416160_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.905(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Engine power and propeller shaft rotational speed may not exceed the limits for which the propeller is certificated. (See CS-P 50.)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
