d:idSpecObject_547329926_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1383(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) There must be a means to indicate to the pilots when the landing lights are extended.</div>" ;
