d:idSpecObject_1187850300_37
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(h)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each emergency ex in the passenger compartment in excess of the minimum number of required emergency exits.</div>" ;
