	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Each powerplant instrument that utilises flammable fluids must be installed and located so that the escape of fluid would not create a hazard.</div>" ;
