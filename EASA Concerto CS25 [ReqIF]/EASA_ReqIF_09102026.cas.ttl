		d:idSpecObject_1169978537_14 .

d:idSpecObject_1169978537_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(b)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Under sub-paragraph (b)(3)(ii) and (iii) of this paragraph, the time of test must be adjusted to accomplish the same number of vibration cycles that would be accomplished in 25 hours at the frequency specified in sub-paragraph (b)(3)(i) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "965" ;
	o:idSubref1 "(b)(4)" ;
	o:idTitle1 "Fuel tank tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8370" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1169978537_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(b)(5).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) During the test, the tank assembly must be rocked at the rate of 16 to 20 complete cycles per minute, through an angle of 15° on both sides of the horizontal (30° total), about the most critical axis, for 25 hours. If motion about more than one axis is likely to be critical, the tank must be rocked about each critical axis for 12·5 hours.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "965" ;
	o:idSubref1 "(b)(5)" ;
	o:idTitle1 "Fuel tank tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8370" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1169978537_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each metallic tank with large unsupported or unstiffened flat surfaces, whose failure or deformation could cause fuel leakage, must be able to withstand the following test, or its equivalent, without leakage or excessive deformation of the tank walls:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "965" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Fuel tank tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8370" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" ;
	cas:lists d:idSpecObject_1169978537_9 ,
		d:idSpecObject_1169978537_10 ,
		d:idSpecObject_1169978537_11 ,
		d:idSpecObject_1169978537_15 ,
		d:idSpecObject_1169978537_16 .

d:idSpecObject_1169978537_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Except where satisfactory operating experience with a similar tank in a similar installation is shown, non-metallic tanks must withstand the test specified in sub-paragraph (b)(5) of this paragraph, with fuel at a temperature of 43.3°C (110°F). During this test, a representative specimen of the tank must be installed in a supporting structure simulating the installation in the aeroplane.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "965" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Fuel tank tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8370" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1169978537_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) For pressurised fuel tanks, it must be shown by analysis or tests that the fuel tanks can withstand the maximum pressure likely to occur on the ground or in flight.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
