d:idSpecObject_171137685_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Protection of flightdeck. If a secure flightdeck door is required by operating rules, the bulkhead, door, and any other accessible boundary separating the flight crew compartment from occupied areas must be designed to:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
