	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(c)(4)(i).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) each boom, mask, or handheld microphone, headset or speaker used at the stations for the third and fourth crew members; or</div>" ;
