	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each fire detector system must be constructed and installed so that –</div>" ;
