	a o:idSpecObject1 ;
	rdfs:label "CS 25.1123(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Piping must be supported to withstand any vibration and inertia loads to which it would be subjected in operation; and</div>" ;
