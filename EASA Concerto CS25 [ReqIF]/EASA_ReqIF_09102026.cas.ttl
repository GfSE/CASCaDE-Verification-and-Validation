d:idSpecObject_1879502793_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 6(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A means for the flight crew to deactivate the automatic function. This means must be designed to prevent inadvertent deactivation.</div>" ;
