d:idSpecObject_1062517513_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.843(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Functional tests. The following functional tests must be performed: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
