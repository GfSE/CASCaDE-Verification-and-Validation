d:idSpecObject_1444542175_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305(b)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The deformations involved are fully accounted for in the analysis; or </div>" ;
