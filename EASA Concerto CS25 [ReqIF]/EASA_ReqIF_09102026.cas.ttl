	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(b).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Aeroelastic stability envelopes. The aeroplane must be designed to be free from aeroelastic instability for all configurations and design conditions within the aeroelastic stability envelopes as follows:</div>" ;
