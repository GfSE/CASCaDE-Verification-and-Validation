d:idSpecObject_-1702518332_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1435(c)(1).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The system(s), subsystem(s), or element(s) must be subjected to performance, fatigue, and endurance tests representative of aeroplane ground and flight operations.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1435" ;
	o:idSubref1 "(c)(1)" ;
	o:idTitle1 "Hydraulic Systems" ;
	o:idAmendedBy1 "Amendment 2;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-9433" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2006/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2006-10-02T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2006-10-02T00:00:00Z" .

d:idSpecObject_-1702518332_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1435(c)(2).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The complete system must be tested to determine proper functional performance and relation to other systems, including simulation of relevant failure conditions, and to support or validate element design.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1435" ;
	o:idSubref1 "(c)(2)" ;
	o:idTitle1 "Hydraulic Systems" ;
	o:idAmendedBy1 "Amendment 2;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-9433" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2006/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2006-10-02T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2006-10-02T00:00:00Z" .

d:idSpecObject_-1702518332_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1435(c)(3).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The complete hydraulic system(s) must be functionally tested on the aeroplane in normal operation over the range of motion of all associated user systems. The test must be conducted at the relief pressure or 1.25 times the DOP if a system pressure relief device is not part of the system design. Clearances between hydraulic system elements and other systems or structural elements must remain adequate and there must be no detrimental effects.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
