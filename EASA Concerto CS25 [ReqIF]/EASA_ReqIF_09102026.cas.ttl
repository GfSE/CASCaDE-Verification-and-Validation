d:idSpecObject_-1014618069_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1715(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Electrical bonding provided by EWIS components must provide an adequate electrical return path under both normal and fault conditions, on aeroplanes having earthed electrical systems (see CS 25.1353(e)).</div>" ;
