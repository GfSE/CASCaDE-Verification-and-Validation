d:idSpecObject_1529221552_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1316(a).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each electrical and electronic system that performs a function whose failure would prevent the continued safe flight and landing of the aeroplane must be designed and installed so that: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1316" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Electrical and electronic system lightning protection" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10036" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_1529221552_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1316(a)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) the function is not adversely affected during and after the time the aeroplane is exposed to lightning; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1316" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Electrical and electronic system lightning protection" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10036" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_1529221552_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1316(a)(2).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) the system automatically recovers normal operation of that function, in a timely manner, after the aeroplane is exposed to lightning, unless the system’s recovery conflicts with other operational or functional requirements of the system that would prevent continued safe flight and landing of the aeroplane. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1316" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Electrical and electronic system lightning protection" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10036" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_1529221552_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1316(b).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each electrical and electronic system that performs a function whose failure would reduce the capability of the aeroplane or the ability of the flight crew to respond to an adverse operating condition must be designed and installed so that the function recovers normal operation in a timely manner after the aeroplane is exposed to lightning.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1316" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Electrical and electronic system lightning protection" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10036" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
