	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1452152415_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Prevent the continued safe operation of the remaining engines; or</div>" ;
