	a o:idSpecObject1 ;
	rdfs:label "CS 25.415(g)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) 0.75 times these maximum loads for each pilot when the pilot forces are applied in the same direction</div>" ;
