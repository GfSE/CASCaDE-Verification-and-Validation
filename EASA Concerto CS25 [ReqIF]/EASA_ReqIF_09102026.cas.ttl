d:idSpecObject_-261558925_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841.Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.841.Amendment 15;" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(a).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Pressurised cabins and compartments to be occupied must be equipped to provide a cabin pressure altitude of not more than 2438 m (8000 ft) at the maximum operating altitude of the aeroplane under normal operating conditions. If certification for operation over 7620 m (25 000 ft) is requested, the aeroplane must be able to maintain a cabin pressure altitude of not more than 4572 m (15 000 ft) in the event of any reasonably probable failure or malfunction in the pressurisation system.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Pressurised cabins must have at least the following valves, controls, and indicators for controlling cabin pressure:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(1).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Two pressure relief valves to automatically limit the positive pressure differential to a predetermined value at the maximum rate of flow delivered by the pressure source. The combined capacity of the relief valves must be large enough so that the failure of any one valve would not cause an appreciable rise in the pressure differential. The pressure differential is positive when the internal pressure is greater than the external.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
	o:idSubref1 "(b)(1)" ;
	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(2).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Two reverse pressure differential relief valves (or their equivalents) to automatically prevent a negative pressure differential that would damage the structure. One valve is enough, however, if it is of a design that reasonably precludes it’s malfunctioning.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
	o:idSubref1 "(b)(2)" ;
	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(3).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) A means by which the pressure differential can be rapidly equalised.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
