	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(e).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) The aeroplane must be designed to indicate to the flight crew whenever the primary control means is near the limit of control authority.</div>" ;
