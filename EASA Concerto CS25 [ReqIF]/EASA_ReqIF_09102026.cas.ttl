	a o:idSpecObject1 ;
	rdfs:label "CS 25.1585(f).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Information on the total quantity of usable fuel for each fuel tank must be furnished.</div>" ;
