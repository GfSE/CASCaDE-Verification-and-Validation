	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(8).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) A door that could result in a hazard if not closed, must have means to prevent the latches from being moved to the latched position unless it can be shown that a door that is not closed would be clearly evident before flight.</div>" ;
