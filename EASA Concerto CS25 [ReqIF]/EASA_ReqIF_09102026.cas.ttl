	a o:idSpecObject1 ;
	rdfs:label "CS 25.1535(a).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Compliance with the requirements of CS-25 considering the maximum flight duration and the longest diversion time for which approval is being sought. </div>" ;
