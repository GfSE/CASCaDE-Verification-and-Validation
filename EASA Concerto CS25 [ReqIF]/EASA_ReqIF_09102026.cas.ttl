	a o:idSpecObject1 ;
	rdfs:label "CS 25.471(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Appropriate loading instructions for random disposable loads are included under the provisions of CS 25.1583(c)(1) to ensure that the lateral displacement of the centre of gravity is maintained within these limits.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
