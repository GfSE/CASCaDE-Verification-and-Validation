	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(f)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) For the determination of the strength of the local attachments of –</div>" ;
