d:idSpecObject_-945172181_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J993(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Flexible hose must be approved or must be shown to be suitable for the particular application.</div>" ;
