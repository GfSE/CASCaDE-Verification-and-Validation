	a o:idSpecObject1 ;
	rdfs:label "CS 25.1461(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Equipment containing high energy rotors must meet sub-paragraph (b), (c) or (d) of this paragraph.</div>" ;
