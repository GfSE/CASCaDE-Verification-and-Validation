d:idSpecObject_-192061252_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A means to indicate system pressure located at a flight-crew member station, must be provided for each pneumatic system that –</div>" ;
