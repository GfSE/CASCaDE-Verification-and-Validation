d:idSpecObject_-906118180_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1585(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Information must be furnished that indicates that when the fuel quantity indicator reads ‘zero’ in level flight, any fuel remaining in the fuel tank cannot be used safely in flight.</div>" ;
