d:idSpecObject_-1028631822_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1713(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) All EWIS components must meet the applicable fire and smoke protection requirements of CS 25.831(c) and CS 25.863. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
