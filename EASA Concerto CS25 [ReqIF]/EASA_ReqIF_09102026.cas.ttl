	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(c)(2)(i)(A).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(A) the limit symmetrical manoeuvring conditions specified in CS 25.331 and in CS 25.345.</div>" ;
