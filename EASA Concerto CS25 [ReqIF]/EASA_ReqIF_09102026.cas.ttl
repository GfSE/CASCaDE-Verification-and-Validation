d:idSpecObject_-247441853_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.107(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) V1 must be established in relation to VEF as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
