d:idSpecObject_-718172015_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.231(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Wheel brakes must operate smoothly and may not cause any undue tendency to nose over; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
