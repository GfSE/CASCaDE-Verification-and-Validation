	o:idTitle1 "Strength and deformation" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-9318" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1444542175_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305(f).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Unless shown to be extremely improbable, the aeroplane must be designed to withstand any forced structural vibration resulting from any failure, malfunction or adverse condition in the flight control system. These loads must be treated in accordance with the requirements of CS 25.302.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
