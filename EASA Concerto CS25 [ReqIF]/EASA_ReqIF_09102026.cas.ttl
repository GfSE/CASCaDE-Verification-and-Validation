d:idSpecObject_-1509662283_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(l).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(l) Wheel brake temperature. Equipment and structure that are essential to the safe operation of the aeroplane and that are located on the landing gear and in wheel wells must be protected from the damaging effects of possible wheel brake temperatures.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
