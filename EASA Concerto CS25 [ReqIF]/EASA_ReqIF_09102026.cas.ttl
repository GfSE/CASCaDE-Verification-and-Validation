	a o:idSpecObject1 ;
	rdfs:label "CS 25.J953(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) From the fuel supply to the main engine if provision is made for a shut-off means to isolate the APU fuel line. </div>" ;
