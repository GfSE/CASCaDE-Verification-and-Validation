	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1082908761_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(e).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) No hazardous quantity of flammable fluid may drain into any designated fire zone after shut-off.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
