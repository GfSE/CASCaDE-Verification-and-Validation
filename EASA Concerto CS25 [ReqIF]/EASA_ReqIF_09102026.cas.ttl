	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 5(a)(2).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) An approach path angle 2° steeper than the selected approach path angle, at VREF(SAL) or VREF(SAL)-1 as appropriate; and</div>" ;
