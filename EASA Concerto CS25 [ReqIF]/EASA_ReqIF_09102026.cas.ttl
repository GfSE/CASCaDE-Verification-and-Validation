d:idSpecObject_1187850300_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(g)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) For a passenger seating configuration of 1 to 9 seats, there must be at least one Type IV or larger over-wing exit on each side of the fuselage or, if over-wing exits are not provided, at least one exit on each side that meets the minimum dimensions of a Type III exit.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "807" ;
	o:idSubref1 "(g)(1)" ;
	o:idTitle1 "Emergency exits" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-18458" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1187850300_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(g)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For a passenger seating configuration of more than 9 seats, each exit must be a Type III or larger exit.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
