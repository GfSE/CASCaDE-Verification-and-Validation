	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10085" ;
