d:idSpecObject_-423451995_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1309(d).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Electrical wiring interconnection systems must be assessed in accordance with the requirements of CS 25.1709.</div>" ;
