	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-8646" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1347327207_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part V(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Acceptance Criteria. The specific optical smoke density (Ds) which is obtained by averaging the reading obtained after 4 minutes with each of the three specimens, shall not exceed 200.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
