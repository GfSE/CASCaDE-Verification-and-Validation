d:idSpecObject_-961563324_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(e).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) If a public address system is installed in the aeroplane, speakers must be provided in each lower deck service compartment.</div>" ;
