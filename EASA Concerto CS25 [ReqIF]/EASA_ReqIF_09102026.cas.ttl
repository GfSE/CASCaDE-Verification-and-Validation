	a o:idSpecObject1 ;
	rdfs:label "CS 25.1557(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Emergency exit placards. Each emergency exit placard must meet the requirements of CS 25.811. </div>" ;
