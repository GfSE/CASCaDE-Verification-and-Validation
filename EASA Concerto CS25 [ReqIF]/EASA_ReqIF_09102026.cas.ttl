	a o:idSpecObject1 ;
	rdfs:label "CS 25.1423(a)(2).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) An additional time duration in its standby state appropriate or required for any other loads that are powered by the same source and that are essential to safety of flight or required during emergency conditions.</div>" ;
