	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-18462" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_-1070920956_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(e).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Any novel or unique design or operational characteristics of the aeroplane must be evaluated to determine if any dedicated parameters must be recorded on the flight data recorder in addition to, or in place of, the parameters that are required by the existing requirements.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1459" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Flight data recorders" ;
