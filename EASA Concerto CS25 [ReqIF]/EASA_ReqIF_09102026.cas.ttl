	a o:idSpecObject1 ;
	rdfs:label "CS 25.471(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) In each specified ground load condition, the external loads must be placed in equilibrium with the linear and angular inertia loads in a rational or conservative manner.</div>" ;
