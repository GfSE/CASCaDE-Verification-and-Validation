	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(d)(2).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If dispatch with the system inoperative under the Master Minimum Equipment List (MMEL) is requested, the time period assumed in the reliability analysis shall be consistent with the proposed rectification interval, depending on aeroplane utilisation,</div>" ;
