d:idSpecObject_-786188817_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Fire classes against which fire-extinguishing agents may be employed are: Class A: Fires involving ordinary combustible materials, such as wood, cloth, paper, rubber and plastics; Class B: Fires involving flammable liquids, petroleum oils, greases, tars, oil base paints, lacquers, solvents, alcohols and flammable gases; Class C: Fires involving energised electrical equipment where the use of an extinguishing agent that is electrically non-conductive is important.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
