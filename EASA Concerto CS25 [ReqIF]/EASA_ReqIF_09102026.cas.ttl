	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(c)(2)(i)(C).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(C) the limit rolling conditions specified in CS 25.349 and the limit unsymmetrical conditions specified in CS 25.367 and CS 25.427(b) and (c). </div>" ;
