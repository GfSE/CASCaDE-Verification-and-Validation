	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-9483" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1302.Amendment 3;" ;
	o:idApplicabilityDate1 "2007-09-19T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

