	a o:idSpecObject1 ;
	rdfs:label "CS 25.1163(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Electrical equipment subject to arcing or sparking must be installed to minimise the probability of contact with any flammable fluids or vapours that might be present in a free state.</div>" ;
