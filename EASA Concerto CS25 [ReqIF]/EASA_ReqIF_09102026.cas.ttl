	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1165.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Each APU ignition system must be independent of any electrical circuit except those used for assisting, controlling, or analysing the operation of that system.</div>" ;
