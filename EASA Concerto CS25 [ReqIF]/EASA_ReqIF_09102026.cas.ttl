d:idSpecObject_1829980631_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.689(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Turnbuckles must be attached to parts having angular motion in a manner that will positively prevent binding throughout the range of travel.</div>" ;
