d:idSpecObject_171137685_30
	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(d)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) By providing effective resistance to tampering; </div>" ;
