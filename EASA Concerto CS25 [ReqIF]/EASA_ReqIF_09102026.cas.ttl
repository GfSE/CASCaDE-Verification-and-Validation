	o:idEntryIntoForceDate1 "2011-07-04T00:00:00Z" .

d:idSpecObject_1995393275_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(f).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Use of the colours red, amber and yellow on the flight deck for functions other than flight crew alerting must be limited and must not adversely affect flight crew alerting.</div>" ;
