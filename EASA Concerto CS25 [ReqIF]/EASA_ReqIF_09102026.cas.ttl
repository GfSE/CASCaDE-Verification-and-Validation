	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1460114103_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(7)(iii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) no protrusions (such as coat hooks) could impede evacuation.</div>" ;
