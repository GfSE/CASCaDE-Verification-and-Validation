	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(c)(1)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) At maximum regulated voltage or power;</div>" ;
