d:idSpecObject_286963373_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) For aeroplane systems for which the ability to remove or reset power during normal operations is necessary, the system must be designed so that circuit breakers are not the primary means to remove or reset system power, unless specifically designed for use as a switch. (see AMC 25.1357(f)).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1357" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 "Circuit protective devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10102" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_286963373_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1357(g).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Automatic reset circuit breakers may be used as integral protectors for electrical equipment (such as thermal cutouts) if there is circuit protection to protect the cable to the equipment.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
