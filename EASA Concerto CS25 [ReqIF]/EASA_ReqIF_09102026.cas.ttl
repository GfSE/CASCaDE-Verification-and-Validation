d:idSpecObject_659713843_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.237(a)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A 90° cross component of wind velocity, demonstrated to be safe for take-off and landing, must be established for dry runways and must be at least 37 km/h (20 kt) or 0·2 VSR0, whichever is greater, except that it need not exceed 46 km/h (25 kt).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
