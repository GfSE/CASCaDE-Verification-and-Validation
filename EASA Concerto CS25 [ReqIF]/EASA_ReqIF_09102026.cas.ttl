d:idSpecObject_779656215_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.321(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Enough points on and within the boundaries of the design envelope must be investigated to ensure that the maximum load for each part of the aeroplane structure is obtained.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
