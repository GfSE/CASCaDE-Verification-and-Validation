d:idSpecObject_1220423236_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1707(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each EWIS must be designed and installed with adequate physical separation from other EWIS and aeroplane systems so that an EWIS component failure will not create a hazardous condition. Unless otherwise stated, for the purposes of this paragraph, adequate physical separation must be achieved by separation distance or by a barrier that provides protection equivalent to that separation distance.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1707" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "System Separation; EWIS" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART H – ELECTRICAL WIRING INTERCONNECTION SYSTEMS" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-9550" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_1220423236_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1707(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each EWIS must be designed and installed such that any electrical interference likely to be present in the aeroplane will not result in hazardous effects upon the aeroplane or its systems except under extremely remote conditions.</div>" ;
