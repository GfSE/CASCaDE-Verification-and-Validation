	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(c)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For the continuation of the flight. For the aeroplane, in the system failed state and considering any appropriate reconfiguration and flight limitations, the following apply:</div>" ;
