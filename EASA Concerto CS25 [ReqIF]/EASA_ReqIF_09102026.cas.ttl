	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(3).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) (i) It receives its electrical power from the bus that provides the maximum reliability for operation of the recorder without jeopardising service to essential or emergency loads; and</div>" ;
