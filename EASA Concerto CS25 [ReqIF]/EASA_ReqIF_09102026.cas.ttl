	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(d)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Those required for continued controlled flight; and</div>" ;
