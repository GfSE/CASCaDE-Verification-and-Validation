	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(c)(6)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) A system to control the charging rate of the battery automatically so as to prevent battery overheating or;</div>" ;
