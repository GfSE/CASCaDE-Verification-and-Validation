	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(7).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) If another recorder is installed to perform the cockpit voice recorder function, any single electrical failure that is external to the recorder dedicated to the flight data recorder function does not disable both the recorders; and</div>" ;
