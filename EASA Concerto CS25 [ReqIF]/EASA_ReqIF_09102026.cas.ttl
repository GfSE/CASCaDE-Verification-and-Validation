	a o:idSpecObject1 ;
	rdfs:label "CS 25.1305(a)(2)(iv)(A).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(A) It is provided to the flight crew when the usable quantity of fuel in the tank concerned reaches the quantity required to operate the engine(s) for 30 minutes at cruise conditions;</div>" ;
