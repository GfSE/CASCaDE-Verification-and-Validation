	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1023.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Each oil radiator must be able to withstand, without failure, any vibration, inertia, and oil pressure load to which it would be subjected in operation.</div>" ;
