	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_39662269_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1019(a)(5).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) An oil strainer or filter that has no bypass, except one that is installed at an oil tank outlet, must have a means to connect it to the warning system required in CS 25.1305(c)(7). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
