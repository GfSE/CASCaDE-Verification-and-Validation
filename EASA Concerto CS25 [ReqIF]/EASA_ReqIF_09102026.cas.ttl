	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_2055683509_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.777(h).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) If a flight engineer is required as part of the minimum flight crew (established under CS 25.1523), the aeroplane must have a flight engineer station located and arranged so that the flight-crew members can perform their functions efficiently and without interfering with each other.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
