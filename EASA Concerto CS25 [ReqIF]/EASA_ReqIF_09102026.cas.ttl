	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1189(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Operation of any shut-off may not interfere with the later emergency operation of other equipment.</div>" ;
