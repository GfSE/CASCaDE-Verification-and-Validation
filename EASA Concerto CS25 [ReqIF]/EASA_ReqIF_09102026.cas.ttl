	a o:idSpecObject1 ;
	rdfs:label "CS 25.993(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each flexible connection in fuel lines that may be under pressure and subject to axial loading must use flexible hose assemblies.</div>" ;
