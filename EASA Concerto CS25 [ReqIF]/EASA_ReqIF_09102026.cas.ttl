	a o:idSpecObject1 ;
	rdfs:label "CS 25.J901(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) An essential APU is defined as an APU whose function is required for the dispatch of the aeroplane and/or continued safe flight.</div>" ;
