	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1575056278_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(d)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The combination of vertical and drag components is considered to be acting at the wheel axle centreline.</div>" ;
