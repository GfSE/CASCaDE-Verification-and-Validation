d:idSpecObject_875000094_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.519(b)(2)(ii).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) The jacking pads and local structure must be designed for a vertical load of 2·0 times the vertical static reaction at each jacking point, acting singly and in combination with a horizontal load of 0·33 times the vertical static reaction applied in any direction.</div>" ;
