	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A forward acting load at the aeroplane centre of gravity of 0·8 times the vertical load on one main gear.</div>" ;
