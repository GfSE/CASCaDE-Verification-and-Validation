d:idSpecObject_-615295197_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.772(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For aeroplanes with passenger seating configuration of 20 seats or more, the emergency exit configuration must be designed so that neither crewmembers nor passengers require use of the flight deck door in order to reach the emergency exits provided for them; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
