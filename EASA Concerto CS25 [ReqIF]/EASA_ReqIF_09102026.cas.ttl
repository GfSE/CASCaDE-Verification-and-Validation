	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_441843313_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.233(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There may be no uncontrollable ground-looping tendency in 90° cross winds, up to a wind velocity of 37 km/h (20 kt) or 0·2 VSR0, whichever is greater, except that the wind velocity need not exceed 46 km/h (25 kt) at any speed at which the aeroplane may be expected to be operated on the ground. This may be shown while establishing the 90° cross component of wind velocity required by CS 25.237. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "233" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Directional stability and control" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "GROUND HANDLING CHARACTERISTICS" ;
	o:ideRules1 "ERULES-1963177438-8304" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_441843313_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.233(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Aeroplanes must be satisfactorily controllable, without exceptional piloting skill or alertness, in power-off landings at normal landing speed, without using brakes or engine power to maintain a straight path. This may be shown during power-off landings made in conjunction with other tests.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
