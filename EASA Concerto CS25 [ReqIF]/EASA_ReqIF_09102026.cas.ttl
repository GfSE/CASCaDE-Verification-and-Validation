d:idSpecObject_-1456217317_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.854(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each lavatory must be equipped with a smoke detector system or equivalent that provides a warning light in the cockpit, or provides a warning light or audible warning in the passenger cabin that would be readily detected by a cabin crew member; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
