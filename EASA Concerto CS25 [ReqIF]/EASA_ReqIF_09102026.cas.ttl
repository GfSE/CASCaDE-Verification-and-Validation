d:idSpecObject_-749083209_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Near a required floor level emergency exit, except that another location is acceptable if the emergency egress of passengers would be enhanced with that location. A cabin crewmember seat must be located adjacent to each Type A or B emergency exit. Other cabin crewmember seats must be evenly distributed among the required floor level emergency exits to the extent feasible.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "785" ;
	o:idSubref1 "(h)(1)" ;
	o:idTitle1 "Seats, berths, safety belts and harnesses" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10204" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-749083209_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) To the extent possible, without compromising proximity to a required floor level emergency exit, located to provide a direct view of the cabin area for which the cabin crewmember is responsible. (See AMC 25.785(h)(2))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "785" ;
	o:idSubref1 "(h)(2)" ;
	o:idTitle1 "Seats, berths, safety belts and harnesses" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10204" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-749083209_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Positioned so that the seat will not interfere with the use of a passageway or exit when the seat is not in use.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "785" ;
