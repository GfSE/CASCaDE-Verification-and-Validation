d:idSpecObject_1273335886_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.981(b)(3).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Any active Flammability Reduction means introduced to allow compliance with sub-paragraph (2) must meet appendix M of CS-25.</div>" ;
