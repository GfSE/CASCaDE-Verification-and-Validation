	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(f).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Location. (See AMC 25.807(f))</div>" ;
