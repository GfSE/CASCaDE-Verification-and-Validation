	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(5)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) are readable by each person seated adjacent to and facing a passageway to the exit, one in their normal field of view; and one adjacent to or on the exit;</div>" ;
