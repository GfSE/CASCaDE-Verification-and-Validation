d:idSpecObject_1783419709_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. For aeroplanes with retractable landing gear, the following apply: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
