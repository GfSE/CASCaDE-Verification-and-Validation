	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(b)(3).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Configuration changes, including deployment or retraction of deceleration devices; and</div>" ;
