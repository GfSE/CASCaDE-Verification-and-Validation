	o:idApplicabilityDate1 "2018-03-28T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-03-28T00:00:00Z" .

d:idSpecObject_502859743_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.562(a)(1).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Proper use is made of seats, safety belts, and shoulder harnesses provided for in the design; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
