d:idSpecObject_2093360209_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(d)(2).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Life rafts must be stowed near exits through which the rafts can be launched during an unplanned ditching.</div>" ;
