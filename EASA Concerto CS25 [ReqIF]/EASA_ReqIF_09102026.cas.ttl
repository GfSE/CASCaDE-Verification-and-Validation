d:idSpecObject_25245537_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.571(d).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Sonic fatigue strength. It must be shown by analysis, supported by test evidence, or by the service history of aeroplanes of similar structural design and sonic excitation environment, that:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
