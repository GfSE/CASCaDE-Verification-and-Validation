	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1141(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) APU controls located elsewhere on the aeroplane, which are in addition to the flight deck controls, must meet the following requirements:</div>" ;
