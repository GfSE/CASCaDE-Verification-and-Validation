d:idSpecObject_791163241_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.855(i).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) During the above tests, it must be shown that no inadvertent operation of smoke or fire detectors in any compartment would occur as a result of fire contained in any other compartment, either during or after extinguishment, unless the extinguishing system floods each such compartment simultaneously.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
