	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) 0 g to 2·0 g, and extrapolating by an acceptable method to – 1 g and 2·5 g.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
