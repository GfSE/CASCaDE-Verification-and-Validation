d:idSpecObject_-1378341971_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J991(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Main pumps. Each fuel pump required for proper essential APU operation, or required to meet the fuel system requirements of this subpart (other than those in sub-paragraph (b) of this paragraph), is a main pump. For each main pump, provision must be made to allow the bypass of each positive displacement fuel injection pump other than a fuel pump approved as part of the APU.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J991" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Fuel Pumps" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "FUEL SYSTEM COMPONENTS" ;
	o:ideRules1 "ERULES-1963177438-9565" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_-1378341971_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J991(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Emergency pumps. There must be emergency pumps or another main pump to feed an essential APU immediately after failure of any main pump (other than a fuel pump approved as part of the APU). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
