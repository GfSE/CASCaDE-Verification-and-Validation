d:idSpecObject_-2072346087_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1001(d)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The jettisoning operation does not adversely affect the controllability of the aeroplane.</div>" ;
