	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(d)(3).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) a flare to a landing, and a flare to a ditching can be achieved; and</div>" ;
