d:idSpecObject_1100884094_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.343(b)(1)(i).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) A manoeuvring load factor of +2·25; and </div>" ;
