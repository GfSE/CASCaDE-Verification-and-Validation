d:idSpecObject_-1510765691_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1703(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The selection of wires must take into account known characteristics of the wire in relation to each particular installation and application in order to minimise the risk of wire damage, including any arc tracking phenomena.</div>" ;
