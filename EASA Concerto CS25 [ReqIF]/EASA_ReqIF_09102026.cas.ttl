d:idSpecObject_347083284_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1324(b).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For aeroplanes certificated in accordance with CS 25.1420(a)(2), the icing conditions that the aeroplane is certified to safely operate in and the icing conditions that the aeroplane is certified to safely exit following detection;</div>" ;
