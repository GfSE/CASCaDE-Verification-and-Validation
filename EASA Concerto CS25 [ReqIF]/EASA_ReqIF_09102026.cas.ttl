d:idSpecObject_346279536_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.119(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) In non-icing conditions, with a climb speed of VREF determined in accordance with CS 25.125(b)(2)(i); and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
