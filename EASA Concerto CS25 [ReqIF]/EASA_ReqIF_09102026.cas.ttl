d:idSpecObject_-615295197_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.772(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) There must be an emergency means to enable a crewmember to enter the pilot compartment in the event that the flight crew becomes incapacitated.</div>" ;
