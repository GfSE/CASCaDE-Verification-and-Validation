	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(g)(3).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Have, if the recorder is not deployable, an underwater locating device on or adjacent to the container which is secured in such a manner that they are not likely to be separated during crash impact;</div>" ;
