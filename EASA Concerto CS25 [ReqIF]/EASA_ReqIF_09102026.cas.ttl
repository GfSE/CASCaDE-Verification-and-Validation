	a o:idSpecObject1 ;
	rdfs:label "CS 25.483(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The ground reactions must be the same as those obtained on that side under CS 25.479(d)(1), and </div>" ;
