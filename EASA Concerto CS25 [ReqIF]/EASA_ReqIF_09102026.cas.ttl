	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(e)(2)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Be conspicuously located and well illuminated by the emergency lighting even in conditions of occupant crowding at the exit.</div>" ;
