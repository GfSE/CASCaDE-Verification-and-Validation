d:idSpecObject_1267322594_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1121(g).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Each exhaust shroud must be ventilated or insulated to avoid, during normal operation, a temperature high enough to ignite any flammable fluids or vapours external to the shroud.</div>" ;
