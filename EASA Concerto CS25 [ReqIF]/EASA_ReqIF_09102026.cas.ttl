	a o:idSpecObject1 ;
	rdfs:label "CS 25.509(c)(2).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The towing loads at the auxiliary gear and the drag components of the towing loads at the main gear must be reacted as follows:</div>" ;
