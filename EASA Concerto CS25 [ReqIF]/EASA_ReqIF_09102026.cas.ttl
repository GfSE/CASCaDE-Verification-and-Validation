d:idSpecObject_-1624084903_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) For each fuel tank and surrounding airframe structure, the effects of crushing and scraping actions with the ground should not cause the spillage of enough fuel, or generate temperatures that would constitute a fire hazard under the conditions specified in CS 25.721(b). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "963" ;
	o:idSubref1 "(d)(4)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Fuel tank installations must be such that the tanks will not rupture as a result of an engine pylon or engine mount or landing gear, tearing away as specified in CS 25.721(a) and (c). (See AMC 25.963(g).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
