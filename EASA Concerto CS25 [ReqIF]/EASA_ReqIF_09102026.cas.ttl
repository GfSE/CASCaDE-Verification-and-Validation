	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Failures, malfunctions, and adverse conditions. The failures, malfunctions, and adverse conditions which must be considered in showing compliance with this paragraph are:</div>" ;
