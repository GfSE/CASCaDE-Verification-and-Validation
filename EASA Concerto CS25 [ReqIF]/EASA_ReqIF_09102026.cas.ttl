d:idSpecObject_-1359237463_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1187(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) No ventilation opening may be where it would allow the entry of flammable fluids, vapours, or flame from other zones.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
