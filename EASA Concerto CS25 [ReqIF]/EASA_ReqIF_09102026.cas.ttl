	o:idAmendedBy1 "Amendment 11;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9657" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2011/004/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2011-07-04T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2011-07-04T00:00:00Z" .

d:idSpecObject_1995393275_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(d)(1).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) prevent the presentation of an alert when it is inappropriate or unnecessary;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1322" ;
	o:idSubref1 "(d)(1)" ;
	o:idTitle1 "Flight Crew Alerting" ;
	o:idAmendedBy1 "Amendment 11;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9657" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2011/004/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2011-07-04T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2011-07-04T00:00:00Z" .

d:idSpecObject_1995393275_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(d)(2).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) provide a means to suppress an attention-getting component of an alert caused by a failure of the alerting function that interferes with the flight crew’s ability to safely operate the aeroplane. This means must not be readily available to the flight crew so that it could be operated inadvertently or by habitual reflexive action. When an alert is suppressed, there must be a clear and unmistakable annunciation to the flight crew that the alert has been suppressed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1322" ;
	o:idSubref1 "(d)(2)" ;
	o:idTitle1 "Flight Crew Alerting" ;
	o:idAmendedBy1 "Amendment 11;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9657" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2011/004/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2011-07-04T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2011-07-04T00:00:00Z" .

d:idSpecObject_1995393275_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(e).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Visual alert indications must:</div>" ;
