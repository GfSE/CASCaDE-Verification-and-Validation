d:idSpecObject_-1302882791_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI.Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Use this test method to evaluate the flammability and flame propagation characteristics of thermal/acoustic insulation when exposed to both a radiant heat source and a flame. TABLE 1.—CALIBRATION TABLE </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
