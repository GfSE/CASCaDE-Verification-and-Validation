d:idSpecObject_-1958403998_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1717.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1717)EWIS components must be designed and installed so they are compatible with the circuit protection devices required by CS 25.1357, so that a fire or smoke hazard cannot be created under temporary or continuous fault conditions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1717" ;
	o:idTitle1 "Circuit protective devices; EWIS" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART H – ELECTRICAL WIRING INTERCONNECTION SYSTEMS" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-9556" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1717.Amendment 5;" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_-1712505962_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1719.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1719)Means must be provided to allow for inspection of EWIS and the replacement of its components as necessary for continued airworthiness.</div>" ;
