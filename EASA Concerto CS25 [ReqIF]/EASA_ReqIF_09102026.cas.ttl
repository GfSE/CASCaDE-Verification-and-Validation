	a o:idSpecObject1 ;
	rdfs:label "CS 25.J955(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) Fuel must be delivered at a pressure within the limits specified for the APU.</div>" ;
