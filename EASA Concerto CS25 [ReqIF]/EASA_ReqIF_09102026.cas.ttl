	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(6).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Warning indication at the pilot or flight engineer station to indicate when the safe or pre-set pressure differential and cabin pressure altitude limits are exceeded. Appropriate warning markings on the cabin pressure differential indicator meet the warning requirement for pressure differential limits and an aural or visual signal (in addition to cabin altitude indicating means) meets the warning requirement for cabin pressure altitude limits if it warns the flight crew when the cabin pressure altitude exceeds 3048 m (10 000 ft).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "841" ;
	o:idSubref1 "(b)(6)" ;
	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(7).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) A warning placard at the pilot or flight engineer station if the structure is not designed for pressure differentials up to the maximum relief valve setting in combination with landing loads.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
