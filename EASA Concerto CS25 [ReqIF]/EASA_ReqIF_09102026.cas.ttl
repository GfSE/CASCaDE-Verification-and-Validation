	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_-1712505962_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1719.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1719)Means must be provided to allow for inspection of EWIS and the replacement of its components as necessary for continued airworthiness.</div>" ;
