d:idSpecObject_-1612993865_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) From an initial condition with the aeroplane trimmed at cruise speeds up to VMO/MMO, the aeroplane must have satisfactory manoeuvring stability and controllability with the degree of out-of-trim in both the aeroplane nose-up and nose-down directions, which results from the greater of –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
