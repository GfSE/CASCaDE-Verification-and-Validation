d:idSpecObject_-125199643_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The energy supply to each emergency lighting unit must provide the required level of illumination for at least 10 minutes at the critical ambient conditions after emergency landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
