	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "TRIM" ;
	o:ideRules1 "ERULES-1963177438-8264" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_431726346_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.161(c)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Level flight at any speed from 1·3 VSR1, to VMO/MMO, with the landing gear and wing-flaps retracted, and from 1·3 VSR1 to VLE with the landing gear extended. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
