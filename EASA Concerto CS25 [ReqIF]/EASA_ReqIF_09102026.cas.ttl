	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(d)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The elimination of any injurious object within striking radius of the head.</div>" ;
