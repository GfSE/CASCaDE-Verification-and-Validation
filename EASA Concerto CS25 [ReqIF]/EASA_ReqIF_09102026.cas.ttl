	a o:idSpecObject1 ;
	rdfs:label "CS 25.1197(a)(1).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Be capable of extinguishing flames emanating from any burning of fluids or other combustible materials in the area protected by the fire extinguishing system; and</div>" ;
