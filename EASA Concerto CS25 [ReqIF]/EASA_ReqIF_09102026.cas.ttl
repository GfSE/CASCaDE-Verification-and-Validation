d:idSpecObject_1047426119_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.809(i).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Each emergency exit must have a means to retain the exit in the open position, once the exit is opened in an emergency. The means must not require separate action to engage when the exit is opened, and must require positive action to disengage.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
