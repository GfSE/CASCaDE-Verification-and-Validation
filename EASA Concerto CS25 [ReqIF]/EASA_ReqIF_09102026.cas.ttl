	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(7)(vii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(vii) There is no means to manually deploy the recorder while the aeroplane is capable of moving under its own power; and</div>" ;
