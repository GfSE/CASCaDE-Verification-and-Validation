d:idSpecObject_-1777977512_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1325(c).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (c) The design and installation of the static pressure system must be such that –</div>" ;
