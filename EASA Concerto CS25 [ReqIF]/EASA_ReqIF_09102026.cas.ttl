d:idSpecObject_-749083209_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(d).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each occupant of a seat that makes more than an 18-degree angle with the vertical plane containing the aeroplane centre line must be protected from head injury by a safety belt and an energy absorbing rest that will support the arms, shoulders, head and spine, or by a safety belt and shoulder harness that will prevent the head from contacting any injurious object. Each occupant of any other seat must be protected from head injury by a safety belt and, as appropriate to the type, location, and angle of facing of each seat, by one or more of the following: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "785" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Seats, berths, safety belts and harnesses" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10204" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-749083209_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(d)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A shoulder harness that will prevent the head from contacting any injurious object.</div>" ;
