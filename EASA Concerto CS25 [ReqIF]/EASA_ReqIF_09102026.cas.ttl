	a o:idSpecObject1 ;
	rdfs:label "CS 25.J977(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The diameter of each strainer must be at least that of the fuel tank outlet.</div>" ;
