d:idSpecObject_-783279111_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Fuel quantity indicator. There must be means to indicate to the flight-crew members, the quantity, in litres, (gallons), or equivalent units, of usable fuel in each tank during flight. In addition – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1337" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Powerplant instruments" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8669" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
