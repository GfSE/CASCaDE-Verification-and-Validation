	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(c)(2)(0).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Insulation blanket test specimen. </div>" ;
