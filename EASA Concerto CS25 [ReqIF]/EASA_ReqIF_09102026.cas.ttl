	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(d)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Those required for immediate safety and which must continue to operate following the loss of the normal electrical power generating system(s), without the need for flight crew action;</div>" ;
