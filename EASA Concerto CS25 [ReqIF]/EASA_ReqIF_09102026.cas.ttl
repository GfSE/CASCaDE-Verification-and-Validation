d:idSpecObject_-1100064879_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1043(a)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) If the tests are conducted under conditions deviating from the maximum ambient atmospheric temperature, the recorded APU temperatures must be corrected under sub-paragraph (c) of this paragraph.</div>" ;
