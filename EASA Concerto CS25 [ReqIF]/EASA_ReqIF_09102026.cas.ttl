d:idSpecObject_193138890_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1515(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The established landing gear operating speed or speeds, VLO, may not exceed the speed at which it is safe both to extend and to retract the landing gear, as determined under CS 25.729 or by the flight characteristics. If the extension speed is not the same as the retraction speed, the two speeds must be designated as VLO(EXT) and VLO(RET), respectively. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1515" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Landing gear speeds" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART G – OPERATING LIMITATIONS AND INFORMATION" ;
	o:idSubsection1 "OPERATING LIMITATIONS" ;
	o:ideRules1 "ERULES-1963177438-8263" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_193138890_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1515(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The established landing gear extended speed VLE may not exceed the speed at which it is safe to fly with the landing gear secured in the fully extended position, and that determined under CS 25.729. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
