d:idSpecObject_1789991084_92
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(h)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each of the two insulation blanket test specimens must not allow fire or flame penetration in less than 4 minutes. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
