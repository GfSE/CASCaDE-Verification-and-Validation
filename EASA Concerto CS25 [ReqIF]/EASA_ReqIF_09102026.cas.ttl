	a o:idSpecObject1 ;
	rdfs:label "CS 25.1182(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each nacelle area immediately behind the firewall, and each portion of any engine pod attaching structure containing flammable fluid lines, must meet each requirement of CS 25.1103(b), 25.1165(e), 25.1183, 25.1185(c), 25.1187, 25.1189 and 25.1195 to 25.1203, including those concerning designated fire zones. However, engine pod attaching structures need not contain fire detection or extinguishing means.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1182" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Nacelle areas behind firewalls, and engine pod attaching structures containing flammable fluid lines" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8546" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1417695629_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1182(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For each area covered by sub-paragraph (a) of this paragraph that contains a retractable landing gear, compliance with that sub-paragraph need only be shown with the landing gear retracted.</div>" ;
