	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-1248489521_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1549.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">For each APU instrument either a placard or colour markings or an acceptable combination must be provided to convey information on the maximum and (where applicable) minimum operating limits. Colour coding must comply with the following:</div>" ;
