	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The following minimum number of hand fire extinguishers must be conveniently located and evenly distributed in passenger compartments. (See AMC 25.851(a)(1).): </div>" ;
