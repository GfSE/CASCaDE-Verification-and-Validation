d:idSpecObject_1959871857_14_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(0).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Pressurisation prevention means. There must be a provision to prevent pressurisation of the aeroplane to an unsafe level if any door subject to pressurisation is not fully closed, latched, and locked. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(c)(0)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The provision must be designed to function after any single failure, or after any combination of failures not shown to be extremely improbable. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(c)(1)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Doors that meet the conditions described in sub-paragraph (h) of this paragraph are not required to have a dedicated pressurisation prevention means if, from every possible position of the door, it will remain open to the extent that it prevents pressurisation or safely close and latch as pressurisation takes place. This must also be shown with any single failure and malfunction except that: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(c)(2)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) with failures or malfunctions in the latching mechanism, it need not latch after closing, and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(c)(2)(i)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) with jamming as a result of mechanical failure or blocking debris, the door need not close and latch if it can be shown that the pressurisation loads on the jammed door or mechanism would not result in an unsafe condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(c)(2)(ii)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
