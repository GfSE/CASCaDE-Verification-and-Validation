d:idSpecObject_762706738_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1041.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25J1041.) The APU cooling provisions must be able to maintain the temperatures of APU components and fluids within the temperature limits established for these components and fluids, under critical ground and flight operating conditions, and after normal APU shutdown.</div>" ;
