	a o:idSpecObject1 ;
	rdfs:label "CS 25.121(a)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The weight equal to the weight existing when retraction of the landing gear is begun determined under CS 25.111.</div>" ;
