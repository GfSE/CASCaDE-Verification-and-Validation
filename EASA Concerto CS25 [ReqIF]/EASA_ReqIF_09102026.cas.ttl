d:idSpecObject_1651683409_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(1).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Specimen Mounting Stand. The mounting stand for the test specimens consists of steel angles as shown in Figure 1. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
