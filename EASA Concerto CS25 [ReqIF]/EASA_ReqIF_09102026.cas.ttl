d:idSpecObject_1297350278_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.605(a).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The fabrication methods used (i.e. the manufacturing and assembly methods, including consideration of the materials and material processes) must produce the strength and other properties necessary to ensure a consistently safe part. If a fabrication method includes processes that require close control to reach this objective, then those processes must be performed under representative approved fabrication process specifications, supported by appropriately approved material specifications (including considering the raw/feedstock/unfinished material specifications) with appropriate controls for the design data.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "605" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Fabrication methods" ;
	o:idAmendedBy1 "Amendment 27;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-8563" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2021/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-12-07T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2021-12-07T00:00:00Z" .

d:idSpecObject_1297350278_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.605(b).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each new fabrication method must be substantiated by a test programme that is representative of the application.</div>" ;
