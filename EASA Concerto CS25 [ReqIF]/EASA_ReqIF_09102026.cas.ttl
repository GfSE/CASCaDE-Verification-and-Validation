	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (e) Electrical bonding must provide an adequate electrical return path under both normal and fault conditions, on aeroplanes having earthed electrical systems (see CS 25.899).</div>" ;
