d:idSpecObject_1273335886_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.981(b)(2)(i).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) three percent, or</div>" ;
