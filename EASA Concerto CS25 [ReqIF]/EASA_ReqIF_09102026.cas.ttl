d:idSpecObject_-442894939_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) With the wing-flaps and power settings corresponding to the values determined in the establishment of the take-off path under CS 25.111 assuming that the critical engine fails at the minimum value of V1.</div>" ;
