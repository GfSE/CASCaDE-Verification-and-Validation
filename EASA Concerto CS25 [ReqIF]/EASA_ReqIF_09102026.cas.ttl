d:idSpecObject_1370083084_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(e).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Approved operating procedures or conventional operating practices must be followed when demonstrating compliance with the control force limitations for short term application that are prescribed in sub-paragraph (d) of this paragraph. The aeroplane must be in trim, or as near to being in trim as practical, in the immediately preceding steady flight condition. For the take-off condition, the aeroplane must be trimmed according to the approved operating procedures.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "143" ;
	o:idSubref1 "(e)" ;
