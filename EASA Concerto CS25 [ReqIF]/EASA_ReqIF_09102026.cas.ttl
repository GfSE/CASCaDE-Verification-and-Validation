	a o:idSpecObject1 ;
	rdfs:label "CS 25.1310(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Loads connected to the system with the system functioning normally.</div>" ;
