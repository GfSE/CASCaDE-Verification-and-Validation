	a o:idSpecObject1 ;
	rdfs:label "CS 25.858(b).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The system must be capable of detecting a fire at a temperature significantly below that at which the structural integrity of the aeroplane is substantially decreased.</div>" ;
