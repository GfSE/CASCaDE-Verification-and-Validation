d:idSpecObject_-613333795_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(c).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Caution information, such as an amber caution light or equivalent, must be provided to alert the flight crew when the anti-ice or de-ice system is not functioning normally.</div>" ;
