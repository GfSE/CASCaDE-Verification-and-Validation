d:idSpecObject_-1380706352_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1531.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Load factor limitations, not exceeding the positive limit load factors determined from the manoeuvring diagram in CS 25.333(b), must be established. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
