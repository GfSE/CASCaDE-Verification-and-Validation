d:idSpecObject_-2062423000_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(c).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Any FRM failures or failures that could affect the FRM, with potential catastrophic consequences shall not result from a single failure or a combination of failures not shown to be extremely improbable.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
