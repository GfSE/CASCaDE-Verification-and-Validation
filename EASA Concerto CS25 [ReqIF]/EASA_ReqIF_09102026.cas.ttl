d:idSpecObject_1948325804_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1199(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each extinguishing agent container must have a pressure relief to prevent bursting of the container by excessive internal pressures.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
