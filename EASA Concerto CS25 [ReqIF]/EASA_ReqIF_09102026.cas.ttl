	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-442894939_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) From VMO to VMO + ⅔ (VDF – VMO) the IAS must change perceptibly with CAS and in the same sense, and at higher speeds up to VDF the IAS must not change in an incorrect sense. (See AMC 25.1323(e))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
