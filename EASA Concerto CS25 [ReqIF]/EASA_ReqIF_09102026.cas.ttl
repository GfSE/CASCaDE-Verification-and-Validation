	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-8324" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1612993865_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A three-second movement of the longitudinal trim system at its normal rate for the particular flight condition with no aerodynamic load (or an equivalent degree of trim for aeroplanes that do not have a power-operated trim system), except as limited by stops in the trim system, including those required by CS 25.655(b) for adjustable stabilisers; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
