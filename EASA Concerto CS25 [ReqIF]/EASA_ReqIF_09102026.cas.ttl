d:idSpecObject_404047824_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Compliance with sub-paragraph (1) of this paragraph must be shown by test unless experience with similar batteries and installations has shown that maintaining safe cell temperatures and pressures presents no problem.</div>" ;
