	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_2049864097_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1721(c).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) EWIS must be designed and installed to minimise damage and risk of damage to EWIS by items carried onto the aeroplane by passengers or cabin crew.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
