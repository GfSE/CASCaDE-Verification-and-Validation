	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-626282916_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.697(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The lift device control must be designed to retract the surfaces from the fully extended position, during steady flight at maximum continuous engine power at any speed below VF + 17 km/hr (9·0 knots).</div>" ;
