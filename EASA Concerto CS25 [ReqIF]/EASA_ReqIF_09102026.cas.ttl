d:idSpecObject_217569270_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.858.Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">If certification with cargo or baggage compartment smoke or fire detection provisions is requested, the following must be met for each cargo or baggage compartment with those provisions: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
