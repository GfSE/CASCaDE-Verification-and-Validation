d:idSpecObject_-1194292592_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.335.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.335)The selected design airspeeds are equivalent airspeeds (EAS). Estimated values of VS0 and VS1 must be conservative. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
