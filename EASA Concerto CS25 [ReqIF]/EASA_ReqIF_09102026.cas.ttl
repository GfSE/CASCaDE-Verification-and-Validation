	a o:idSpecObject1 ;
	rdfs:label "CS 25.1445(a).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) When oxygen is supplied to both crew and passengers, the distribution system must be designed for either –</div>" ;
