	o:ideRules1 "ERULES-1963177438-10214" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix S – Airworthiness requirements for non-commercially operated aeroplanes and low-occupancy aeroplanes" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_1829045085_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(b)(2)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) an occupant of the compartment would not need to go through more than one door to access an emergency exit above the waterline on the other side of the fuselage; and</div>" ;
