	a o:idSpecObject1 ;
	rdfs:label "CS 25.343(b)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The structure must be designed for a condition of zero fuel and oil in the wing at limit loads corresponding to –</div>" ;
