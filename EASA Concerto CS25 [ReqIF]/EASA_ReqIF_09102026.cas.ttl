	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1103(a)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) Drained to prevent accumulation of hazardous quantities of flammable fluid and moisture in the ground attitude. The drain(s) must not discharge in locations that might cause a fire hazard; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
