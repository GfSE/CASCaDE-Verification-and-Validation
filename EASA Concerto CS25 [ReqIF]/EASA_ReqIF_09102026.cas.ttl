	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(6)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) the powered latch actuators, if installed; and </div>" ;
