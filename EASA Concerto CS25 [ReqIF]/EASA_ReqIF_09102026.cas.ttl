	a o:idSpecObject1 ;
	rdfs:label "CS 25.832(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For the purpose of this paragraph, “sea level equivalent” refers to conditions of 25° C (77° F) and 1 013·2 hPa (760 millimetres of mercury) pressure.</div>" ;
