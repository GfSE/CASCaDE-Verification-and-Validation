	a o:idSpecObject1 ;
	rdfs:label "CS 25.1449.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">There must be a means to allow the crew to determine whether oxygen is being delivered to the dispensing equipment. </div>" ;
