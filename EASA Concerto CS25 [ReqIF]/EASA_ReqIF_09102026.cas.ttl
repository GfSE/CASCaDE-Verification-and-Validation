	a o:idSpecObject1 ;
	rdfs:label "CS 25.445(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) 100% to the area of the vertical surfaces above (or below) the horizontal surface.</div>" ;
