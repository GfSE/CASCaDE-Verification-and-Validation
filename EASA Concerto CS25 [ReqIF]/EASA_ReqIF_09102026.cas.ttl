d:idSpecObject_1224749019_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.791(e).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Symbols that clearly express the intent of the sign or placard may be used in lieu of letters.</div>" ;
