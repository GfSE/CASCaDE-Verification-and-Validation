	a o:idSpecObject1 ;
	rdfs:label "CS 25.415(g)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The control surfaces, the control system stops nearest the surfaces and the parts of the control systems (if any) between the surfaces and the stops must be designed to the resultant limit loads.</div>" ;
