d:idSpecObject_-2058332334_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Expansion space. Oil tank expansion space must be provided as follows: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
