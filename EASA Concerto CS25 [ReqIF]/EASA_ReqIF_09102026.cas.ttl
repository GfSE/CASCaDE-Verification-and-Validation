	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-103094868_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1043(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) No corrected temperatures determined under sub-paragraph (1) of this paragraph may exceed established limits.</div>" ;
