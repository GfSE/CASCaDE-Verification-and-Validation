d:idSpecObject_-749083209_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(k).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(k) Each projecting object that would injure persons seated or moving about the aeroplane in normal flight must be padded.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
