d:idSpecObject_1642579540_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(d).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The location of each passenger emergency exit must be indicated by a sign visible to occupants approaching along the main passenger aisle (or aisles). There must be See AMC 25.811(d)):</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "811" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Emergency exit marking" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10202" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
