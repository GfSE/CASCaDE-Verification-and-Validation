	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_1748508159_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831.Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "831" ;
	o:idTitle1 " Ventilation" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "VENTILATION AND HEATING" ;
	o:ideRules1 "ERULES-1963177438-10068" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.831.Amendment 23;" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(a).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Under normal operating conditions and in the event of any probable failure conditions of any system that would adversely affect the ventilating air, the ventilation system must be designed to provide a sufficient amount of uncontaminated air to enable the crew members to perform their duties without undue discomfort or fatigue, and to provide reasonable passenger comfort. For normal operating conditions, the ventilation system must be designed to provide each occupant with an airflow that contains at least 0.25 Kg (0.55 lb) of fresh air per minute. (See AMC 25.831(a).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "831" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 " Ventilation" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "VENTILATION AND HEATING" ;
	o:ideRules1 "ERULES-1963177438-10068" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(b).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Crew and passenger compartment air must be free from harmful or hazardous concentrations of gases or vapours. In meeting this requirement, the following apply:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "831" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 " Ventilation" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "VENTILATION AND HEATING" ;
	o:ideRules1 "ERULES-1963177438-10068" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(b)(1).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Carbon monoxide concentrations in excess of one part in 20 000 parts of air are considered hazardous. For test purposes, any acceptable carbon monoxide detection method may be used.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "831" ;
	o:idSubref1 "(b)(1)" ;
	o:idTitle1 " Ventilation" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "VENTILATION AND HEATING" ;
	o:ideRules1 "ERULES-1963177438-10068" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(b)(2).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Carbon dioxide concentration during flight must be shown not to exceed 0·5% by volume (sea level equivalent) in compartments normally occupied by passengers or crewmembers. For the purpose of this subparagraph, “sea level equivalent” refers to conditions of 25° C (77° F) and 1 013·2 hPa (760 millimetres of mercury) pressure.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "831" ;
	o:idSubref1 "(b)(2)" ;
	o:idTitle1 " Ventilation" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "VENTILATION AND HEATING" ;
	o:ideRules1 "ERULES-1963177438-10068" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(c).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) There must be provisions made to ensure that the conditions prescribed in sub-paragraph (b) of this paragraph are met after reasonably probable failures or malfunctioning of the ventilating, heating, pressurisation or other systems and equipment. (See AMC 25.831(c).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "831" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 " Ventilation" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "VENTILATION AND HEATING" ;
	o:ideRules1 "ERULES-1963177438-10068" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(d).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) If accumulation of hazardous quantities of smoke in the cockpit area is reasonably probable, smoke evacuation must be readily accomplished, starting with full pressurisation and without depressurising beyond safe limits.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
