	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(c)(2)(ii).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Allow the pilot(s) to override the system by use of manual braking.</div>" ;
