d:idSpecObject_-1182953428_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1093(b)(1)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Cause a stall, surge, or flameout or loss of engine controllability (for example, rollback).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
