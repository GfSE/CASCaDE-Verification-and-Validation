d:idSpecObject_764655131_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J977(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The clear area of each fuel tank outlet strainer must be at least five times the area of the outlet line.</div>" ;
