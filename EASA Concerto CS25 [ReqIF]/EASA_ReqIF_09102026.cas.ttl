d:idSpecObject_-442894939_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(h).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Each system must be arranged, so far as practicable, to prevent malfunction or serious error due to the entry of moisture, dirt, or other substances. (See AMC 25.1323(h).)</div>" ;
