d:idSpecObject_1370083084_35
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(j)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) There is no pitch control force reversal during a pushover manoeuvre down to 0.5 g load factor.</div>" ;
