	a o:idSpecObject1 ;
	rdfs:label "CS 25.955(a)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) If there is a fuel flowmeter, it must be blocked and the fuel must flow through the meter or its bypass. (See AMC 25.955(a)(4).)</div>" ;
