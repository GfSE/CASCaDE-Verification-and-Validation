	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-8679" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_69105852_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.723(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) In lieu of the tests prescribed in this paragraph, changes in previously approved design weights and minor changes in design may be substantiated by analyses based on previous tests conducted on the same basic landing gear system that has similar energy absorption characteristics.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
