d:idSpecObject_459389398_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1711(c).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The identifying markings required by sub-paragraphs (a) and (b) must remain legible throughout the expected service life of the EWIS component.</div>" ;
