	a o:idSpecObject1 ;
	rdfs:label "CS 25.1103(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Strong enough to prevent structural failure resulting from engine surging; and</div>" ;
