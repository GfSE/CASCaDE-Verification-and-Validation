	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(e)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The system used to generate the aural warning must be designed to minimise false or inappropriate alerts.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
