	a o:idSpecObject1 ;
	rdfs:label "CS 25.1583(a)(3)(i).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) full application of pitch, roll, or yaw controls should be confined to speeds below the manoeuvring speed; and</div>" ;
