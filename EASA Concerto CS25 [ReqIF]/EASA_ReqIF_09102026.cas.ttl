d:idSpecObject_1959871857_38
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(e)(3)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) each door that is subject to pressurisation and for which the initial opening movement is not inward; or</div>" ;
