	a o:idSpecObject1 ;
	rdfs:label "CS 25.1001(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A climb at the one-engine inoperative best rate-of-climb speed, with the critical engine inoperative and the remaining engines at maximum continuous power; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
