	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1091(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) May not draw air from within the APU compartment or other compartments unless the inlet is isolated from the APU accessories and power section by a firewall,</div>" ;
