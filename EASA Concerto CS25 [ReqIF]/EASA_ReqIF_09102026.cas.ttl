	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Failure indications. For system failure detection and indication, the following apply:</div>" ;
