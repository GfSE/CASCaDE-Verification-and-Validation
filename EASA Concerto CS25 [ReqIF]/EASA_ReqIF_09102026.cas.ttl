	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(5)(iii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) if the exit is a removable hatch, state the weight of the hatch and indicate an appropriate location to place the hatch after removal. </div>" ;
