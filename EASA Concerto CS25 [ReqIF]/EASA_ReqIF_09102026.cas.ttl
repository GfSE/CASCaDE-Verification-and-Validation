	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(e)(1).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) It must operate satisfactorily over the range of expected runway conditions, without external adjustment.</div>" ;
