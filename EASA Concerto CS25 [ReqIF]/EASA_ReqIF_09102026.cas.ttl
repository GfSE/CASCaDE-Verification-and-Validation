	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(2)(iv).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iv) Have a burner fuel pressure regulator that is adjusted to deliver a nominal 7.6 l/hr (2·0 US gallon/hour) of # 2 Grade kerosene or equivalent required for the test.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
