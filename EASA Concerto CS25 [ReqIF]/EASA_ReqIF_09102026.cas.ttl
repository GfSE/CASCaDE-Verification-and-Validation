d:idSpecObject_459389398_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1711(b)(2).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If an EWIS component cannot be marked physically, then others means of identification must be provided.</div>" ;
