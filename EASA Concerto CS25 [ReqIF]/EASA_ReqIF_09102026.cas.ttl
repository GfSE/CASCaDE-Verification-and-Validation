	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(c)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) It shall be possible to shut down the APU from the flight deck in normal and emergency conditions.</div>" ;
