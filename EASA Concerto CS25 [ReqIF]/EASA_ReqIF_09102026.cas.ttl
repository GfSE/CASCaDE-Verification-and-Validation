	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(l)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) At least one required exterior emergency light for each side of the aeroplane remains operative exclusive of those that are directly damaged by the separation.</div>" ;
