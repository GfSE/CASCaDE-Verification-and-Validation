d:idSpecObject_-792266652_59
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(h)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The peak heat release and the 2 minute integrated heat release rate must be reported.</div>" ;
