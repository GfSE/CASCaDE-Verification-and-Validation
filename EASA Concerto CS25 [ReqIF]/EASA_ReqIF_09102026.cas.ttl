d:idSpecObject_1805953230_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(d).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) For both unprotected and protected parts, the ice accretion for the takeoff phase may be determined by calculation, assuming the takeoff maximum icing conditions defined in appendix C, and assuming that:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
