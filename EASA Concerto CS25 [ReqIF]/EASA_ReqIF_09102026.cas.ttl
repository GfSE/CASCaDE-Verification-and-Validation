	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1082908761_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Operation of any shut-off means may not interfere with the later emergency operation of other equipment, such as the means for feathering the propeller.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
