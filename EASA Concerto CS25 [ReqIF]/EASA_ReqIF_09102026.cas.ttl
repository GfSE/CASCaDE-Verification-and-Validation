	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_57
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(10).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(10) Timing device. Provide a stopwatch or other device, accurate to ± 1 second/hour, to measure the time of application of the pilot burner flame. </div>" ;
