	a o:idSpecObject1 ;
	rdfs:label "CS 25.177(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) one-half of the available rudder control input; and </div>" ;
