d:idSpecObject_-792266652_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Conditioning. Specimens must be conditioned as described in Part 1 of this Appendix. </div>" ;
