	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-419854869_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.675(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each stop must be located so that wear, slackness, or take-up adjustments will not adversely affect the control characteristics of the aeroplane because of a change in the range of surface travel. </div>" ;
