d:idSpecObject_443791706_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Buffeting, of a magnitude and severity that is a strong and effective deterrent to further speed reduction; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
