	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) No combustion air duct may restrict the prompt relief of any backfire that, if so restricted, could cause heater failure.</div>" ;
