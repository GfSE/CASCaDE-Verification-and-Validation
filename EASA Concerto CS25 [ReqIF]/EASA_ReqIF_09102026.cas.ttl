d:idSpecObject_443791706_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(b)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The aeroplane trimmed for straight flight at the speed prescribed in CS 25.103(b)(6).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
