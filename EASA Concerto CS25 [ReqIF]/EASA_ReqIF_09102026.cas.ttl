	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(g)(4).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Have, if the recorder is deployable, an integrated emergency locator transmitter that automatically starts emitting upon deployment; and</div>" ;
