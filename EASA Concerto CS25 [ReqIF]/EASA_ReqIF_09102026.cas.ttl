	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(b)(1).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) It will withstand the vibration, inertia, and other loads to which it may be subjected in operation;</div>" ;
