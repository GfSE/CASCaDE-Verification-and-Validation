	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1201(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each system component in an APU compartment must be fireproof. </div>" ;
