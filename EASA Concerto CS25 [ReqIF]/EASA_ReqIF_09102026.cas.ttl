d:idSpecObject_-1383213079_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(e)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Pivoting need not be considered.</div>" ;
