	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) It is supplied with airspeed, altitude, and directional data obtained from sources that meet the accuracy requirements of CS 25.1323, 25.1325 and 25.1327, as appropriate;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
