	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Fuel tanks must comply with the following criteria in order to avoid hazardous fuel leak: </div>" ;
