d:idSpecObject_1062517513_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.843(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Tests of the pressurisation system to show proper functioning under each possible condition of pressure, temperature, and moisture, up to the maximum altitude for which certification is requested.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
