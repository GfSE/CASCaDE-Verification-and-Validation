d:idSpecObject_146084428_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1331.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1331" ;
	o:idTitle1 "Instruments using a power supply" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8658" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1331.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_146084428_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1331(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For each instrument required by CS 25.1303(b) that uses a power supply, the following apply:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1331" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Instruments using a power supply" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8658" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_146084428_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1331(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each instrument must have a visual means integral with the instrument, to indicate when power adequate to sustain proper instrument performance is not being supplied. The power must be measured at or near the point where it enters the instruments. For electric instruments, the power is considered to be adequate when the voltage is within approved limits.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1331" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Instruments using a power supply" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8658" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_146084428_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1331(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each instrument must, in the event of the failure of one power source, be supplied by another power source. This may be accomplished automatically or by manual means. The failure of one power source must not affect the same instrument of both pilot stations.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1331" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Instruments using a power supply" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8658" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_146084428_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1331(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) If an instrument presenting flight and/or navigation data receives information from sources external to that instrument and loss of that information would render the presented data unreliable, a clear and unambiguous visual warning must be given to the crew when such loss of information occurs that the presented data should not be relied upon. The indication must be incorporated in the instrument.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1331" ;
	o:idSubref1 "(a)(3)" ;
	o:idTitle1 "Instruments using a power supply" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8658" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_146084428_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1331(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) As used in this paragraph, ‘instrument’ includes devices that are physically contained in one unit, and devices that are composed of two or more physically separate units or components connected together (such as a remote indicating gyroscopic direction indicator that includes a magnetic sensing element, a gyroscopic unit, an amplifier, and an indicator connected together).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1331" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Instruments using a power supply" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
