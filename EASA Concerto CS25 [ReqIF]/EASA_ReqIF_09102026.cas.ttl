	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1693011484_35
	a o:idSpecObject1 ;
	rdfs:label "CS 25.331(c)(2)(v)(A).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(A) For the nose-up pitching manoeuvre, the time at which the normal acceleration at the c.g. goes below 0g;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
