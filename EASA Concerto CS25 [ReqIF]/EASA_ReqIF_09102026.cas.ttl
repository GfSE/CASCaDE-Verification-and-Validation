d:idSpecObject_-2062423000_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(a)(4).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) identify critical features of the fuel tank system to prevent an auxiliary fuel tank installation from increasing the flammability exposure of main tanks above that permitted under paragraphs M25.1(a) and (b) of this appendix and to prevent degradation of the performance and reliability of the FRM.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
