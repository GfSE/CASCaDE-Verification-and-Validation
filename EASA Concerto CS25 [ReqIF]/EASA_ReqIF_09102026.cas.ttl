d:idSpecObject_404047824_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Safe cell temperatures and pressures must be maintained during any probable charging or discharging condition. No uncontrolled increase in cell temperature may result when the battery is recharged (after previous complete discharge) –</div>" ;
