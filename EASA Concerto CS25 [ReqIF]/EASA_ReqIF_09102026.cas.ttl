d:idSpecObject_-1847500952_3_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1583(a)(0).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Airspeed limitations. The following airspeed limitations and any other airspeed limitations necessary for safe operation must be furnished. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
