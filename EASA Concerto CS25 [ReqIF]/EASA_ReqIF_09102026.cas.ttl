	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1187850300_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(a)(7).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Type A. This type is a floor-level exit with a rectangular opening of not less than 106.7 cm (42 inches) wide by 182.9 cm (72 inches) high, with corner radii not greater than 17.8 cm (7 inches).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
