	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(b).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Crew and passenger compartment air must be free from harmful or hazardous concentrations of gases or vapours. In meeting this requirement, the following apply:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
