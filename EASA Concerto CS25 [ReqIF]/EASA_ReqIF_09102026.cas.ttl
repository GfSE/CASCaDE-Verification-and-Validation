	a o:idSpecObject1 ;
	rdfs:label "CS 25.1447(c)(4).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Portable oxygen equipment must be immediately available for each cabin crew member. The portable oxygen equipment must have the oxygen dispensing unit connected to the portable oxygen supply. (See AMC 25.1447(c)(4).)</div>" ;
