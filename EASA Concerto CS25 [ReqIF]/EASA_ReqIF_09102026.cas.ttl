d:idSpecObject_2021291266_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 30(b).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Firm Handholds: in lieu of the requirements of CS 25.785(j), if the seat backs do not provide a firm handhold, there must be an acceptable means to enable persons to steady themselves while using the aisles in moderately rough air (See AMC to Appendix S, S25.30(b)).</div>" ;
