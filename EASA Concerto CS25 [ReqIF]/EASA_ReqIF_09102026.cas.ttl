	a o:idSpecObject1 ;
	rdfs:label "CS 25.405.Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Secondary controls, such as wheel brake, spoiler, and tab controls, must be designed for the maximum forces that a pilot is likely to apply to those controls. The following values may be used: </div>" ;
