	a o:idSpecObject1 ;
	rdfs:label "CS 25.603.Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The suitability and durability of materials used for parts, the failure of which could adversely affect safety, must:</div>" ;
