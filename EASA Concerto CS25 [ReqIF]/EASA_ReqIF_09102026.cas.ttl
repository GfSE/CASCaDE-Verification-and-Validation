d:idSpecObject_-356525592_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(a)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) At least three sets of seat bottom and seat back cushion specimens must be tested.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
