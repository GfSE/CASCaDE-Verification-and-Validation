	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_-1616694310_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1723.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1723)EWIS components must be considered to be a potential ignition source in each area where flammable fluid or vapours might escape by leakage of a fluid system and must meet the requirements of CS 25.863.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1723" ;
	o:idTitle1 "Flammable fluid protection; EWIS" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART H – ELECTRICAL WIRING INTERCONNECTION SYSTEMS" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-9560" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1723.Amendment 5;" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_2141324199_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1725.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1725" ;
	o:idTitle1 "Powerplants; EWIS" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART H – ELECTRICAL WIRING INTERCONNECTION SYSTEMS" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-9561" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1725.Amendment 5;" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_2141324199_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1725(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) EWIS associated with any powerplant must be designed and installed so that the failure of an EWIS component will not prevent the continued safe operation of the remaining powerplants or require immediate action by any crew member for continued safe operation, in accordance with the requirements of CS 25.903(b).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1725" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Powerplants; EWIS" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART H – ELECTRICAL WIRING INTERCONNECTION SYSTEMS" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-9561" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_2141324199_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1725(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Design precautions must be taken to minimise hazards to the aeroplane due to EWIS damage in the event of a powerplant rotor failure or of a fire originating within the powerplant, which burns through the powerplant case, in accordance with the requirements of CS 25.903(d)(1).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1725" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Powerplants; EWIS" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART H – ELECTRICAL WIRING INTERCONNECTION SYSTEMS" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-9561" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_1094467572_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1727.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">EWIS associated with each flammable fluid shutoff means and control must be fireproof or must be located and protected so that any fire in a fire zone will not affect operation of the flammable fluid shutoff means in accordance with the requirements of CS 25.1189.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
