	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(6).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Determine (where applicable) the burnthrough time, or the point at which the heat flux exceeds 2.27 W/cm2 (2.0 Btu/ft2 sec). </div>" ;
