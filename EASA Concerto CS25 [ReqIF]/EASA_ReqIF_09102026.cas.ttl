d:idSpecObject_1370083084_24_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(h)(0).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) (See AMC 25.143(h)). The manoeuvring capabilities in a constant speed coordinated turn at forward centre of gravity, as specified in the following table, must be free of stall warning or other characteristics that might interfere with normal manoeuvring. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "143" ;
	o:idSubref1 "(h)(0)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "CONTROLLABILITY AND MANOEUVRABILITY" ;
	o:ideRules1 "ERULES-1963177438-18456" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1370083084_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(h)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A combination of weight, altitude and temperature (WAT) such that the thrust or power setting produces the minimum climb gradient specified in CS 25.121 for the flight condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
