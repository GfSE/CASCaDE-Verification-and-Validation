d:idSpecObject_1350743459_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(d)(4).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Large cabinets and cabin stowage compartments, other than underseat stowage compartments for stowing small items such as magazines and maps.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
