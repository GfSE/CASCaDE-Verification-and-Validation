	o:idSubsection1 "AIR INTAKE AND BLEED AIR DUCT SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-9355" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-376552637_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1103(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each duct connected to components between which relative motion could exist must have means for flexibility.</div>" ;
