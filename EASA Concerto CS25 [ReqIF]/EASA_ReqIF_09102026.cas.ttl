d:idSpecObject_1651683409_11_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(0).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Test Apparatus. The arrangement of the test apparatus, which is shown in Figure 3 of Part II and Figures 1 through 3 of this Part of Appendix F, must include the components described in this paragraph. Minor details of the apparatus may vary, depending on the model of the burner used. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
