	a o:idSpecObject1 ;
	rdfs:label "CS 25.787(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Penetrate fuel tanks or lines or cause fire or explosion hazard by damage to adjacent systems; or</div>" ;
