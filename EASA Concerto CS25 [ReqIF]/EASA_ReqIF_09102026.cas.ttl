	a o:idSpecObject1 ;
	rdfs:label "CS 25.473(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The method of analysis of aeroplane and landing gear loads must take into account at least the following elements:</div>" ;
