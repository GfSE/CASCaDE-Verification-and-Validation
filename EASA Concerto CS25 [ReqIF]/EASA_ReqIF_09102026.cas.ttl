d:idSpecObject_1749378911_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.793.Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC to CS 25.793 and 25.810(c)) The floor surface of all areas, which are likely to become wet in service, must have slip resistant properties. </div>" ;
