d:idSpecObject_502859743_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.562(c)(3).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The upper torso restraint straps (where installed) must remain on the occupant’s shoulder during the impact.</div>" ;
