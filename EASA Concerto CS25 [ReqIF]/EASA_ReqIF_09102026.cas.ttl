d:idSpecObject_1959871857_39
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(e)(3)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) each door that could be a hazard if unlatched.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
