	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Means for providing flexibility must be used to connect points in a pneumatic line between which relative motion or differential vibration exists.</div>" ;
