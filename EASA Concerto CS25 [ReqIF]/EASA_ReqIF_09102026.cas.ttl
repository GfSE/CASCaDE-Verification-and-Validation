	a o:idSpecObject1 ;
	rdfs:label "CS 25.1141(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each flexible control must be approved or must be shown to be suitable for the particular application.</div>" ;
