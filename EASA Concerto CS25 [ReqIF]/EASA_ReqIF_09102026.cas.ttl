d:idSpecObject_346279536_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.119(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) In icing conditions with the most critical of the “Landing Ice” accretion(s) defined in Appendices C and O, as applicable, in accordance with CS 25.21(g), and with a climb speed of VREF determined in accordance with CS 25.125(b)(2)(i).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
