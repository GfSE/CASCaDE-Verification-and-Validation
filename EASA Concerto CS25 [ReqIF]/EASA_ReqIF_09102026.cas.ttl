d:idSpecObject_1586589071_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 3(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The actual propulsive thrust resulting from the initial setting of power or thrust controls with the ATTCS system functioning normally as designed, without requiring any action by the crew to increase thrust or power until the aeroplane has achieved a height of 122 m (400 feet) above the take-off surface; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
