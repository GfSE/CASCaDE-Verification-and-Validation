	a o:idSpecObject1 ;
	rdfs:label "CS 25.1317(a)(3).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The system is not adversely affected during and after the time the aeroplane is exposed to HIRF environment II, as described in Appendix R.</div>" ;
