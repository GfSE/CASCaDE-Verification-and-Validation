	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_346279536_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.119(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) In icing conditions with the most critical of the “Landing Ice” accretion(s) defined in Appendices C and O, as applicable, in accordance with CS 25.21(g), and with a climb speed of VREF determined in accordance with CS 25.125(b)(2)(i).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "119" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Landing climb: all engines operating" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "PERFORMANCE" ;
	o:ideRules1 "ERULES-1963177438-10101" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_346279536_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.119.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.119) In the landing configuration, the steady gradient of climb may not be less than 3·2%, with the engines at the power or thrust that is available 8 seconds after initiation of movement of the power or thrust controls from the minimum flight idle to the go-around power or thrust setting; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
