	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9590" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_1789991084_83
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) When ready to begin the test, direct the burner away from the test position to the warm-up position so that the flame will not impinge on the specimens prematurely. Turn on and light the burner and allow it to stabilize for 2 minutes. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
