d:idSpecObject_1778913055_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.487(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) With the landing gear fully extended and not in contact with the ground, a load factor of 20·0 must act on the unsprung weights of the landing gear. This load factor must act in the direction of motion of the unsprung weights as they reach their limiting positions in extending with relation to the sprung parts of the landing gear.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "487" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Rebound landing condition" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8487" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1502584359_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.489.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Unless otherwise prescribed, the landing gear and aeroplane structure must be investigated for the conditions in CS 25.491 to 25.509 with the aeroplane at the design ramp weight (the maximum weight for ground handling conditions). No wing lift may be considered. The shock absorbers and tyres may be assumed to be in their static position. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "489" ;
	o:idTitle1 "Ground handling conditions" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8491" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.489.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-455727732_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.491.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.415)Within the range of appropriate ground speeds and approved weights, the aeroplane structure and landing gear are assumed to be subjected to loads not less than those obtained when the aircraft is operating over the roughest ground that may reasonably be expected in normal operation. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "491" ;
	o:idTitle1 "Taxi, take-off and landing roll" ;
