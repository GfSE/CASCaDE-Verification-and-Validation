d:idSpecObject_632595865_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.351(a)(2).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) a limit pilot force of 1335 N (300 lbf) from VMC to VA and 890 N (200 lbf) from VC/MC to VD/MD, with a linear variation between VA and VC/MC.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "351" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Yaw manoeuvre conditions" ;
	o:idAmendedBy1 "Amendment 13;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT MANOEUVRE AND GUST CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-9737" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2013/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_632595865_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.351(b).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) With the cockpit rudder control deflected so as always to maintain the maximum rudder deflection available within the limitations specified in subparagraph (a) of this paragraph, it is assumed that the aeroplane yaws to the overswing sideslip angle.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "351" ;
