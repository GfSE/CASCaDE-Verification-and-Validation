d:idSpecObject_-1167862034_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) A means must be provided to prevent damage to the fuel system in the event of failure of the automatic shut-off means prescribed in sub-paragraph (b) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
