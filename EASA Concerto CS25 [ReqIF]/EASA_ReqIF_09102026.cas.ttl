d:idSpecObject_-192061252_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) In the event of pneumatic system malfunction, requires corrective action by the crew to ensure continued safe flight and landing.</div>" ;
