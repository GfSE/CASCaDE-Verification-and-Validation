d:idSpecObject_1273713098_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.785(g).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.785(g) Seats, berths, safety belts and harnesses ED Decision 2003/2/RM Where there is a risk that a safety belt or harness might, when not in use, foul the controls or impede the crew, suitable stowage should be provided, unless it can be shown that the risk can be avoided by the application of suitable crew drills.</div>" ;
