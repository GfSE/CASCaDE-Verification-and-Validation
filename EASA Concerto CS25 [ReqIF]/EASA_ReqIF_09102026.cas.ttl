	a o:idSpecObject1 ;
	rdfs:label "CS 25.1549.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1549)For each required powerplant instrument, as appropriate to the type of instrument: </div>" ;
