d:idSpecObject_1330287417_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1521.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The APU limitations must be established so that they do not exceed the corresponding approved limits for the APU and its systems. The APU limitations, including categories of operation, must be specified as operating limitations for the aeroplane.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J1521" ;
	o:idTitle1 "APU limitations" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "OPERATING LIMITATIONS" ;
	o:ideRules1 "ERULES-1963177438-9379" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.J1521.Amendment 1;" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-1943974257_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1527.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The extremes of the ambient air temperature and operating altitude for which operation is allowed, as limited by flight, structural, APU installation, functional, or equipment characteristics, must be established. </div>" ;
