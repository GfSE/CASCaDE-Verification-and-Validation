d:idSpecObject_-749083209_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h)(4).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Located to minimise the probability that occupants would suffer injury by being struck by items dislodged from service areas, stowage compartments, or service equipment.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
