	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(a)(2)(ii).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Be installed and located so that the escape of fluids would not create a hazard.</div>" ;
