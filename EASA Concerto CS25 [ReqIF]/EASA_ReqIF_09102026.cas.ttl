	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_714132880_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.788(a)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) placards must be installed to indicate that the shower cubicle must not be used for the stowage of cargo or passenger baggage;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
