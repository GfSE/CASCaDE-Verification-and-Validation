	rdfs:label "CS 25.361(a)(2)(i).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) for turbo-propeller installations, multiplying mean engine torque for the specified power/thrust and speed by a factor of 1·25.</div>" ;
