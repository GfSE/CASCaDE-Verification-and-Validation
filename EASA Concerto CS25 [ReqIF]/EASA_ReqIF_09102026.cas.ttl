	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1298727579_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.481(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Vertically; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
