	rdfs:label "CS 25.1353(c)(6)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) A battery temperature sensing and over-temperature warning system with a means for disconnecting the battery from its charging source in the event of an overtemperature condition; or</div>" ;
