d:idSpecObject_85639090_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(d).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) There must be means to allow the crew to check, in flight, the functioning of each fire or overheat detector electric circuit.</div>" ;
