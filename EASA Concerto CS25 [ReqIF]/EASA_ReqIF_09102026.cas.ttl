d:idSpecObject_552252819_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The aeroplane must reach V2 before it is 11 m (35 ft) above the take-off surface and must continue at a speed as close as practical to, but not less than V2 until it is 122 m (400 ft) above the take-off surface;</div>" ;
