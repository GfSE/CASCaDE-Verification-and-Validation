	a o:idSpecObject1 ;
	rdfs:label "CS 25.103(b)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The centre of gravity position that results in the highest value of reference stall speed; and</div>" ;
