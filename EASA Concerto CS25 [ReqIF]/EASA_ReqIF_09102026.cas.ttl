	a o:idSpecObject1 ;
	rdfs:label "CS 25.427(b)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) 80% of these loadings acting on the other side.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
