	a o:idSpecObject1 ;
	rdfs:label "CS 25.1547(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The placard must state whether the calibration was made with radio receivers on or off.</div>" ;
