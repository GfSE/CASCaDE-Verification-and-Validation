d:idSpecObject_-356525592_39
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(g)(2).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Mount the seat bottom and seat back cushion test specimens on the test stand as shown in Figure 2, securing the seat back cushion specimen to the test stand at the top.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
