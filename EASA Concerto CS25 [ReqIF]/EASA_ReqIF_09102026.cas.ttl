	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(e).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Except as provided in sub-paragraph (f) of this paragraph, means must be provided to enable the occupants of the following compartments and areas to control the temperature and quantity of ventilating air supplied to their compartment or area independently of the temperature and quantity of air supplied to other compartments and areas:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
