	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1187850300_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(e).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Uniformity. Exits must be distributed as uniformly as practical, taking into account passenger seat distribution. (See AMC 25.807(e))</div>" ;
