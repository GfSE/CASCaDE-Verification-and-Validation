d:idSpecObject_-235609149_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.733(c).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) When a landing gear axle is fitted with more than one wheel and tyre assembly, such as dual or dual-tandem, each wheel must be fitted with a suitable tyre of proper fit with a speed rating approved by the Agency that is not exceeded under critical conditions, and with a load rating approved by the Agency that is not exceeded by –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "733" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Tyres" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-18457" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" ;
	cas:lists d:idSpecObject_-235609149_11 ,
		d:idSpecObject_-235609149_12 .

d:idSpecObject_-235609149_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.733(d).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each tyre installed on a retractable landing gear system must, at the maximum size of the tyre type expected in service, have a clearance to surrounding structure and systems that is adequate to prevent unintended contact between the tyre and any part of the structure or systems.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "733" ;
