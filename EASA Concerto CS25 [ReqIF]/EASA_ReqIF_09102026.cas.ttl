	a o:idSpecObject1 ;
	rdfs:label "CS 25.995.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">In addition to the requirements of CS 25.1189 for shut-off means, each fuel valve must – </div>" ;
