	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-2058332334_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each reserve oil tank not directly connected to any engine may have an expansion space of not less than 2% of the tank capacity.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
