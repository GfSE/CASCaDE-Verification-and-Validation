	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(b)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Within the compartment, there is at least one emergency exit above the waterline on one side of the fuselage that meets at least the requirements of a type IV emergency exit for a compartment that has a passenger seating configuration of nine seats or less, or of a type III emergency exit otherwise, and:</div>" ;
