d:idSpecObject_1100884094_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.343(b)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Fatigue evaluation of the structure must account for any increase in operating stresses resulting from the design condition of sub-paragraph (b)(1) of this paragraph; and</div>" ;
