	o:idSubsection1 "EMERGENCY LANDING CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-8534" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1181927572_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.561(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Seats and items of mass (and their supporting structure) must not deform under any loads up to those specified in sub-paragraph (b)(3) of this paragraph in any manner that would impede subsequent rapid evacuation of occupants. (See AMC 25.561(d).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
