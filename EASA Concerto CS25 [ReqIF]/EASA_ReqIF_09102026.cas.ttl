d:idSpecObject_-1359237463_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1187(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Arranged so that no discharge fluid will cause an additional fire hazard.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
