d:idSpecObject_1829980631_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.689(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Clevis pins subject to load or motion and retained only by cotter pins may not be used in the control system.</div>" ;
