d:idSpecObject_1478673283_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) For APU installation:</div>" ;
