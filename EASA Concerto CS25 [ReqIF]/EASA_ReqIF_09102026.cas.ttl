	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1460114103_31
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(7)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) evacuees are hindered from climbing over in the course of evacuating.</div>" ;
