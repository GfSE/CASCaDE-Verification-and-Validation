d:idSpecObject_-783279111_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each powerplant instrument line must meet the requirements of CS 25.993 and CS 25.1183.</div>" ;
