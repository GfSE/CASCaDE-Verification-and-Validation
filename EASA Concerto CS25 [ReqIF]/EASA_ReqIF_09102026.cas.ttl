	a o:idSpecObject1 ;
	rdfs:label "CS 25.773(b)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The openable window specified in sub-paragraph (b)(3) of this paragraph need not be provided if it is shown that an area of the transparent surface will remain clear sufficient for at least one pilot to land the aeroplane safely in the event of -</div>" ;
