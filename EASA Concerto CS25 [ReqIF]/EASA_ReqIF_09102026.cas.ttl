d:idSpecObject_1829980631_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.689(f).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) There must be provisions for visual inspection of fairleads, pulleys, terminals, and turnbuckles.</div>" ;
