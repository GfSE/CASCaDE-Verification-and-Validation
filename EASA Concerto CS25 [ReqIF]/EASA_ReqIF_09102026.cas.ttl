	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(a)(3).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) There must be no flame penetration of any specimen within 5 minutes after application of the flame source, and the peak temperature measured at 10 cm (4 inches) above the upper surface of the horizontal test sample must not exceed 204oC (400oF).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
