	a o:idSpecObject1 ;
	rdfs:label "CS 25.967(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) No engine nacelle skin immediately behind a major air outlet from the engine compartment may act as the wall of an integral tank.</div>" ;
