	rdfs:label "CS 25.Apdx Q 4.Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">In a configuration corresponding to the normal all-engines-operating procedure in which VSR for this configuration does not exceed 110 % of the VSR for the related all-engines-operating steep approach landing configuration, the steady gradient of climb may not be less than 2.1 % for two-engined aeroplanes, 2.4 % for three-engined aeroplanes, and 2.7 % for four-engined aeroplanes, with:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
