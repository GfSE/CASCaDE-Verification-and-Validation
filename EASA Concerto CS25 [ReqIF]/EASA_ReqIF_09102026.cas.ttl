d:idSpecObject_779656215_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.321(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) For each required altitude and weight, for any practicable distribution of disposable load within the operating limitations recorded in the Aeroplane Flight Manual.</div>" ;
