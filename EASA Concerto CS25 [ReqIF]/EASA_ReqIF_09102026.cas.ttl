	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Accessibility. Required safety equipment to be used by the crew in an emergency must be readily accessible. </div>" ;
