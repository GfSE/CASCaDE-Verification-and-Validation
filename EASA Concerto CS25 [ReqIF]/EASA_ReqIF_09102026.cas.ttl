d:idSpecObject_-1724052015_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d)(1).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Any critical fuel loading conditions, not shown to be extremely improbable, which may result from mismanagement of fuel.</div>" ;
