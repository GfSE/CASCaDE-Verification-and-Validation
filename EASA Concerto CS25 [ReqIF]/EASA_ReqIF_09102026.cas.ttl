d:idSpecObject_1330287417_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1521.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The APU limitations must be established so that they do not exceed the corresponding approved limits for the APU and its systems. The APU limitations, including categories of operation, must be specified as operating limitations for the aeroplane.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
