	a o:idSpecObject1 ;
	rdfs:label "CS 25.1201(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each system component in an engine compartment must be fireproof.</div>" ;
