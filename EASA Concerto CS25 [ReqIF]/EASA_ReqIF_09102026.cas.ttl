d:idSpecObject_-880013300_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.775(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Internal panes must be made of non-splintering material.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
