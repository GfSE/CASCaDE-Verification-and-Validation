d:idSpecObject_1829045085_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(b)(2)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) the demonstration of compliance with the provisions S25.10(a)(1) and (2) does not rely on any passenger action, nor involve any flight crew member leaving their position in the cockpit.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx S 10" ;
