d:idSpecObject_-356525592_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(6).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Data Recording. A recording potentiometer or other suitable calibrated instrument with an appropriate range must be used to measure and record the outputs of the calorimeter and the thermocouples. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(6)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(7).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Weight Scale. Weighing Device – A device must be used that with proper procedures may determine the before and after test weights of each set of seat cushion specimens within 9 grams (0·02 pound). A continuous weighing system is preferred. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(7)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(8).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) Timing Device. A stopwatch or other device (calibrated to ± 1 second) must be used to measure the time of application of the burner flame and self-extinguishing time or test duration. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(8)" ;
