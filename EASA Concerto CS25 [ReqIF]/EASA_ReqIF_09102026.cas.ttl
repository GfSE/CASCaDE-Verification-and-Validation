	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(c).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Balance weights. If balance weights are used, their effectiveness and strength, including supporting structure, must be substantiated.</div>" ;
