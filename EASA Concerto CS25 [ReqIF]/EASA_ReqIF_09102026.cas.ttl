	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(e)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) There must not be a manual shut-off means readily available to the flight crew for the warning required by sub-paragraph (e)(2) of this paragraph such that it could be operated instinctively, inadvertently or by habitual reflexive action.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
