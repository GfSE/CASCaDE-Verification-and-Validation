d:idSpecObject_-1282142559_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.471(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Critical centres of gravity. The critical centres of gravity within the range for which certification is requested must be selected so that the maximum design loads are obtained in each landing gear element. Fore and aft, vertical, and lateral aeroplane centres of gravity must be considered. Lateral displacements of the centre of gravity from the aeroplane centreline which would result in main gear loads not greater than 103% of the critical design load for symmetrical loading conditions may be selected without considering the effects of these lateral centre of gravity displacements on the loading of the main gear elements, or on the aeroplane structure provided –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "471" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8459" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1282142559_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.471(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The lateral displacement of the centre of gravity results from random passenger or cargo disposition within the fuselage or from random unsymmetrical fuel loading or fuel usage; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
