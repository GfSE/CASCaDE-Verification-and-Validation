d:idSpecObject_-786188817_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) At least one hand fire extinguisher must be conveniently located in the pilot compartment (see AMC 25.851(a)(2)).</div>" ;
