d:idSpecObject_-1383213079_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(f).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Towing conditions. For one and for two deflated tyres, the towing load, FTOW, must be 60% and 50% respectively, of the load prescribed.</div>" ;
