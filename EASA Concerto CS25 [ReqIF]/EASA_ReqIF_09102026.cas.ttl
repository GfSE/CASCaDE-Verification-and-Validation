d:idSpecObject_-1221697221_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.251(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The aeroplane must be demonstrated in flight to be free from any vibration and buffeting that would prevent continued safe flight in any likely operating condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "251" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Vibration and buffeting" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10097" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1221697221_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.251(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each part of the aeroplane must be demonstrated in flight to be free from excessive vibration under any appropriate speed and power conditions up to VDF/MDF. The maximum speeds shown must be used in establishing the operating limitations of the aeroplane in accordance with CS 25.1505.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "251" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Vibration and buffeting" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10097" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1221697221_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.251(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Except as provided in sub-paragraph (d) of this paragraph, there may be no buffeting condition, in normal flight, including configuration changes during cruise, severe enough to interfere with the control of the aeroplane, to cause excessive fatigue to the crew, or to cause structural damage. Stall warning buffeting within these limits is allowable.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "251" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Vibration and buffeting" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10097" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1221697221_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.251(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) There may be no perceptible buffeting condition in the cruise configuration in straight flight at any speed up to VMO/MMO, except that the stall warning buffeting is allowable.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "251" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Vibration and buffeting" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10097" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
