d:idSpecObject_1651683409_36
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(g)(2).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Mount the test specimen on the test stand shown in Figure 1 in either the horizontal or vertical position. Mount the insulating material in the other position.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
