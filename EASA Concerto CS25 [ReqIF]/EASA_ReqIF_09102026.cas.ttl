	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-862454206_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Parameters critical for the test being conducted, such as weight, loading (centre of gravity and inertia), airspeed, power, and wind, must be maintained within acceptable tolerances of the critical values during flight testing. (See AMC 25.21(d))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
