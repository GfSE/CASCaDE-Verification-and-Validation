d:idSpecObject_-749083209_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(d)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) An energy absorbing rest that will support the arms, shoulders, head and spine.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
