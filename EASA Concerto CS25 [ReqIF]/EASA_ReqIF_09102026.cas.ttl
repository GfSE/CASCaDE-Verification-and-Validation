	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-615295197_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.772(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Means must be provided to enable flight-crew members to directly enter the passenger compartment from the pilot compartment if the cockpit door becomes jammed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
