	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(b)(3).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Flight tests of the aeroplane or its components in measured simulated icing conditions.</div>" ;
