d:idSpecObject_-1320806339_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1027.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1027.)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1027" ;
	o:idTitle1 "Propeller feathering system" ;
	o:idAmendedBy1 "Initial issue;" ;
