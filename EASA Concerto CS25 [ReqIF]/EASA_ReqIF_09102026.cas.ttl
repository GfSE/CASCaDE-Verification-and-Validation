	a o:idSpecObject1 ;
	rdfs:label "CS 25.1401(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Consists of one or more approved anti-collision lights located so that their light will not impair the crew’s vision or detract from the conspicuity of the position lights; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1401" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Anti-collision light system" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8143" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-304003163_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1401(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Meets the requirements of sub-paragraphs (b) to (f) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1401" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Anti-collision light system" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8143" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-304003163_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1401(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Field of coverage. The system must consist of enough light to illuminate the vital areas around the aeroplane considering the physical configuration and flight characteristics of the aeroplane. The field of coverage must extend in each direction within at least 75° above and 75° below the horizontal plane of the aeroplane, except that a solid angle or angles of obstructed visibility totalling not more than 0·03 steradians is allowable within a solid angle equal to 0·15 steradians centred about the longitudinal axis in the rearward direction. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1401" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Anti-collision light system" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8143" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-304003163_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1401(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Flashing characteristics. The arrangement of the system, that is, the number of light sources, beam width, speed of rotation, and other characteristics, must give an effective flash frequency of not less than 40, nor more than 100 cycles per minute. The effective flash frequency is the frequency at which the aeroplane’s complete anti-collision light system is observed from a distance, and applies to each section of light including any overlaps that exist when the system consists of more than one light source. In overlaps, flash frequencies may exceed 100, but not 180 cycles per minute. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1401" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Anti-collision light system" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8143" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-304003163_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1401(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Colour. Each anti-collision light must be either aviation red or aviation white and must meet the applicable requirements of CS 25.1397. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
