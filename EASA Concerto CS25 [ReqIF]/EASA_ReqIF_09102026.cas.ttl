	a o:idSpecObject1 ;
	rdfs:label "CS 25.1461(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Auxiliary rotor cases must be able to contain damage caused by the failure of high energy rotor blades; and</div>" ;
