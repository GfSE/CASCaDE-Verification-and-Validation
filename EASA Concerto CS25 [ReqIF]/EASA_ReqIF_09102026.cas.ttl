	a o:idSpecObject1 ;
	rdfs:label "CS 25.954(b)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Direct lightning strikes to areas having a high probability of stroke attachment;</div>" ;
