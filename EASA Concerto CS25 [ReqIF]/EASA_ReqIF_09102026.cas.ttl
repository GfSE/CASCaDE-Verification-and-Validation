	a o:idSpecObject1 ;
	rdfs:label "CS 25.1703(d).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) EWIS components located in areas of known moisture accumulation must be adequately protected to minimise any hazardous effect due to moisture.</div>" ;
