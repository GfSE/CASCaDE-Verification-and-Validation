d:idSpecObject_-2058332334_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(d)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Oil tank vents must be arranged so that condensed water vapour that might freeze and obstruct the line cannot accumulate at any point.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
