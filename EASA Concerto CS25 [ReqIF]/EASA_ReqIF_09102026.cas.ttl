	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "AIR INTAKE AND BLEED AIR DUCT SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-9355" ;
