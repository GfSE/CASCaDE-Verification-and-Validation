	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_38
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(g)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Record the weight of each set of seat bottom and seat back cushion specimens to be tested to the nearest 9 grams (0·02 pound).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(g)(1)" ;
