d:idSpecObject_-2058332334_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Installation. Each oil tank installation must meet the requirements of CS 25.967. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
