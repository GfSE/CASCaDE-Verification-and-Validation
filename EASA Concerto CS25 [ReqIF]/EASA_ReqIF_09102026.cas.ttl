		d:idSpecObject_1298727579_9 .

d:idSpecObject_1298727579_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.481(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) For the tail-down landing condition for aeroplanes with nose wheels, the aeroplane is assumed to be at an attitude corresponding to either the stalling angle or the maximum angle allowing clearance with the ground by each part of the aeroplane other than the main wheels, in accordance with Figure 3 of Appendix A, whichever is less.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
