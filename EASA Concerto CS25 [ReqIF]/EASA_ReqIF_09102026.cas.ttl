	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(h)(1).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) At least 6 full applications of the brakes when an anti-skid system is not operating; and </div>" ;
