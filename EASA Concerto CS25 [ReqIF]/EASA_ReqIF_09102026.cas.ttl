d:idSpecObject_-1167862034_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The aeroplane pressure fuelling system (not including fuel tanks and fuel tank vents) must withstand an ultimate load that is 2·0 times the load arising from the maximum pressures, including surge, that is likely to occur during fuelling. The maximum surge pressure must be established with any combination of tank valves being either intentionally or inadvertently closed. (See AMC 25.979(d).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "979" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Pressure fuelling system" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10074" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1167862034_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) The aeroplane defuelling system (not including fuel tanks and fuel tank vents) must withstand an ultimate load that is 2·0 times the load arising from the maximum permissible defuelling pressure (positive or negative) at the aeroplane fuelling connection.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
