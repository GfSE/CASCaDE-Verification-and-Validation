	a o:idSpecObject1 ;
	rdfs:label "CS 25.925(c)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Positive clearance between other rotating parts of the propeller or spinner and stationary parts of the aeroplane.</div>" ;
