d:idSpecObject_25245537_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.571(a)(1)(iii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) An analysis, supported by test evidence, of the principal structural elements and detail design points identified in sub-paragraph (a)(1)(ii) of this paragraph.</div>" ;
