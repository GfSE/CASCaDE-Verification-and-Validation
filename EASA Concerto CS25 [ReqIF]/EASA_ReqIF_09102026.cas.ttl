	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(d)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A nose-down pitch that cannot be readily arrested; </div>" ;
