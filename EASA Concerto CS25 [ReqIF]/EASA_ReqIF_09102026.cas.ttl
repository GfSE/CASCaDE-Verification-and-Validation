d:idSpecObject_171137685_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each chemical oxygen generator or its installation must be designed to be secure from deliberate manipulation by one of the following: </div>" ;
