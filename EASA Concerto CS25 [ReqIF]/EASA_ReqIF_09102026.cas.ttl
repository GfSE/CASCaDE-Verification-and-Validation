	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(a)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) describe the circumstances under which the FRM would not be operated during each phase of flight.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
