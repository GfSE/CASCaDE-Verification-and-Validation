	a o:idSpecObject1 ;
	rdfs:label "CS 25.1450(a).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For the purpose of this paragraph, a chemical oxygen generator is defined as a device, which produces oxygen, by chemical reaction.</div>" ;
