	a o:idSpecObject1 ;
	rdfs:label "CS 25.161(d)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The remaining engines at maximum continuous power; and</div>" ;
