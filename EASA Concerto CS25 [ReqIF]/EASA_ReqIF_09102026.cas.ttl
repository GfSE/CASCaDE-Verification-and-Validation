	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(c).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each seat or berth must be approved.</div>" ;
