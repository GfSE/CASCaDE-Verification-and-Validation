d:idSpecObject_-1439567751_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Speed increase and recovery characteristics. The following speed increase and recovery characteristics must be met: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "253" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "High-speed characteristics" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10129" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
