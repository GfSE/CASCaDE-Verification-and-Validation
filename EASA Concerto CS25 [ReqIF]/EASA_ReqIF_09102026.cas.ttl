d:idSpecObject_1789991084_93
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(h)(2).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each of the two insulation blanket test specimens must not allow more than 2.27 W/cm2 (2.0 Btu/ft2 sec) on the cold side of the insulation specimens at a point 30.5 cm (12 inches) from the face of the test rig.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
