	o:ideRules1 "ERULES-1963177438-9521" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/020/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-12-27T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_-2012264952_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(k).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(k) Following disengagement of the autothrust function, a caution must be provided to each pilot.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
