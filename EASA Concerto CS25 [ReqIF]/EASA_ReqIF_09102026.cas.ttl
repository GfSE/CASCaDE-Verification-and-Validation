	a o:idSpecObject1 ;
	rdfs:label "CS 25.961(a)(5).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The fuel temperature must be at least 43.3°C (110°F).</div>" ;
