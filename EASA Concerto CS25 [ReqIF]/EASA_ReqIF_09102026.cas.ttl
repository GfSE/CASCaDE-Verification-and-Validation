	a o:idSpecObject1 ;
	rdfs:label "CS 25.863(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each area where flammable fluids or vapours might escape by leakage of a fluid system must be identified and defined.</div>" ;
