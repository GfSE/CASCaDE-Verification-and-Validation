	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-906118180_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1585(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The buffet onset envelopes determined under CS 25.251 must be furnished. The buffet onset envelopes presented may reflect the centre of gravity at which the aeroplane is normally loaded during cruise if corrections for the effect of different centre of gravity locations are furnished.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
