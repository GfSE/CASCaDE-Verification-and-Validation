	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 3(a)(4).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The landing must be made without excessive vertical acceleration, tendency to bounce, nose over or ground loop and with a vertical touchdown velocity not greater than 6 ft/sec.</div>" ;
