	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_2049864097_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1721(a)(1).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) It cannot be damaged by the movement of cargo or baggage in the compartment.</div>" ;
