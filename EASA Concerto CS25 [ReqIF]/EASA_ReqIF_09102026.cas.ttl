	a o:idSpecObject1 ;
	rdfs:label "CS 25.1711(d).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The means used for identifying each EWIS component as required by this paragraph must not have an adverse effect on the performance of that component throughout its expected service life.</div>" ;
