d:idSpecObject_1789991084_46
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(b)(7).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Timing device. Provide a stopwatch or other device, accurate to ± 1%, to measure the time of application of the burner flame and burnthrough time. </div>" ;
