d:idSpecObject_-1336223160_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.1360(a).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.1360(a) Precaution against injury ED Decision 2007/010/R 1 Where there may be a hazard during maintenance or servicing, aeroplane panels, etc., carrying voltages of above 50V RMS, should be marked with the voltage. 2 Where socket outlets are provided, these should be labelled as to use and with the output voltage or voltages. Where the output voltage exceeds 100 volts d.c. and/or 50 volts a.c. RMS either the output should be electrically isolated from the aeroplane structure, or means shall be provided to prevent inadvertent contact with live parts. [Amdt 25/3]</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
