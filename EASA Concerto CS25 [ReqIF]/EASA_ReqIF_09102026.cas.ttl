	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The services to be powered must include – </div>" ;
