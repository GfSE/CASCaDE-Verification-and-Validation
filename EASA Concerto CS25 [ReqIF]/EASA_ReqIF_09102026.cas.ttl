d:idSpecObject_457844235_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.457.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Wing flaps, their operating mechanisms, and their supporting structures must be designed for critical loads occurring in the conditions prescribed in CS 25.345, accounting for the loads occurring during transition from one wing-flap position and airspeed to another. </div>" ;
