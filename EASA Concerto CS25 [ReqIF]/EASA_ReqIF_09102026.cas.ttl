d:idSpecObject_552252819_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(a)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The aeroplane must be accelerated on the ground to VEF, at which point the critical engine must be made inoperative and remain inoperative for the rest of the take-off; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
