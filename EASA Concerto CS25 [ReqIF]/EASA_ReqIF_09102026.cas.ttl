	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 4(c)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A temperature at the beginning of the overnight period that equals the landing temperature of the previous flight that is a random value based on a Gaussian distribution; and</div>" ;
