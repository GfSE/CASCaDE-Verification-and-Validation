d:idSpecObject_176150888_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.929(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) If certification for flight in icing conditions is sought, there must be a means to prevent or remove hazardous ice accumulations that could form in the icing conditions defined in Appendices C and O on propellers or on accessories where ice accumulation would jeopardise engine performance (see AMC 25.929(a)).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "929" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Propeller de-icing" ;
