d:idSpecObject_-1518766152_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J955(a)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Each main pump must be used that is necessary for each operating condition and attitude for which compliance with this paragraph is shown, and the appropriate emergency pump must be substituted for each main pump so used.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
