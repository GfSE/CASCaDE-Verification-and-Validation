d:idSpecObject_-1720090435_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 1(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) This Appendix specifies additional requirements and limitations for aeroplanes equipped with an engine control system that automatically resets thrust or power on the operating engine(s) when any engine fails during take-off, and for which performance credit is limited to that of paragraph 25.3(b) of this Appendix. When performance credit is not so limited, Special Conditions will apply.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx I 1" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix I – Automatic Takeoff Thrust Control System (ATTCS)" ;
	o:ideRules1 "ERULES-1963177438-8666" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1720090435_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 1(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) With the ATTCS system and associated systems functioning normally as designed, all applicable requirements of CS-25, except as provided in this Appendix, must be met without requiring any action by the crew to increase thrust or power. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
