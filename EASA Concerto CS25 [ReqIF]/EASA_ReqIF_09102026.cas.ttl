	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d)(2)(ii)(A).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(A) Fuel pressures resulting from the accelerations as specified in CS 25.561(b)(3) considering the fuel tank full of fuel at maximum fuel density. Fuel pressures based on the 9.0g forward acceleration may be calculated using the fuel static head equal to the streamwise local chord of the tank. For inboard and outboard conditions, an acceleration of 1.5g may be used in lieu of 3.0g as specified in CS 25.561(b)(3); and:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "963" ;
	o:idSubref1 "(d)(2)(ii)(A)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d)(2)(ii)(B).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(B) Fuel pressures resulting from the accelerations as specified in CS 25.561(b)(3) considering a fuel volume beyond 85% of the maximum permissible volume in each tank using the static head associated with the 85% fuel level. A typical density of the appropriate fuel may be used. For inboard and outboard conditions, an acceleration of 1.5g may be used in lieu of 3.0g as specified in CS 25.561(b)(3).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "963" ;
	o:idSubref1 "(d)(2)(ii)(B)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Fuel tank internal barriers and baffles may be considered as solid boundaries if shown to be effective in limiting fuel flow.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
