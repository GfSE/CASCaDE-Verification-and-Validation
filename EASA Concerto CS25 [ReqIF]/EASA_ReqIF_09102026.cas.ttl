	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1342275228_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1447(c)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) There must be sufficient outlets and units of dispensing equipment of a type similar to that required by sub-paragraph (c)(1) of this paragraph in all other areas that may be occupied by passengers or crew members during flight. (See AMC 25.1447 (c)(3))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
