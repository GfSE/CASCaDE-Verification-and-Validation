d:idSpecObject_-2014239363_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.345(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Propeller slipstream corresponding to maximum continuous power at the design flap speeds VF, and with take-off power at not less than 1·4 times the stalling speed for the particular flap position and associated maximum weight; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
