	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(6)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) the maximum operator effort when the latches are operated manually; </div>" ;
