d:idSpecObject_-59689317_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.961(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The weight of the aeroplane must be the weight with full fuel tanks, minimum crew, and the ballast necessary to maintain the centre of gravity within allowable limits.</div>" ;
