d:idSpecObject_1642579540_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(e)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each passenger emergency exit must have, on or near the exit, a marking that is readable from a distance of 76 cm (30 inches).</div>" ;
