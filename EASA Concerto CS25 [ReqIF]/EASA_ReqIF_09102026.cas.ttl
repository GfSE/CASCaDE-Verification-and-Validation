d:idSpecObject_-2012264952_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(a).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Quick disengagement controls for the autopilot and autothrust functions must be provided for each pilot. The autopilot quick disengagement controls must be located on both control wheels (or equivalent). The autothrust quick disengagement controls must be located on the thrust control levers. Quick disengagement controls must be readily accessible to each pilot while operating the control wheel (or equivalent) and thrust control levers.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1329" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Flight Guidance System" ;
	o:idAmendedBy1 "Amendment 4;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9521" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/020/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-12-27T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_-2012264952_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(b).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The effects of a failure of the system to disengage the autopilot or autothrust functions when manually commanded by the pilot must be assessed in accordance with the specifications of CS 25.1309.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1329" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Flight Guidance System" ;
	o:idAmendedBy1 "Amendment 4;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9521" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/020/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-12-27T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_-2012264952_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(c).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Engagement or switching of the flight guidance system, a mode, or a sensor must not produce a transient response affecting the control or flight path of the aeroplane any greater than a minor transient.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1329" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Flight Guidance System" ;
	o:idAmendedBy1 "Amendment 4;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9521" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/020/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-12-27T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_-2012264952_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(d).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Under normal conditions, the disengagement of any automatic control functions of a flight guidance system must not produce a transient response affecting the control or flight path of the aeroplane any greater than a minor transient.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1329" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Flight Guidance System" ;
	o:idAmendedBy1 "Amendment 4;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9521" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/020/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-12-27T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_-2012264952_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(e).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Under rare-normal or non-normal conditions, the disengagement of any automatic control functions of a flight guidance system must not produce a transient response affecting the control or flight path of the aeroplane any greater than a significant transient.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
