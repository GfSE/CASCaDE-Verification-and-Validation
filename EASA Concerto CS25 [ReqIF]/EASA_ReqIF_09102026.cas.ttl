	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_1789991084_84
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(4).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) To begin the test, rotate the burner into the test position and simultaneously start the timing device. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
