d:idSpecObject_798579601_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1041.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The powerplant cooling provisions must be able to maintain the temperatures of powerplant components, and engine fluids, within the temperature limits established for these components and fluids, under ground and flight operating conditions, and after normal engine shutdown. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
