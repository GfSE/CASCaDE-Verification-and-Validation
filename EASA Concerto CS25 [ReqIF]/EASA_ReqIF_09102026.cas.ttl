d:idSpecObject_-1092025642_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(4).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Any single electrical failure that is external to the recorder does not disable both the cockpit voice recorder function and the flight data recorder function;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
