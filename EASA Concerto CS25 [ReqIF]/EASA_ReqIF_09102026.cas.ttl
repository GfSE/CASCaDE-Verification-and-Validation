	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-442894939_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(b)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) From 0·8 of the minimum value of V1, to the maximum value of V2, considering the approved ranges of altitude and weight; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
