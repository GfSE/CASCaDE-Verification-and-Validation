	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(e).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Anti-skid system. If an anti-skid system is installed: </div>" ;
