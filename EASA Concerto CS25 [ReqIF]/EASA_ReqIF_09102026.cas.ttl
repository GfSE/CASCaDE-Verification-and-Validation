d:idSpecObject_-103094868_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1043(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Maximum ambient atmospheric temperature. A maximum ambient atmospheric temperature corresponding to sea level conditions of at least 37.8°C (100°F) must be established. The assumed temperature lapse rate is 6.6°C per thousand meter (3·6°F per thousand feet) of altitude above sea level until a temperature of -56.5°C (–69·7°F) is reached, above which altitude the temperature is considered at -56.5°C (–69·7°F). However, for winterization installations, the applicant may select a maximum ambient atmospheric temperature corresponding to sea-level conditions of less than 37.8°C (100°F). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1043" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Cooling tests" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "COOLING" ;
	o:ideRules1 "ERULES-1963177438-10075" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-103094868_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1043(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Correction factor. Unless a more rational correction applies, temperatures of engine fluids and powerplant components for which temperature limits are established, must be corrected by adding to them the difference between the maximum ambient atmospheric temperature and the temperature of the ambient air at the time of the first occurrence of the maximum component or fluid temperature recorded during the cooling test. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1043" ;
	o:idSubref1 "(c)" ;
