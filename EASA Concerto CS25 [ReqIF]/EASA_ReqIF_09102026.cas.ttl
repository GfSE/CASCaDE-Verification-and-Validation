	a o:idSpecObject1 ;
	rdfs:label "CS 25.1001(d)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The fuel discharges clear of any part of the aeroplane;</div>" ;
