d:idSpecObject_-1058491393_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1025(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The closing of oil shut-off means may not prevent propeller feathering.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
