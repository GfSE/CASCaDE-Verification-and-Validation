	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(2)(i).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Be a modified gun type;</div>" ;
