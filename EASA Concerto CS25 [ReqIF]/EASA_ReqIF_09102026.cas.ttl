d:idSpecObject_72976871_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.145(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.145(b)(2) Longitudinal control ED Decision 2003/2/RM Where high lift devices are being retracted and where large and rapid changes in maximum lift occur as a result of movement of high-lift devices, some reduction in the margin above the stall may be accepted.</div>" ;
