	a o:idSpecObject1 ;
	rdfs:label "CS 25.679(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The device must have means to preclude the possibility of it becoming inadvertently engaged in flight. (See AMC 25.679(b).)</div>" ;
