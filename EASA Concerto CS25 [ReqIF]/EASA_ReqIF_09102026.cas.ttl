d:idSpecObject_-1383213079_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. Multiple-wheel landing gear units are assumed to be subjected to the limit ground loads prescribed in this Subpart under sub-paragraphs (b) through (f) of this paragraph. In addition – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
