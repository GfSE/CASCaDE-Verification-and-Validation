	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT CONTROLS AND ACCESSORIES" ;
	o:ideRules1 "ERULES-1963177438-10079" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1548625723_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1155(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) A caution provided to the flight crew when a cockpit control is displaced from the flight regime (forward thrust regime for turbo-jet powered aeroplanes) into a position to select propeller pitch settings below the flight regime (reverse thrust for turbo-jet powered aeroplanes) outside the approved in-flight operating envelope. This caution need not be provided if the means required by sub-paragraph (b) is a mechanical baulk that prevents movement of the control.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1155" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Reverse thrust and propeller pitch settings below the flight regime" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT CONTROLS AND ACCESSORIES" ;
	o:ideRules1 "ERULES-1963177438-10079" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-689208963_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1161.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Each fuel jettisoning system control must have guards to prevent inadvertent operation. No control may be near any fire extinguisher control or other control used to combat fire. </div>" ;
