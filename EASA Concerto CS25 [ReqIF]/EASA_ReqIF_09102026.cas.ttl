d:idSpecObject_-1509662283_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(k).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(k) Compatibility. Compatibility of the wheel and brake assemblies with the aeroplane and its systems must be substantiated. </div>" ;
