d:idSpecObject_1829045085_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(b)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Within the compartment, there is at least one emergency exit above the waterline on each side of the fuselage that meets at least the requirements of a type IV emergency exit for a compartment that has a passenger seating configuration of nine seats or less, or of a type III emergency exit otherwise; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
