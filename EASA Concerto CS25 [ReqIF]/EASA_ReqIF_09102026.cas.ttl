	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(d)(5).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The number of castings per production batch to be inspected by non-visual methods in accordance with sub-paragraphs (d)(2) and (d)(3) of this paragraph may be reduced from 100% when an accepted quality control procedure is established.</div>" ;
