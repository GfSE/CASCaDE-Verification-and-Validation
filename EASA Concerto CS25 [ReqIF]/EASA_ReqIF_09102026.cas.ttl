	o:ideRules1 "ERULES-1963177438-10217" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix S – Airworthiness requirements for non-commercially operated aeroplanes and low-occupancy aeroplanes" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1255451117_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 20(b)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) for aeroplanes required to have at least one cabin crew member on board, the item is intended for use only by a cabin crew member that has direct view of the deployable item and can confirm that it is correctly stowed and secured, while they are seated during taxiing, take-off, and landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
