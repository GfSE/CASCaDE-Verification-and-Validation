d:idSpecObject_673143495_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.415(g)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The parts of the control systems between the stops nearest the surfaces and the cockpit controls must be designed to the resultant limit loads, except that the parts of the control system where loads are eventually reacted by the pilot need not exceed:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
