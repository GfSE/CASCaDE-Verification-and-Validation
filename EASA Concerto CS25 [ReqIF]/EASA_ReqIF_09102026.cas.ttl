	a o:idSpecObject1 ;
	rdfs:label "CS 25.1193(d).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each part of the cowling subject to high temperatures due to its nearness to exhaust system parts or exhaust gas impingement must be fireproof.</div>" ;
