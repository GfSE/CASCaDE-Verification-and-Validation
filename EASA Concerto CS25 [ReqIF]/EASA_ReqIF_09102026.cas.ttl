	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_-1092025642_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(7)(iv).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iv) The deployment occurs upon the immersion of the aeroplane in water;</div>" ;
