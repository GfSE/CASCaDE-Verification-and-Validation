d:idSpecObject_-585877381_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) ‘No Smoking’ Placards and Lavatory Ashtrays: if smoking is to be prohibited, in lieu of the requirements of CS 25.791(a) and CS 25.791(d), a reduced number of ‘No smoking’ placards may be provided and lavatory ashtrays do not need to be provided in accordance with the following:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx S 40" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Markings and Placards" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix S – Airworthiness requirements for non-commercially operated aeroplanes and low-occupancy aeroplanesED Decision 2017/015/R(See AMC to Appendix S)" ;
	o:ideRules1 "ERULES-1963177438-10219" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix S – Airworthiness requirements for non-commercially operated aeroplanes and low-occupancy aeroplanes" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-585877381_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) a ‘No smoking’ placard must be conspicuously located inside the passenger compartment in the immediate vicinity of each door that can be used as a passenger boarding door. Each placard must be clearly legible for passengers entering the aeroplane;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx S 40" ;
