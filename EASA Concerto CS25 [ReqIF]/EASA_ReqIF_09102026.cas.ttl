	a o:idSpecObject1 ;
	rdfs:label "CS 25.562(c)(8).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) Seats must not yield under the tests specified in sub-paragraphs (b)(1) and (b)(2) of this paragraph to the extent they would impede rapid evacuation of the aeroplane occupants.</div>" ;
