d:idSpecObject_1768976959_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1501(a).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each operating limitation specified in CS 25.1503 to 25.1533 and other limitations and information necessary for safe operation must be established.</div>" ;
