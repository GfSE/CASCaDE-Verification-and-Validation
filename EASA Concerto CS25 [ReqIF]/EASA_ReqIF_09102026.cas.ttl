	o:idTitle1 "General" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8434" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-187177386_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1011(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The usable oil capacity may not be less than the product of the endurance of the aeroplane under critical operating conditions and the approved maximum allowable oil consumption of the engine under the same conditions, plus a suitable margin to ensure system circulation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
