d:idSpecObject_-1509662283_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(h)(2).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Bringing the aeroplane to a complete stop when an anti-skid system is operating, under all runway surface conditions for which the aeroplane is certificated.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
