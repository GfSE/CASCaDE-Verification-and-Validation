d:idSpecObject_-1624084903_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each fuel tank must be able to withstand, without failure, the vibration, inertia, fluid and structural loads that it may be subjected to in operation. (See AMC 25.963(a).)</div>" ;
