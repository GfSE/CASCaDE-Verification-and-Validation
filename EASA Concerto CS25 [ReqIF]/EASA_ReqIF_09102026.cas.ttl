d:idSpecObject_332991979_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.925(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) At least 25 mm (1·0 inches) radial clearance between the blade tips and the aeroplane structure, plus any additional radial clearance necessary to prevent harmful vibration; </div>" ;
