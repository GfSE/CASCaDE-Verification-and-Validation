d:idSpecObject_-1518766152_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J955(a)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The quantity of fuel in the tank may not exceed the amount established as the unusable fuel supply for that tank under the requirements of CS 25.959 plus that necessary to show compliance with this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
