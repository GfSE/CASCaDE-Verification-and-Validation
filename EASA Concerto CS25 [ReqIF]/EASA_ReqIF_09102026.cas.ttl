d:idSpecObject_-977006163_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.145(f)(2).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Reasonably expected variations in service from the established approach, landing and go-around procedures for the operation of the aeroplane must not result in unsafe flight characteristics during the go-around.</div>" ;
