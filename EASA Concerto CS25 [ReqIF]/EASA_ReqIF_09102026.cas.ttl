	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For those (parts of) wing fuel tanks near the fuselage or near the engines, the greater of the fuel pressures resulting from subparagraphs (i) and (ii) must be used:</div>" ;
