d:idSpecObject_-1070920956_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(3)(ii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) It remains powered for as long as possible without jeopardising the emergency operation of the aeroplane;</div>" ;
