d:idSpecObject_-442894939_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) VMO to 1·23 VSR1 with wing-flaps retracted; and </div>" ;
