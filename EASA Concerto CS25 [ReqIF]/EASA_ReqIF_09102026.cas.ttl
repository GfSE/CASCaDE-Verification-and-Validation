d:idSpecObject_-1693011484_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.331(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Manoeuvring balanced conditions. Assuming the aeroplane to be in equilibrium with zero pitching acceleration, the manoeuvring conditions A through I on the manoeuvring envelope in CS 25.333(b) must be investigated. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
