	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(6)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) A survey of those transient pressures is conducted to determine their magnitude and frequency; and</div>" ;
