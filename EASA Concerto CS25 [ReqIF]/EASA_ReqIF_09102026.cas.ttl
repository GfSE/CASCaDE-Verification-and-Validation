d:idSpecObject_-1744053042_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(m).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(m) Transport Effects. For purposes of this appendix, transport effects are the change in fuel vapour concentration in a fuel tank caused by low fuel conditions and fuel condensation and vaporization.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
