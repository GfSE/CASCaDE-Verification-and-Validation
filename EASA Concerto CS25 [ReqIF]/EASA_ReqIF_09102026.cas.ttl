d:idSpecObject_2127648882_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1199(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) If a pyrotechnic capsule is used to discharge the extinguishing agent, each container must be installed so that temperature conditions will not cause hazardous deterioration of the pyrotechnic capsule.</div>" ;
