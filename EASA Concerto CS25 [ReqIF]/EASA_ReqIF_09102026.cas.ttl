	a o:idSpecObject1 ;
	rdfs:label "CS 25.788(b).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Large display panels: Any large display panel installed in the passenger compartment must not be a source of danger to occupants when submitted to any of the following conditions (See AMC 25.788(b)):</div>" ;
