	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9521" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/020/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-12-27T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-12-27T00:00:00Z" .

d:idSpecObject_-2012264952_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1329(m).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(m) During autothrust operation, it must be possible for the flight crew to move the thrust levers without requiring excessive force. The autothrust response to flight crew override must not create an unsafe condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
