d:idSpecObject_-786188817_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(a)(6).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) The required fire extinguishers located in the passenger compartment must contain an accepted extinguishing agent that is appropriate for the kinds and classes of fires likely to occur where used.</div>" ;
