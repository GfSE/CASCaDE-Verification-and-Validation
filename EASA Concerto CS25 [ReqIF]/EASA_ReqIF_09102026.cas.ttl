	a o:idSpecObject1 ;
	rdfs:label "CS 25.685(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each detail of each control system must be designed and installed to prevent jamming, chafing, and interference from cargo, passengers, loose objects or the freezing of moisture. (See AMC 25.685(a).)</div>" ;
