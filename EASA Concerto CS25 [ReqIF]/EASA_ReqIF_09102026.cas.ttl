	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The following must be provided for each Type III or Type IV exit – (See AMC 25.813(c))</div>" ;
