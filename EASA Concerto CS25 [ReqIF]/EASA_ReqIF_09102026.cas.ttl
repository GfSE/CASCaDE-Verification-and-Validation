d:idSpecObject_1537624992_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(c)(2)(i).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The loads derived from the following conditions at speeds up to VC / MC, or the speed limitation prescribed for the remainder of the flight must be determined:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx K 2" ;
