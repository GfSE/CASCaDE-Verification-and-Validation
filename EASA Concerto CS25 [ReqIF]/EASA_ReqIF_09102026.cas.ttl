d:idSpecObject_-103094868_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1043(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. Compliance with CS 25.1041 must be shown by tests, under critical ground and flight operating conditions. For these tests, the following apply: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1043" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Cooling tests" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "COOLING" ;
	o:ideRules1 "ERULES-1963177438-10075" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-103094868_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1043(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) If the tests are conducted under conditions deviating from the maximum ambient atmospheric temperature, the recorded power-plant temperatures must be corrected under sub-paragraph (c) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
