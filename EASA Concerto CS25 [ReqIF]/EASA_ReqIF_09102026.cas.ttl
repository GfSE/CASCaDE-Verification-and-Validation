d:idSpecObject_-1092025642_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(3).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) There is an aural or visual means for pre-flight checking of the recorder for proper operation;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
