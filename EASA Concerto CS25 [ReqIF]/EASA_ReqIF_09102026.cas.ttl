d:idSpecObject_1187850300_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(g).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Type and number required. The maximum number of passenger seats permitted depends on the type and number of exits installed on each side of the fuselage. Except as further restricted in subparagraphs (g)(1) through (g)(9) of this paragraph, the maximum number of passenger seats permitted for each exit of a specific type installed on each side of the fuselage is as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
