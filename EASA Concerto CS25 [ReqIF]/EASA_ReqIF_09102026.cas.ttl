	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-9958" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2013/033/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2013-12-20T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-12-20T00:00:00Z" .

d:idSpecObject_-1509662283_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(j).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) Over-temperature burst prevention. Means must be provided in each braked wheel to prevent a wheel failure, a tyre burst, or both, that may result from elevated brake temperatures. Additionally, all wheels must meet the requirements of CS 25.731(d). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
