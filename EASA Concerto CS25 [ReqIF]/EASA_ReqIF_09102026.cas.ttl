d:idSpecObject_552252819_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The slope of the airborne part of the take-off path must be positive at each point;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
