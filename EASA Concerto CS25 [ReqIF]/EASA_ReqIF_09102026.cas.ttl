d:idSpecObject_1651683409_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(2)(ii).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Use a suitable nozzle and maintain fuel pressure to yield a 7.6 l/hr (2 US gallons/hour) fuel flow. For example: an 80-degree nozzle nominally rated at 8.5 l/hr (2·25 US gallons/hour) and operated at 586 Kpa (85 pounds per square inch) gauge to deliver 7.7 l/hr (2·03 US gallons/hour). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(2)(ii)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(2)(iii).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Have a 31 cm (12 inch) burner extension installed at the end of the draft tube with an opening 15 cm (6 inches) high and 28 cm (11 inches) wide as shown in Figure 3 of Part II of this Appendix.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(2)(iii)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
