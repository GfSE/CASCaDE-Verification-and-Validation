d:idSpecObject_1350743459_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(d)(2).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Partitions, other than transparent panels needed to enhance cabin safety;</div>" ;
