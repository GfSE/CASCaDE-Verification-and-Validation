d:idSpecObject_-654752177_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1360.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1360" ;
	o:idTitle1 "Precautions against injury" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10164" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1360.Amendment 18;" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-654752177_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1360(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Shock. The electrical system must be designed so as to minimise the risk of electric shock to crew, passengers and servicing personnel and also to maintenance personnel using normal precautions. (See AMC 25.1360(a) and CS 25.899.) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1360" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Precautions against injury" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10164" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-654752177_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1360(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Burns. The temperature of any part, which has to be handled during normal operation by the flight crew, must not be such as to cause dangerous inadvertent movement, or injury to the crewmember. (See AMC 25.1360(b).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
