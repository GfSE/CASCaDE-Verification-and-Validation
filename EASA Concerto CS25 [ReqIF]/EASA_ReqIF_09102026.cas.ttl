	o:idSubsection1 "PERFORMANCE" ;
	o:ideRules1 "ERULES-1963177438-10149" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_55650433_48
	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) A flight test demonstration of the maximum brake kinetic energy accelerate-stop distance must be conducted with not more than 10% of the allowable brake wear range remaining on each of the aeroplane wheel brakes.</div>" ;
