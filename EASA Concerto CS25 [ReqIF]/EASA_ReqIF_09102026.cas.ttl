	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-880013300_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.775(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Unless it can be shown by analysis or tests that the probability of occurrence of a critical windshield fragmentation condition is of a low order, the aeroplane must have a means to minimise the danger to the pilots from flying windshield fragments due to bird impact. This must be shown for each transparent pane in the cockpit that –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "775" ;
	o:idSubref1 "(c)" ;
