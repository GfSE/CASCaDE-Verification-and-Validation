d:idSpecObject_953978848_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.685(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) There must be means to prevent the slapping of cables or tubes against other parts.</div>" ;
