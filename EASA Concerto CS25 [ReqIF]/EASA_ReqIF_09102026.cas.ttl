d:idSpecObject_-1302882791_50
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(G).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(G) The distance of the calorimeter to the plate must be no less than 1.6 mm (0.0625 inches), nor greater than 9.5 mm (0.375 inches). </div>" ;
