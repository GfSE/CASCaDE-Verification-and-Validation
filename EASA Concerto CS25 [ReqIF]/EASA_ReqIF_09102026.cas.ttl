d:idSpecObject_1651683409_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(a)(1).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) At least three specimens of cargo compartment sidewall or ceiling liner panels must be tested.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
