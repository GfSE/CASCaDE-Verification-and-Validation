	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_153552573_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.967(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) There must be pads, if necessary, to prevent chafing between the tank and its supports;</div>" ;
