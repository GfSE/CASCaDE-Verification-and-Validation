	a o:idSpecObject1 ;
	rdfs:label "CS 25.1545.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1545)The airspeed limitations required by CS 25.1583(a) must be easily read and understood by the flight crew.</div>" ;
