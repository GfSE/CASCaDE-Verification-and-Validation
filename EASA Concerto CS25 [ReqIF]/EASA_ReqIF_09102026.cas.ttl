	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(e).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Components of each fire or overheat detector system in a fire zone must be at least fire-resistant.</div>" ;
