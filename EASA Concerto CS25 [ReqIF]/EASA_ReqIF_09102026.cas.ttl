	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1185(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) No tank or reservoir that is a part of a system containing flammable fluids or gases may be in a designated fire zone unless the fluid contained, the design of the system, the materials used in the tank, the shut-off means, and all connections, lines, and controls provide a degree of safety equal to that which would exist if the tank or reservoir were outside such a zone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J1185" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Flammable fluids" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "APU FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-9365" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-2123868427_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1185(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) There must be at least 12,7 mm of clear airspace between each tank or reservoir and each firewall or shroud isolating a designated fire zone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
