	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(b).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Alerts must conform to the following prioritisation hierarchy based on the urgency of flight crew awareness and response:</div>" ;
