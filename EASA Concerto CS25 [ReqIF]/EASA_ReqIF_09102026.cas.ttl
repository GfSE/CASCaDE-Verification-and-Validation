	a o:idSpecObject1 ;
	rdfs:label "CS 25.832(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Compliance with this paragraph must be shown by analysis or tests based on aeroplane operational procedures and performance limitations, that demonstrated that either –</div>" ;
