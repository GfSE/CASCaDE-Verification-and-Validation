	o:idRegulatorySource1 "ED Decision 2012/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2012-07-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2012-07-13T00:00:00Z" .

d:idSpecObject_388814335_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.341(a)(5)(ii).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) At the aeroplane design speed VD: The reference gust velocity must be 0·5 times the value obtained under CS 25.341(a)(5)(i).</div>" ;
