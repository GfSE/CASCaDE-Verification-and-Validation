d:idSpecObject_1379186953_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.787(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Nullify any of the escape facilities provided for use after an emergency landing, to the emergency landing conditions of CS 25.561(b)(3). If the aeroplane has a passenger-seating configuration, excluding pilot seats, of 10 seats or more, each stowage compartment in the passenger cabin, except for under seat and overhead compartments for passenger convenience, must be completely enclosed. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "787" ;
	o:idSubref1 "(a)(3)" ;
	o:idTitle1 "Stowage compartments" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10067" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1379186953_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.787(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) There must be a means to prevent the contents in the compartments from becoming a hazard by shifting, under the loads specified in sub-paragraph (a) of this paragraph. (See AMC 25.787(b))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
