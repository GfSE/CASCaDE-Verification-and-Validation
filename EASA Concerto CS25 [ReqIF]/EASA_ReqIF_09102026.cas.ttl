d:idSpecObject_1098922692_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(c)(2).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Any combination of failures not shown to be extremely improbable, excluding failures of the type defined in CS 25.671(c)(3); and</div>" ;
