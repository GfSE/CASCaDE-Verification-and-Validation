d:idSpecObject_-1302882791_47
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(D).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(D) The method of transfer must be a heated graphite plate.</div>" ;
