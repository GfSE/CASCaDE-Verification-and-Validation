d:idSpecObject_-2102244434_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Unless the nose-wheel, when lowered, is automatically in the fore-and-aft attitude successful landings must be demonstrated with the nose-wheel initially in all possible off-centre positions.</div>" ;
