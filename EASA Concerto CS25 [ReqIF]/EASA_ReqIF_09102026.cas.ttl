d:idSpecObject_1651683409_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Calibration. To ensure the proper thermal output of the burner the following test must be made: </div>" ;
