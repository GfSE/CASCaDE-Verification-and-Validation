	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 5(b)(5).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The flare, touchdown and landing may not require exceptional piloting skill or alertness.</div>" ;
