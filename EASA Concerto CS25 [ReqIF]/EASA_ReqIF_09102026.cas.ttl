	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1350743459_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(d)(1).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Interior ceiling and wall panels, other than lighting lenses and windows;</div>" ;
