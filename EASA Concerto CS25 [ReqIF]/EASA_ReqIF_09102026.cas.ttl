	a o:idSpecObject1 ;
	rdfs:label "CS 25.1326(a).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The alert provided must conform to the Caution alert indications.</div>" ;
