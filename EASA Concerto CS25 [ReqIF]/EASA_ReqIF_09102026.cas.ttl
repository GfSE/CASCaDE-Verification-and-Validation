	a o:idSpecObject1 ;
	rdfs:label "CS 25.925(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Structural clearance. There must be – </div>" ;
