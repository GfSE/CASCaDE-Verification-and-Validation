	a o:idSpecObject1 ;
	rdfs:label "CS 25.343(b)(3).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The flutter, deformation, and vibration requirements must also be met with zero fuel.</div>" ;
