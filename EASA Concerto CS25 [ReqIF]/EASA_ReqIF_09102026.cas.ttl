	o:idSubref1 "(d)" ;
	o:idTitle1 "Damage tolerance and fatigue evaluation of structure" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FATIGUE EVALUATION" ;
	o:ideRules1 "ERULES-1963177438-10206" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_25245537_30
	a o:idSpecObject1 ;
	rdfs:label "CS 25.571(d)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Sonic fatigue cracks are not probable in any part of the flight structure subject to sonic excitation; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "571" ;
	o:idSubref1 "(d)(1)" ;
	o:idTitle1 "Damage tolerance and fatigue evaluation of structure" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FATIGUE EVALUATION" ;
	o:ideRules1 "ERULES-1963177438-10206" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_25245537_31
	a o:idSpecObject1 ;
	rdfs:label "CS 25.571(d)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Catastrophic failure caused by sonic fatigue cracks is not probable assuming that the loads prescribed in sub-paragraph (b) of this paragraph are applied to all areas affected by those cracks.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
