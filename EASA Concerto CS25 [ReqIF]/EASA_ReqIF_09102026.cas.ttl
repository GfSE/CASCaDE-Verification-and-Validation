d:idSpecObject_1141067270_10_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part I(a)(2)(0).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Cargo and baggage compartments not occupied by crew or passengers. </div>" ;
