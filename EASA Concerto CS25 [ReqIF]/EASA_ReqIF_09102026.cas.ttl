d:idSpecObject_-1302882791_48
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(E).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(E) The graphite plate must be electrically heated, have a clear surface area on each side of the plate of at least 51 by 51 mm (2 by 2 inches), and be 3.2 ± 1.6 mm (⅛± 1⁄16 inch) thick.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
