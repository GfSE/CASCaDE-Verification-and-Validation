	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(b)(1)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) No discharge of the extinguisher can cause structural damage.</div>" ;
