	a o:idSpecObject1 ;
	rdfs:label "CS 25.1583(c)(1).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The condition of the aeroplane and the items included in the empty weight as defined in accordance with CS 25.29.</div>" ;
