d:idSpecObject_-240025242_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.J955(a)(2)(iii).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25J955(a)(2)(iii) Fuel Flow ED Decision 2005/006/R The word \"blocked\" should be interpreted to mean \"with the moving parts fixed in the position for maximum pressure drop\". [Amdt 25/1]</div>" ;
