d:idSpecObject_-920989927_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.365(e)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Any opening in any pressurised compartment up to the size Ho in square feet; however, small compartments may be combined with an adjacent pressurised compartment and both considered as a single compartment for openings that cannot reasonably be expected to be confined to the small compartment. The size Ho must be computed by the following formula: <object data=\"images/CS-25_27_-920989927-12.jpg\" type=\"image/jpg\"></object> where, Ho = maximum opening in square feet, need not exceed 20 square feet. P = As = maximum cross sectional area of the pressurised shell normal to the longitudinal axis, in square feet; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "365" ;
	o:idSubref1 "(e)(2)" ;
	o:idTitle1 "Pressurised compartment loads" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "SUPPLEMENTARY CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-10153" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-920989927_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.365(e)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The maximum opening caused by aeroplane or equipment failures not shown to be extremely improbable. (See AMC 25.365(e).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
