	a o:idSpecObject1 ;
	rdfs:label "CS 25.683(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) It must be shown that under vibration loads in the normal flight and ground operating conditions, no hazard can result from interference or contact with adjacent elements.</div>" ;
