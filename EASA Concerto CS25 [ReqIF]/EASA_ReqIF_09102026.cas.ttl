d:idSpecObject_-2120777850_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.731(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Overpressure burst prevention. Means must be provided in each wheel to prevent wheel failure and tyre burst that may result from excessive pressurisation of the wheel and tyre assembly. </div>" ;
