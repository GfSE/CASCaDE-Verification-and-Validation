	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1879502793_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 6(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The ATTCS system must be designed to perform accurately its intended function without exceeding engine operating limits under all reasonably expected conditions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
