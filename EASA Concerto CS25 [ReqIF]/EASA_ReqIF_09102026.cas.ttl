	a o:idSpecObject1 ;
	rdfs:label "CS 25.1561(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Stowage provisions for required emergency equipment must be conspicuously marked to identify the contents and facilitate the easy removal of the equipment.</div>" ;
