	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-792266652_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(e)(8).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) The test duration time is five minutes.</div>" ;
