d:idSpecObject_349408889_1
	a o:idSpecObject1 ;
	rdfs:label "CS 25.933(0).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii)It can be demonstrated that any in-flight thrust reversal complies with CS 25.1309(b).</div>" ;
