d:idSpecObject_-1460114103_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A cross-aisle which leads directly to each passageway between the nearest main aisle and a Type A or B exit; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
