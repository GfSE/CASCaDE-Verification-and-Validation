	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_171137685_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(c)(3)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Toilets must be designed to prevent the passage of solid objects greater than 5 cm (2.0 inches) in diameter.</div>" ;
