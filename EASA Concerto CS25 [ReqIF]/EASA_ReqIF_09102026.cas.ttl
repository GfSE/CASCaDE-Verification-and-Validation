	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Heater safety controls. For each combustion heater there must be the following safety control means: </div>" ;
