d:idSpecObject_1805953230_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(d)(4).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Failure of the critical engine occurs at VEF; and</div>" ;
