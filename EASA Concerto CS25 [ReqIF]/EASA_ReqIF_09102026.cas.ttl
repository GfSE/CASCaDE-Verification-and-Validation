	a o:idSpecObject1 ;
	rdfs:label "CS 25.121(b)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) the steady gradient of climb may not be less than 2·4% for two-engined aeroplanes, 2·7% for three-engined aeroplanes and 3·0% for four-engined aeroplanes, at V2 with – </div>" ;
