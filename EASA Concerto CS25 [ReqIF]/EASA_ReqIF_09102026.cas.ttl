d:idSpecObject_1045854938_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.509(c)(2)(i).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) A reaction with a maximum value equal to the vertical reaction must be applied at the axle of the wheel to which the load is applied. Enough aeroplane inertia to achieve equilibrium must be applied.</div>" ;
