	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(d)(3).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The critical ratio of thrust/power-to-weight;</div>" ;
