	o:idApplicabilityDate1 "2012-07-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2012-07-13T00:00:00Z" .

d:idSpecObject_388814335_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.341(a)(4).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The design gust velocity must be: <object data=\"images/CS-25_27_388814335-15.jpg\" type=\"image/jpg\"></object> where – Uref = the reference gust velocity in equivalent airspeed defined in sub-paragraph (a)(5) of this paragraph; Fg = the flight profile alleviation factor defined in sub-paragraph (a)(6) of this paragraph. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
