d:idSpecObject_-585877381_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(a)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) the indication that smoking is prohibited must be the subject of a passenger briefing, and the requirement for this briefing must be part of the AFM.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
