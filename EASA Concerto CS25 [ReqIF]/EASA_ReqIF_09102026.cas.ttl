	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_178944266_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.409(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Servo tabs. Servo tabs must be designed for deflections consistent with the primary control surface loading conditions obtainable within the pilot manoeuvring effort, considering possible opposition from the trim tabs. </div>" ;
