	a o:idSpecObject1 ;
	rdfs:label "CS 25.1141(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each control must have sufficient strength and rigidity to withstand operating loads without failure and without excessive deflection.</div>" ;
