	o:ideRules1 "ERULES-1963177438-18316" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/001/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2020-01-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_1098922692_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(c)(1).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Any single failure, excluding failures of the type defined in CS 25.671(c)(3);</div>" ;
