	a o:idSpecObject1 ;
	rdfs:label "CS 25.733(a)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The loads corresponding to the ground reactions in sub-paragraph (b) of this paragraph, on the nose-wheel tyre, except as provided in sub-paragraphs (b)(2) and (b)(3) of this paragraph.</div>" ;
