	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Doors that meet the conditions described in sub-paragraph (h) of this paragraph are not required to have a dedicated pressurisation prevention means if, from every possible position of the door, it will remain open to the extent that it prevents pressurisation or safely close and latch as pressurisation takes place. This must also be shown with any single failure and malfunction except that: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
