	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-961563324_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(f).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) For each occupant permitted in a lower deck service compartment, there must be a forward or aft facing seat, which meets the requirements of CS 25.785(d) and must be able to withstand maximum flight loads when occupied.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "819" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 "Lower deck service compartments (including galleys)" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10037" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-961563324_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(g).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) For each powered lift system installed between a lower deck service compartment and the main deck for the carriage of persons or equipment, or both, the system must meet the following requirements:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "819" ;
	o:idSubref1 "(g)" ;
	o:idTitle1 "Lower deck service compartments (including galleys)" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10037" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-961563324_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(g)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each lift control switch outside the lift, except emergency stop buttons, must be designed to prevent the activation of the lift if the lift door, or the hatch required by sub-paragraph (g)(3) of this paragraph, or both are open.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "819" ;
	o:idSubref1 "(g)(1)" ;
	o:idTitle1 "Lower deck service compartments (including galleys)" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10037" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-961563324_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(g)(2).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) An emergency stop button, that when activated will immediately stop the lift, must be installed within the lift and at each entrance to the lift.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "819" ;
