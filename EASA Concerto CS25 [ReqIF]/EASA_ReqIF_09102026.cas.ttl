	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1163(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) APU mounted accessories must be approved for installation on the APU concerned and use the provisions of the APU for mounting.</div>" ;
