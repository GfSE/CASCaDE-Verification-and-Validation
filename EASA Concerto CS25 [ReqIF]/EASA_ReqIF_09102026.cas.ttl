d:idSpecObject_1397201062_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.103(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Starting from the stabilised trim condition, apply the longitudinal control to decelerate the aeroplane so that the speed reduction does not exceed 0.5 m/s2 (one knot per second). (See AMC 25.103(b) and (c)).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "103" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Stall speed" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "PERFORMANCE" ;
	o:ideRules1 "ERULES-1963177438-10145" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1397201062_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.103(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) In addition to the requirements of sub-paragraph (a) of this paragraph, when a device that abruptly pushes the nose down at a selected angle of attack (e.g. a stick pusher) is installed, the reference stall speed, VSR, may not be less than 3,7 km/h (2 kt) or 2%, whichever is greater, above the speed at which the device operates. (See AMC 25.103(d))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
