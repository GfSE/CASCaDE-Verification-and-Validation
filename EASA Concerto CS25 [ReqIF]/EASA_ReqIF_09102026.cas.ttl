	o:idAmendedBy1 "Amendment 3;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-9480" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-09-19T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

d:idSpecObject_-1752443724_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.941(c).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) In showing compliance with sub-paragraph (b) of this paragraph, the pilot strength required may not exceed the limits set forth in CS 25.143(d) subject to the conditions set forth in sub-paragraphs (e) and (f) of CS 25.143. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "941" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Inlet, engine, and exhaust compatibility" ;
	o:idAmendedBy1 "Amendment 3;" ;
