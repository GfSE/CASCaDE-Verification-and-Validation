	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_2060306491_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 4(b).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The Flight Length Distribution defined in Table 2 must be used in the Monte Carlo analysis. Table 2. Flight Length Distribution </div>" ;
