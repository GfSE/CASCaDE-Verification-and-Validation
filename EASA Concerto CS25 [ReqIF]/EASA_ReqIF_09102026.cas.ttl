d:idSpecObject_-356525592_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(b).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Test Conditions. Vertical air velocity should average 13cm/s ± 5 cm/s (25 fpm ± 10 fpm) at the top of the back seat cushion. Horizontal air velocity should be below 51 mm/s (10 fpm) just above the bottom seat cushion. Air velocities should be measured with the ventilation hood operating and the burner motor off. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
