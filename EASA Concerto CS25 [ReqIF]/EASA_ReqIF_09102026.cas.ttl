d:idSpecObject_139109823_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx H 4(a)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each mandatory modification time, replacement time, structural inspection interval, and related structural inspection procedure approved under CS 25.571;</div>" ;
