	a o:idSpecObject1 ;
	rdfs:label "CS 25.1445(a)(1).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A source of supply for the flight crew on duty and a separate source for the passengers and other crew members; or</div>" ;
