d:idSpecObject_-2058332334_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(d)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each oil tank must be vented from the top part of the expansion space so that venting is effective under any normal flight condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
