	a o:idSpecObject1 ;
	rdfs:label "CS 25.1707(d)(1).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Aeroplane independent electrical power sources must not share a common ground terminating location, and</div>" ;
