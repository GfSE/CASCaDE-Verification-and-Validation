	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1783419709_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(e)(6).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Failures of systems used to inhibit the landing gear aural warning, that would prevent the warning system from operating, must be improbable.</div>" ;
