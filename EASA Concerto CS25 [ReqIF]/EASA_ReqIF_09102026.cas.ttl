	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 6(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A means for checking prior to takeoff that the system is in an operable condition; and</div>" ;
