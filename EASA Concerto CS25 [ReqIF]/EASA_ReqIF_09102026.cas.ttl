d:idSpecObject_1541080023_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1091(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Air intakes may not open within the cowling, unless that part of the cowling is isolated from the engine accessory section by means of a fireproof diaphragm.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
