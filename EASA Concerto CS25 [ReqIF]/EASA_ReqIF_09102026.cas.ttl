	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Require immediate action by any crew member for continued safe operation.</div>" ;
