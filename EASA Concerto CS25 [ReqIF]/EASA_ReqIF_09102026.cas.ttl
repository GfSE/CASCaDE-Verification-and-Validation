	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) At speeds between VFC/MFC and VDF/MDF, the direction of the primary longitudinal control force may not reverse. </div>" ;
