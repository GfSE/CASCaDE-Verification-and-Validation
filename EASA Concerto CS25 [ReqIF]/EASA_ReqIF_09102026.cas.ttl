	a o:idSpecObject1 ;
	rdfs:label "CS 25.105(a)(2)(i).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The stall speed at maximum take-off weight exceeds that in non-icing conditions by more than the greater of 5.6 km/h (3 knots) CAS or 3% of VSR; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
