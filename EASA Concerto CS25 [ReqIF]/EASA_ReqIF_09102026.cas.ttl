d:idSpecObject_-880013300_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.775(c)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Has any part of the pane located where its fragmentation will constitute a hazard to the pilots.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
