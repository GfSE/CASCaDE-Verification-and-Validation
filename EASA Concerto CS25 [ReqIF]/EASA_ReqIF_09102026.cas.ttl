	a o:idSpecObject1 ;
	rdfs:label "CS 25.1420(a)(0).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) If certification for flight in icing conditions is sought, in addition to the requirements of CS 25.1419, the aeroplane must be capable of operating in accordance with sub-paragraphs (a)(1), (a)(2), or (a)(3) of this paragraph.</div>" ;
