d:idSpecObject_-1058491393_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1025(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each oil valve must have positive stops or suitable index provisions in the ‘on’ and ‘off’ positions and must be supported so that no loads resulting from its operation or from accelerated flight conditions are transmitted to the lines attached to the valve.</div>" ;
