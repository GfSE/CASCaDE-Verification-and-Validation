	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(e)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) For non-essential APUs that can be started in-flight and all essential APUs:</div>" ;
