	a o:idSpecObject1 ;
	rdfs:label "CS 25.509(a)(2).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The shock struts and tyres must be in their static positions; and</div>" ;
