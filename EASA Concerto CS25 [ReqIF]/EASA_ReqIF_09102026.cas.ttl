	a o:idSpecObject1 ;
	rdfs:label "CS 25.1581(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Approved information. Each part of the manual listed in CS 25.1583 to 25.1587 that is appropriate to the aeroplane, must be furnished, verified, and approved, and must be segregated, identified, and clearly distinguished from each unapproved part of that manual. </div>" ;
