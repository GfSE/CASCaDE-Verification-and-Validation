	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1400785182_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.904.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Aeroplanes equipped with an engine power control system that automatically resets the power or thrust on the operating engine(s) when any engine fails during the takeoff must comply with the requirements of Appendix I.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "904" ;
	o:idTitle1 "Automatic Takeoff Thrust Control System (ATTCS)" ;
	o:idAmendedBy1 "Initial issue;" ;
