		d:idSpecObject_1954248786_6 .

d:idSpecObject_1954248786_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.181(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Any combined lateral-directional oscillations (‘Dutch roll’) occurring between 1·13 VSR and maximum allowable speed appropriate to the configuration of the aeroplane must be positively damped with controls free, and must be controllable with normal use of the primary controls without requiring exceptional pilot skill.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
