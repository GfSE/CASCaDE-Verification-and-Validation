	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1575056278_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If reasonably attainable at the specified descent and forward velocities an attitude in which the nose and main wheels are assumed to contact the ground simultaneously.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
