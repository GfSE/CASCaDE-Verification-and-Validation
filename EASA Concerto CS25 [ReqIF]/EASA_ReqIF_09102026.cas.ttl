	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1444542175_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305(b)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The effects of deformation are not significant; </div>" ;
