	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(2)(iv).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iv) Have a burner fuel pressure regulator that is adjusted to deliver a nominal 7.6 l/hr (2·0 US gallons/hour) of # 2 Grade kerosene or equivalent.</div>" ;
