	a o:idSpecObject1 ;
	rdfs:label "CS 25.J977(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each finger strainer must be accessible for inspection and cleaning.</div>" ;
