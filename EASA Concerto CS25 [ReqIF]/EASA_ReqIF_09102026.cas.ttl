	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The vertical acceleration sensor is rigidly attached, and located longitudinally either within the approved centre of gravity limits of the aeroplane, or at a distance forward or aft of these limits that does not exceed 25% of the aeroplanes mean aerodynamic chord;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
