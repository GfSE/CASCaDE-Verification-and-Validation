	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(3).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Calorimeter </div>" ;
