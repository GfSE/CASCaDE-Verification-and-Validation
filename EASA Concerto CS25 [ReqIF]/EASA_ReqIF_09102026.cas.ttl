	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(l).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(l) Each forward observer’s seat required by the operating rules must be shown to be suitable for use in conducting the necessary en-route inspections.</div>" ;
