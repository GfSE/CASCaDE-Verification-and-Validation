d:idSpecObject_1931415354_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1549(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each maximum and, if applicable, minimum safe operating limit must be marked with a red radial or a red line;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
