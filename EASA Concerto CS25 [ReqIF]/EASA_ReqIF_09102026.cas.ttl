d:idSpecObject_-1302882791_84
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(h)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) There must be no flame propagation beyond 51 mm (2 inches) to the left of the centerline of the pilot flame application. </div>" ;
