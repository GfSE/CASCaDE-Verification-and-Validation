	o:idTitle1 "Operating limitations" ;
	o:idAmendedBy1 "Amendment 22;" ;
	o:idSection1 "SUBPART G – OPERATING LIMITATIONS AND INFORMATION" ;
	o:idSubsection1 "AEROPLANE FLIGHT MANUAL" ;
	o:ideRules1 "ERULES-1963177438-10109" ;
