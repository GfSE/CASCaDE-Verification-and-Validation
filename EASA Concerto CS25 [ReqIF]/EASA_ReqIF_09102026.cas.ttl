	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1199(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The temperature of each container must be maintained, under intended operating conditions, to prevent the pressure in the container from:</div>" ;
