	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1203(f)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) It is protected against the possibility of false warnings resulting from fires in zones through which it passes; or</div>" ;
