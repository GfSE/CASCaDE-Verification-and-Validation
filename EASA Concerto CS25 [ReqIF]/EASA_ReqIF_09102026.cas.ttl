d:idSpecObject_2021291266_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 30(a)(3).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) procedures must be established and documented in the AFM for restoring the aisle width for taxiing, take-off, and landing. </div>" ;
