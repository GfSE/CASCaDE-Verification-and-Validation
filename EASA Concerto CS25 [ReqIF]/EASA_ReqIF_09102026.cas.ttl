d:idSpecObject_640206105_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.954(b)(3).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Lightning-induced or conducted electrical transients.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
