	rdfs:label "CS 25.1305(a)(2)(iv)(B).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(B) The alert and the fuel quantity indication for that tank are not adversely affected by the same single failure. (See AMC 25.1305(a)(2))</div>" ;
