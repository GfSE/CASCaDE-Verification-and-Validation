d:idSpecObject_-1320806339_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1027(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) If the propeller feathering system depends on engine oil, there must be means to trap an amount of oil in the tank if the supply becomes depleted due to failure of any part of the lubricating system other than the tank itself.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1027" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Propeller feathering system" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8466" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1320806339_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1027(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The amount of trapped oil must be enough to accomplish the feathering operation and must be available only to the feathering pump. (See AMC 25.1027(b).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1027" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Propeller feathering system" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8466" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1320806339_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1027(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The ability of the system to accomplish feathering with the trapped oil must be shown. This may be done on the ground using an auxiliary source of oil for lubricating the engine during operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
