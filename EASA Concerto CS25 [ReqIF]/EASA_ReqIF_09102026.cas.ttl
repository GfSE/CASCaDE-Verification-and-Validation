	a o:idSpecObject1 ;
	rdfs:label "CS 25.788(b)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) each relevant flight and ground load conditions (including the emergency landing conditions prescribed in CS 25.561); </div>" ;
