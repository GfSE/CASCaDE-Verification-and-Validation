d:idSpecObject_1452152415_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Any engine not certificated to CS-E must be shown to comply with CS-E 790 and CS-E 800 or be shown to have a foreign object ingestion service history in similar installation locations which has not resulted in any unsafe condition.</div>" ;
