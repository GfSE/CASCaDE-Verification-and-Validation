	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(6).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) There is a means to record data from which the time of each radio transmission either to or from ATC can be determined;</div>" ;
