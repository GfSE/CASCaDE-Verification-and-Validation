	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-18339" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/001/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2020-01-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_1242372907_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.705(a)(2).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) on-ground, timely, and unambiguous predictive alert(s) of a runway overrun risk. At the option of the applicant, the ROAAS may also provide an automated means of deceleration control that prevents or minimises runway overrun during landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
