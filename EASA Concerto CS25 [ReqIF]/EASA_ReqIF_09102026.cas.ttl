	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1835903365_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.867(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Sub-paragraph (a) of this paragraph does not apply to tail surfaces to the rear of the nacelles that could not be readily affected by heat, flames, or sparks coming from a designated fire zone or engine compartment of any nacelle.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
