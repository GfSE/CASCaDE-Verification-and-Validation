d:idSpecObject_1947832264_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1553.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">If the unusable fuel supply for any tank exceeds 3.8 l (one gallon), or 5% of the tank capacity, whichever is greater, a red arc must be marked on its indicator extending from the calibrated zero reading to the lowest reading obtainable in level flight. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
