d:idSpecObject_896675872_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.997.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">There must be a fuel strainer or filter between the fuel tank outlet and the inlet of either the fuel metering device or an engine driven positive displacement pump, whichever is nearer the fuel tank outlet. This fuel strainer or filter must – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "997" ;
	o:idTitle1 "Fuel strainer or filter" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM COMPONENTS" ;
	o:ideRules1 "ERULES-1963177438-8422" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.997.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_896675872_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.997(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Be accessible for draining and cleaning and must incorporate a screen or element which is easily removable;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "997" ;
	o:idSubref1 "(a)" ;
