d:idSpecObject_-1509662283_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(b)(1).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) If any electrical, pneumatic, hydraulic, or mechanical connecting or transmitting element fails, or if any single source of hydraulic or other brake operating energy supply is lost, it is possible to bring the aeroplane to rest with a braked roll stopping distance of not more than two times that obtained in determining the landing distance as prescribed in CS 25.125.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
