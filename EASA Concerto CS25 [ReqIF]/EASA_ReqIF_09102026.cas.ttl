	a o:idSpecObject1 ;
	rdfs:label "CS 25.509(a)(1).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A vertical load factor equal to 1·0 must be considered acting at the centre of gravity;</div>" ;
