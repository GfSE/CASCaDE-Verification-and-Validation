	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_875000094_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.519(b)(2)(i).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The aeroplane structure must be designed for a vertical load of 1·33 times the vertical reaction at each jacking point acting singly and in combination with a horizontal load of 0·33 times the vertical static reaction applied in any direction.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
