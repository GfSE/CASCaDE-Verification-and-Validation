	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" ;
	cas:lists d:idSpecObject_1541080023_10 .

d:idSpecObject_1541080023_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1091(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) If the engine air intake system contains parts or components that could be damaged by foreign objects entering the air intake, it must be shown by tests or, if appropriate, by analysis that the air intake system design can withstand the foreign object ingestion test conditions of CS-E 790 and CS-E 800 without failure of parts or components that could create a hazard. (See AMC 25.1091(e).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
