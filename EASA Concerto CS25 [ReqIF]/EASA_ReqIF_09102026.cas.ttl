	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a)(8).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) If the recorder is deployable, it complies with CS 25.1457(d)(7).</div>" ;
