d:idSpecObject_1478673283_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(d)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) Design precautions must be taken to minimise the hazards to the aeroplane in the event of an APU rotor failure or of a fire originating within the APU which burns through the APU casing. (See AMC 20-128A.)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
