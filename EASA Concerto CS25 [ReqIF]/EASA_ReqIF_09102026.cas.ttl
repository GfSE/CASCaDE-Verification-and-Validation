	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_640206105_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.954(b)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Swept lightning strokes to areas where swept strokes are highly probable; and</div>" ;
