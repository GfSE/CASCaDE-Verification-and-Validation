	a o:idSpecObject1 ;
	rdfs:label "CS 25.1199(d)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Falling below that necessary to provide an adequate rate of discharge; or</div>" ;
