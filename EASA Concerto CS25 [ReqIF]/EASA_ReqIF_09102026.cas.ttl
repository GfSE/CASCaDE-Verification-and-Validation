d:idSpecObject_-192061252_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Tests</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1436" ;
	o:idSubref1 "(c)" ;
