	a o:idSpecObject1 ;
	rdfs:label "CS 25.1521(c)(4).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Any other parameter for which a limitation has been established as part of the engine type certificate except that a limitation need not be established for a parameter that cannot be exceeded during normal operation due to the design of the installation or to another established limitation.</div>" ;
