	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) By providing an effective combination of resistance to tampering and active tamper-evident features; </div>" ;
