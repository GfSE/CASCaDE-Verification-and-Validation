	a o:idSpecObject1 ;
	rdfs:label "CS 25.601.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The aeroplane may not have design features or details that experience has shown to be hazardous or unreliable. The suitability of each questionable design detail and part must be established by tests. </div>" ;
