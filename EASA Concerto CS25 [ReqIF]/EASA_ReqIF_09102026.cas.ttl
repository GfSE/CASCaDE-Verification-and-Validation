	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d)(8)(i).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The structural element could not fail due to discrete source damage resulting from the conditions described in CS 25.571(e) and CS 25.903(d); and</div>" ;
