d:idSpecObject_1789991084_80_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(0).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Test procedure. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
