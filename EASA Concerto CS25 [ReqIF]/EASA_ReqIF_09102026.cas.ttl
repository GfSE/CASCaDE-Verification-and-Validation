d:idSpecObject_1520688775_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.810(e)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The door, integral stair, and operating mechanism have been subjected to the inertia forces specified in CS 25.561(b)(3), acting separately relative to the surrounding structure.</div>" ;
