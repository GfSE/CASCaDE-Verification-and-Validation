d:idSpecObject_1357185748_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.473(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The landing gear dynamic characteristics must be validated by tests as defined in CS 25.723(a).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
