d:idSpecObject_1575056278_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(d)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The landing gear and directly affected structure must be designed for the maximum vertical ground reaction combined with an aft acting drag component of not less than 25% of this maximum vertical ground reaction.</div>" ;
