d:idSpecObject_767239410_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.967(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.967(a)(3) Fuel tank installation ED Decision 2003/2/RM The installation of a flexible tank and its venting, according to CS 25.975(a)(3) should be such that the tank liner will not be deformed in such a way as to significantly affect the fuel quantity indication.</div>" ;
