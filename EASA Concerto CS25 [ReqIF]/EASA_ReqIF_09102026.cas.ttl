d:idSpecObject_1169978537_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Fluid pressures developed during maximum limit accelerations, and deflections, of the aeroplane with a full tank.</div>" ;
