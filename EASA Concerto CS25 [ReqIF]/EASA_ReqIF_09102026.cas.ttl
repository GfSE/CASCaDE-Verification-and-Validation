d:idSpecObject_1187850300_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(g)(9)(ii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) For a tail cone exit incorporating a floor-level opening of not less than 50.8 cm (20 inches) wide by 152.4 cm (60 inches) high, with corner radii not greater than 17.8 cm (7 inches), in the pressure shell and incorporating an approved assisting means in accordance with CS 25.810(a), 25 additional passenger seats.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "807" ;
	o:idSubref1 "(g)(9)(ii)" ;
	o:idTitle1 "Emergency exits" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-18458" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1187850300_35
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(g)(9)(iii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) For a tail cone exit incorporating an opening in the pressure shell which is at least equivalent to a Type III emergency exit with respect to dimensions, step-up and step-down distance, and with the top of the opening not less than 142.2 cm (56 inches) from the passenger compartment floor, 15 additional passenger seats.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
