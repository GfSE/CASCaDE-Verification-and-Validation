d:idSpecObject_242480181_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1201(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) No material in any fire extinguishing system may react chemically with any extinguishing agent so as to create a hazard.</div>" ;
