	a o:idSpecObject1 ;
	rdfs:label "CS 25.445(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) 80% to the area below (or above) the horizontal surface.</div>" ;
