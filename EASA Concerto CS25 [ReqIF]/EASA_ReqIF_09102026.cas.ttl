	a o:idSpecObject1 ;
	rdfs:label "CS 25.105(b).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) No take-off made to determine the data required by this paragraph may require exceptional piloting skill or alertness.</div>" ;
