d:idSpecObject_-796176447_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1023(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each oil radiator air duct must be located so that, in case of fire, flames coming from normal openings of the engine nacelle cannot impinge directly upon the radiator.</div>" ;
