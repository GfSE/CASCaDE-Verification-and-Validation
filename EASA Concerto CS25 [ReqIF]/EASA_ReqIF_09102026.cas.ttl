	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(h)(2)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) May not be adversely affected by stowage; and</div>" ;
