	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(7)(vi).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(vi) Effects on persons other than aeroplane occupants and on search-and-rescue services are taken into account when assessing the unintended deployment failure condition;</div>" ;
