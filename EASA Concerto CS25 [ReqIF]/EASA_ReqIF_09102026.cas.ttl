	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1189(a)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (2) Oil systems for APU installations in which all external components of the oil system, including the oil tanks, are fireproof.</div>" ;
