	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_1098922692_5_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(c)(0).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The aeroplane must be shown by analysis, test, or both, to be capable of continued safe flight and landing after any of the following failures or jams in the flight control system within the normal flight envelope. In addition, it must be shown that the pilot can readily counteract the effects of any probable failure.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
