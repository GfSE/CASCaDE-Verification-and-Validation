	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_1141067270_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part I(a).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Material test criteria –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part I" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Test Criteria and Procedures for Showing Compliance with CS 25.853, 25.855 or 25.869" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10034" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" ;
