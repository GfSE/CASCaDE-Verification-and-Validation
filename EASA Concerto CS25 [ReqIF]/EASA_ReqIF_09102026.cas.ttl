	a o:idSpecObject1 ;
	rdfs:label "CS 25.773(b)(1)(ii)(A).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(A) For aeroplanes certificated in accordance with CS 25.1420(a)(1), the icing conditions that the aeroplane is certified to safely exit following detection.</div>" ;
