	a o:idSpecObject1 ;
	rdfs:label "CS 25.869(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Components of the electrical system must meet the applicable fire and smoke protection requirements of CS 25.831(c) and CS 25.863. (See AMC 25.863(a).)</div>" ;
