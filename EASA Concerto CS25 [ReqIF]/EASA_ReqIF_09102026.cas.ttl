	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_431726346_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.161(c)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Level flight at any speed from 1·3 VSR1, to VMO/MMO, with the landing gear and wing-flaps retracted, and from 1·3 VSR1 to VLE with the landing gear extended. </div>" ;
