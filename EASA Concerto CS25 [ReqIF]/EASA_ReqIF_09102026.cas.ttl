d:idSpecObject_1098922692_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(c)(3)(i).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The jam must be considered at any normally encountered position of the control surface, or pilot controls;</div>" ;
