d:idSpecObject_326914144_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.485(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For the side load condition, the aeroplane is assumed to be in the level attitude with only the main wheels contacting the ground, in accordance with Figure 5 of Appendix A. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
