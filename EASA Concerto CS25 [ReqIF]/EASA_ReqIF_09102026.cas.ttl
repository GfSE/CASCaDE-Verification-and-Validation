	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(a).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each flight data recorder required by the operating rules must be approved and must be installed so that – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
