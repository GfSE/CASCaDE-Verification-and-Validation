d:idSpecObject_1187850300_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(b).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Step down distance. Step down distance, as used in this paragraph, means the actual distance between the bottom of the required opening and a usable foot hold, extending out from the fuselage, that is large enough to be effective without searching by sight or feel.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
