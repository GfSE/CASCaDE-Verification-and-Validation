d:idSpecObject_1267322594_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1121(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) No exhaust gases may discharge where they will cause a glare seriously affecting pilot vision at night.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
