d:idSpecObject_1067037176_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.820.Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">All lavatory doors must be designed to preclude anyone from becoming trapped inside the lavatory. If a locking mechanism is installed, it must be capable of being unlocked from the outside without the aid of special tools.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "820" ;
	o:idTitle1 "Lavatory doors" ;
