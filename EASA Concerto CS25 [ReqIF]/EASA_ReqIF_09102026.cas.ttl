	a o:idSpecObject1 ;
	rdfs:label "CS 25.105(a)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) In non-icing conditions; and</div>" ;
