d:idSpecObject_-792266652_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(e)(7).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Injection of the specimen and closure of the inner door marks time zero. A continuous record of the thermopile output with at least one data point per second must be made during the time the specimen is in the environmental chamber.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
