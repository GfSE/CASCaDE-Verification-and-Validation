d:idSpecObject_1164303681_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.631.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.631)The aeroplane must be designed to assure capability of continued safe flight and landing of the aeroplane after impact with a 4 lb bird when the velocity of the aeroplane (relative to the bird along the aeroplane’s flight path) is equal to VC at sealevel or 0·85 VC at 2438 m (8000 ft), whichever is the more critical. Compliance may be shown by analysis only when based on tests carried out on sufficiently representative structures of similar design. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "631" ;
	o:idTitle1 "Bird strike damage" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10060" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.631.Amendment 18;" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_2040305464_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.651(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Limit load tests of control surfaces are required. These tests must include the horn or fitting to which the control system is attached.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
