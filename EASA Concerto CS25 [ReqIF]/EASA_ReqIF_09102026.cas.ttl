d:idSpecObject_314120127_2
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1441(a).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) If certification with supplemental oxygen equipment is requested, the equipment must meet the requirements of this paragraph and CS 25.1443 through 25.1453. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
