	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) By tests upon an aeroplane of the type for which certification is requested, or by calculations based on, and equal in accuracy to, the results of testing; and</div>" ;
