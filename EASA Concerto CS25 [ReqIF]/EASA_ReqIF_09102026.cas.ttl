d:idSpecObject_-2014239363_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.345(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Manoeuvring to a positive limit load factor of 2·0; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "345" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "High lift devices" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT MANOEUVRE AND GUST CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-10114" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
