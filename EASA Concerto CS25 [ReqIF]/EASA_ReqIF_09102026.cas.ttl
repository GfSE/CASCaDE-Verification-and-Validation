	a o:idSpecObject1 ;
	rdfs:label "CS 25.1721(a)(2).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Its breakage or failure will not create a fire hazard.</div>" ;
