d:idSpecObject_171137685_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Aeroplanes with a certificated passenger seating capacity of more than 60 persons or a maximum take-off weight of over 45 500 Kg (100 000 lb) must be designed to limit the effects of an explosive or incendiary device as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
