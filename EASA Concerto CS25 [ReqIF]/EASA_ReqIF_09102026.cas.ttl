	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 30(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) all areas of the cabin must be easily accessible by passengers or crew in the event of an emergency situation (e.g. in-flight fire, depressurisation); </div>" ;
