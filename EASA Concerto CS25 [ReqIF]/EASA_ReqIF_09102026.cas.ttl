d:idSpecObject_-1938741407_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.307(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Compliance with the strength and deformation requirements of this Subpart must be shown for each critical loading condition. Structural analysis may be used only if the structure conforms to that for which experience has shown this method to be reliable. In other cases, substantiating tests must be made to load levels that are sufficient to verify structural behaviour up to loads specified in CS 25.305.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
