	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_542900824_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.991.Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "991" ;
	o:idTitle1 "Fuel pumps" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM COMPONENTS" ;
	o:ideRules1 "ERULES-1963177438-9540" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.991.Amendment 5;" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_542900824_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.991(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Main pumps. Each fuel pump required for proper engine operation, or required to meet the fuel system requirements of this Subpart (other than those in sub-paragraph (b) of this paragraph), is a main pump. For each main pump, provision must be made to allow the bypass of each positive displacement fuel pump other than a fuel injection pump approved as part of the engine. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "991" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Fuel pumps" ;
	o:idAmendedBy1 "Amendment 5;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM COMPONENTS" ;
	o:ideRules1 "ERULES-1963177438-9540" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2008/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_542900824_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.991(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Emergency pumps. There must be emergency pumps or another main pump to feed each engine immediately after failure of any main pump. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
