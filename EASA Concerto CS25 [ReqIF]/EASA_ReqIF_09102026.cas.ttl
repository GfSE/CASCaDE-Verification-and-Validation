d:idSpecObject_85639090_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There must be approved, quick acting fire or overheat detectors in each designated fire zone, and in the combustion, turbine, and tailpipe sections of turbine engine installations, in numbers and locations ensuring prompt detection of fire in those zones.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
