	a o:idSpecObject1 ;
	rdfs:label "CS 25.105(d).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The take-off data must include, within the established operational limits of the aeroplane, the following operational correction factors:</div>" ;
