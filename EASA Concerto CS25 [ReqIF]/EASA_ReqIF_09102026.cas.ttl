	a o:idSpecObject1 ;
	rdfs:label "CS 25.809(b)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) With the aeroplane in the normal ground attitude and in each of the attitudes corresponding to collapse of one or more legs of the landing gear; and</div>" ;
