	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(a).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each cockpit voice recorder required by the operating rules must be approved and must be installed so that it will record the following:</div>" ;
