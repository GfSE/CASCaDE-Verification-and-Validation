d:idSpecObject_640206105_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.954(b).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The design and installation of a fuel system must prevent catastrophic fuel vapour ignition due to lightning and its effects, including:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
