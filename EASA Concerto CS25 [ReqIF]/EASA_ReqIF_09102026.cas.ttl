	o:idSubref1 "(a)(5)(iii)" ;
	o:idTitle1 "Rolling conditions" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT MANOEUVRE AND GUST CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-10099" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1955781191_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.349(a)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) For aeroplanes equipped with electronic flight controls, where the motion of the control surfaces does not bear a direct relationship to the motion of the cockpit control devices, in lieu of subparagraphs (a)(2), (a)(3), and (a)(4), the following apply:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
