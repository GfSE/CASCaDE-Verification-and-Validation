d:idSpecObject_1959871857_32
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(7).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Each door for which unlatching would not result in a hazard is not required to have a locking mechanism meeting the requirements of sub-paragraphs (d)(3) through (d)(6) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(d)(7)" ;
	o:idTitle1 "Fuselage Doors" ;
