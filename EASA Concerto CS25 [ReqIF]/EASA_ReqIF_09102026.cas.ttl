	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(l).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(l) The emergency lighting system must be designed so that after any single transverse vertical separation of the fuselage during crash landing:</div>" ;
