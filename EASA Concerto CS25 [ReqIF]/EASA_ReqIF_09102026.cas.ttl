d:idSpecObject_954043391_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.J901(c)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25J901(c)(2) Assembly of Components ED Decision 2005/006/R The objectives of CS 25.671(b) should be satisfied with respect to APU systems, where the safety of the aeroplane could otherwise be jeopardised. [Amdt 25/1]</div>" ;
