d:idSpecObject_-585877381_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(b)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) the detailed minimum instructions to be included in the briefing card must be part of the type design and referred to in the ‘Limitations’ section of the AFM; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
