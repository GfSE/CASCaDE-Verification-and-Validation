	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1350743459_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(e).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) The interiors of compartments, such as pilot compartments, galleys, lavatories, crew rest quarters, cabinets and stowage compartments, need not meet the standards of sub-paragraph (d) of this paragraph, provided the interiors of such compartments are isolated from the main passenger cabin by doors or equivalent means that would normally be closed during an emergency landing condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "853" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 " Compartment interiors" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-9704" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1350743459_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(f).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Smoking is not allowed in lavatories. If smoking is allowed in any area occupied by the crew or passengers, an adequate number of self-contained, removable ashtrays must be provided in designated smoking sections for all seated occupants.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "853" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 " Compartment interiors" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-9704" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1350743459_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(g).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Regardless of whether smoking is allowed in any other part of the aeroplane, lavatories must have self-contained removable ashtrays located conspicuously on or near the entry side of each lavatory door, except that one ashtray may serve more than one lavatory door if the ashtray can be seen readily from the cabin side of each lavatory served.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "853" ;
	o:idSubref1 "(g)" ;
	o:idTitle1 " Compartment interiors" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-9704" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1350743459_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(h).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Each receptacle used for the disposal of flammable waste material must be fully enclosed, constructed of at least fire resistant materials, and must contain fires likely to occur in it under normal use. The ability of the receptacle to contain those fires under all probable conditions of wear, misalignment, and ventilation expected in service must be demonstrated by test.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "853" ;
	o:idSubref1 "(h)" ;
	o:idTitle1 " Compartment interiors" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-9704" ;
