	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) An automatic shut-off means must be provided to prevent the quantity of fuel in each tank from exceeding the maximum quantity approved for that tank. This means must –</div>" ;
