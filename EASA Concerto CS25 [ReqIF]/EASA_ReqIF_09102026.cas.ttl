	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Each pneumatic element must be installed and supported to prevent excessive vibration, abrasion, corrosion, and mechanical damage, and to withstand inertia loads.</div>" ;
