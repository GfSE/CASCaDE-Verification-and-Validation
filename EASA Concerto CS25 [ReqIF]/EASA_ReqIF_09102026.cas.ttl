d:idSpecObject_-936042545_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.235.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The shock absorbing mechanism may not damage the structure of the aeroplane when the aeroplane is taxied on the roughest ground that may reasonably be expected in normal operation. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
