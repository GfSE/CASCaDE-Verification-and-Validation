	a o:idSpecObject1 ;
	rdfs:label "CS 25.101(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Unless otherwise prescribed, the applicant must select the take-off, en-route, approach, and landing configuration for the aeroplane.</div>" ;
