d:idSpecObject_1370083084_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(j)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The aeroplane is controllable in a pull-up manoeuvre up to 1.5 g load factor; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
