	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(7)(v).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(v) An assessment of the effects of unintended deployment is made in accordance with the specifications of CS 25.1309;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
