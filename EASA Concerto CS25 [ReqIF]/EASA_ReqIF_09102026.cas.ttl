d:idSpecObject_779656215_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.321(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) At each weight from the design minimum weight to the design maximum weight appropriate to each particular flight load condition; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
