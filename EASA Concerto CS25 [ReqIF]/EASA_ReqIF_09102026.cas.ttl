d:idSpecObject_896675872_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.997(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Be accessible for draining and cleaning and must incorporate a screen or element which is easily removable;</div>" ;
