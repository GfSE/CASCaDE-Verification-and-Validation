	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(f)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) May be included as an additional means of deceleration using recommended reverse thrust procedures when determining the accelerate-stop distance on a wet runway, provided the requirements of sub-paragraph (e) of this paragraph are met. (See AMC 25.109(f).)</div>" ;
