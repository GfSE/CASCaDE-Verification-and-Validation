d:idSpecObject_-961563324_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.819(f).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) For each occupant permitted in a lower deck service compartment, there must be a forward or aft facing seat, which meets the requirements of CS 25.785(d) and must be able to withstand maximum flight loads when occupied.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
