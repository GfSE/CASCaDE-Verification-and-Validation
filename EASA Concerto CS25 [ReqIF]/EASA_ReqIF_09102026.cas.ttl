	o:ideRules1 "ERULES-1963177438-9470" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2007/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2007-09-19T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2007-09-19T00:00:00Z" .

d:idSpecObject_-225946946_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.721(b)(1).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Impact at 1.52 m/s (5 fps) vertical velocity, with the aeroplane under control, at Maximum Design Landing Weight, </div>" ;
