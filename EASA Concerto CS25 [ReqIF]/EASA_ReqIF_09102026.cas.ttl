d:idSpecObject_1651683409_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(7).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Repeat (f)(1) to ensure that the burner is in the correct range.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
