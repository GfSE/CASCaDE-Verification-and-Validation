	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_-1753834034_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.121(b)(1)(ii).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) The weight equal to the weight existing when the aeroplane’s landing gear is fully retracted, determined under CS 25.111.</div>" ;
