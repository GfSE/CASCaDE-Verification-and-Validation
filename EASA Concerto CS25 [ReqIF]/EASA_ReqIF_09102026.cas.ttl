	a o:idSpecObject1 ;
	rdfs:label "CS 25.1703(c).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The design and installation of the main power cables, including generator cables, in the fuselage must allow for a reasonable degree of deformation and stretching without failure.</div>" ;
