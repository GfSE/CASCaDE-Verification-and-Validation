	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-2062423000_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(d).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) It must be shown that the fuel tank pressures will remain within limits during normal operating conditions and failure conditions.</div>" ;
