d:idSpecObject_2013342590_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1381(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Provide sufficient illumination to make each instrument, switch and other device necessary for safe operation easily readable unless sufficient illumination is available from another source; and</div>" ;
