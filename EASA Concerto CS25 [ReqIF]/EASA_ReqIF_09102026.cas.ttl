	a o:idSpecObject1 ;
	rdfs:label "CS 25.161(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Longitudinal trim. The aeroplane must maintain longitudinal trim during – </div>" ;
