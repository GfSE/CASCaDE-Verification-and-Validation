d:idSpecObject_856076457_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1527.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The extremes of the ambient air temperature and operating altitude for which operation is allowed, as limited by flight, structural, powerplant, functional, or equipment characteristics, must be established. </div>" ;
