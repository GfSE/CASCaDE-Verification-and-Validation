d:idSpecObject_-585877381_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(b).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Briefing Card Placard: for non-commercially operated aeroplanes, the instructions required by CS 25.1541 for properly setting the cabin in its configuration approved for taxiing, take-off, and landing may alternatively be provided by a reduced number of placards, each one referring to a briefing card. In that case (See AMC to Appendix S, S25.40(b)):</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
