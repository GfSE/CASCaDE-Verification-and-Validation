	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(l)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) the percentage of electrically illuminated emergency lights required by this paragraph which are rendered inoperative, in addition to the lights that are directly damaged by the separation, does not exceed the values set in the following table (See AMC 25.812(l)(1)): </div>" ;
