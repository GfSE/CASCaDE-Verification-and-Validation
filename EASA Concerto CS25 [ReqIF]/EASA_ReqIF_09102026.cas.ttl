	a o:idSpecObject1 ;
	rdfs:label "CS 25.1585(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Emergency procedures for foreseeable but unusual situations in which immediate and precise action by the crew may be expected to substantially reduce the risk of catastrophe.</div>" ;
