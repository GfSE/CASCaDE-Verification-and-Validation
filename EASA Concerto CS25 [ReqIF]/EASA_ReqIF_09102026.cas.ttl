	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(d).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The alert function must be designed to minimise the effects of false and nuisance alerts. In particular, it must be designed to:</div>" ;
