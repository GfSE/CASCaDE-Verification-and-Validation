d:idSpecObject_1082908761_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each engine installation and each fire zone specified in CS 25.1181(a)(5) must have a means to shut off or otherwise prevent hazardous quantities of fuel, oil, de-icer, and other flammable fluids, from flowing into, within, or through any designated fire zone, except that shutoff means are not required for –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
