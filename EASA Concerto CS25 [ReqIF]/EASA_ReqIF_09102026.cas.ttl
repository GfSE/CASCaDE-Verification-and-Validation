	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(B).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(B) The standardized transducer must meet the specifications given in paragraph (b)(6) of Part VI of this Appendix.</div>" ;
