d:idSpecObject_-2102244434_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A flight crew alert is provided, before the start of taxiing, if damage may have occurred (see AMC 25.1322). (See AMC 25.745(d))</div>" ;
