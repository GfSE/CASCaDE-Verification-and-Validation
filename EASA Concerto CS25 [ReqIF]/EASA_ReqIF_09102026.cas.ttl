	o:idSubref1 "(a)" ;
	o:idTitle1 "Speed control devices" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "SUPPLEMENTARY CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-9392" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-1124846704_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.373(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) If the device has automatic operating or load limiting features, the aeroplane must be designed for the manoeuvre and gust conditions prescribed in sub-paragraph (a) of this paragraph, at the speeds and corresponding device positions that the mechanism allows.</div>" ;
