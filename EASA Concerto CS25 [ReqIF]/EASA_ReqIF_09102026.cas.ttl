d:idSpecObject_349408889_1
	a o:idSpecObject1 ;
	rdfs:label "CS 25.933(0).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii)It can be demonstrated that any in-flight thrust reversal complies with CS 25.1309(b).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "933" ;
	o:idSubref1 "(0)" ;
	o:idTitle1 "Reversing systems" ;
	o:idAmendedBy1 "Amendment 24;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-18318" ;
	SpecIF:Domain "Initial airworthiness;" ;
