	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(2)(iii).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Have a 31 cm (12 inch) burner extension installed at the end of the draft tube with an opening 15 cm (6 inches) high and 28 cm (11 inches) wide as shown in Figure 3 of Part II of this Appendix.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(2)(iii)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(2)(iv).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iv) Have a burner fuel pressure regulator that is adjusted to deliver a nominal 7.6 l/hr (2·0 US gallons/hour) of # 2 Grade kerosene or equivalent.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(2)(iv)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(3).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Calorimeter </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(3)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(3)(i).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The calorimeter to be used in testing must be a total heat flux Foil Type Gardon Gauge of an appropriate range, approximately 0–17·0 Watts/cm2 (0 to 15·0 BTU per ft2 sec). The calorimeter must be mounted in a 15 by 31 cm (6 inch by 12 inch) by 19 mm (0·75 of an inch) thick insulating block which is attached to a steel angle bracket for placement in the test stand during burner calibration as shown in Figure 2 of this Part of this Appendix.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(3)(i)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(3)(ii).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) The insulating block must be monitored for deterioration and the mounting shimmed as necessary to ensure that the calorimeter face is parallel to the exit plane of the test burner cone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(3)(ii)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(4).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Thermocouples. The seven thermocouples to be used for testing must be 1.59 mm (0·0625 of an inch) ceramic sheathed, type K, grounded thermocouples with a nominal 30 American wire gauge (AWG)-size conductor 0·254 mm (0·010 inches) diameter). The seven thermocouples must be attached to a steel angle bracket to form a thermocouple rake for placement in the stand during burner calibration as shown in Figure 3 of this Part of this Appendix. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(4)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(5).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Apparatus Arrangement. The test burner must be mounted on a suitable stand to position the exit of the burner cone a distance of 20 cm (8 inches) from the ceiling liner panel and 50 mm (2 inches) from the sidewall liner panel. The burner stand should have the capability of allowing the burner to be swung away from the test specimen during warm-up periods. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(5)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(6).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Instrumentation. A recording potentiometer or other suitable instrument with an appropriate range must be used to measure and record the outputs of the calorimeter and the thermocouples. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(6)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(d)(7).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Timing Device. A stopwatch or other device must be used to measure the time of flame application and the time of flame penetration, if it occurs. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(d)(7)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(e).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Preparation of Apparatus. Before calibration, all equipment must be turned on and allowed to stabilize, and the burner fuel flow must be adjusted as specified in sub-paragraph (d)(2). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_26
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Calibration. To ensure the proper thermal output of the burner the following test must be made: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(1).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Remove the burner extension from the end of the draft tube. Turn on the blower portion of the burner without turning the fuel or igniters on. Measure the air velocity using a hot wire anemometer in the centre of the draft tube across the face of the opening. Adjust the damper such that the air velocity is in the range of 7.9 m/s to 9.1 m/s (1550 to 1800 ft/min). If tabs are being used at the exit of the draft tube, they must be removed prior to this measurement. Reinstall the draft tube extension cone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(f)(1)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(2).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Place the calorimeter on the test stand as shown in Figure 2 at a distance of 20 cm (8 inches) from the exit of the burner cone to simulate the position of the horizontal test specimen.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(f)(2)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(3).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Turn on the burner, allow it to run for 2 minutes for warm-up, and adjust the damper to produce a calorimeter reading of 9·1 ± 0·6 Watts/cm2 (8·0 ± 0·5 BTU per ft2 sec).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(f)(3)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_30
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(4).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Replace the calorimeter with the thermocouple rake (see Figure 3).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(f)(4)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_31
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(5).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Turn on the burner and ensure that each of the seven thermocouples reads 927°C ± 38°C (1700°F ± 100°F) to ensure steady state conditions have been achieved. If the temperature is out of this range, repeat steps 2 through 5 until proper readings are obtained.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(f)(5)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_32
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(f)(6).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Turn off the burner and remove the thermocouple rake.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
