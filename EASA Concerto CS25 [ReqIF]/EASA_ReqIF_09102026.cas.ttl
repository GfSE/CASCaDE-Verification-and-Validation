	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(e)(6).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Reserved.</div>" ;
