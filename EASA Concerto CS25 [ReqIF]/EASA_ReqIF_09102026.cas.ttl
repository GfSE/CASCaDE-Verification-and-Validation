d:idSpecObject_-718172015_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.231(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Aeroplanes may have no uncontrollable tendency to nose over in any reasonably expected operating condition or when rebound occurs during landing or take-off. In addition –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
