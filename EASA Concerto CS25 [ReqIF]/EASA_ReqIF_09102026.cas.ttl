	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(b)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The system voltage and frequency (as applicable) at the terminals of all essential load equipment can be maintained within the limits for which the equipment is designed, during any probable operating condition;</div>" ;
