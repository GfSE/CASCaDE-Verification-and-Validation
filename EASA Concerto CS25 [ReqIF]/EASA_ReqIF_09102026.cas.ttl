	a o:idSpecObject1 ;
	rdfs:label "CS 25.473(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a)For the landing conditions specified in CS 25.479 to 25.485, the aeroplane is assumed to contact the ground:</div>" ;
