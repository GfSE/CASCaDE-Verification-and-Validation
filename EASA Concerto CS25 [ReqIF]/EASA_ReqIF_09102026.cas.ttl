	a o:idSpecObject1 ;
	rdfs:label "CS 25.1141(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each control must be able to maintain any set position without constant attention by flight-crew members and without creep due to control loads or vibration.</div>" ;
