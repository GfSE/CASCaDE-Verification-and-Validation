d:idSpecObject_-1201838289_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.353(a).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) With the aeroplane in un-accelerated flight at zero yaw, it is assumed that the cockpit rudder control is suddenly and fully displaced to achieve the resulting rudder deflection, as limited by the control system or the control surface stops.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "353" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 " Rudder control reversal conditions" ;
	o:idAmendedBy1 "Amendment 22;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT MANOEUVRE AND GUST CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-15419" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2018/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2018-11-07T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-11-07T00:00:00Z" .

d:idSpecObject_-1201838289_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.353(b).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) With the aeroplane yawed to the overswing sideslip angle, it is assumed that the cockpit rudder control is suddenly and fully displaced in the opposite direction to achieve the resulting rudder deflection, as limited by the control system or the control surface stops.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
