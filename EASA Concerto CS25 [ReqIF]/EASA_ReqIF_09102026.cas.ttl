d:idSpecObject_-749083209_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(f)(3)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Each belt or harness to the seat or structure; a multiplication factor of 1·33 instead of the fitting factor as defined in CS 25.625 should be used for the inertia forces specified in CS 25.561. (For the lateral forces according to CS 25.561(b)(3) 1·33 times 3·0 g should be used.)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
