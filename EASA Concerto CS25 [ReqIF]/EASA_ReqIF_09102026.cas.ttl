	a o:idSpecObject1 ;
	rdfs:label "CS 25.373.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">If speed control devices (such as spoilers and drag flaps) are installed for use in en-route conditions:</div>" ;
