	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d)(3).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) For aeroplanes not approved for operation in icing conditions, the maximum likely ice accumulation expected as a result of an inadvertent encounter.</div>" ;
