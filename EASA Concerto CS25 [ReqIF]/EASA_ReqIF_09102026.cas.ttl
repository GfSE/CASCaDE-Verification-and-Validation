d:idSpecObject_-1456217317_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.854.Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.854)For aeroplanes with a passenger capacity of 20 or more, or with a cabin length of 18.29 m (60 ft) or more:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
