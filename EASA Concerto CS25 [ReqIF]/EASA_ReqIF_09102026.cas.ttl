	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_43
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(g)(6).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Expose the seat bottom cushion specimen to the burner flame for 2 minutes and then turn off the burner. Immediately swing the burner away from the test position. Terminate test 7 minutes after initiating cushion exposure to the flame by use of an appropriate gaseous extinguishing agent.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
