	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(b)(3).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) For failure conditions in those systems covered by CS 25.302, the margins defined in Appendix K of CS-25 apply.</div>" ;
