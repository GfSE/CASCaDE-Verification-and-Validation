d:idSpecObject_1892022917_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 3(e).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) The landing distance data must include correction factors for not more than 50 % of the nominal wind components along the landing path opposite to the direction of landing, and not less than 150 % of the nominal wind components along the landing path in the direction of landing.</div>" ;
