	rdfs:label "CS 25.101(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Unless otherwise prescribed, aeroplanes must meet the applicable performance requirements of this Subpart for ambient atmospheric conditions and still air.</div>" ;
