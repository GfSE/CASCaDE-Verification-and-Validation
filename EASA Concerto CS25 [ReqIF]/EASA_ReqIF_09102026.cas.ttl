d:idSpecObject_1805953230_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(d)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Airfoils, control surfaces and, if applicable, propellers are free from frost, snow, or ice at the start of the take-off; </div>" ;
