	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each part of any ventilating duct passing through any region having a flammable fluid system must be constructed or isolated from that system so that the malfunctioning of any component of that system cannot introduce flammable fluids or vapours into the ventilating airstream.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
