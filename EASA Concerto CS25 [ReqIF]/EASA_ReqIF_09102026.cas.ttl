d:idSpecObject_306483869_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1187(a)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (2) Arranged so that no discharged fluid will cause an additional fire hazard.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
