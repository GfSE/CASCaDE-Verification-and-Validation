	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx O Part II(f).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) The ice accretion that has the most adverse effect on handling qualities may be used for aeroplane performance tests provided any difference in performance is conservatively taken into account.</div>" ;
