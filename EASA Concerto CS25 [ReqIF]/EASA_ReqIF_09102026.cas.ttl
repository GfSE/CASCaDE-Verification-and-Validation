	a o:idSpecObject1 ;
	rdfs:label "CS 25.1439(b)(2)(ii).Amendment 4;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Masks covering the nose and mouth, plus accessory equipment to cover the eyes.</div>" ;
