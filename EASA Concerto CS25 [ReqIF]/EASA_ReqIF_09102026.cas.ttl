d:idSpecObject_-1092025642_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If the recorder has a recording duration of less than 25 hours, there is an automatic means to stop the recording within 10 minutes after crash impact;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
