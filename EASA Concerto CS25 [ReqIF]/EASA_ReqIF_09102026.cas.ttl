d:idSpecObject_-348525131_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1141(d)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) Each control must be located so that it cannot be inadvertently operated by persons entering, leaving, or moving normally in the area of the control; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
