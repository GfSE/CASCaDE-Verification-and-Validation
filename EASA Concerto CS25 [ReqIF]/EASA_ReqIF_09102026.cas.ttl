	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(6)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Based on the survey, the fatigue strength of that part of the system is substantiated by analysis or tests, or both.</div>" ;
