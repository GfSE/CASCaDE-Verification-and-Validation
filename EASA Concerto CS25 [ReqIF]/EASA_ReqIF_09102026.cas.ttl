	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(h)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) If melting, sagging, delaminating, or other behaviour that affects the exposed surface area or the mode of burning occurs, these behaviours must be reported, together with the time at which such behaviours were observed.</div>" ;
