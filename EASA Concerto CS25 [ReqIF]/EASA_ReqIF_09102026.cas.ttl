	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(d)(4).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) during the ground phase, the aeroplane can be stopped.</div>" ;
