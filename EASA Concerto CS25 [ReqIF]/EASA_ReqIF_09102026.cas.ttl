d:idSpecObject_1541080023_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1091(d)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The aeroplane must be designed to prevent water or slush on the runway, taxiway, or other airport operating surfaces from being directed into the engine air intake ducts in hazardous quantities, and the air intake ducts must be located or protected so as to minimise the ingestion of foreign matter during take-off, landing and taxying. (See AMC 25.1091(d)(2).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1091" ;
