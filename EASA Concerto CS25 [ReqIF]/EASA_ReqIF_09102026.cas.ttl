d:idSpecObject_1152054989_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1189(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The closing of any fuel shut-off valve for any APU may not make fuel unavailable to the main engines.</div>" ;
