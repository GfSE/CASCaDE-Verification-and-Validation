d:idSpecObject_-792266652_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(d)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The standard size for vertically mounted specimens is 150 x 150 mm with thicknesses up to 45 mm.</div>" ;
