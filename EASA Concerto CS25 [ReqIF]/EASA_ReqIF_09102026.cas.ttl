	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) 1·23 VSR0 to VFE with wing-flaps in the landing position.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
