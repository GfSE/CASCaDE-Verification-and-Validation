d:idSpecObject_-1674997375_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.934.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Thrust reversers installed on turbo-jet engines must meet the requirements of CS-E 890. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "934" ;
	o:idTitle1 "Turbo-jet engine thrust reverser system tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-8310" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
