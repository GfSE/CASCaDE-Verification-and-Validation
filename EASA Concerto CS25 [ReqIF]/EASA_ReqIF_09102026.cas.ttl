	a o:idSpecObject1 ;
	rdfs:label "CS 25.1141(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each control must be located so that it cannot be inadvertently operated by persons entering, leaving, or moving normally in, the cockpit.</div>" ;
