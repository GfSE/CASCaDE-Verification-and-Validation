d:idSpecObject_-900117897_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.945(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. Each fluid injection system must provide a flow of fluid at the rate and pressure established for proper engine functioning under each intended operating condition. If the fluid can freeze, fluid freezing may not damage the aeroplane or adversely affect aeroplane performance. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
