	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1954884424_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1387(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Dihedral angle A (aft) is formed by two intersecting vertical planes making angles of 70 o to the right and to the left, respectively, to a vertical plane passing through the longitudinal axis, as viewed when looking aft along the longitudinal axis.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1387" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Position light system dihedral angles" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8717" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1954884424_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1387(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) If the rear position light when mounted as far aft as practicable in accordance with CS 25.1385(c), cannot show unbroken light within dihedral angle A (as defined in sub-paragraph (d) of this paragraph), a solid angle or angles of obstructed visibility totalling not more than 0·04 steradians is allowable within that dihedral angle, if such solid angle is within a cone whose apex is at the rear position light and whose elements make an angle of 30 o with a vertical line passing through the rear position light. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1387" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Position light system dihedral angles" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "LIGHTS" ;
	o:ideRules1 "ERULES-1963177438-8717" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
