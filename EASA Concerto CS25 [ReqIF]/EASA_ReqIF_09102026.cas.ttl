d:idSpecObject_2093360209_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(d)(1).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The stowage provisions for the liferafts described in CS 25.1415 must accommodate enough rafts for the maximum number of occupants for which certification for ditching is requested.</div>" ;
