d:idSpecObject_1179356299_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.503(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The aeroplane is assumed to pivot about one side of the main gear with the brakes on that side locked. The limit vertical load factor must be 1·0 and the coefficient of friction 0·8.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
