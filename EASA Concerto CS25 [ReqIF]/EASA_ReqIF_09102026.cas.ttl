d:idSpecObject_-2055202981_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.203.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.203.)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "203" ;
	o:idTitle1 "Stall characteristics" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "STALLS" ;
	o:ideRules1 "ERULES-1963177438-8292" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.203.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-2055202981_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.203(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) It must be possible to produce and to correct roll and yaw by unreversed use of aileron and rudder controls, up to the time the aeroplane is stalled. No abnormal nose-up pitching may occur. The longitudinal control force must be positive up to and throughout the stall. In addition, it must be possible to promptly prevent stalling and to recover from a stall by normal use of the controls.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "203" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Stall characteristics" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "STALLS" ;
	o:ideRules1 "ERULES-1963177438-8292" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-2055202981_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.203(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For level wing stalls, the roll occurring between the stall and the completion of the recovery may not exceed approximately 20°.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
