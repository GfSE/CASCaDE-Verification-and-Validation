	o:idTitle1 "Runway overrun awareness and alerting systems" ;
	o:idAmendedBy1 "Amendment 24;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-18339" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/001/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2020-01-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_1242372907_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.705(a).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) During approach (from a given height above the selected runway) and landing, the ROAAS shall perform real-time energy-based calculations of the predicted landing stopping point, compare that point with the location of the end of the runway, and provide the flight crew with:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
