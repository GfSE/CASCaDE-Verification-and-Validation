	a o:idSpecObject1 ;
	rdfs:label "CS 25.1549(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each engine or propeller speed range that is restricted because of excessive vibration stresses must be marked with red arcs or red lines.</div>" ;
