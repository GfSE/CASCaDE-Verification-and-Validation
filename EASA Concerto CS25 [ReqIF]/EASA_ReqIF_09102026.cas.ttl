	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 5(b)(2).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The rate of descent must be reduced to 3 feet per second or less before touchdown; </div>" ;
