	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_49
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(7)(ii)(F).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(F) enter the 2 transducers on opposite sides of the plates at equal distances from the plate.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
