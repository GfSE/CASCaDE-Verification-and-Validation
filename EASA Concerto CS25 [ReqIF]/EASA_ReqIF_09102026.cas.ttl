d:idSpecObject_-1724052015_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d)(4).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Failure of any single element of the structure supporting any engine, independently mounted propeller shaft, large auxiliary power unit, or large externally mounted aerodynamic body (such as an external fuel tank).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
