d:idSpecObject_1216410122_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1185(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) No tank or reservoir that is a part of a system containing flammable fluids or gases may be in a designated fire zone unless the fluid contained, the design of the system, the materials used in the tank, the shut-off means, and all connections, lines and controls provide a degree of safety equal to that which would exist if the tank or reservoir were outside such a zone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1185" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Flammable fluids" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8554" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1216410122_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1185(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) There must be at least 13 mm (0·5 inches) of clear airspace between each tank or reservoir and each firewall or shroud isolating a designated fire zone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1185" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Flammable fluids" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-8554" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1216410122_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1185(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Absorbent materials close to flammable fluid system components that might leak must be covered or treated to prevent the absorption of hazardous quantities of fluids.</div>" ;
