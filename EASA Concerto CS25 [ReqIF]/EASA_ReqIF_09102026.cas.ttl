d:idSpecObject_-1070920956_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(e).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Any novel or unique design or operational characteristics of the aeroplane must be evaluated to determine if any dedicated parameters must be recorded on the flight data recorder in addition to, or in place of, the parameters that are required by the existing requirements.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
