	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(e).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) One of the following methods of icing detection and activation of the airframe ice protection system must be provided: </div>" ;
