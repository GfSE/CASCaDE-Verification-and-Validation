d:idSpecObject_1169978537_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) An internal pressure of 24 kPa (3·5 psi).</div>" ;
