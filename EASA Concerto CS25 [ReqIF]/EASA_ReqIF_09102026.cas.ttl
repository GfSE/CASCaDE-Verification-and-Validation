d:idSpecObject_-1996925683_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1365(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Domestic appliances must be so designed and installed that in the event of failures of the electrical supply or control system, the requirements of CS 25.1309(b) and (c) will be satisfied.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1365" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Electrical appliances, motors and transformers" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10197" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1996925683_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1365(b).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The installation of galleys and cooking appliances must be such as to minimise the risk of overheat, fire, burns, or spilled liquids to the aeroplane, passengers, and crew (See AMC 25.1365(b)).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1365" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Electrical appliances, motors and transformers" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10197" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1996925683_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1365(c).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Domestic appliances, particularly those in galley areas, must be so installed or protected as to prevent damage or contamination of other equipment or systems from fluids or vapours which may be present during normal operation or as a result of spillage, where such damage or contamination may hazard the aeroplane.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1365" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Electrical appliances, motors and transformers" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10197" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1996925683_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1365(d).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Unless it can be shown that compliance with CS 25.1309(b) is provided by the circuit protective device required by CS 25.1357(a), electric motors and transformers etc. (including those installed in domestic systems, such as galleys and toilet flush systems) must be provided with a suitable thermal protection device if necessary to prevent them overheating such as to create a smoke or fire hazard under normal operation and failure conditions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
