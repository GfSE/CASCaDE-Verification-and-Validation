	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "SUPPLEMENTARY CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-10153" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-920989927_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.365(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The external pressure distribution in flight, and stress concentrations and fatigue effects must be accounted for.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
