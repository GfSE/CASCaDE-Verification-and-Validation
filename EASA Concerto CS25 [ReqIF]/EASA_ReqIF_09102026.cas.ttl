d:idSpecObject_62663563_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1555(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each cockpit control, other than primary flight controls and controls whose function is obvious, must be plainly marked as to its function and method of operation.</div>" ;
