d:idSpecObject_-442894939_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(g).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) The effects of airspeed indicating system lag may not introduce significant takeoff indicated airspeed bias, or significant errors in takeoff or accelerate-stop distances.</div>" ;
