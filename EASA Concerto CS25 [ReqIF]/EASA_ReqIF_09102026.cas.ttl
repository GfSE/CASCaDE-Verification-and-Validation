	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Fuel tanks must, so far as it is practicable, be designed, located and installed so that no fuel is released in or near the fuselage or near the engines in quantities sufficient to start a serious fire in otherwise survivable emergency landing conditions, and:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
