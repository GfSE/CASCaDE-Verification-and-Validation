	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-613333795_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419.Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1419)If the applicant seeks certification for flight in icing conditions, the aeroplane must be able to safely operate in the continuous maximum and intermittent maximum icing conditions of Appendix C. To establish this–</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1419" ;
	o:idTitle1 "Ice Protection" ;
	o:idAmendedBy1 "Amendment 7;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "SAFETY EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-9611" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1419.Amendment 7;" ;
	o:idApplicabilityDate1 "2009-10-21T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-10-21T00:00:00Z" .

d:idSpecObject_-613333795_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(a).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) An analysis must be performed to establish that the ice protection for the various components of the aeroplane is adequate, taking into account the various aeroplane operational configurations; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1419" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Ice Protection" ;
	o:idAmendedBy1 "Amendment 7;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "SAFETY EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-9611" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-10-21T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-10-21T00:00:00Z" .

d:idSpecObject_-613333795_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(b).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) To verify the ice protection analysis, to check for icing anomalies, and to demonstrate that the ice protection system and its components are effective, the aeroplane or its components must be flight tested in the various operational configurations, in measured natural atmospheric icing conditions, and as found necessary, by one or more of the following means:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1419" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Ice Protection" ;
	o:idAmendedBy1 "Amendment 7;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "SAFETY EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-9611" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-10-21T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-10-21T00:00:00Z" .

d:idSpecObject_-613333795_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(b)(1).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Laboratory dry air or simulated icing tests, or a combination of both, of the components or models of the components.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
