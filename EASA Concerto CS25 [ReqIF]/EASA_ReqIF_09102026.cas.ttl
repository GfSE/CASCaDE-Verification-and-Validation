d:idSpecObject_945042841_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 7(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) System Control and Monitoring. A means must be provided to indicate when the ATTCS system is in the armed or ready condition. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
