d:idSpecObject_-278040378_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(d)(4).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Effects of failures of the FRM that could increase the flammability exposure of the fuel tank,</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
