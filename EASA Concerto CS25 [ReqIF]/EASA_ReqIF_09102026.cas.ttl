	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1045(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Cooling tests for each critical condition must be continued until:</div>" ;
