d:idSpecObject_1651683409_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(a)(2).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each specimen tested must simulate the cargo compartment sidewall or ceiling liner panel, including any design features, such as joints, lamp assemblies, etc., the failure of which would affect the capability of the liner to safely contain a fire.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(a)(3).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) There must be no flame penetration of any specimen within 5 minutes after application of the flame source, and the peak temperature measured at 10 cm (4 inches) above the upper surface of the horizontal test sample must not exceed 204oC (400oF).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(a)(3)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9624" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/017/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-12-18T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-12-18T00:00:00Z" .

d:idSpecObject_1651683409_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(b).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Summary of Method. This method provides a laboratory test procedure for measuring the capability of cargo compartment lining materials to resist flame penetration within a 7.6 l/hr (2 US gallons/hour) # 2 Grade kerosene or equivalent burner fire source. Ceiling and sidewall liner panels may be tested individually provided a baffle is used to simulate the missing panel. Any specimen that passes the test as a ceiling liner panel may be used as a sidewall liner panel. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part III" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Test Method to Determine Flame Penetration Resistance of Cargo Compartment Liners" ;
	o:idAmendedBy1 "Amendment 8;" ;
