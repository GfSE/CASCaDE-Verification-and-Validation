	o:idApplicabilityDate1 "2008-09-05T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2008-09-05T00:00:00Z" .

d:idSpecObject_459389398_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1711(b)(1).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The identification must be placed along the wire, cable or wire bundles at appropriate intervals and in areas of the aeroplane so they are readily visible to maintenance, repair, or alteration personnel. </div>" ;
