	rdfs:label "CS 25.1423(f).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Be accessible for immediate use from each of two flight-crew member stations in the pilot compartment.</div>" ;
