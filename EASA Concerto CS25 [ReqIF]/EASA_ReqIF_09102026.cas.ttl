	a o:idSpecObject1 ;
	rdfs:label "CS 25.485.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">In addition to CS 25.479(d)(2) the following conditions must be considered: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
