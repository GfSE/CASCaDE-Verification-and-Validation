	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(c)(0).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Test specimens. </div>" ;
