d:idSpecObject_-215517561_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.125(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) The landing distance data must include correction factors for not more than 50% of the nominal wind components along the landing path opposite to the direction of landing, and not less than 150% of the nominal wind components along the landing path in the direction of landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
