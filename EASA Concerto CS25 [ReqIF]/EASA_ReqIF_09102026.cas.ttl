	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-10-21T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-10-21T00:00:00Z" .

d:idSpecObject_-613333795_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(b)(2).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Flight dry air tests of the ice protection system as a whole, or of its individual components.</div>" ;
