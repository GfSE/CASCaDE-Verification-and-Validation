	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(b)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For aeroplanes with three or more engines, the sudden failure of the second critical engine when the aeroplane is in the en-route, approach, or landing configuration and is trimmed with the critical engine inoperative; and</div>" ;
