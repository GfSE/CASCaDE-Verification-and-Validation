	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_552252819_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(d).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (d) The take-off path must be determined by a continuous demonstrated take-off or by synthesis from segments. If the take-off path is determined by the segmental method –</div>" ;
