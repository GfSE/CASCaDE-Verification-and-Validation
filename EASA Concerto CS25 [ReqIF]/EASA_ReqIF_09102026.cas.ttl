	a o:idSpecObject1 ;
	rdfs:label "CS 25.1103(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each duct connected to components between which relative motion could exist must have means for flexibility.</div>" ;
