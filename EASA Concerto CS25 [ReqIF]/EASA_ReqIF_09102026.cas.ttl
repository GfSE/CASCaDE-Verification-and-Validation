	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-18459" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_640206105_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.954(a)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A fuel system includes any component within either the fuel tank structure or the fuel tank systems, and any aeroplane structure or system components that penetrate, connect to, or are located within a fuel tank.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
