d:idSpecObject_-2124219872_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.613(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Material strength properties must be based on enough tests of material meeting approved specifications to establish design values on a statistical basis.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
