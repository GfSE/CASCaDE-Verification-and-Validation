d:idSpecObject_1805953230_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(b).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) In order to reduce the number of ice accretions to be considered when demonstrating compliance with the requirements of paragraph CS 25.21(g), any of the ice accretions defined in sub-paragraph (a) of this section may be used for any other flight phase if it is shown to be more critical than the specific ice accretion defined for that flight phase. Configuration differences and their effects on ice accretions must be taken into account.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
