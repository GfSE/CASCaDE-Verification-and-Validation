	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 1(a)(2)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) up to and including one third of the maximum passenger seating capacity of the type-certified aeroplane as indicated in the aeroplane TCDS, provided that:</div>" ;
