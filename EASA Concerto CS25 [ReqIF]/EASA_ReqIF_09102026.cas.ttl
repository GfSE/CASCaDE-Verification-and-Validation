d:idSpecObject_1520688775_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.810.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
