	a o:idSpecObject1 ;
	rdfs:label "CS 25.562(a)(2).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The occupant is exposed to loads resulting from the conditions prescribed in this paragraph.</div>" ;
