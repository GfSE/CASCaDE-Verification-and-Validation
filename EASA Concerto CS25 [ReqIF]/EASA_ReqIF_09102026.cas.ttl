	a o:idSpecObject1 ;
	rdfs:label "CS 25.1501(b).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The operating limitations and other information necessary for safe operation must be made available to the crew members as prescribed in CS 25.1541 to CS 25.1593.</div>" ;
