	a o:idSpecObject1 ;
	rdfs:label "CS 25.773(b)(4)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Any system failure or combination of failures, which is not, Extremely Improbable in accordance with CS 25.1309, under the precipitation conditions specified in sub-paragraph (b)(1) of this paragraph.</div>" ;
