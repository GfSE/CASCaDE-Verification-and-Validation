	a o:idSpecObject1 ;
	rdfs:label "CS 25.1383(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each landing light must be approved, and must be installed so that –</div>" ;
