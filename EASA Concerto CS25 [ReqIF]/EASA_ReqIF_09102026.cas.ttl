d:idSpecObject_673143495_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.415(g)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The loads corresponding to the maximum pilot loads in CS 25.397(c) for each pilot alone; or</div>" ;
