d:idSpecObject_-356525592_32
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(f)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Place the calorimeter on the test stand as shown in Figure 4 at a distance of 102-±3 mm (4 ± 0·125 inches) from the exit of the burner cone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(f)(1)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(f)(2).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Turn on the burner, allow it to run for 2 minutes for warm-up, and adjust the burner air intake damper to produce a reading of 11·9 ± 0·6 Watts/cm2 (10·5 ± 0·5 BTU per ft2 sec) on the calorimeter to ensure steady state conditions have been achieved. Turn off the burner.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(f)(2)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(f)(3).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Replace the calorimeter with the thermocouple rake (Figure 5).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(f)(3)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_35
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(f)(4).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Turn on the burner and ensure that the thermocouples are reading 1038 ± 56°C (1900 ± 100°F) to ensure steady state conditions have been achieved.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(f)(4)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
