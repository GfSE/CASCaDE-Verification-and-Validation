d:idSpecObject_-829075061_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.337(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Manoeuvring load factors lower than those specified in this paragraph may be used if the aeroplane has design features that make it impossible to exceed these values in flight.</div>" ;
