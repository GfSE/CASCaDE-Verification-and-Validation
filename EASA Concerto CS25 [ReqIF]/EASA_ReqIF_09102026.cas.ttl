	rdfs:label "CS 25.111(d)(3).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The flight path must be based on the aeroplane’s performance without ground effect; and</div>" ;
