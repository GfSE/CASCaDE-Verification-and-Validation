	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "ELECTRICAL SYSTEMS AND EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10085" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_506950409_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(d)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Unless it can be shown that the loss of the normal electrical power generating system(s) is Extremely Improbable, alternate high integrity electrical power system(s), independent of the normal electrical power generating system(s), must be provided to power those services necessary to complete a flight and make a safe landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
