d:idSpecObject_1789991084_52
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(c)(2)(i).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) For batt-type materials such as fibreglass, the constructed, finished blanket specimen assemblies must be 81.3 wide by 91.4 cm long (32 inches by 36 inches), exclusive of heat sealed film edges. </div>" ;
