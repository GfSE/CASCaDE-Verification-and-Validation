d:idSpecObject_-2124219872_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.613(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The effects of environmental conditions, such as temperature and moisture, on material design values used in an essential component or structure must be considered where these effects are significant within the aeroplane operating envelope.</div>" ;
