	a o:idSpecObject1 ;
	rdfs:label "CS 25.1145(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) There must be means to quickly shut off all ignition by the grouping of switches or by a master ignition control.</div>" ;
