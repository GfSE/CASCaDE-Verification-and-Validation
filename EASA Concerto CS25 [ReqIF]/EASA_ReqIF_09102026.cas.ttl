	a o:idSpecObject1 ;
	rdfs:label "CS 25.459.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The loading for special devices using aero-dynamic surfaces (such as slots, slats and spoilers) must be determined from test data. </div>" ;
