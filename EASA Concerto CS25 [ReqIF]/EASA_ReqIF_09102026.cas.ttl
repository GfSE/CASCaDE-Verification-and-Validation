	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(a)(9).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(9) Type C. This type is a floor-level exit with a rectangular opening of not less than 76.2 cm (30 inches) wide by 121.9 cm (48 inches) high, with corner radii not greater than 25.4 cm (10 inches).</div>" ;
