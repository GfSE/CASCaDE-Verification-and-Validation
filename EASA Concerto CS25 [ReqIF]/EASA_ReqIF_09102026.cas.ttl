d:idSpecObject_-227518127_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.907(a).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The magnitude of the propeller blade vibration stresses under any normal condition of operation must be determined by actual measurement or by comparison with similar installations for which these measurements have been made.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
