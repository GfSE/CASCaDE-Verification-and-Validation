	a o:idSpecObject1 ;
	rdfs:label "CS 25.1305(f).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) For aeroplanes equipped with fluid systems (other than fuel) for thrust or power augmentation, an approved means must be provided to indicate the proper functioning of that system to the flight crew.</div>" ;
