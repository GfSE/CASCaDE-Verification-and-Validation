	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1091(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Must supply the air required by the APU under each operating condition for which certification is requested,</div>" ;
