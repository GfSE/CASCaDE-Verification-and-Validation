d:idSpecObject_1552222846_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1121(f).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Each exhaust system component must be ventilated to prevent points of excessively high temperature.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
