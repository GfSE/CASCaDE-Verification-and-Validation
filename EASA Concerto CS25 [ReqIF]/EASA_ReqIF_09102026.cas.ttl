	o:idTitle1 "Proof of compliance" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10117" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-862454206_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(g)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) No changes in the load distribution limits of CS 25.23, the weight limits of CS 25.25 (except where limited by performance requirements of this subpart), and the centre of gravity limits of CS 25.27, from those for non-icing conditions, are allowed for flight in icing conditions or with ice accretion.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
