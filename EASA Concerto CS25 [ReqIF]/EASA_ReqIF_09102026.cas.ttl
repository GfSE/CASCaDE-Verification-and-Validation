	a o:idSpecObject1 ;
	rdfs:label "CS 25.J953.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Each fuel system must allow the supply of fuel to the APU:</div>" ;
