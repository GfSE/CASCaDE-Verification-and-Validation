d:idSpecObject_-1687569284_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) A vertical load factor of 1·0 at the aeroplane centre of gravity, and a side component at the nose wheel ground contact equal to 0·8 of the vertical ground reaction at that point are assumed.</div>" ;
