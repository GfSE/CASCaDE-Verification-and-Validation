	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each pressure fuelling system fuel manifold connection must have means to prevent the escape of hazardous quantities of fuel from the system if the fuel entry valve fails.</div>" ;
