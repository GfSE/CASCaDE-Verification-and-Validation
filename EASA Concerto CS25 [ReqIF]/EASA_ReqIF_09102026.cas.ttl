	a o:idSpecObject1 ;
	rdfs:label "CS 25.1165(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) No ground wire for any engine may be routed through a fire zone of another engine unless each part of that wire within that zone is fireproof.</div>" ;
