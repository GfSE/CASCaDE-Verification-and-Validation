d:idSpecObject_-1028631822_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1713(b).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) EWIS components that are located in designated fire zones and are necessary during emergency procedures must be at least fire resistant.</div>" ;
