	a o:idSpecObject1 ;
	rdfs:label "CS 25.925(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) At least 13 mm (0·5 inches) longitudinal clearance between propeller blades or cuffs and stationary parts of the aeroplane; and</div>" ;
