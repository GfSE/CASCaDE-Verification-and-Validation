	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-192061252_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Design. Each pneumatic system must be designed as follows: </div>" ;
