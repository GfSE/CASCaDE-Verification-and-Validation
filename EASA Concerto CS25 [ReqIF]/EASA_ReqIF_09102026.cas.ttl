d:idSpecObject_1839006948_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1327(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Direction indicators required by CS 25.1303(b)(6) must have an accuracy adequate for the safe operation of the aeroplane.</div>" ;
