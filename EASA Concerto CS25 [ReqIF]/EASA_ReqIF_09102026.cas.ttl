d:idSpecObject_-792266652_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(d)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Mounting. Only one surface of a specimen will be exposed during a test. A single layer of 0·025 mm aluminium foil is wrapped tightly on all unexposed sides. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
