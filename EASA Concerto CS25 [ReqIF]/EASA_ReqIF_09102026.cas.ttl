	a o:idSpecObject1 ;
	rdfs:label "CS 25.781.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Cockpit control knobs must conform to the general shapes (but not necessarily the exact sizes or specific proportions) in the following figure: </div>" ;
