	o:idSubsection1 "AEROPLANE FLIGHT MANUAL" ;
	o:ideRules1 "ERULES-1963177438-10109" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2018/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2018-11-07T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-11-07T00:00:00Z" .

d:idSpecObject_-1847500952_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1583(a)(2).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If an airspeed limitation is based upon compressibility effects, a statement to this effect and information as to any symptoms, the probable behaviour of the aeroplane, and the recommended recovery procedures.</div>" ;
