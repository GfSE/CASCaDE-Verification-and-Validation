d:idSpecObject_-1302882791_69_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(0).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Test Procedure. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VI" ;
	o:idSubref1 "(f)(0)" ;
	o:idTitle1 "Test Method to Determine the Flammability and Flame Propagation Characteristics of Thermal/Acoustic Insulation Materials" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9589" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_70
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Ignite the pilot burner. Ensure that it is at least 51 mm (2 inches) above the top of the platform. The burner must not contact the specimen until the test begins. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VI" ;
	o:idSubref1 "(f)(1)" ;
	o:idTitle1 "Test Method to Determine the Flammability and Flame Propagation Characteristics of Thermal/Acoustic Insulation Materials" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9589" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_71
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(2).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Place the test specimen in the sliding platform holder. Ensure that the test sample surface is level with the top of the platform. At ‘‘zero’’ point, the specimen surface must be 191 ± 3 mm (7 ½ ± ⅛ inches) below the radiant panel. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VI" ;
	o:idSubref1 "(f)(2)" ;
	o:idTitle1 "Test Method to Determine the Flammability and Flame Propagation Characteristics of Thermal/Acoustic Insulation Materials" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9589" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_72
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Place the retaining/securing frame over the test specimen. It may be necessary (due to compression) to adjust the sample (up or down) in order to maintain the distance from the sample to the radiant panel 191 ± 3 mm (7½ ± ⅛ inches) at ‘‘zero’’ position). With film/fiberglass assemblies, it is critical to make a slit in the film cover to purge any air inside. This allows the operator to maintain the proper test specimen position (level with the top of the platform) and to allow ventilation of gases during testing. A longitudinal slit, approximately 2 inches (51 mm) in length, must be centered 76 ± 13 mm (3 ± ½ inches) from the left flange of the securing frame. A utility knife is acceptable for slitting the film cover. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VI" ;
	o:idSubref1 "(f)(3)" ;
	o:idTitle1 "Test Method to Determine the Flammability and Flame Propagation Characteristics of Thermal/Acoustic Insulation Materials" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9589" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_73
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(4).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Immediately push the sliding platform into the chamber and close the bottom door. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VI" ;
	o:idSubref1 "(f)(4)" ;
