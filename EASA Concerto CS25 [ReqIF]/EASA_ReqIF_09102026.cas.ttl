	a o:idSpecObject1 ;
	rdfs:label "CS 25.939(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The turbine engine air inlet system may not, as a result of air flow distortion during normal operation, cause vibration harmful to the engine. (See AMC 25.939(c).)</div>" ;
