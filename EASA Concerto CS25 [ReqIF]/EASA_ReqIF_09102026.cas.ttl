	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(3)(i).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) 1·2% for two-engined aeroplanes;</div>" ;
