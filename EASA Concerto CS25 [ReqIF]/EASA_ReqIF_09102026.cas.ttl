	a o:idSpecObject1 ;
	rdfs:label "CS 25.473(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) With a limit descent velocity of 3·05 m/sec (10 fps) at the design landing weight (the maximum weight for landing conditions at maximum descent velocity); and</div>" ;
