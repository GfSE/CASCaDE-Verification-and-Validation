	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(g).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) The landing gear must remain extended throughout the accelerate-stop distance.</div>" ;
