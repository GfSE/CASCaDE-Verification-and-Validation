	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(a).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Approval. Each assembly consisting of a wheel(s) and brake(s) must be approved. </div>" ;
