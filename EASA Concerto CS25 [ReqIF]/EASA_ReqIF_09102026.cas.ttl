	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(c).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The ice accretion that has the most adverse effect on handling characteristics may be used for aeroplane performance tests provided any difference in performance is conservatively taken into account. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
