d:idSpecObject_-1687569284_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) With the aeroplane assumed to be in static equilibrium with the loads resulting from the use of brakes on one side of the main landing gear, the nose gear, its attaching structure, and the fuselage structure forward of the centre of gravity must be designed for the following loads:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "499" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Nose-wheel yaw and steering" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8511" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" ;
	cas:lists d:idSpecObject_-1687569284_5 ,
		d:idSpecObject_-1687569284_6 ,
		d:idSpecObject_-1687569284_7 ,
		d:idSpecObject_-1687569284_8 .

d:idSpecObject_-1687569284_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) If the loads prescribed in sub-paragraph (b) of this paragraph result in a nose gear side load higher than 0·8 times the vertical nose gear load, the design nose gear side load may be limited to 0·8 times the vertical load, with unbalanced yawing moments assumed to be resisted by aeroplane inertia forces.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "499" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Nose-wheel yaw and steering" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8511" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1687569284_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(d)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A lower drag reaction may be used if an effective drag force of 0·8 times the vertical reaction cannot be reached under any likely loading condition; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "499" ;
	o:idSubref1 "(d)(1)" ;
	o:idTitle1 "Nose-wheel yaw and steering" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8511" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1687569284_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(d)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The forward acting load at the centre of gravity need not exceed the maximum drag reaction on one main gear, determined in accordance with CS 25.493(b).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "499" ;
