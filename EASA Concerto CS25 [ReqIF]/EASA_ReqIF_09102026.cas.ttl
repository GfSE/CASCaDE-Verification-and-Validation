	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 5(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) That required to permit normal operation of all safety-related systems and equipment dependent upon engine thrust or power lever position; or</div>" ;
