	a o:idSpecObject1 ;
	rdfs:label "CS 25.1383(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Except when one switch is used for the lights of a multiple light installation at one location, there must be a separate switch for each light.</div>" ;
