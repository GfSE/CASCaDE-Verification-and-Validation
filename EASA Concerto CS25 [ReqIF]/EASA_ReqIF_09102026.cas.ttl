d:idSpecObject_-1100064879_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1043(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Maximum ambient atmospheric temperature. A maximum ambient atmospheric temperature corresponding to sea level conditions must be established. The temperature lapse rate is 2.0°C per 300 metres of altitude above sea level until a temperature of -56.5°C is reached, above which altitude, the temperature is considered constant at -56.5°C.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J1043" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Cooling tests" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "COOLING" ;
	o:ideRules1 "ERULES-1963177438-9349" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-1100064879_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1043(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Correction factor. Unless a more rational correction applies, temperatures of APU fluids and components for which temperature limits are established, must be corrected by adding to them the difference between the maximum ambient atmospheric temperature and the temperature of the ambient air at the time of the first occurrence of the maximum component or fluid temperature recorded during the cooling test.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
