	o:idSubsection1 "AEROPLANE FLIGHT MANUAL" ;
	o:ideRules1 "ERULES-1963177438-10264" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2018/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2018-03-28T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-03-28T00:00:00Z" .

d:idSpecObject_-210633444_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1587(b)(1).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) In each case, the conditions of power, configuration, and speeds, and the procedures for handling the aeroplane and any system having a significant effect on the performance information.</div>" ;
