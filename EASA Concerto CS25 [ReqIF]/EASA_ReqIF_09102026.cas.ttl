	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Any unequal tyre inflation pressure, assuming the maximum variation to be ±5% of the nominal tyre inflation pressure.</div>" ;
