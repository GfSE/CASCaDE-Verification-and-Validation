d:idSpecObject_-783279111_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Tanks with interconnected outlets and airspaces may be treated as one tank and need not have separate indicators; and</div>" ;
