	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx H 3(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Basic control and operation information describing how the aeroplane components and systems are controlled and how they operate, including any special procedures and limitations that apply.</div>" ;
