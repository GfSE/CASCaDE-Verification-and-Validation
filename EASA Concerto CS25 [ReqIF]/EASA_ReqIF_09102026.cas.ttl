	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-2124219872_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.613(b)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For redundant structure, in which the failure of individual elements would result in applied loads being safely distributed to other load carrying members, 90% probability with 95% confidence.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
