		d:idSpecObject_-783279111_12 .

d:idSpecObject_-783279111_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Fuel flow meter system. If a fuel flow meter system is installed, each metering component must have a means for bypassing the fuel supply if malfunction of that component severely restricts fuel flow. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1337" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Powerplant instruments" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-8669" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-783279111_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Oil quantity indicator. There must be a stick gauge or equivalent means to indicate the quantity of oil in each tank. If an oil transfer or reserve oil supply system is installed, there must be a means to indicate to the flight crew, in flight, the quantity of oil in each tank. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
