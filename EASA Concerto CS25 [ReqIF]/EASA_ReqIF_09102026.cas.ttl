d:idSpecObject_703832581_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 4(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The concurrent existence of an ATTCS system failure and an engine failure during the critical time interval must be shown to be Extremely Improbable.</div>" ;
