d:idSpecObject_-848608315_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx H 1(c).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The applicant must consider the effect of ageing structures in the Instructions for Continued Airworthiness (see AMC 20-20).</div>" ;
