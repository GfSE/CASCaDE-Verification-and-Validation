	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(b)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) System transients due to switching, fault clearing, or other causes do not make essential loads inoperative, and do not cause a smoke or fire hazard;</div>" ;
