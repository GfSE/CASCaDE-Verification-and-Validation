	a o:idSpecObject1 ;
	rdfs:label "CS 25.1145(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Ignition switches must control each engine ignition circuit on each engine.</div>" ;
