d:idSpecObject_1959871857_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(3)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) be designed so that, during pressurised flight, no single failure in the locking system would prevent the locks from restraining the latches necessary to secure the door.</div>" ;
