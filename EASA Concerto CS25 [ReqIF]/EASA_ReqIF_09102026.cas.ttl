	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(g)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Be bright orange; however, if the recorder is deployable, the surface that is visible from outside the aeroplane, when the recorder is installed, may be of another colour;</div>" ;
