	rdfs:label "CS 25.788(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Showers: If a shower cubicle is installed (See AMC 25.788(a) and AMC 25.1447(c)(3)):</div>" ;
