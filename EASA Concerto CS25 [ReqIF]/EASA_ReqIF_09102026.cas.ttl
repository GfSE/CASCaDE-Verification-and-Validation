	a o:idSpecObject1 ;
	rdfs:label "CS 25.1355(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The distribution system includes the distribution busses, their associated feeders, and each control protective device.</div>" ;
