	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(l)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each electrically illuminated exit sign required under CS 25.811(d)(2) remains operative exclusive of those that are directly damaged by the separation; and</div>" ;
