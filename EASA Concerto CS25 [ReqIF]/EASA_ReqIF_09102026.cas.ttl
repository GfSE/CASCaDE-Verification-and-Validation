	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_-1092025642_31
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(7)(i).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) It has an automatic deployment capability that is engaged no later than when the aeroplane is airborne and that remains engaged as long as the aeroplane is airborne;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
