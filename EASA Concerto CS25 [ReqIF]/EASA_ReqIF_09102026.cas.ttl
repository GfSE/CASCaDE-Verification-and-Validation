	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1187850300_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(c).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Over-sized exits. Openings larger than those specified in this paragraph, whether or not of rectangular shape, may be used if the specified rectangular opening can be inscribed within the opening and the base of the inscribed rectangular opening meets the specified step-up and step-down heights.</div>" ;
