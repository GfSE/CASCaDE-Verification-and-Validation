d:idSpecObject_735147005_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1017(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Condensed water vapour that might freeze and obstruct the line cannot accumulate at any point;</div>" ;
