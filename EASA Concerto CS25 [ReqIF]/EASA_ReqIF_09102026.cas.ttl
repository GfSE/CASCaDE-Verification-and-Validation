d:idSpecObject_659129742_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.427(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The horizontal tail must be assumed to be subjected to unsymmetrical loading conditions determined as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
