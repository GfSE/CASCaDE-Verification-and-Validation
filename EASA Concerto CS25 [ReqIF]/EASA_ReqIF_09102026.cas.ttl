	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-1440164610_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1317(a)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The function is not adversely affected during and after the time the aeroplane is exposed to HIRF environment I, as described in Appendix R;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1317" ;
