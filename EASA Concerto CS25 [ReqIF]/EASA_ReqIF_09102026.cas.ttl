d:idSpecObject_-356525592_41
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(g)(4).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Swing the burner away from the test position. Turn on the burner and allow it to run for 2 minutes to provide adequate warm-up of the burner cone and flame stabilization.</div>" ;
