d:idSpecObject_1082908761_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(d).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each flammable fluid shut-off means and control must be fireproof or must be located and protected so that any fire in a fire zone will not affect its operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
