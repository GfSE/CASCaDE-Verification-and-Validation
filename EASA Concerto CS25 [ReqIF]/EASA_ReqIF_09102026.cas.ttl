d:idSpecObject_-351018849_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1415(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Ditching equipment used in aeroplanes to be certified for ditching under CS 25.801, and required by the Operating Rules, must meet the requirements of this paragraph.</div>" ;
