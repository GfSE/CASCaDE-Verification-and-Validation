	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(b)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) For aeroplanes that have a passenger-seating configuration, excluding pilot seats, of 10 seats or more must meet the following requirements:</div>" ;
