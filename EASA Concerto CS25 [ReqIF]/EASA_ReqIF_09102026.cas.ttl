	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10200" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1460114103_38
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(f).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) If it is necessary to pass through a doorway separating any crew member seat (except those seats on the flight deck), occupiable for take-off and landing, from any emergency exit, the door must have a means to latch it in the open position. The latching means must be able to withstand the loads imposed upon it when the door is subjected to the ultimate inertia forces, relative to the surrounding structure, listed in CS 25.561(b).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
