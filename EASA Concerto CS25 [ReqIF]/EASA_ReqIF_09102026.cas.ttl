	a o:idSpecObject1 ;
	rdfs:label "CS 25.651(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Compliance with the special factors requirements of CS 25.619 to 25.625 and 25.657 for control surface hinges must be shown by analysis or individual load tests. </div>" ;
