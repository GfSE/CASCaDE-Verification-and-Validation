	a o:idSpecObject1 ;
	rdfs:label "CS 25.1017(b)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The breather discharge does not constitute a fire hazard if foaming occurs or causes emitted oil to strike the pilot’s windshield; and</div>" ;
