	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_44
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(g)(7).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Determine the weight of the remains of the seat cushion specimen set left on the mounting stand to the nearest 9 grams (0·02 pound ) excluding all droppings.</div>" ;
