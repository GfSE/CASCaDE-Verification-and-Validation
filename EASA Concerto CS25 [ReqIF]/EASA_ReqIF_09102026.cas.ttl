d:idSpecObject_-2040176130_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.803(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each crew and passenger area must have emergency means to allow rapid evacuation in crash landings, with the landing gear extended as well as with the landing gear retracted, considering the possibility of the aeroplane being on fire.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
