	a o:idSpecObject1 ;
	rdfs:label "CS 25.335(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Design wing-flap speeds, VF. For VF, the following apply: </div>" ;
