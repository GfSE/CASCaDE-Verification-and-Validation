d:idSpecObject_-442894939_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) From 1·23 VSR to the speed at which stall warning begins, the IAS must change perceptibly with CAS and in the same sense, and at speeds below stall warning speed the IAS must not change in an incorrect sense. (See AMC 25.1323(d).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1323" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Airspeed indicating system" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-10120" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-442894939_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) From VMO to VMO + ⅔ (VDF – VMO) the IAS must change perceptibly with CAS and in the same sense, and at higher speeds up to VDF the IAS must not change in an incorrect sense. (See AMC 25.1323(e))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
