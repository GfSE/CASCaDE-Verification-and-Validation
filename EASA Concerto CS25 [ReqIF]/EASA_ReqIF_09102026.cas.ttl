d:idSpecObject_-1014618069_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1715(a).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) EWIS components used for electrical bonding and protection against static electricity must meet the requirements of CS 25.899.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
