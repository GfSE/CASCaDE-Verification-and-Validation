	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(a)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) compliance with CS 25.853(g) is not required; and</div>" ;
