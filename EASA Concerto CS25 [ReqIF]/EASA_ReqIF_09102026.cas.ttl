d:idSpecObject_1397201062_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.103(b)(6).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) The aeroplane trimmed for straight flight at a speed selected by the applicant, but not less than 1.13 VSR and not greater than 1.3 VSR. (See AMC 25.103(b))</div>" ;
