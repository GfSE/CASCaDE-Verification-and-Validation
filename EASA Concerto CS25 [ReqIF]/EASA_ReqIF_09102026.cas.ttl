	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(a)(5).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Voice communications of flight-crew members using the passenger loudspeaker system, if there is such a system and if the fourth channel is available in accordance with the requirements of sub-paragraph (c)(4)(ii) of this paragraph.</div>" ;
