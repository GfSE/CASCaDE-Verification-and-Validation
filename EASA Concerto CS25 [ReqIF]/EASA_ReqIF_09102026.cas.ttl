	rdfs:label "CS 25.1420(a)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Following detection, the aeroplane must be capable of operating safely while exiting all icing conditions.</div>" ;
