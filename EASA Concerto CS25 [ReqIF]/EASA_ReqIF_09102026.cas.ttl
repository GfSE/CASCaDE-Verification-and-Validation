d:idSpecObject_-356525592_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(c)(2).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The seat bottom cushion specimen must be 457 ± 3 mm (18 ± 0·125 inches) wide by 508 ± 3 mm (20 ± 0·125 inches) deep by 102 ± 3 mm (4 ± 0·125 inches) thick, exclusive of fabric closures and seam overlap.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
