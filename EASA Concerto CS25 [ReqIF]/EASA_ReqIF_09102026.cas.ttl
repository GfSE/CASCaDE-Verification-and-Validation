	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) a ‘No smoking’ placard must be conspicuously located inside the passenger compartment in the immediate vicinity of each door that can be used as a passenger boarding door. Each placard must be clearly legible for passengers entering the aeroplane;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
