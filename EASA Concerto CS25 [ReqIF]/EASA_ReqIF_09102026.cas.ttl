	a o:idSpecObject1 ;
	rdfs:label "CS 25.855(b).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The following cargo or baggage compartments, as defined in CS 25.857, must have a liner that is separate from, but may be attached to, the aeroplane structure:</div>" ;
