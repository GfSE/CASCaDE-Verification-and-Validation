	a o:idSpecObject1 ;
	rdfs:label "CS 25.1435(b)(3).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Have means to minimise the release of harmful or hazardous concentrations of hydraulic fluid or vapours into the crew and passenger compartments during flight;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1435" ;
