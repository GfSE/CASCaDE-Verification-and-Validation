	rdfs:label "CS 25.109(a)(2)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) A distance equivalent to 2 seconds at the V1 for take-off from a dry runway.</div>" ;
