	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Generating system. The generating system includes electrical power sources, main power busses, transmission cables, and associated control, regulation, and protective devices. It must be designed so that – </div>" ;
