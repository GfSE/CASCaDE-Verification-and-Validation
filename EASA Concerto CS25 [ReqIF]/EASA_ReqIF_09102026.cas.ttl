	a o:idSpecObject1 ;
	rdfs:label "CS 25.1423(b).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The system must be capable of operation within 3 seconds from the time a microphone is removed from its stowage by a cabin crew member at those stations in the passenger compartment from which its use is accessible.</div>" ;
