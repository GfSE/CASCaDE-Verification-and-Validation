d:idSpecObject_-945172181_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J993(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each fuel line connected to components of the aeroplane between which relative motion could exist must have provisions for flexibility.</div>" ;
