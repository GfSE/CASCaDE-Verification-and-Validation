	a o:idSpecObject1 ;
	rdfs:label "CS 25.859(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Ventilating air ducts. Each ventilating air duct passing through any fire zone must be fireproof. In addition – </div>" ;
