d:idSpecObject_-235609149_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.733(d).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each tyre installed on a retractable landing gear system must, at the maximum size of the tyre type expected in service, have a clearance to surrounding structure and systems that is adequate to prevent unintended contact between the tyre and any part of the structure or systems.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
