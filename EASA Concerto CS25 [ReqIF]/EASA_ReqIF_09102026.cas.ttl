	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-192061252_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(8).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) Where any part of the system is subject to fluctuating or repeated external or internal loads, adequate allowance must be made for fatigue.</div>" ;
