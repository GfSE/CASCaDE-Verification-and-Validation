	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-8148" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1224749019_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.791(d).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Lavatories must have ‘No Smoking’ or ‘No Smoking in Lavatory’ placards conspicuously located on or adjacent to each side of the entry door.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
