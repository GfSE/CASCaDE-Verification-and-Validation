	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 4(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Results in a significant loss or reduction in thrust or power, must be shown to be Extremely Improbable.</div>" ;
