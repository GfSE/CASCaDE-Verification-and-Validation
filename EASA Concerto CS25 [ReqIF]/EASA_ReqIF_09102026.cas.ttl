d:idSpecObject_171137685_28
	a o:idSpecObject1 ;
	rdfs:label "CS 25.795(c)(3)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Life preservers or their storage locations must be designed so that tampering is evident. (See AMC 25.795(c)(3))</div>" ;
