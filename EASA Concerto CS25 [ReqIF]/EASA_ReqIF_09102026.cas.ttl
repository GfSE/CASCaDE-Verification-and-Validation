d:idSpecObject_1119482053_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.875(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each part of the aeroplane near the propeller tips must be strong and stiff enough to withstand the effects of the induced vibration and of ice thrown from the propeller.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
