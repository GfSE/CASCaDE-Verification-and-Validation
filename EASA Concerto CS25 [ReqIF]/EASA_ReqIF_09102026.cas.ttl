	a o:idSpecObject1 ;
	rdfs:label "CS 25.1307(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Electrical protective devices, as prescribed in this CS-25.</div>" ;
