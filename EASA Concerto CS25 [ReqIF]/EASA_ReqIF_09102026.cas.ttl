	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(f)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The control force required to produce 1·5 g.</div>" ;
