d:idSpecObject_-356525592_30
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(e).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Preparation of Apparatus. Before calibration, all equipment must be turned on and the burner fuel must be adjusted as specified in sub-paragraph (d)(2). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
