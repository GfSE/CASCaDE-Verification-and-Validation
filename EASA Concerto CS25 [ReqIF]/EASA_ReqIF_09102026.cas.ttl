d:idSpecObject_1856917487_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1310(a)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Essential loads for which an alternate source of power is required, after any failure or malfunction in any one-power supply system, distribution system, or other utilisation system.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
