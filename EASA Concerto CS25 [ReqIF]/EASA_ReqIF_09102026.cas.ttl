	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT MANOEUVRE AND GUST CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-15419" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2018/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2018-11-07T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-11-07T00:00:00Z" .

d:idSpecObject_-1201838289_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.353(c).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) With the aeroplane yawed to the opposite overswing sideslip angle, it is assumed that the cockpit rudder control is suddenly and fully displaced in the opposite direction to achieve the resulting rudder deflection, as limited by the control system or the control surface stops.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
