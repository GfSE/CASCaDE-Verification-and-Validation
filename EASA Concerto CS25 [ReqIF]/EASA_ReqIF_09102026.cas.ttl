d:idSpecObject_1220423236_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1707(d)(2).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Aeroplane system’s static grounds must not share a common ground terminating location with any of the aeroplane independent electrical power sources. </div>" ;
