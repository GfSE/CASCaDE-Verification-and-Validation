	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(d)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Damage affecting the safe operation of the nose-wheel steering system is precluded, or</div>" ;
