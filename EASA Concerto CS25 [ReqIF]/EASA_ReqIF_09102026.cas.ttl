	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(a)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) each door remains open during taxiing, take-off, and landing, and especially during and after a crash landing; and </div>" ;
