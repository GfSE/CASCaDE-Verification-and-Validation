d:idSpecObject_-2120777850_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.731(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The maximum limit load rating of each wheel must equal or exceed the maximum radial limit load determined under the applicable ground load requirements of this CS-25.</div>" ;
