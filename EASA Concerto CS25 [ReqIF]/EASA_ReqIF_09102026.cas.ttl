	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(g)(5).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Be, if the recorder is deployable, able to float on water and self-oriented so that the transmission of the emergency signal is not impeded.</div>" ;
