	rdfs:label "CS 25.103(b)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The weight used when VSR is being used as a factor to determine compliance with a required performance standard;</div>" ;
