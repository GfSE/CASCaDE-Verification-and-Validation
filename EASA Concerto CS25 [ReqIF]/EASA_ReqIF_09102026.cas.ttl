d:idSpecObject_-585877381_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 40(b)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) the briefing card must be easily accessible from each passenger seat. A dedicated stowage must be provided to stow the briefing card within easy reach of each seated passenger with their seat belts fastened.</div>" ;
