	o:idSubref1 "(d)(5)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_31
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(e).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Fuel tanks must comply with the following criteria in order to avoid hazardous fuel leak: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "963" ;
	o:idSubref1 "(e)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_32
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(e)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Fuel tanks located in an area where experience or analysis indicates a strike is likely, must be shown by analysis supported by test, or by test to address penetration and deformation by tyre and wheel fragments, small debris from uncontained engine failure or APU failure, or other likely debris (such as runway debris).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "963" ;
	o:idSubref1 "(e)(1)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(e)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) All fuel tank access covers must have the capacity to withstand the heat associated with fire at least as well as an access cover made from aluminium alloy in dimensions appropriate for the purpose for which they are to be used, except that the access covers need not be more resistant to fire than an access cover made from the base fuel tank structural material. (See AMC 25.963(e).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "963" ;
	o:idSubref1 "(e)(2)" ;
	o:idTitle1 "Fuel tanks: general" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10093" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1624084903_35
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) For pressurised fuel tanks, a means with failsafe features must be provided to prevent the build-up of an excessive pressure difference between the inside and the outside of the tank.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
