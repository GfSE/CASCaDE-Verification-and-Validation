d:idSpecObject_2122803792_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.955(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each fuel system must provide at least 100% of the fuel flow required under each intended operating condition and manoeuvre. Compliance must be shown as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
