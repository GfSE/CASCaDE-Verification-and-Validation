d:idSpecObject_-749083209_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(d)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A shoulder harness that will prevent the head from contacting any injurious object.</div>" ;
