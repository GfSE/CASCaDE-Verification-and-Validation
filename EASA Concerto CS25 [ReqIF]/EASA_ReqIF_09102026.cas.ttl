	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(c)(3)(iii).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) 1·7% for four-engined aeroplanes, </div>" ;
