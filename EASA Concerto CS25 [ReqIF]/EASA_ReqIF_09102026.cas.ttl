d:idSpecObject_-749083209_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Each seat located in the passenger compartment and designated for use during take-off and landing by a cabin crewmember required by the Operating Rules must be:</div>" ;
