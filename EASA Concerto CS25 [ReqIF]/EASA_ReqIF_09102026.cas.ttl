	a o:idSpecObject1 ;
	rdfs:label "CS 25.1203(g).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Each fire detector system must be constructed so that when it is in the configuration for installation it will not exceed the alarm activation time approved for the detectors using the response time criteria specified in the appropriate European Technical Standard Order for the detector.</div>" ;
