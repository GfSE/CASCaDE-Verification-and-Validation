d:idSpecObject_-1836590785_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 50(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For non-commercially operated aeroplanes, at least half of the installed cabin crew member seats must face the passenger cabin.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
