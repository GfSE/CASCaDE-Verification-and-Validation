d:idSpecObject_552252819_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(b).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) During the acceleration to speed V2, the nose gear may be raised off the ground at a speed not less than VR. However, landing gear retraction may not be begun until the aeroplane is airborne. (See AMC 25.111(b).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
