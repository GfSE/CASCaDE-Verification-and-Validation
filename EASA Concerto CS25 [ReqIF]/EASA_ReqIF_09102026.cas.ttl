	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(d)(4).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) A casting factor of 2.0 or greater may be used, provided that each casting receives inspection of 100 percent of its surface using visual inspection methods.</div>" ;
