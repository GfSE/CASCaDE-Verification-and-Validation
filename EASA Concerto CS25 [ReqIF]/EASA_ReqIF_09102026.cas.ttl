	a o:idSpecObject1 ;
	rdfs:label "CS 25.851(a)(8).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) Each extinguisher intended for use in a personnel compartment must be designed to minimise the hazard of toxic gas concentration.</div>" ;
