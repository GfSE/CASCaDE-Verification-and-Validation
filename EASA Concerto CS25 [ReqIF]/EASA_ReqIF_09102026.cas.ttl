d:idSpecObject_-1347327207_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part V.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
