	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1639969494_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.677(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) If an irreversible tab control system is used, the part from the tab to the attachment of the irreversible unit to the aeroplane structure must consist of a rigid connection.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
