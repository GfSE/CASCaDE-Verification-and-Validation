d:idSpecObject_640206105_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.954(a)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A critical lightning strike is a lightning strike that attaches to the aeroplane in a location that, when combined with the failure of any design feature or structure, could create an ignition source.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "954" ;
