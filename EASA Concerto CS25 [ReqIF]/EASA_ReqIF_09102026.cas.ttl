d:idSpecObject_-1092025642_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(d)(1)(ii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) It remains powered for as long as possible without jeopardising emergency operation of the aeroplane;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
