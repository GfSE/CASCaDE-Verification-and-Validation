	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-10196" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1342275228_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1447(c)(4).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Portable oxygen equipment must be immediately available for each cabin crew member. The portable oxygen equipment must have the oxygen dispensing unit connected to the portable oxygen supply. (See AMC 25.1447(c)(4).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
