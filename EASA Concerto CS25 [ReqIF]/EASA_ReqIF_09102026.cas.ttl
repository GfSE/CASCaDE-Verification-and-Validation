	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(5).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Instruments at the pilot or flight engineer station to show the pressure differential, the cabin pressure altitude, and the rate of change of the cabin pressure altitude.</div>" ;
