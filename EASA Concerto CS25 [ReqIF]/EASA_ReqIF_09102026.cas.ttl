	o:idTitle1 "Airworthiness limitations and procedures " ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix M – Fuel Tank Flammability Reduction Means (FRM)" ;
	o:ideRules1 "ERULES-1963177438-9591" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_320081634_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 4(b).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Maintenance procedures must be developed to identify any hazards to be considered during maintenance of the fuel system and of the FRM. These procedures must be included in the instructions for continued airworthiness (ICA).</div>" ;
