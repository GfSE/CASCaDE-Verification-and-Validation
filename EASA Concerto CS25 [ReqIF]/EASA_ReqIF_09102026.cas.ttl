	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(c)(4).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The specimens must be conditioned at 21 ± 2°C (70 ± 5°F) 55% ± 10% relative humidity for at least 24 hours before testing.</div>" ;
