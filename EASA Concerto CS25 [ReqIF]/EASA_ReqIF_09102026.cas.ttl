	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1103(a)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (2) Constructed of materials that will not absorb or trap sufficient quantities of flammable fluids such as to create a fire hazard.</div>" ;
