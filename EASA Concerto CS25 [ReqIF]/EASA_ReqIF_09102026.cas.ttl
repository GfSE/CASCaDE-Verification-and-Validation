d:idSpecObject_-1687569284_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) For other than the nose gear, its attaching structure, and the forward fuselage structure the loading conditions are those prescribed in sub-paragraph (b) of this paragraph, except that –</div>" ;
