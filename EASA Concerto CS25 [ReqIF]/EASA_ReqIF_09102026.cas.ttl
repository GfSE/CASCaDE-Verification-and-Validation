	a o:idSpecObject1 ;
	rdfs:label "CS 25.952(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The likely failure of any heat exchanger using fuel as one of its fluids may not result in a hazardous condition.</div>" ;
