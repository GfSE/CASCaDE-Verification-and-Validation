	a o:idSpecObject1 ;
	rdfs:label "CS 25.773(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) No single failure of the systems used to provide the view required by sub-paragraph (b)(1) of this paragraph must cause the loss of that view by both pilots in the specified precipitation conditions.</div>" ;
