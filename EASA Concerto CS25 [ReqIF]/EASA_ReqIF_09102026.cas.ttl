	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(b)(1).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Warning: For conditions that require immediate flight crew awareness and immediate flight crew response.</div>" ;
