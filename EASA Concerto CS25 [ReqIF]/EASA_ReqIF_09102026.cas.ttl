d:idSpecObject_-442894939_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) From 1·23 VSR to the speed at which stall warning begins, the IAS must change perceptibly with CAS and in the same sense, and at speeds below stall warning speed the IAS must not change in an incorrect sense. (See AMC 25.1323(d).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
