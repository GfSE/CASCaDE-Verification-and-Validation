d:idSpecObject_502859743_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.562(c)(4).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The lap safety belt must remain on the occupant’s pelvis during the impact.</div>" ;
