	a o:idSpecObject1 ;
	rdfs:label "CS 25.181(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Any short period oscillation, not including combined lateral-directional oscillations, occurring between 1·13 VSR and maximum allowable speed appropriate to the configuration of the aeroplane must be heavily damped with the primary controls –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
