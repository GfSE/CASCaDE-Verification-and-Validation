d:idSpecObject_-1167862034_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.979(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Provide indication, at each fuelling station, of failure of the shut-off means to stop the fuel flow at the maximum quantity approved for that tank.</div>" ;
