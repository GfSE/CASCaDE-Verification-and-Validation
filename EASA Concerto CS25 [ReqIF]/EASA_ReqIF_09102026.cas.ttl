d:idSpecObject_1994393186_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1533(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The maximum take-off weights must be established as the weights at which compliance is shown with the applicable provisions of this CS-25 (including the take-off climb provisions of CS 25.121(a) to (c), for altitudes and ambient temperatures).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1533" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Additional operating limitations" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART G – OPERATING LIMITATIONS AND INFORMATION" ;
	o:idSubsection1 "OPERATING LIMITATIONS" ;
	o:ideRules1 "ERULES-1963177438-10127" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1994393186_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1533(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The maximum landing weights must be established as the weights at which compliance is shown with the applicable provisions of this CS-25 (including the landing and approach climb provisions of CS 25.119 and 25.121(d) for altitudes and ambient temperatures).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
