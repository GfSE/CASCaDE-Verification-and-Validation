	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(6)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) the relative motion between the latch and the structural counterpart.</div>" ;
