	rdfs:label "CS 25.855(d).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) All other materials used in the construction of the cargo or baggage compartment must meet the applicable test criteria prescribed in Part I of Appendix F, or other approved equivalent methods.</div>" ;
