d:idSpecObject_-1687569284_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) With the aeroplane assumed to be in static equilibrium with the loads resulting from the use of brakes on one side of the main landing gear, the nose gear, its attaching structure, and the fuselage structure forward of the centre of gravity must be designed for the following loads:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
