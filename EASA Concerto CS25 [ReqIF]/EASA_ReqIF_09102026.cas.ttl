	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_74
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(5).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Bring the pilot burner flame into contact with the center of the specimen at the ‘‘zero’’ point and simultaneously start the timer. The pilot burner must be at a 27° angle with the sample and be approximately ½ inch (12 mm) above the sample. See figure 7. A stop, as shown in figure 8, allows the operator to position the burner correctly each time. <object data=\"images/CS-25_27_image119.jpeg\" type=\"image/jpeg\"></object></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VI" ;
	o:idSubref1 "(f)(5)" ;
	o:idTitle1 "Test Method to Determine the Flammability and Flame Propagation Characteristics of Thermal/Acoustic Insulation Materials" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9589" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_77
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(f)(6).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Leave the burner in position for 15 seconds and then remove to a position at least 51 mm (2 inches) above the specimen. </div>" ;
