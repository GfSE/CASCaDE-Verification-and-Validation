	a o:idSpecObject1 ;
	rdfs:label "CS 25.1436(b)(3)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Will be within 90 to 110% of pump average discharge pressure at each pump outlet or at the outlet of the pump transient pressure dampening device, if provided; and</div>" ;
