	a o:idSpecObject1 ;
	rdfs:label "CS 25.672.Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "672" ;
	o:idTitle1 "Stability augmentation and automatic and power-operated systems" ;
	o:idAmendedBy1 "Amendment 24;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-18317" ;
