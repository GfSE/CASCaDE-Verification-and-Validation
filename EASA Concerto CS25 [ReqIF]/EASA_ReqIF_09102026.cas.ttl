	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1748508159_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(e)(2).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Crew-member compartments and areas other than the flight-crew compartment unless the crewmember compartment or area is ventilated by air interchange with other compartments or areas under all operating conditions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
