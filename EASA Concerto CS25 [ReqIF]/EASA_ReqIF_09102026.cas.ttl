d:idSpecObject_-829075061_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.337(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Except where limited by maximum (static) lift coefficients, the aeroplane is assumed to be subjected to symmetrical manoeuvres resulting in the limit manoeuvring load factors prescribed in this paragraph. Pitching velocities appropriate to the corresponding pull-up and steady turn manoeuvres must be taken into account.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "337" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Limit manoeuvring load factors" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "FLIGHT MANOEUVRE AND GUST CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-8360" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-829075061_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.337(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The positive limit manoeuvring load factor ‘n’ for any speed up to VD may not be less than except that ‘n’ may not be less than 2·5 and need not be greater than 3·8 – where ‘W’ is the design maximum take-off weight (lb). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
