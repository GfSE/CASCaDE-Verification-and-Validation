d:idSpecObject_245038442_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 3(a).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Reliability indications must be provided to identify failures of the FRM that would otherwise be latent and whose identification is necessary to ensure the fuel tank with an FRM meets the fleet average flammability exposure listed in paragraph M25.1 of this appendix, including when the FRM is inoperative.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx M 3" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Reliability indications and maintenance access" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix M – Fuel Tank Flammability Reduction Means (FRM)" ;
	o:ideRules1 "ERULES-1963177438-9595" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_245038442_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 3(b).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Sufficient accessibility to FRM reliability indications must be provided for maintenance personnel or the flight crew. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx M 3" ;
	o:idSubref1 "(b)" ;
