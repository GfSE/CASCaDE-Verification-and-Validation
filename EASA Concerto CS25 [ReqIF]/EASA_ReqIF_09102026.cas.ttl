	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(h)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Radiant heat flux to the specimen, expressed in Watts/cm2.</div>" ;
