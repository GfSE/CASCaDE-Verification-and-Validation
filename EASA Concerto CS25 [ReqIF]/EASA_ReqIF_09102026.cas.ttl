d:idSpecObject_-125199643_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Illuminated emergency exit marking and locating signs, sources of general cabin illumination, interior lighting in emergency exit areas, and floor proximity escape path marking.</div>" ;
