d:idSpecObject_1516740204_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.1362.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.1362 Electrical supplies for emergency conditions ED Decision 2003/2/RM 1 The emergency services which may require a supply include fuel shut-off valves, hydraulic shut-off valves and engine / APU fire extinguisher systems. 2 An appropriate design and/or unambiguous AFM procedures should be provided in order to prevent disconnection of the electrical supply to the required services before the emergency procedures are fully completed. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
