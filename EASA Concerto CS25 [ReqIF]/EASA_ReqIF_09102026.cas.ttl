d:idSpecObject_-1070920956_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(c).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) A correlation must be established between the flight data recorder readings of airspeed, altitude, and heading and the corresponding readings (taking into account correction factors) of the first pilot’s instruments. The correlation must cover the airspeed range over which the aeroplane is to be operated, the range of altitude to which the aeroplane is limited, and 360° of heading. Correlation may be established on the ground as appropriate.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1459" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Flight data recorders" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "MISCELLANEOUS EQUIPMENT" ;
	o:ideRules1 "ERULES-1963177438-18462" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_-1070920956_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1459(d).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The container of the flight data recorder must comply with the specifications in CS 25.1457(g) that are applicable to the container of the cockpit voice recorder.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
