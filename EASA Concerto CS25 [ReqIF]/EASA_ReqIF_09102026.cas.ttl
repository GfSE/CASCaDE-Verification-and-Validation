d:idSpecObject_55650433_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(a)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Accelerate the aeroplane from a standing start with all engines operating to the highest speed reached during the rejected take-off, assuming the pilot takes the first action to reject the take-off at the V1 for take-off from a dry runway; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
