d:idSpecObject_-469441825_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.699(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) If any extension of the lift and drag device beyond the landing position is possible, the control must be clearly marked to identify this range of extension.</div>" ;
