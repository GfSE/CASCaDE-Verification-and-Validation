d:idSpecObject_387969350_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.832(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The aeroplane cannot be operated at an altitude which would result in cabin ozone concentrations exceeding the limits prescribed by sub-paragraph (a) of this paragraph; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
