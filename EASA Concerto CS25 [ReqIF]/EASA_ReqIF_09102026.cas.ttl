	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1370083084_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(j).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) For flight in icing conditions before the ice protection system has been activated and is performing its intended function, it must be demonstrated in flight with the most critical of the ice accretion(s) defined in appendix C, part II(e), and Appendix O, part II(d), as applicable, in accordance with CS 25.21(g), that:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
