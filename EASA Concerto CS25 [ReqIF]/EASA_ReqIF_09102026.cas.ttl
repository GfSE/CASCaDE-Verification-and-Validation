	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_441843313_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.233(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The aeroplane must have adequate directional control during taxying. This may be shown during taxying prior to take-offs made in conjunction with other tests.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
