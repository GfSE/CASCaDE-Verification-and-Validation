	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(f)(3)(i).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Each seat to the structure; and</div>" ;
