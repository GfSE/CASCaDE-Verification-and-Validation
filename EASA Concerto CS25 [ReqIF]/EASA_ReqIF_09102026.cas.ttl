	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-66702698_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.703(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The means used to activate the system must function properly for all authorised take-off power settings and procedures, and throughout the ranges of take-off weights, altitudes, and temperatures for which certification is requested.</div>" ;
