	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(h).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Report. The test report must include the following for each specimen tested: </div>" ;
