d:idSpecObject_874429002_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.407(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For aileron and rudder trim tabs, those required to trim the aeroplane in the critical unsymmetrical power and loading conditions, with appropriate allowance for rigging tolerances.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
