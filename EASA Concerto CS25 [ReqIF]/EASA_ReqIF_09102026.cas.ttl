d:idSpecObject_-862454206_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) In meeting the requirements of CS 25.105(d), 25.125, 25.233 and 25.237, the wind velocity must be measured at a height of 10 metres above the surface, or corrected for the difference between the height at which the wind velocity is measured and the 10-metre height.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
