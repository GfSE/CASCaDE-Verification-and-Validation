	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a)(5)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) An excessive positive load factor when the pilot does not take action to counteract the effects of extension; </div>" ;
