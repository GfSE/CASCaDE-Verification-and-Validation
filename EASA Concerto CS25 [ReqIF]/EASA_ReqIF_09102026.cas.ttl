	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix Q – Additional airworthiness requirements for approval of a Steep Approach Landing (SAL) capability" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_1892022917_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 3(a)(1).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The aeroplane must be in the all-engines-operating or one-engine-inoperative steep approach landing configuration, as applicable.</div>" ;
