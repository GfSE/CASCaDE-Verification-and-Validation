	a o:idSpecObject1 ;
	rdfs:label "CS 25.1309(a).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The aeroplane equipment and systems must be designed and installed so that:</div>" ;
