	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(c)(2)(i).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Arm and disarm the system, and</div>" ;
