d:idSpecObject_-2058332334_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) It must be impossible to fill the expansion space inadvertently with the aeroplane in the normal ground attitude.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
