	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(g)(5).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) To begin the test, swing the burner into the test position and simultaneously start the timing device.</div>" ;
