	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 1(b).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Aeroplane Flight Manual (AFM) Limitation: if compliance with any part of this Appendix limits the aeroplane to non-commercial operations, this limitation must be included in the ‘Limitations’ Section of the AFM.</div>" ;
