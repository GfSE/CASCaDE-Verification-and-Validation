	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1141(d)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (2) Each control must be able to maintain any set position without creep due to control loads, vibration, or other external forces resulting from the location.</div>" ;
