d:idSpecObject_-1515623790_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1123.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">For powerplant installations, the following apply: </div>" ;
