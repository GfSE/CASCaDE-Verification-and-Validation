	a o:idSpecObject1 ;
	rdfs:label "CS 25.731(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Braked wheels. Each braked wheel must meet the applicable requirements of CS 25.735.</div>" ;
