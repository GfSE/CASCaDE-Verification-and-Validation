d:idSpecObject_-356525592_15_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(0).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Test Apparatus. The arrangement of the test apparatus is shown in Figure 1 through 5 and must include the components described in this paragraph. Minor details of the apparatus may vary, depending on the model burner used. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
