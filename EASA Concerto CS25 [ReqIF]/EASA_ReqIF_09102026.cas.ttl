d:idSpecObject_443791706_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Starting at a speed sufficiently above the stalling speed to ensure that a steady rate of speed reduction can be established, apply the longitudinal control so that the speed reduction does not exceed 0.5 m/s2 (one knot per second) until the aeroplane is stalled. (See AMC 25.103(c).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
