	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Flexible fuel tank liners must be approved or must be shown to be suitable for the particular application.</div>" ;
