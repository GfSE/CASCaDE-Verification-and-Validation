d:idSpecObject_1789991084_85
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(5).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Expose the test specimens to the burner flame for 4 minutes and then turn off the burner. Immediately rotate the burner out of the test position. </div>" ;
