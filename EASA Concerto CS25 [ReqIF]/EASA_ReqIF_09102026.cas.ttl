d:idSpecObject_1601993134_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(b)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Need not exceed 1.25 with respect to bearing stresses regardless of the method of inspection used; and</div>" ;
