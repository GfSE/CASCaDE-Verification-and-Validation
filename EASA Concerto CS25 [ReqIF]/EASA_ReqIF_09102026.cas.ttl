d:idSpecObject_1537624992_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(c)(2)(i)(E).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(E) the limit ground loading conditions specified in CS 25.473 and CS 25.491.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
