	a o:idSpecObject1 ;
	rdfs:label "CS 25.871.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">There must be means for determining when the aeroplane is in a level position on the ground. </div>" ;
