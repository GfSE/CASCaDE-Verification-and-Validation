	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_39
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(e)(3)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) each door that could be a hazard if unlatched.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(e)(3)(ii)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_40
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(e)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) There must be an aural warning to the pilots prior to or during the initial portion of take-off roll if any door is not fully closed, latched, and locked, and its opening would prevent a safe take-off and return to landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(e)(4)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_41
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(f).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Visual inspection provision. Each door for which unlatching could be a hazard must have a provision for direct visual inspection to determine, without ambiguity, if the door is fully closed, latched, and locked. The provision must be permanent and discernible under operational lighting conditions, or by means of a flashlight or equivalent light source.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(f)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_42
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(g).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Certain maintenance doors, removable emergency exits, and access panels. Some doors not normally opened except for maintenance purposes or emergency evacuation and some access panels need not comply with certain sub-paragraphs of this paragraph as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(g)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_43
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(g)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Access panels that are not subject to cabin pressurisation and would not be a hazard if open during flight need not comply with sub-paragraphs (a) through (f) of this paragraph, but must have a means to prevent inadvertent opening during flight.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(g)(1)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_44
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(g)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Inward-opening removable emergency exits that are not normally removed, except for maintenance purposes or emergency evacuation, and flight deckopenable windows need not comply with sub-paragraphs (c) and (f) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(g)(2)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_45
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(g)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Maintenance doors that meet the conditions of sub-paragraph (h) of this paragraph, and for which a placard is provided limiting use to maintenance access, need not comply with sub-paragraphs (c) and (f) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(g)(3)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_46
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(h).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Doors that are not a hazard. For the purposes of this paragraph, a door is considered not to be a hazard in the unlatched condition during flight, provided it can be shown to meet all of the following conditions:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(h)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_47
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(h)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Doors in pressurised compartments would remain in the fully closed position if not restrained by the latches when subject to a pressure greater than 3.447 kPa (0.5 psi). Opening by persons, either inadvertently or intentionally, need not be considered in making this determination.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(h)(1)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_48
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(h)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The door would remain inside the aeroplane or remain attached to the aeroplane if it opens either in pressurised or unpressurised portions of the flight. This determination must include the consideration of inadvertent and intentional opening by persons during either pressurised or unpressurised portions of the flight.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(h)(2)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_49
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(h)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The disengagement of the latches during flight would not allow depressurisation of the cabin to an unsafe level. This safety assessment must include the physiological effects on the occupants.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(h)(3)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_50
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(h)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The open door during flight would not create aerodynamic interference that could preclude safe flight and landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "783" ;
	o:idSubref1 "(h)(4)" ;
	o:idTitle1 "Fuselage Doors" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-10100" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1959871857_51
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(h)(5).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) The aeroplane would meet the structural design requirements with the door open. This assessment must include the aeroelastic stability requirements of CS 25.629, as well as the strength requirements of Subpart C.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
