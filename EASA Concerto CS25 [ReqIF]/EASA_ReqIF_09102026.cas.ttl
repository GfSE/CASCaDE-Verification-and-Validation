d:idSpecObject_198645633_46
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx O Part II(c)(7)(i).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The aerofoils, control surfaces, and, if applicable, propellers are free from frost, snow, or ice at the start of take-off;</div>" ;
