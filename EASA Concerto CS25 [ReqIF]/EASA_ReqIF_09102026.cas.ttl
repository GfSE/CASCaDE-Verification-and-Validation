	a o:idSpecObject1 ;
	rdfs:label "CS 25.1021.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">A drain (or drains) must be provided to allow safe drainage of the oil system. Each drain must – </div>" ;
