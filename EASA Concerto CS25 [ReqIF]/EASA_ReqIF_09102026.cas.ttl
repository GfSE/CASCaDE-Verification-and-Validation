	a o:idSpecObject1 ;
	rdfs:label "CS 25.1017(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each oil line must meet the requirements of CS 25.993 and each oil line and fitting in any designated fire zone must meet the requirements of CS 25.1183.</div>" ;
