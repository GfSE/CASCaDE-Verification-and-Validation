	a o:idSpecObject1 ;
	rdfs:label "CS 25.1001(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A power-off glide at 1·3 VSR1;</div>" ;
