	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(c)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Aeroplane cruise Mach Number.</div>" ;
