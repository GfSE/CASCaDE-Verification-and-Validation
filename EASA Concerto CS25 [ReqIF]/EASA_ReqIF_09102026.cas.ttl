	o:idTitle1 "Shut-off means" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "POWERPLANT FIRE PROTECTION" ;
	o:ideRules1 "ERULES-1963177438-9402" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1082908761_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(a)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Lines, fittings, and components forming an integral part of an engine; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
