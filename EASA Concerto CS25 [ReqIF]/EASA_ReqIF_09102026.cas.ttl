	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(b)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The sudden failure of the critical engine; (See AMC 25.143(b)(1).)</div>" ;
