d:idSpecObject_1187850300_38
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(h)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Any other floor-level door or exit that is accessible from the passenger compartment and is as large or larger than a Type II exit, but less than 116.8 cm (46 inches) wide.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
