	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_1568223768_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 1(b)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Compliance with this paragraph may be shown using only those flights for which the aeroplane is dispatched with the flammability reduction means operational. </div>" ;
