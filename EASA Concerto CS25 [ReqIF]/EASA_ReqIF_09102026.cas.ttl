	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The maximum mistrim that can be sustained by the autopilot while maintaining level flight in the high speed cruising condition.</div>" ;
