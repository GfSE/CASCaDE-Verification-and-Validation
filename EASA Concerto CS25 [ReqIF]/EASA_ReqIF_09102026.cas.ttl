	o:idTitle1 "Reversed braking" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8518" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.507.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1860827282_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.507(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The aeroplane must be in a three point static ground attitude. Horizontal reactions parallel to the ground and directed forward must be applied at the ground contact point of each wheel with brakes. The limit loads must be equal to 0·55 times the vertical load at each wheel or to the load developed by 1·2 times the nominal maximum static brake torque, whichever is less.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "507" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Reversed braking" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8518" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1860827282_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.507(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For aeroplanes with nose wheels, the pitching moment must be balanced by rotational inertia.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
