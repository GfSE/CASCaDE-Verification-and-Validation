d:idSpecObject_-1302882791_22_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(3)(0).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Specimen holding system. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
