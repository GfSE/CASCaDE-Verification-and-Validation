	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10202" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_1642579540_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(d)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A passenger emergency exit marking sign next to each passenger emergency exit, except that one sign may serve two such exits if they both can be seen readily from the sign; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
