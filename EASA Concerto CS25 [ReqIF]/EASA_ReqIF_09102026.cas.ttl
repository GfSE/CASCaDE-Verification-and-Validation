d:idSpecObject_-862454206_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) By systematic investigation of each probable combination of weight and centre of gravity, if compliance cannot be reasonably inferred from combinations investigated.</div>" ;
