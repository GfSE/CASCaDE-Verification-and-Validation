d:idSpecObject_-900117897_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.945(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each tank must be able to withstand without failure the vibration, inertia, fluid, and structural loads that it may be subjected to in operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
