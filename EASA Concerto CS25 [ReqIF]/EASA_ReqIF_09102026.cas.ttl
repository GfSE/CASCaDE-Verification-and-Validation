d:idSpecObject_1542664213_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.771(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Vibration and noise characteristics of cockpit equipment may not interfere with safe operation of the aeroplane.</div>" ;
