d:idSpecObject_-356525592_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(3)(i).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) The calorimeter to be used in testing must be a 0–17·0 Watts/cm2 (0– 15·0 BTU per ft2 sec) calorimeter, accurate ± 3%, mounted in a 15 by 31 cm (6-inch by 12-inch) by 19 mm (0·75 inch) thick calcium silicate insulating board which is attached to a steel angle bracket for placement in the test stand during burner calibration, as shown in Figure 4.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(3)(i)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(3)(ii).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Because crumbling of the insulating board with service can result in misalignment of the calorimeter, the calorimeter must be monitored and the mounting shimmed, as necessary, to ensure that the calorimeter face is flush with the exposed plane of the insulating board in a plane parallel to the exit of the test burner cone.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(3)(ii)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(3).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Calorimeter</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(3)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
