	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Electrical Wiring Interconnection System components must meet the requirements of 25.1703, 25.1707, 25.1711 and 25.1717.</div>" ;
