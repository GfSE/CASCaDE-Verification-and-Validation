	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_68
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(e)(4).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Open the bottom door. Remove the calorimeter and holder fixture. Use caution as the fixture is very hot. </div>" ;
