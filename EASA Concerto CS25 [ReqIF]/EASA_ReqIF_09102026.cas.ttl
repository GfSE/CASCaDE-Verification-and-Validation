	o:ideRules1 "ERULES-1963177438-9635" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2010/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.J951.Amendment 9;" ;
	o:idApplicabilityDate1 "2010-08-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2010-08-12T00:00:00Z" .

d:idSpecObject_-2108777033_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J951(a).Amendment 9;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each fuel system must be constructed and arranged to ensure a flow of fuel at a rate and pressure established for proper APU functioning under each likely operating condition, including any manoeuvre for which certification is requested and during which the APU is permitted to be in operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J951" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 9;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-9635" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2010/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2010-08-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2010-08-12T00:00:00Z" .

d:idSpecObject_-2108777033_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J951(b).Amendment 9;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For essential APUs: Each fuel system must be arranged so that any air which is introduced into the system will not result in flameout.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J951" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 9;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-9635" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2010/005/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2010-08-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2010-08-12T00:00:00Z" .

d:idSpecObject_-2108777033_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J951(c).Amendment 9;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) For essential APUs: Each fuel system for an essential APU must be capable of sustained operation throughout its flow and pressure range with fuel initially saturated with water at 26.7 °C and having 0.20 cm3 of free water per liter added and cooled to the most critical condition for icing likely to be encountered in operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J951" ;
