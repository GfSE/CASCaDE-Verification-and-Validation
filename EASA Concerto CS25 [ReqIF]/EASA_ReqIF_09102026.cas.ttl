d:idSpecObject_306483869_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1187(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each designated fire zone must be ventilated to prevent the accumulation of flammable vapours.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
