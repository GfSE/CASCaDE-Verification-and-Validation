d:idSpecObject_-2106828640_3
	a o:idSpecObject1 ;
	rdfs:label "CS25.J1011(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each APU must have an independent oil system that can supply it with an appropriate quantity of oil at a temperature not above that safe for continuous operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
