d:idSpecObject_764655131_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J977(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There must be a fuel strainer for the fuel tank outlet or for the booster pump. This strainer must prevent the passage of any object that could restrict fuel flow or damage any fuel system component.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J977" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Fuel Tank Outlet" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART J – AUXILIARY POWER UNIT INSTALLATIONS" ;
	o:idSubsection1 "FUEL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-9336" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_764655131_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J977(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The clear area of each fuel tank outlet strainer must be at least five times the area of the outlet line.</div>" ;
