d:idSpecObject_-1567730231_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.J901(c)(4).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25J901(c)(4) Electrical Bonding ED Decision 2005/006/R Where the APU is not in direct electrical contact with its mounting the engine should be electrically connected to the main earth system by at least two removable primary conductors, one on each side of the APU. [Amdt 25/1]</div>" ;
