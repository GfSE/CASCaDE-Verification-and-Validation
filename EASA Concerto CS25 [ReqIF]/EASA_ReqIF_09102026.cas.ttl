d:idSpecObject_1642579540_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each passenger emergency exit, its means of access, and its means of opening must be conspicuously marked. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "811" ;
	o:idSubref1 "(a)" ;
