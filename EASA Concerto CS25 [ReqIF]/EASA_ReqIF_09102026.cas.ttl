	a o:idSpecObject1 ;
	rdfs:label "CS 25.519(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Jacking. The aeroplane must have provisions for jacking and must withstand the following limit loads when the aeroplane is supported on jacks: </div>" ;
