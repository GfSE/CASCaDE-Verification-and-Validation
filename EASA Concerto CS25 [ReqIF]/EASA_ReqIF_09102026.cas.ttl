d:idSpecObject_-1885867533_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.672(c)(3).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The trim, stability, and stall characteristics are not impaired below a level needed to permit continued safe flight and landing.</div>" ;
