	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(b)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) A side load factor at the aeroplane centre of gravity of zero.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
