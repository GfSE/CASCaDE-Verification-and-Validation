d:idSpecObject_-1095961204_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1592(a).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) At the discretion of the applicant, supplementary landing performance information may be furnished for aeroplanes landing on slippery wet runways and on runways contaminated with standing water, slush, snow, or ice to be used by operators to support the dispatch of a flight. If information on any one or more of the above surface conditions is not supplied, the AFM must contain a statement that prohibits landing on surfaces that do not meet the minimum friction criteria, or contaminated surface(s) for which information is not supplied. Additional information covering operation on surface conditions other than the above may be provided at the discretion of the applicant.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1592" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Performance information for assessing the landing distance" ;
	o:idAmendedBy1 "Amendment 27;" ;
	o:idSection1 "SUBPART G – OPERATING LIMITATIONS AND INFORMATION" ;
	o:idSubsection1 "SUPPLEMENTARY INFORMATION" ;
	o:ideRules1 "ERULES-1963177438-19061" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2021/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-12-07T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2021-12-07T00:00:00Z" .

d:idSpecObject_-1095961204_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1592(b).Amendment 27;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Landing-distance information must be furnished for assessing the landing performance at the time of arrival on dry, wet, slippery wet runways, and runways contaminated with standing water, slush, snow, or ice.</div>" ;
