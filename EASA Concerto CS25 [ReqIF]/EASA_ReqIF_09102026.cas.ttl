d:idSpecObject_404047824_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(c)(6).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Nickel cadmium battery installations must have –</div>" ;
