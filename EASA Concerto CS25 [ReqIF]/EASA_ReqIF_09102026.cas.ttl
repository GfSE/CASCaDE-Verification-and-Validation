	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-469441825_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.699.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "699" ;
	o:idTitle1 "Lift and drag device indicator" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-8663" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.699.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-469441825_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.699(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There must be means to indicate to the pilots the position of each lift or drag device having a separate control in the cockpit to adjust its position. In addition, an indication of unsymmetrical operation or other malfunction in the lift or drag device systems must be provided when such indication is necessary to enable the pilots to prevent or counteract an unsafe flight or ground condition, considering the effects on flight characteristics and performance.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "699" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Lift and drag device indicator" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SYSTEMS" ;
	o:ideRules1 "ERULES-1963177438-8663" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-469441825_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.699(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) There must be means to indicate to the pilots the take-off, en-route, approach, and landing lift device positions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
