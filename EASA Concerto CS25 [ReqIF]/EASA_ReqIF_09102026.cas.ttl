	a o:idSpecObject1 ;
	rdfs:label "CS 25.23(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The load distribution limits may not exceed – </div>" ;
