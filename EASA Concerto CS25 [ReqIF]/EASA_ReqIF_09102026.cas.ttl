d:idSpecObject_2122803792_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.955(a)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Each main pump must be used that is necessary for each operating condition and attitude for which compliance with this paragraph is shown, and the appropriate emergency pump must be substituted for each main pump so used.</div>" ;
