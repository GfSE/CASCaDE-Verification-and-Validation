d:idSpecObject_-442894939_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1323(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The airspeed error of the installation, excluding the airspeed indicator instrument calibration error, may not exceed 3% or five knots, whichever is greater, throughout the speed range, from –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
