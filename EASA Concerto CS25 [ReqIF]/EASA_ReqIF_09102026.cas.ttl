d:idSpecObject_-351018849_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1415(b)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Unless excess rafts of enough capacity are provided, the buoyancy and seating capacity beyond the rated capacity of the rafts must accommodate all occupants of the aeroplane in the event of a loss of one raft of the largest rated capacity; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
