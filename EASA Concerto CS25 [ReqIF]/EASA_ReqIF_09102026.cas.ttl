d:idSpecObject_-1100064879_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1043(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Maximum ambient atmospheric temperature. A maximum ambient atmospheric temperature corresponding to sea level conditions must be established. The temperature lapse rate is 2.0°C per 300 metres of altitude above sea level until a temperature of -56.5°C is reached, above which altitude, the temperature is considered constant at -56.5°C.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J1043" ;
	o:idSubref1 "(b)" ;
