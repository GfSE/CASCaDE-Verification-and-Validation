d:idSpecObject_1452152415_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(e)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) An altitude and airspeed envelope must be established for in-flight engine restarting, and each engine must have a restart capability within that envelope. (See AMC 25.903(e)(2).)</div>" ;
