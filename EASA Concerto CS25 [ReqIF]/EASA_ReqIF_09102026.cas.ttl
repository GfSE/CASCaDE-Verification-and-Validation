	a o:idSpecObject1 ;
	rdfs:label "CS 25.109(a)(1)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Come to a full stop on a dry runway from the speed reached as prescribed in sub-paragraph (a)(1)(ii) of this paragraph; plus</div>" ;
