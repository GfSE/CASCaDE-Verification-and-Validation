d:idSpecObject_-749083209_27
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(j).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(j) If the seat backs do not provide a firm handhold, there must be a handgrip or rail along each aisle to enable persons to steady themselves while using the aisles in moderately rough air.</div>" ;
