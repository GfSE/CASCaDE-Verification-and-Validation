	a o:idSpecObject1 ;
	rdfs:label "CS 25.1445(a)(2).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A common source of supply with means to separately reserve the minimum supply required by the flight crew on duty.</div>" ;
