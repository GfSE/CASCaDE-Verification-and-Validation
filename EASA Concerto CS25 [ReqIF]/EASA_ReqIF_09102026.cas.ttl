	a o:idSpecObject1 ;
	rdfs:label "CS 25.1197(a)(2).Amendment 12;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Have thermal stability over the temperature range likely to be experienced in the compartment in which they are stored.</div>" ;
