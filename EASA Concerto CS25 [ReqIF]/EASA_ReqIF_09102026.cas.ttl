	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(c)(4).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Aeroplane maximum Range</div>" ;
