d:idSpecObject_-2058332334_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Filler connection. Each recessed oil tank filler connection that can retain any appreciable quantity of oil must have a drain that discharges clear of each part of the aeroplane. In addition each oil tank filler cap must provide an oil-tight seal. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1013" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Oil tanks" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "OIL SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-8438" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-2058332334_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1013(d)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each oil tank must be vented from the top part of the expansion space so that venting is effective under any normal flight condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
