	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) the failure of any single source of hydraulic, electric, or equivalent energy supply.</div>" ;
