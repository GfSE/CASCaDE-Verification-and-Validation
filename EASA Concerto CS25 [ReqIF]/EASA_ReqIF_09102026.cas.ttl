d:idSpecObject_1452152415_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(e)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Means to restart any engine in flight must be provided.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "903" ;
	o:idSubref1 "(e)(1)" ;
	o:idTitle1 "Engines" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-10140" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_1452152415_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(e)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) An altitude and airspeed envelope must be established for in-flight engine restarting, and each engine must have a restart capability within that envelope. (See AMC 25.903(e)(2).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "903" ;
