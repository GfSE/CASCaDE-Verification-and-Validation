d:idSpecObject_443791706_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The following procedures must be used to show compliance with CS 25.203:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "201" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Stall demonstration" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "STALLS" ;
	o:ideRules1 "ERULES-1963177438-10152" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_443791706_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(c)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Starting at a speed sufficiently above the stalling speed to ensure that a steady rate of speed reduction can be established, apply the longitudinal control so that the speed reduction does not exceed 0.5 m/s2 (one knot per second) until the aeroplane is stalled. (See AMC 25.103(c).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "201" ;
	o:idSubref1 "(c)(1)" ;
	o:idTitle1 "Stall demonstration" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "STALLS" ;
	o:ideRules1 "ERULES-1963177438-10152" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_443791706_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) In addition, for turning flight stalls, apply the longitudinal control to achieve airspeed deceleration rates up to 5,6 km/h (3 kt) per second. (See AMC 25.201(c)(2).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "201" ;
	o:idSubref1 "(c)(2)" ;
	o:idTitle1 "Stall demonstration" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "STALLS" ;
	o:ideRules1 "ERULES-1963177438-10152" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_443791706_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.201(c)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) As soon as the aeroplane is stalled, recover by normal recovery techniques.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
