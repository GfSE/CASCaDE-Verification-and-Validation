	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2020-01-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_-1885867533_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.672(c).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) It must be shown that after any single failure of the stability augmentation system or any other automatic or power-operated system:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
