	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-2102244434_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The nose-wheel steering system, unless it is restricted in use to low-speed manoeuvring, must be so designed that exceptional skill is not required for its use during take-off and landing, including the case of cross-wind, and in the event of sudden power-unit failure at any stage during the take-off run. This must be shown by tests. (See AMC 25.745(a).) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "745" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Nose-wheel steering" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10106" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-2102244434_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) It must be shown that, in any practical circumstances, movement of the pilot’s steering control (including movement during retraction or extension or after retraction of the landing gear) cannot interfere with the correct retraction or extension of the landing gear.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "745" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Nose-wheel steering" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10106" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-2102244434_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Under failure conditions the system must comply with CS 25.1309(b) and (c). The arrangement of the system must be such that no single failure will result in a nose-wheel position, which will lead to a Hazardous Effect. Where reliance is placed on nose-wheel steering in showing compliance with CS 25.233, the nose-wheel steering system must be shown to comply with CS 25.1309. (See AMC 25.745(c).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "745" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Nose-wheel steering" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-10106" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-2102244434_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.745(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The nose-wheel steering system, towing attachment(s), and associated elements must be designed or protected by appropriate means such that during ground manoeuvring operations effected by means independent of the aeroplane:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
