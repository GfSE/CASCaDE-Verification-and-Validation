	a o:idSpecObject1 ;
	rdfs:label "CS 25.1419(e)(1).Amendment 7;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A primary ice detection system that automatically activates or alerts the flight crew to activate the airframe ice protection system; or </div>" ;
