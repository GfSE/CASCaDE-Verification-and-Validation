d:idSpecObject_525302954_44
	a o:idSpecObject1 ;
	rdfs:label "CS 25.149(h)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Lateral control must be sufficient to roll the aeroplane, from an initial condition of steady straight flight, through an angle of 20° in the direction necessary to initiate a turn away from the inoperative engine(s), in not more than 5 seconds (see AMC 25.149(h)(3)); and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "149" ;
	o:idSubref1 "(h)(3)" ;
	o:idTitle1 "Minimum control speed" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "CONTROLLABILITY AND MANOEUVRABILITY" ;
	o:ideRules1 "ERULES-1963177438-8260" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_525302954_45
	a o:idSpecObject1 ;
	rdfs:label "CS 25.149(h)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) For propeller aeroplanes, hazardous flight characteristics must not be exhibited due to any propeller position achieved when the engine fails or during any likely subsequent movements of the engine or propeller controls (see AMC 25.149(h)(4)).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
