	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(b)(4).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Go-around manoeuvres with all engines operating. The assessment must include, in addition to controllability and manoeuvrability aspects, the flight crew workload and the risk of a somatogravic illusion. (See AMC 25.143(b)(4))</div>" ;
