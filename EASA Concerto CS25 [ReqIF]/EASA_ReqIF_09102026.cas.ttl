	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1022398883_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.483.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">For the one-gear landing conditions, the aeroplane is assumed to be in the level attitude and to contact the ground on one main landing gear, in accordance with Figure 4 of Appendix A of CS-25. In this attitude – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
