d:idSpecObject_1892022917_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 3(f).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) If any device is used that depends on the operation of any engine, and if the landing distance would be noticeably increased when a landing is made with that engine assumed to fail during the final stages of an all-engines-operating steep approach, the steep approach landing distance must be determined with that engine inoperative unless the use of compensating means will result in a landing distance not more than that with each engine operating.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
