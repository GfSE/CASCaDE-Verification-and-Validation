	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1197(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Fire extinguishing agents must:</div>" ;
