	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx Q 5(b)(3).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Below a height of 200 ft no action shall be taken to increase power or thrust apart from those small changes which are necessary to maintain an accurate approach;</div>" ;
