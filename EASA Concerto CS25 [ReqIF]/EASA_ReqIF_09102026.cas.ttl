	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_306483869_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1187(a)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) Effective under conditions expected to prevail when drainage is needed; and</div>" ;
