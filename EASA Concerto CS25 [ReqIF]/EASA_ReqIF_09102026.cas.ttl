d:idSpecObject_632595865_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.351(a)(1).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) the control system or control surface stops; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
