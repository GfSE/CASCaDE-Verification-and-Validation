d:idSpecObject_1225981764_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1516.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">Any other limitation associated with speed must be established. </div>" ;
