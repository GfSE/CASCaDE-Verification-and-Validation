d:idSpecObject_2092360120_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J939(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The APU air inlet system may not, as a result of air-flow distortion during normal operation, cause vibration harmful to the APU.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
