	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx K 2(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) System in the failure condition. For any system failure condition not shown to be extremely improbable, the following apply: </div>" ;
