	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(g).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) The container of the cockpit voice recorder must –</div>" ;
