	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(c)(2).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If an automatic braking system is installed, means are provided to:</div>" ;
