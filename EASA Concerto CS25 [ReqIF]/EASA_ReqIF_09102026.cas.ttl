d:idSpecObject_-1460114103_32
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(7)(ii).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) any baggage stowage provisions (such as under seat stowage) would prevent baggage items entering the passageway under the inertia forces of CS 25.561(b)(3) unless placards are installed to indicate that no baggage shall be stowed under the seats bounding the passageway.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
