	a o:idSpecObject1 ;
	rdfs:label "CS 25.995(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Be supported so that no loads resulting from their operation or from accelerated flight conditions are transmitted to the lines attached to the valve.</div>" ;
