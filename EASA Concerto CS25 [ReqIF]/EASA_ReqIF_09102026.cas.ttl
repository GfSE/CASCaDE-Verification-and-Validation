	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d)(8)(ii).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) A damage tolerance investigation in accordance with CS 25.571(b) shows that the maximum extent of damage assumed for the purpose of residual strength evaluation does not involve complete failure of the structural element.</div>" ;
