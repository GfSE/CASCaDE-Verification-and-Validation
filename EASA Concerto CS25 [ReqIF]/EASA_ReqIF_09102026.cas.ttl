d:idSpecObject_-1460114103_30
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(7).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) The design of each seat, bulkhead/partition or other feature, bounding the passageway leading to each Type III or Type IV exit must be such that -</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
