	a o:idSpecObject1 ;
	rdfs:label "CS 25.903(e)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Means to restart any engine in flight must be provided.</div>" ;
