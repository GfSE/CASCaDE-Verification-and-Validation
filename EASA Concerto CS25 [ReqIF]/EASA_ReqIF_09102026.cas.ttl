	o:idTitle1 "Emergency exit marking" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10202" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_1642579540_22
	a o:idSpecObject1 ;
	rdfs:label "CS 25.811(g).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Each sign required by sub-paragraph (d) of this paragraph may use the word ‘exit’ in its legend in place of the term ‘emergency exit’ or a universal symbolic exit sign (See AMC 25.812(b)(1), AMC 25.812(b)(2) and AMC 25.812(e)(2)). The design of exit signs must be chosen to provide a consistent set throughout the cabin.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
