d:idSpecObject_-1744053042_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(k).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(k) Oxygen evolution occurs when oxygen dissolved in the fuel is released into the ullage as the pressure and temperature in the fuel tank are reduced.</div>" ;
