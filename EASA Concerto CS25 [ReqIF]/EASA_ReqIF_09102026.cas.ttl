d:idSpecObject_-1112936448_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.655(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Movable tail surfaces must be installed so that there is no interference between any surfaces when one is held in its extreme position and the others are operated through their full angular movement.</div>" ;
