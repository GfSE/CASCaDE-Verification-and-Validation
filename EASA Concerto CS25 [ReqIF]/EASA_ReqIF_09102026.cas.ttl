d:idSpecObject_1082908761_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(f).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) There must be means to guard against inadvertent operation of the shut-off means and to make it possible for the crew to reopen the shut-off means in flight after it has been closed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
