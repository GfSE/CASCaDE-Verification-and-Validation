	a o:idSpecObject1 ;
	rdfs:label "CS 25.J955(a)(2)(iii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) If there is a fuel flowmeter, it must be blocked and the fuel must flow through the meter or its bypass. (See AMC 25J955(a)(2)(iii).)</div>" ;
