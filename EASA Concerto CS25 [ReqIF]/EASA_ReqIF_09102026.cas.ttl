	a o:idSpecObject1 ;
	rdfs:label "CS 25.1461(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Equipment containing high energy rotors must be located where rotor failure will neither endanger the occupants nor adversely affect continued safe flight.</div>" ;
