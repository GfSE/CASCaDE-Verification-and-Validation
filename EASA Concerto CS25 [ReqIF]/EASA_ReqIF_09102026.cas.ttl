	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Each line carrying flammable fluids under pressure must –</div>" ;
