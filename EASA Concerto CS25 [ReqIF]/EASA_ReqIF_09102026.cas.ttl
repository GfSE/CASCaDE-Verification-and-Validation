d:idSpecObject_1350743459_10
	a o:idSpecObject1 ;
	rdfs:label "CS 25.853(d)(3).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Galley structure, including exposed surfaces of stowed carts and standard containers and the cavity walls that are exposed when a full complement of such carts or containers is not carried; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
