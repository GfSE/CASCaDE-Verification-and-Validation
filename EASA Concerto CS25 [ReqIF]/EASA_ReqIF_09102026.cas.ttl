	a o:idSpecObject1 ;
	rdfs:label "CS 25.1015(b)(1)(i).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) For pressurised tanks used with a turbine engine, may not be less than 34 kPa (5 psi) plus the maximum operating pressure of the tank instead of the pressure specified in CS 25.965(a); and</div>" ;
