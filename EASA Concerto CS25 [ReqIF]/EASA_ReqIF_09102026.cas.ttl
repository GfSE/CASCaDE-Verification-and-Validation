d:idSpecObject_1478673283_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(c)(2).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (2) Where continued rotation of an APU could jeopardise the safety of the aeroplane, there must be a means for stopping rotation. Each component of the stopping system located in the APU compartment must be at least fire resistant.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
