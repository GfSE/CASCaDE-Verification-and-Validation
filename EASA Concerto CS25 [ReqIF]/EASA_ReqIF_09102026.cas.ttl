	a o:idSpecObject1 ;
	rdfs:label "CS 25.1549(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each take-off and precautionary range must be marked with a yellow arc or a yellow line; and</div>" ;
