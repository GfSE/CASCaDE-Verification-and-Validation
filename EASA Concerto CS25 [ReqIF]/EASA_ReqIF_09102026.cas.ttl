	a o:idSpecObject1 ;
	rdfs:label "CS 25.685(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) CS 25.689 and CS 25.693 apply to cable systems and joints. </div>" ;
