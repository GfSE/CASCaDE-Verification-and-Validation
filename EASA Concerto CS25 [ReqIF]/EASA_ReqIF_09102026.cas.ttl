	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx H 3(a)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Servicing information that covers details regarding servicing points, capacities of tanks, reservoirs, types of fluids to be used, pressures applicable to the various systems, location of access panels for inspection and servicing, locations of lubrication points, lubricants to be used, equipment required for servicing, tow instructions and limitations, mooring, jacking, and levelling information.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
