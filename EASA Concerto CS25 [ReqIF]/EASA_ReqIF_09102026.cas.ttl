d:idSpecObject_-1744053042_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 2(a).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Bulk Average Fuel Temperature means the average fuel temperature within the fuel tank or different sections of the tank if the tank is subdivided by baffles or compartments. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx N 2" ;
