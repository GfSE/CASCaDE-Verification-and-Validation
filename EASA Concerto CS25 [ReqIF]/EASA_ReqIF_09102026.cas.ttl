	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(h)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Airspeed approved for all-engines-operating initial climb.</div>" ;
