	a o:idSpecObject1 ;
	rdfs:label "CS 25.255(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) –1g to 2·5 g; or</div>" ;
