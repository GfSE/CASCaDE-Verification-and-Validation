d:idSpecObject_-278040378_21
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx N 3(d)(3).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Frequency and duration of time periods of FRM inoperability, substantiated by test or analysis, caused by latent or known failures, including aeroplane system shut-downs and failures that could cause the FRM to shut down or become inoperative,</div>" ;
