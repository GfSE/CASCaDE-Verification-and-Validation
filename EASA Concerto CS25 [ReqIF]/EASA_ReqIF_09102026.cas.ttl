d:idSpecObject_473416160_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.905(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each component of the propeller blade pitch control system must meet the requirements of CS-P 420.</div>" ;
