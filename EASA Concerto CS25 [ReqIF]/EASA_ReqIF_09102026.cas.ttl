	o:idTitle1 "Reversing systems" ;
	o:idAmendedBy1 "Amendment 24;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-18318" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/001/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2020-01-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-01-14T00:00:00Z" .

d:idSpecObject_349408889_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.933(b)(2).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Compliance with this paragraph may be shown by failure analysis or testing, or both, for propeller systems that allow propeller blades to move from the flight low-pitch position to a position that is substantially less than that at the normal flight low-pitch position. The analysis may include or be supported by the analysis made to show compliance with the requirements of CS-P 70 for the propeller and associated installation components.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
