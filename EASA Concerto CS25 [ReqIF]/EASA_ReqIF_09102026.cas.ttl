	a o:idSpecObject1 ;
	rdfs:label "CS 25.207(e)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The most crical of the take-off ice and final take-off ice accretions defined in Appendices C and O, as applicable, in accordance with CS 25.21(g), for each configuration used in the take-off phase of flight;</div>" ;
