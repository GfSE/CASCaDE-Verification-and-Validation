	a o:idSpecObject1 ;
	rdfs:label "CS 25.353(e).Amendment 22;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) With the aeroplane yawed to the opposite overswing sideslip angle, it is assumed that the cockpit rudder control is suddenly returned to neutral.</div>" ;
