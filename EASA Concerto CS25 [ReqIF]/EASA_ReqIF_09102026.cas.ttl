d:idSpecObject_-419854869_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.675(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each control system must have stops that positively limit the range of motion of each movable aerodynamic surface controlled by the system.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
