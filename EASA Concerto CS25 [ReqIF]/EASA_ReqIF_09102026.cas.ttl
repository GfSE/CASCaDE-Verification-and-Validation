	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 4(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Prevents the insertion of the required thrust or power, must be shown to be Improbable;</div>" ;
