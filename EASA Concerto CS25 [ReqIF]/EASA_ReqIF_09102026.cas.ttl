	a o:idSpecObject1 ;
	rdfs:label "CS 25.237(a)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The crosswind component for takeoff established without ice accretions is valid in icing conditions.</div>" ;
