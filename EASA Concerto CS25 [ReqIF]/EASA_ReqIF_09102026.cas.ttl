	o:idSubref1 "(j)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "CONTROLLABILITY AND MANOEUVRABILITY" ;
	o:ideRules1 "ERULES-1963177438-18456" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" ;
	cas:lists d:idSpecObject_1370083084_34 ,
		d:idSpecObject_1370083084_35 .

d:idSpecObject_1370083084_36
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(k).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(k) Side stick controllers In lieu of the maximum control forces provided in CS 25.143(d) for pitch and roll, and in lieu of specific pitch force requirements of CS 25.145(b) and CS 25.175(d), it must be shown that the temporary and maximum prolonged force levels for side stick controllers are suitable for all expected operating conditions and configurations, whether normal or non-normal. It must be shown by flight tests that turbulence does not produce unsuitable pilot-in-the-loop control problems when considering precision path control/tasks.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "143" ;
	o:idSubref1 "(k)" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Amendment 26;" ;
	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "CONTROLLABILITY AND MANOEUVRABILITY" ;
	o:ideRules1 "ERULES-1963177438-18456" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2020/024/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2021-06-22T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1370083084_42
	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(l)(1)(i).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) 2.5 g with the EFCS functioning in its normal mode and with the high-lift devices retracted up to VMO/MMO. The positive limiting load factor may be gradually reduced down to 2.25 g above VMO/MMO.;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
