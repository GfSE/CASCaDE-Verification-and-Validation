	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(a)(2)(i).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Have restricting orifices or other safety devices at the source of pressure to prevent the escape of excessive fluid if the line fails; and</div>" ;
