	a o:idSpecObject1 ;
	rdfs:label "CS 25.111(d)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The segments must be clearly defined and must relate to the distinct changes in the configuration, power or thrust, and speed;</div>" ;
