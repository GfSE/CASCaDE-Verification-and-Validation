	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(c)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) For each test, one set of cushion specimens representing a seat bottom and seat back cushion must be used.</div>" ;
