d:idSpecObject_1783419709_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Emergency operation. There must be an emergency means for extending the landing gear in the event of – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
