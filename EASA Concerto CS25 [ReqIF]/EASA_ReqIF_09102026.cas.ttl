	a o:idSpecObject1 ;
	rdfs:label "CS 25.733(f).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) A means shall be provided to minimise the risk that a tyre is below its minimum serviceable inflation pressure during operation. (See AMC 25.733(f))</div>" ;
