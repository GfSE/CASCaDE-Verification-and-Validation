	a o:idSpecObject1 ;
	rdfs:label "CS 25.1363(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) For each flight condition that cannot be simulated adequately in the laboratory or by ground tests on the aeroplane, flight tests must be made.</div>" ;
