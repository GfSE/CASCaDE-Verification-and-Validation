	o:idTitle1 "Pressurised cabins" ;
	o:idAmendedBy1 "Amendment 15;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PRESSURISATION" ;
	o:ideRules1 "ERULES-1963177438-9971" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2014/026/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2014-07-23T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2014-07-23T00:00:00Z" .

d:idSpecObject_-261558925_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.841(b)(4).Amendment 15;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) An automatic or manual regulator for controlling the intake or exhaust airflow, or both, for maintaining the required internal pressures and airflow rates.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
