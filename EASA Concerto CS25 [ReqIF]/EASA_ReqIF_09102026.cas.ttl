	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The effects of increased contact speed must be investigated if approval of downwind landings exceeding 19 km/h (10 knots) is requested.</div>" ;
