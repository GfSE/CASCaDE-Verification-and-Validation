d:idSpecObject_1959871857_24
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(d)(3)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) have the lock located as close as practicable to the latch; and</div>" ;
