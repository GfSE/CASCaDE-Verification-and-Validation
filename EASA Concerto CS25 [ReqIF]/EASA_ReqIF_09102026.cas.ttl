	o:ideRules1 "ERULES-1963177438-10214" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idParentIR1 "Appendix S – Airworthiness requirements for non-commercially operated aeroplanes and low-occupancy aeroplanes" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_1829045085_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx S 10(b)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Within the compartment, there is at least one emergency exit above the waterline on each side of the fuselage that meets at least the requirements of a type IV emergency exit for a compartment that has a passenger seating configuration of nine seats or less, or of a type III emergency exit otherwise; or</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
