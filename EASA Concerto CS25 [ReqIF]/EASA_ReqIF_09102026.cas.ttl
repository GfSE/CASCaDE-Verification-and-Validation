d:idSpecObject_-796176447_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1023(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each oil radiator must be able to withstand, without failure, any vibration, inertia, and oil pressure load to which it would be subjected in operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
