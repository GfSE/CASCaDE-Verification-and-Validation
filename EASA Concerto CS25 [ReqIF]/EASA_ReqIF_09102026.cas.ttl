d:idSpecObject_1651683409_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part III(e).Amendment 8;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Preparation of Apparatus. Before calibration, all equipment must be turned on and allowed to stabilize, and the burner fuel flow must be adjusted as specified in sub-paragraph (d)(2). </div>" ;
