	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_2055683509_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.777.Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "777" ;
	o:idTitle1 "Cockpit controls" ;
	o:idAmendedBy1 "Amendment 13;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-9743" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2013/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.777.Amendment 13;" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_2055683509_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.777(a).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each cockpit control must be located to provide convenient operation and to prevent confusion and inadvertent operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "777" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Cockpit controls" ;
	o:idAmendedBy1 "Amendment 13;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-9743" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2013/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_2055683509_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.777(b).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The direction of movement of cockpit controls must meet the requirements of CS 25.779. Wherever practicable, the sense of motion involved in the operation of other controls must correspond to the sense of the effect of the operation upon the aeroplane or upon the part operated. Controls of a variable nature using a rotary motion must move clockwise from the off position, through an increasing range, to the full on position. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "777" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Cockpit controls" ;
	o:idAmendedBy1 "Amendment 13;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-9743" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2013/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_2055683509_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.777(c).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The controls must be located and arranged, with respect to the pilots' seats, so that there is full and unrestricted movement of each control without interference from the cockpit structure or the clothing of the minimum flight crew (established under CS 25.1523) when any member of this flight crew from 1.58 m (5ft 2 inches) to 1·91 m (6ft 3 inches) in height, is seated with the seat belt and shoulder harness (if provided) fastened. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "777" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Cockpit controls" ;
	o:idAmendedBy1 "Amendment 13;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-9743" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2013/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2013-06-14T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2013-06-14T00:00:00Z" .

d:idSpecObject_2055683509_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.777(d).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Identical powerplant controls for each engine must be located to prevent confusion as to the engines they control.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "777" ;
	o:idSubref1 "(d)" ;
