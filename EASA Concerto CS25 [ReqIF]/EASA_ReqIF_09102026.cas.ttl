d:idSpecObject_-920989927_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.365(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) If landings may be made with the compartment pressurised, landing loads must be combined with pressure differential loads from zero up to the maximum allowed during landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "365" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Pressurised compartment loads" ;
	o:idAmendedBy1 "Amendment 18;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "SUPPLEMENTARY CONDITIONS" ;
	o:ideRules1 "ERULES-1963177438-10153" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
