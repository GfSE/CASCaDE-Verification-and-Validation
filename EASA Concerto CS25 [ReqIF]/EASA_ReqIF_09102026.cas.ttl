d:idSpecObject_-783279111_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Fuel flow meter system. If a fuel flow meter system is installed, each metering component must have a means for bypassing the fuel supply if malfunction of that component severely restricts fuel flow. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1337" ;
	o:idSubref1 "(c)" ;
