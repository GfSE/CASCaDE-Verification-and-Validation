	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a)(2)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Exceptional piloting strength or skill;</div>" ;
