d:idSpecObject_-783279111_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Each exposed sight gauge, used as a fuel quantity indicator, must be protected against damage.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
