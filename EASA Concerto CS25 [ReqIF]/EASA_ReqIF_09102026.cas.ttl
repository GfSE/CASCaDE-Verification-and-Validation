	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1460114103_36
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(d).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) If it is necessary to pass through a passageway between passenger compartments to reach any required emergency exit from any seat in the passenger cabin, the passageway must be unobstructed. However, curtains may be used if they allow free entry through the passageway.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "813" ;
	o:idSubref1 "(d)" ;
	o:idTitle1 "Emergency exit access and ease of operation" ;
	o:idAmendedBy1 "Amendment 19;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "EMERGENCY PROVISIONS" ;
	o:ideRules1 "ERULES-1963177438-10200" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2017/015/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2017-05-16T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2017-05-16T00:00:00Z" .

d:idSpecObject_-1460114103_37
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(e).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) No door may be installed between any passenger seat that is occupiable for take-off and landing and any passenger emergency exit, such that the door crosses any egress path (including aisles, cross-aisles and passageways). (See AMC 25.813(e))</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
