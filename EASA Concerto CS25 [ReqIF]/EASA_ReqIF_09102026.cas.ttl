	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1082908761_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(g).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(g) Each tank-to-engine shut-off valve must be located so that the operation of the valve will not be affected by powerplant or engine mount structural failure.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
