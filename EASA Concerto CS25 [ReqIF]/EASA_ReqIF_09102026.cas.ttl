	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(2).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Test Burner. The burner to be used in testing must – </div>" ;
