	o:idSection1 "SUBPART B – FLIGHT" ;
	o:idSubsection1 "MISCELLANEOUS FLIGHT REQUIREMENTS" ;
	o:ideRules1 "ERULES-1963177438-10129" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1439567751_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Maximum speed for stability characteristics in icing conditions. The maximum speed for stability characteristics with the most critical of the ice accretions defined in Appendices C and O, as applicable, in accordance with CS 25.21(g), at which the requirements of CS 25.143(g), 25.147(f), 25.175(b)(1), 25.177(a) through (c) and 25.181 must be met, is the lower of:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
