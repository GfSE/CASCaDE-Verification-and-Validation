	o:idReqIfChapterName1 "CS 25.303.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1444542175_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "305" ;
	o:idTitle1 "Strength and deformation" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-9318" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.305.Amendment 1;" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1444542175_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The structure must be able to support limit loads without detrimental permanent deformation. At any load up to limit loads, the deformation may not interfere with safe operation.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "305" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Strength and deformation" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-9318" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1444542175_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.305(b).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The structure must be able to support ultimate loads without failure for at least 3 seconds. However, when proof of strength is shown by dynamic tests simulating actual load conditions, the 3-second limit does not apply. Static tests conducted to ultimate load must include the ultimate deflections and ultimate deformation induced by the loading. When analytical methods are used to show compliance with the ultimate load strength requirements, it must be shown that – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
