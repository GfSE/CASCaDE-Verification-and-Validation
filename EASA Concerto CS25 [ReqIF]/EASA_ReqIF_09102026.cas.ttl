d:idSpecObject_-1359237463_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1187(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Each ventilation means must be arranged so that no discharged vapours will cause an additional fire hazard.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
