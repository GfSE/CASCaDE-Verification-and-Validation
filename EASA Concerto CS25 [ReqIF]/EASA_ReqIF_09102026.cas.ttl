	a o:idSpecObject1 ;
	rdfs:label "CS 25.875(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) No window may be near the propeller tips unless it can withstand the most severe ice impact likely to occur.</div>" ;
