	a o:idSpecObject1 ;
	rdfs:label "CS 25.1353(c)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) No corrosive fluids or gases that may escape from the battery may damage surrounding aeroplane structures or adjacent essential equipment.</div>" ;
