d:idSpecObject_2088256445_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1547(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) A placard meeting the requirements of this paragraph must be installed on, or near, the magnetic direction indicator.</div>" ;
