d:idSpecObject_1601993134_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(c).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Critical castings. (See AMC 25.621(c)) Each casting whose failure could preclude continued safe flight and landing of the aeroplane or could result in serious injury to occupants is considered a critical casting. Each critical casting must have a factor associated with it for showing compliance with strength and deformation requirements, and must comply with the following criteria associated with that factor:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "621" ;
	o:idSubref1 "(c)" ;
	o:idTitle1 "Casting factors" ;
	o:idAmendedBy1 "Amendment 1;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "GENERAL" ;
	o:ideRules1 "ERULES-1963177438-9396" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2005/006/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_1601993134_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(c)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) A casting factor of 1.0 or greater may be used, provided that: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
