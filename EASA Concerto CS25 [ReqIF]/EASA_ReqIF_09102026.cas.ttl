d:idSpecObject_-1509662283_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.735(e)(2).Amendment 14;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) It must, at all times, have priority over the automatic braking system, if installed.</div>" ;
