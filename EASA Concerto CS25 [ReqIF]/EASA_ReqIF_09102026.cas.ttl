d:idSpecObject_798579601_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1041.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The powerplant cooling provisions must be able to maintain the temperatures of powerplant components, and engine fluids, within the temperature limits established for these components and fluids, under ground and flight operating conditions, and after normal engine shutdown. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1041" ;
	o:idTitle1 "General" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART E – POWERPLANT" ;
	o:idSubsection1 "COOLING" ;
	o:ideRules1 "ERULES-1963177438-8470" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1041.Initial issue;" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-103094868_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1043(a)(1).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) If the tests are conducted under conditions deviating from the maximum ambient atmospheric temperature, the recorded power-plant temperatures must be corrected under sub-paragraph (c) of this paragraph.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
