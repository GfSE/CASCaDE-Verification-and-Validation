d:idSpecObject_-920989927_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.365(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) If landings may be made with the compartment pressurised, landing loads must be combined with pressure differential loads from zero up to the maximum allowed during landing.</div>" ;
