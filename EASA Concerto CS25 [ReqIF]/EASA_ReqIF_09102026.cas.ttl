	a o:idSpecObject1 ;
	rdfs:label "CS 25.733(c)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Loads specified in sub-paragraphs (a)(2), (b)(1), (b)(2) and (b)(3) of this paragraph on each nose-wheel tyre.</div>" ;
