d:idSpecObject_-880013300_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.775(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Is inclined 15° or more to the longitudinal axis of the aeroplane; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
