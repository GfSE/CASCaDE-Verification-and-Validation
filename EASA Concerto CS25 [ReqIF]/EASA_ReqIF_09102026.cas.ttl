	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9589" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_-1302882791_34
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(b)(6).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Calorimeter. The calorimeter must be a one-inch cylindrical water-cooled, total heat flux density, foil type Gardon Gage that has a range of 0 to 5.7 Watts/cm2 (0 to 5 BTU/ft2 sec).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
