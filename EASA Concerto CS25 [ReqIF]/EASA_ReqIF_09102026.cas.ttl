	a o:idSpecObject1 ;
	rdfs:label "CS 25.345(b)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) A head-on gust of 7.62m/sec (25 fps) velocity (EAS).</div>" ;
