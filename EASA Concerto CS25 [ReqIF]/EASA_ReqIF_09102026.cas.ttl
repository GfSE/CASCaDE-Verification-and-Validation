	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(a)(2).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Exterior emergency lighting.</div>" ;
