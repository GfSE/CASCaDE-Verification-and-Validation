d:idSpecObject_1959871857_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"></div>" ;
