d:idSpecObject_1187850300_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(a)(8).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(8) Type B. This type is a floor-level exit with a rectangular opening of not less than 81.3 cm (32 inches) wide by 182.9 cm (72 inches) high, with corner radii not greater than 15.3 cm (6 inches).</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
