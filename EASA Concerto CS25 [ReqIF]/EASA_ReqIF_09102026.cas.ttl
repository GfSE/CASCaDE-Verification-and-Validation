d:idSpecObject_-1460114103_17
	a o:idSpecObject1 ;
	rdfs:label "CS 25.813(c)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) There must be access from the nearest aisle to each exit.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
