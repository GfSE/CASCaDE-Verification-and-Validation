d:idSpecObject_-749083209_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.785(h)(6).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Equipped with a restraint system consisting of a combined safety belt and shoulder harness unit with a single point release. There must be means to secure each restraint system when not in use to prevent interference with rapid egress in an emergency.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
