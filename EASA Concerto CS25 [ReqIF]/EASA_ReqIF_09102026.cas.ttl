	a o:idSpecObject1 ;
	rdfs:label "CS 25.967(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each fuel tank must be supported so that tank loads (resulting from the weight of the fuel in the tanks) are not concentrated on unsupported tank surfaces. In addition –</div>" ;
