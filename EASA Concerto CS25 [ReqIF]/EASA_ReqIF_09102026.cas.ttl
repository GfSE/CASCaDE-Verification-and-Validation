	rdfs:label "CS 25.967(a)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Padding must be non-absorbent or treated to prevent the absorption of fluids;</div>" ;
