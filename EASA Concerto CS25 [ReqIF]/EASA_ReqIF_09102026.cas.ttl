	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(d)(1).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) it is controllable in flight;</div>" ;
