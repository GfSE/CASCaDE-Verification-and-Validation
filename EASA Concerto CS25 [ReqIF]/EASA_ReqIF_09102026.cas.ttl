d:idSpecObject_-356525592_15_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(0).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Test Apparatus. The arrangement of the test apparatus is shown in Figure 1 through 5 and must include the components described in this paragraph. Minor details of the apparatus may vary, depending on the model burner used. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
	o:idSubref1 "(d)(0)" ;
	o:idTitle1 "Flammability of Seat Cushions" ;
	o:idAmendedBy1 "Amendment 17;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-10033" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/019/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-07-17T00:00:00Z" .

d:idSpecObject_-356525592_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(1).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Specimen Mounting Stand. The mounting stand for the test specimens consists of steel angles, as shown in Figure 1. The length of the mounting stand legs is 305 ± 3mm (12 ± 0·125 inches). The mounting stand must be used for mounting the test specimen seat bottom and seat back, as shown in Figure 2. The mounting stand should also include a suitable drip pan lined with aluminium foil, dull side up. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part II" ;
