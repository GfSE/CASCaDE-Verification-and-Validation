	a o:idSpecObject1 ;
	rdfs:label "CS 25.20(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) In the absence of an appropriate investigation of operational implications these requirements do not necessarily cover –</div>" ;
