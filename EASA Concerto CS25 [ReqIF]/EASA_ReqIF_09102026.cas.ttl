d:idSpecObject_-1302882791_85
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VI(h)(2).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The flame time after removal of the pilot burner may not exceed 3 seconds on any specimen.</div>" ;
