	rdfs:label "CS 25.1309(b)(5)(ii).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) given that a single latent failure has occurred on a given flight, the failure condition is remote; and</div>" ;
