	a o:idSpecObject1 ;
	rdfs:label "CS 25.253(a)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) Exceeding VD/MD, VDF/MDF, or the structural limitations; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
