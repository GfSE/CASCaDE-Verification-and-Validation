	a o:idSpecObject1 ;
	rdfs:label "CS 25.703(a)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The parking brake is unreleased.</div>" ;
