d:idSpecObject_1224749019_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.791.Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.791) </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "791" ;
	o:idTitle1 " Passenger information signs and placards" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-8148" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.791.Amendment 23;" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1224749019_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.791(a).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) If smoking is to be prohibited, there must be at least one placard so stating that is legible to each person seated in the cabin. If smoking is to be allowed, and if the crew compartment is separated from the passenger compartment, there must be at least one sign notifying when smoking is prohibited. Signs, which notify when smoking is prohibited, must be installed so as to be operable from either pilot’s seat and, when illuminated, must be legible under all probable conditions of cabin illumination to each person seated in the cabin.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "791" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 " Passenger information signs and placards" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-8148" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1224749019_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.791(b).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Signs that notify when seat belts should be fastened and that are installed to comply with the Operating Rules must be installed so as to be operable from either pilot’s seat and, when illuminated, must be legible under all probable conditions of cabin illumination to each person seated in the cabin.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "791" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 " Passenger information signs and placards" ;
	o:idAmendedBy1 "Amendment 23;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "PERSONNEL AND CARGO ACCOMMODATIONS" ;
	o:ideRules1 "ERULES-1963177438-8148" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2019/013/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2019-07-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2019-07-17T00:00:00Z" .

d:idSpecObject_1224749019_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.791(c).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) A placard must be located on or adjacent to the door of each receptacle used for the disposal of flammable waste materials to indicate that use of the receptacle for disposal of cigarettes, etc., is prohibited.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
