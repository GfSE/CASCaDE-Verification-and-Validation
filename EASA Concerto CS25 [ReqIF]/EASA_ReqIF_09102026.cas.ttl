	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1189(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each APU compartment specified in CS 25J1181(a) must have a means to shut-off or otherwise prevent hazardous quantities of flammable fluids, from flowing into, within, or through any designated fire zone, except that shut-off means are not required for:</div>" ;
