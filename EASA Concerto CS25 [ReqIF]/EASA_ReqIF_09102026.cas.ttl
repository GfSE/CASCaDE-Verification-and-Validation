d:idSpecObject_-1702518332_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1435(b)(5).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Be designed to use any suitable hydraulic fluid specified by the aeroplane manufacturer, which must be identified by appropriate markings as required by CS 25.1541.</div>" ;
