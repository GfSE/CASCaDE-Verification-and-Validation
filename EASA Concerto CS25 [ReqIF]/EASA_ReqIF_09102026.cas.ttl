d:idSpecObject_-2062423000_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(b).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The applicant must validate that the FRM meets the requirements of paragraph M25.1 of this appendix with any aeroplane or engine configuration affecting the performance of the FRM for which approval is sought. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
