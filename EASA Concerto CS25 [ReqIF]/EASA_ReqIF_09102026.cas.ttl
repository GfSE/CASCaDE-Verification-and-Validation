d:idSpecObject_481494173_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.1357(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.1357(a) Circuit protective devices ED Decision 2003/2/RM No hazard should result from the effects of variations in ambient temperatures on either the protective device or the equipment it protects. See also CS 25.1309.</div>" ;
