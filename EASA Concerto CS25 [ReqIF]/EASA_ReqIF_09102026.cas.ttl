	a o:idSpecObject1 ;
	rdfs:label "CS 25.1707(j)(2).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Hot air leakage or generated heat onto EWIS components will not create a hazardous condition. </div>" ;
