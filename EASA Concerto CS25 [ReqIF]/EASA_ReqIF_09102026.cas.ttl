d:idSpecObject_1804459601_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 5(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) That shown to be free of hazardous engine response characteristics when thrust or power is increased from the initial take-off thrust or power level to the maximum approved take-off thrust or power.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
