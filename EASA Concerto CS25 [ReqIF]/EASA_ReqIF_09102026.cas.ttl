	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2018-03-28T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2018-03-28T00:00:00Z" .

d:idSpecObject_2088178893_12
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1303(b)(5).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) A bank and pitch indicator (gyroscopically stabilised). (See AMC 25.1303(b)(5).)</div>" ;
