	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx H 3.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The contents of the manual or manuals must be prepared in a language acceptable to the Agency. The Instructions for Continued Airworthiness must contain the following manuals or sections, as appropriate, and information:</div>" ;
