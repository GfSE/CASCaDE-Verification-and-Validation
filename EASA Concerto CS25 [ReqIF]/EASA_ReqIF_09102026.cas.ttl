d:idSpecObject_1959871857_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(c)(2)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) with jamming as a result of mechanical failure or blocking debris, the door need not close and latch if it can be shown that the pressurisation loads on the jammed door or mechanism would not result in an unsafe condition.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
