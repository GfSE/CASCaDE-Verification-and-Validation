d:idSpecObject_89561894_15
	a o:idSpecObject1 ;
	rdfs:label "CS 25.147(c).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Lateral control; general. It must be possible to make 20° banked turns, with and against the inoperative engine, from steady flight at a speed equal to 1·3 VSR1, with – </div>" ;
