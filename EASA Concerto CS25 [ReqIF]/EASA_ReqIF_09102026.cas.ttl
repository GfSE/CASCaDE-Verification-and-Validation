	o:idSubsection1 "AIR INTAKE SYSTEM" ;
	o:ideRules1 "ERULES-1963177438-10135" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2016/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1182953428_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1093(b)(1)(i).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Adversely affect installed engine operation or cause a sustained loss of power or thrust; or an unacceptable increase in gas path operating temperature; or an airframe/engine incompatibility; or</div>" ;
