	a o:idSpecObject1 ;
	rdfs:label "CS 25.145(b)(3).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Repeat sub-paragraph (b)(2) of this paragraph except at the go-around power or thrust setting. (See AMC 25.145(b)(1), (b)(2) and (b)(3).)</div>" ;
