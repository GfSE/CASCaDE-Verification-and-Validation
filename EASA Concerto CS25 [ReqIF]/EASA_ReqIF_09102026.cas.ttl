d:idSpecObject_-1624084903_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.963(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Integral fuel tanks must have facilities for interior inspection and repair.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
