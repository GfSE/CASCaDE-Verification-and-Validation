d:idSpecObject_-734172937_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.445(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) When significant, the aerodynamic influence between auxiliary aerodynamic surfaces, such as outboard fins and winglets, and their supporting aerodynamic surfaces must be taken into account for all loading conditions including pitch, roll and yaw manoeuvres, and gusts as specified in CS 25.341(a) acting at any orientation at right angles to the flight path.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "445" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Outboard fins" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "CONTROL SURFACE AND SYSTEM LOADS" ;
	o:ideRules1 "ERULES-1963177438-8447" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-734172937_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.445(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) To provide for unsymmetrical loading when outboard fins extend above and below the horizontal surface, the critical vertical surface loading (load per unit area) determined under CS 25.391 must also be applied as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
