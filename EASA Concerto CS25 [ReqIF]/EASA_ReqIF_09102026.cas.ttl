	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(c)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Specimen preparation. Prepare a minimum of three specimen sets of the same construction and configuration for testing. </div>" ;
