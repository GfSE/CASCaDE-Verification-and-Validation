d:idSpecObject_-920989927_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.365.Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.365)For aeroplanes with one or more pressurised compartments the following apply: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
