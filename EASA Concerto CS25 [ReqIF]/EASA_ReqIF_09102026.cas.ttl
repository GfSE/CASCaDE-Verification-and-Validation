d:idSpecObject_-351018849_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1415(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each liferaft and each life preserver must be approved. In addition –</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
