	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-900117897_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.945(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Fluid tanks. Each augmentation system fluid tank must meet the following requirements: </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
