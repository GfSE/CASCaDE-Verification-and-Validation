	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(c)(3).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The seat back cushion specimen must be 457 ± 3 mm (18 ± 0·125 inches) wide by 635 ± 3 mm (25 ± 0·125 inches) high by 51 ± 3 mm (2 ± 0·125 inches) thick, exclusive of fabric closures and seam overlap.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
