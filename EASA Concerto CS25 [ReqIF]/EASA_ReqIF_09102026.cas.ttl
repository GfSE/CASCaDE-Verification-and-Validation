		d:idSpecObject_1959871857_39 .

d:idSpecObject_1959871857_40
	a o:idSpecObject1 ;
	rdfs:label "CS 25.783(e)(4).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) There must be an aural warning to the pilots prior to or during the initial portion of take-off roll if any door is not fully closed, latched, and locked, and its opening would prevent a safe take-off and return to landing.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
