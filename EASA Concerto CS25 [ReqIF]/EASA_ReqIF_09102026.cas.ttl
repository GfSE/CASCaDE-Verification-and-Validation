	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(d)(3).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Rafts automatically or remotely released outside the aeroplane must be attached to the aeroplane by means of the static line prescribed in CS 25.1415.</div>" ;
