	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1043(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) General. Compliance with CS 25J1041 must be shown by tests, under critical conditions. For these tests, the following apply:</div>" ;
