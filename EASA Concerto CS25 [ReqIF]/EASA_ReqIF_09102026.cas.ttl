	a o:idSpecObject1 ;
	rdfs:label "CS 25.1193(f)(1).Amendment 21;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) keep the cowling closed and secured under the operational loads identified in subparagraph (a) of this paragraph following either of the following conditions: </div>" ;
