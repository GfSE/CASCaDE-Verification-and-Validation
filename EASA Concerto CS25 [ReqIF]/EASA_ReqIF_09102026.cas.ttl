	a o:idSpecObject1 ;
	rdfs:label "CS 25.1415(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) There must be an approved survival type emergency locator transmitter for use in one life raft.</div>" ;
