	a o:idSpecObject1 ;
	rdfs:label "CS 25.J903(e)(1)(i).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) Means must be provided to start the APU in-flight, and</div>" ;
