d:idSpecObject_1047426119_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.809(f).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Each door must be located where persons using them will not be endangered by the propellers when appropriate operating procedures are used.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
