	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(g)(2).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Be arranged to allow the lifelines to be used to enable the occupants to stay on the wing after ditching. This requirement is not applicable to aeroplanes having no over-wing ditching exits.</div>" ;
