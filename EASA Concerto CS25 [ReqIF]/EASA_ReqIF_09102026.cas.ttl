	a o:idSpecObject1 ;
	rdfs:label "CS 25.1555(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each aerodynamic control must be marked under the requirements of CS 25.677 and 25.699.</div>" ;
