d:idSpecObject_1477179654_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1106(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) For APU bleed air duct systems, no hazard may result if a duct failure occurs at any point between the air duct source and the aeroplane unit served by the bleed air.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
