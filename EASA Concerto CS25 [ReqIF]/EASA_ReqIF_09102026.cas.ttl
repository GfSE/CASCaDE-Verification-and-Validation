d:idSpecObject_1575056278_11
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) In addition to the loading conditions prescribed in sub-paragraph (a) of this paragraph, but with maximum vertical ground reactions calculated from paragraph (a), the following apply:</div>" ;
