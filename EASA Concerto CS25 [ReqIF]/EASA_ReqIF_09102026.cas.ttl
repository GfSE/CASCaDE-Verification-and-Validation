	rdfs:label "CS 25.509(c)(2)(ii).Amendment 13;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) The loads must be reacted by aeroplane inertia.</div>" ;
