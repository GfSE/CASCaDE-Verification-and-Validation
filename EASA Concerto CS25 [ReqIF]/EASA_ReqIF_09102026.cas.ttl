	a o:idSpecObject1 ;
	rdfs:label "CS 25.675(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Each stop must be able to withstand any loads corresponding to the design conditions for the control system.</div>" ;
