	a o:idSpecObject1 ;
	rdfs:label "CS 25.203(c)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Approximately 60° in the original direction of the turn, or 30° in the opposite direction, for deceleration rates up to 0.5 m/s2 (1 knot per second); and</div>" ;
