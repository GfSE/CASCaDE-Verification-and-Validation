	a o:idSpecObject1 ;
	rdfs:label "CS 25.621(d)(3).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) A casting factor of 1.5 or greater may be used, provided that each casting receives inspection of 100 percent of its surface using visual and liquid penetrant, or equivalent, inspection methods.</div>" ;
