d:idSpecObject_-1955962065_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.1447(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.1447(c) Equipment standards for oxygen dispensing units ED Decision 2003/2/RM Where Operational Regulations do not require all passengers to be provided with oxygen, (c)(3) and (c)(4) may not apply. </div>" ;
