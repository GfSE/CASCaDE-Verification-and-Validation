d:idSpecObject_1995393275_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1322(c)(2).Amendment 11;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) provide timely attention-getting cues through at least two different senses by a combination of aural, visual, or tactile indications;</div>" ;
