d:idSpecObject_-376552637_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1103(b)(1).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\"> (1) Designed to prevent air intake system failures resulting from reverse flow, APU surging, or inlet door closure; and</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "J1103" ;
	o:idSubref1 "(b)(1)" ;
