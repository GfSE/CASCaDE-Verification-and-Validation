d:idSpecObject_1805953230_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Ice accretions - General. The most critical ice accretion in terms of aeroplane performance and handling qualities for each flight phase must be used to show compliance with the applicable aeroplane performance and handling requirements in icing conditions of subpart B of this part. Applicants must demonstrate that the full range of atmospheric icing conditions specified in part I of this appendix have been considered, including the mean effective drop diameter, liquid water content, and temperature appropriate to the flight conditions (for example, configuration, speed, angle-of-attack, and altitude). The ice accretions for each flight phase are defined as follows:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(a)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a)(1).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Take-off Ice is the most critical ice accretion on unprotected surfaces, and any ice accretion on the protected surfaces appropriate to normal ice protection system operation, occurring between the end of the take-off distance and 122 m (400 ft) above the take-off surface, assuming accretion starts at the end of the take-off distance in the take-off maximum icing conditions of Part I, paragraph (c) of this Appendix. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a)(2).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Final Take-off Ice is the most critical ice accretion on unprotected surfaces, and any ice accretion on the protected surfaces appropriate to normal ice protection system operation, between 122 m (400 ft) and either 457 m (1500 ft) above the take-off surface, or the height at which the transition from the take-off to the en route configuration is completed and VFTO is reached, whichever is higher. Ice accretion is assumed to start at the end of the take-off distance in the take-off maximum icing conditions of Part I, paragraph (c) of this Appendix.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a)(3).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) En-route Ice is the critical ice accretion on the unprotected surfaces, and any ice accretion on the protected surfaces appropriate to normal ice protection system operation, during the en-route phase.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(a)(3)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a)(4).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Holding Ice is the critical ice accretion on the unprotected surfaces, and any ice accretion on the protected surfaces appropriate to normal ice protection system operation, during the holding flight phase.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(a)(4)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a)(5).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(5) Approach ice is the critical ice accretion on the unprotected surfaces, and any ice accretion on the protected surfaces appropriate to normal ice protection system operation following exit from the holding flight phase and transition to the most critical approach configuration.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx C Part II" ;
	o:idSubref1 "(a)(5)" ;
	o:idTitle1 "Airframe Ice Accretions" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix C" ;
	o:ideRules1 "ERULES-1963177438-10005" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" .

d:idSpecObject_1805953230_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx C Part II(a)(6).Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(6) Landing ice is the critical ice accretion on the unprotected surfaces, and any ice accretion on the protected surfaces appropriate to normal ice protection system operation following exit from the approach flight phase and transition to the final landing configuration.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
