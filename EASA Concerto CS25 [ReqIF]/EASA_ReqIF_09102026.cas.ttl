	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1054426491_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1153(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) If feathering is accomplished by movement of the propeller pitch or speed control lever, there must be means to prevent the inadvertent movement of this lever to the feathering position during normal operation.</div>" ;
