	a o:idSpecObject1 ;
	rdfs:label "CS 25.21(a).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each requirement of this Subpart must be met at each appropriate combination of weight and centre of gravity within the range of loading conditions for which certification is requested. This must be shown –</div>" ;
