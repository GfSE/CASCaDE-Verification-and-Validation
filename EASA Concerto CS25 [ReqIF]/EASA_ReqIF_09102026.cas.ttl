d:idSpecObject_1804459601_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 5.Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The initial setting of thrust or power controls on each engine at the beginning of the take-off roll may not be less than the lesser of – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
