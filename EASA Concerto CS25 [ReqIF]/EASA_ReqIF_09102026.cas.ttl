	a o:idSpecObject1 ;
	rdfs:label "CS 25.J993(f).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Each fuel line within the fuselage must be designed and installed to allow a reasonable degree of deformation and stretching without leakage. </div>" ;
