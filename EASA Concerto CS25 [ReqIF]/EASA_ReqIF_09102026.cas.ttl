d:idSpecObject_431726346_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.161(d).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) Longitudinal, directional, and lateral trim. The aeroplane must maintain longitudinal, directional, and lateral trim (and for lateral trim, the angle of bank may not exceed 5°) at 1·3 VSR1, during the climbing flight with – </div>" ;
