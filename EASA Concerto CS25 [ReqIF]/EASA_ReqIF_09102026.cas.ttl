	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8526" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1383213079_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(e)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The applied side or drag load factor, or both factors, at the centre of gravity must be the most critical value up to 50% and 40%, respectively, of the limit side or drag load factors, or both factors, corresponding to the most severe condition resulting from consideration of the prescribed taxying and ground handling conditions.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "511" ;
	o:idSubref1 "(e)(1)" ;
	o:idTitle1 "Ground load: unsymmetrical loads on multiple-wheel units" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART C – STRUCTURE" ;
	o:idSubsection1 "GROUND LOADS" ;
	o:ideRules1 "ERULES-1963177438-8526" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1383213079_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.511(e)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For the braked roll conditions of CS 25.493(a) and (b)(2), the drag loads on each inflated tyre may not be less than those at each tyre for the symmetrical load distribution with no deflated tyres;</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
