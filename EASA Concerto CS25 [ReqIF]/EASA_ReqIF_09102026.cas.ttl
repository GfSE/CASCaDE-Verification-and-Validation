	a o:idSpecObject1 ;
	rdfs:label "CS 25.499(b)(3).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Side and vertical loads at the ground contact point on the nose gear that are required for static equilibrium.</div>" ;
