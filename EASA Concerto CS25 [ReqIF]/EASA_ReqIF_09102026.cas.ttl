	a o:idSpecObject1 ;
	rdfs:label "CS 25.773(b).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Precipitation conditions. For precipitation conditions, the following apply: </div>" ;
