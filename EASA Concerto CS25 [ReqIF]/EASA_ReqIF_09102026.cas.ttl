	a o:idSpecObject1 ;
	rdfs:label "CS 25.1415(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) Approved survival equipment must be attached to, or stored adjacent to, each liferaft.</div>" ;
