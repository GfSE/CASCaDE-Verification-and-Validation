	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part IV(h)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Data giving release rates of heat (in kW/m2) as a function of time, either graphically or tabulated at intervals no greater than 10 seconds. The calibration factor (Kh) must be recorded.</div>" ;
