d:idSpecObject_1098922692_18
	a o:idSpecObject1 ;
	rdfs:label "CS 25.671(f).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) If the flight control system has multiple modes of operation, appropriate flight crew alerting must be provided whenever the aeroplane enters any mode that significantly changes or degrades the normal handling or operational characteristics of the aeroplane.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
