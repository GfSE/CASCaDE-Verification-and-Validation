d:idSpecObject_1391187770_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.125(c).Amendment 3;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25.125(c) Landing ED Decision 2007/010/R 1 During measured landings, if the brakes can be consistently applied in a manner permitting the nose gear to touch down safely, the brakes may be applied with only the main wheels firmly on the ground. Otherwise, the brakes should not be applied until all wheels are firmly on the ground. 2 This is not intended to prevent operation in the normal way of automatic braking systems which, for instance, permit brakes to be selected on before touchdown. [Amdt 25/3]</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
