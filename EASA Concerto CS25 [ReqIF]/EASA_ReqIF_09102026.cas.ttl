	a o:idSpecObject1 ;
	rdfs:label "CS 25.831(f)(3).Amendment 23;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) The temperature and ventilation controls are accessible to the flight crew.</div>" ;
