	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1203(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) There must be approved, quick acting fire or overheat detectors in each APU compartment in numbers and locations ensuring prompt detection of fire.</div>" ;
