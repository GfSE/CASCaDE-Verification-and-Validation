	a o:idSpecObject1 ;
	rdfs:label "CS 25.1561(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each location, such as a locker or compartment, that carries any fire extinguishing, signalling, or other lifesaving equipment must be marked accordingly.</div>" ;
