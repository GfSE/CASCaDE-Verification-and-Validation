	a o:idSpecObject1 ;
	rdfs:label "CS 25.971(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Each fuel tank must allow drainage of any hazardous quantity of water from any part of the tank to its sump with the aeroplane in the ground attitude.</div>" ;
