	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx M 2(e).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Oxygen-enriched air produced by the FRM must not create a hazard during normal operating conditions.</div>" ;
