d:idSpecObject_-848608315_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx H 1(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) This Appendix specifies requirements for the preparation of Instructions for Continued Airworthiness as required by CS 25.1529 and CS 25.1729</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
