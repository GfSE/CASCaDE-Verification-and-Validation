d:idSpecObject_-1242179030_14
	a o:idSpecObject1 ;
	rdfs:label "CS 25.177(c)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) a rudder control force of 180 pounds. This requirement must be met for the configurations and speeds specified in sub-paragraph (a) of this paragraph. (See AMC 25.177(c).)</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
