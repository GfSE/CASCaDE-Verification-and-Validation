	rdfs:label "CS 25.1460(b)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) (i) it receives its electrical power from the bus that provides the maximum reliability for the operation of the recorder without jeopardising service to essential or emergency loads; and</div>" ;
