d:idSpecObject_-59689317_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.961(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) For turbine engine powered aeroplanes, the engines must operate at take-off power for the time interval selected for showing the take-off flight path, and at maximum continuous power for the rest of the climb.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
