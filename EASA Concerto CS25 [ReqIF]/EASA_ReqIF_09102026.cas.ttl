d:idSpecObject_-356525592_20
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part II(d)(2)(iii).Amendment 17;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(iii) Have a 31 cm (12-inch) burner cone installed at the end of the draft tube, with an opening 15 cm (6 inches) high and 28 cm (11 inches) wide, as shown in Figure 3; and </div>" ;
