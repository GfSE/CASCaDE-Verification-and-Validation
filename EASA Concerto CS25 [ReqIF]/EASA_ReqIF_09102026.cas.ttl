d:idSpecObject_-1413292297_3
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J952(a).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Proper fuel system functioning under all probable operating conditions must be shown by analysis and those tests found necessary by the Agency. Tests, if required, must be made using the aeroplane fuel system or a test article that reproduces the operating characteristics of the portion of the fuel system to be tested.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
