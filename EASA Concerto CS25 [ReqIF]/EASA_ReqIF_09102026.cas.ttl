d:idSpecObject_69105852_4_zero
	a o:idSpecObject1 ;
	rdfs:label "CS 25.723(a)(0).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) The analytical representation of the landing gear dynamic characteristics that is used in determining the landing loads must be validated by energy absorption tests. A range of tests must be conducted to ensure that the analytical representation is valid for the design conditions specified in CS 25.473.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "723" ;
	o:idSubref1 "(a)(0)" ;
	o:idTitle1 "Shock absorption tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-8679" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_69105852_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.723(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) The configurations subjected to energy absorption tests at limit design conditions must include at least the design landing weight or the design takeoff weight, whichever produces the greater value of landing impact energy.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "723" ;
	o:idSubref1 "(a)(1)" ;
	o:idTitle1 "Shock absorption tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-8679" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_69105852_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.723(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The test attitude of the landing gear unit and the application of appropriate drag loads during the test must simulate the aeroplane landing conditions in a manner consistent with the development of rational or conservative limit loads.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "723" ;
	o:idSubref1 "(a)(2)" ;
	o:idTitle1 "Shock absorption tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-8679" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_69105852_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.723(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The landing gear may not fail in a test, demonstrating its reserve energy absorption capacity, simulating a descent velocity of 3.7 m/s (12 fps) at design landing weight, assuming aeroplane lift not greater than the aeroplane weight acting during the landing impact.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "723" ;
	o:idSubref1 "(b)" ;
	o:idTitle1 "Shock absorption tests" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "LANDING GEAR" ;
	o:ideRules1 "ERULES-1963177438-8679" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_69105852_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.723(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) In lieu of the tests prescribed in this paragraph, changes in previously approved design weights and minor changes in design may be substantiated by analyses based on previous tests conducted on the same basic landing gear system that has similar energy absorption characteristics.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
