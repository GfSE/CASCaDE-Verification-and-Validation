d:idSpecObject_-718172015_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.231(a)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) If a tail-wheel landing gear is used, it must be possible, during the take-off ground run on concrete, to maintain any attitude up to thrust line level, at 75% of VSR1.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
