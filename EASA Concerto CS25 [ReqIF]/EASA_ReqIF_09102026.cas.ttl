	a o:idSpecObject1 ;
	rdfs:label "CS 25.1337(e).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(e) Turbo-propeller blade position indicator. Required turbo-propeller blade position indicators must begin indicating before the blade moves more than 8° below the flight low pitch stop. The source of indication must directly sense the blade position. </div>" ;
