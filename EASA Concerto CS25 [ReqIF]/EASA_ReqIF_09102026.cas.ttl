	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.J1521.Amendment 1;" ;
	o:idApplicabilityDate1 "2005-12-12T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2005-12-12T00:00:00Z" .

d:idSpecObject_-1943974257_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1527.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">The extremes of the ambient air temperature and operating altitude for which operation is allowed, as limited by flight, structural, APU installation, functional, or equipment characteristics, must be established. </div>" ;
