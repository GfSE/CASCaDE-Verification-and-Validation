d:idSpecObject_-682857235_root
	a o:idSpecObject1 ;
	rdfs:label "AMC 25.J991.Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">AMC 25J991 Fuel Pumps ED Decision 2005/006/R If the fuel supply to the APU is taken from the fuel supply to the main engine, no separate pumps need be provided for the APU. [Amdt 25/1]</div>" ;
