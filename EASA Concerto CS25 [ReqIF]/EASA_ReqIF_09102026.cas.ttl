	o:idEntryIntoForceDate1 "2020-12-23T00:00:00Z" .

d:idSpecObject_1187850300_33
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(g)(9)(i).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(i) For a ventral exit, 12 additional passenger seats.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
