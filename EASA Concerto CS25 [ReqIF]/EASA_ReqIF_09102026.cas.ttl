d:idSpecObject_703832581_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx I 4(c).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The inadvertent operation of the ATTCS system must be shown either to be Remote or to have no more than a minor effect.</div>" ;
