d:idSpecObject_1789991084_53
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(c)(2)(ii).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) For rigid and other non-conforming types of insulation materials, the finished test specimens must fit into the test rig in such a manner as to replicate the actual in-service installation. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
