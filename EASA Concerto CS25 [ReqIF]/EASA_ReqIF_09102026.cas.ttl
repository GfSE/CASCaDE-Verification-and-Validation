	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_326914144_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.485(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Side loads of 0·8 of the vertical reaction (on one side) acting inward and 0·6 of the vertical reaction (on the other side) acting outward must be combined with one-half of the maximum vertical ground reactions obtained in the level landing conditions. These loads are assumed to be applied at the ground contact point and to be resisted by the inertia of the aeroplane. The drag loads may be assumed to be zero.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
