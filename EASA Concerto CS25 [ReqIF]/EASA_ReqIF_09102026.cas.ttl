	a o:idSpecObject1 ;
	rdfs:label "CS 25.1547(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) The placard must show the calibration of the instrument in level flight with the engines operating.</div>" ;
