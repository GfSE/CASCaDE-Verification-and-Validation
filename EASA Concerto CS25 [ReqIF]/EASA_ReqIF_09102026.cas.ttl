	a o:idSpecObject1 ;
	rdfs:label "CS 25.143(l)(1)(ii).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) 2.0 g with the EFCS functioning in its normal mode and with the high-lift devices extended.</div>" ;
