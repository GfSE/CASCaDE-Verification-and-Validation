d:idSpecObject_-125199643_29
	a o:idSpecObject1 ;
	rdfs:label "CS 25.812(h)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) If the assisting means is illuminated by exterior emergency lighting, it must provide illumination of not less than 0.3 lux (0.03 foot candle) (measured normal to the direction of the incident light) at the ground end of the erected assisting means where an evacuee using the established escape route would normally make first contact with the ground, with the aeroplane in each of the attitudes corresponding to the collapse of one or more legs of the landing gear.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
