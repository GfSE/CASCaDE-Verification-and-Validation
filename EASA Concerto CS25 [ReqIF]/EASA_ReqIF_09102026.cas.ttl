	a o:idSpecObject1 ;
	rdfs:label "CS 25.1461(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) High energy rotors contained in equipment must be able to withstand damage caused by malfunctions, vibration, abnormal speeds, and abnormal temperatures. In addition –</div>" ;
