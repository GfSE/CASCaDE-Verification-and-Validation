d:idSpecObject_-663336739_root
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1326.Amendment 16;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(See AMC 25.1326)If a flight instrument external probe heating system is installed, an alert must be provided to the flight crew when the flight instrument external probe heating system is not operating or not functioning normally. The alert must comply with the following requirements:</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "1326" ;
	o:idTitle1 "Flight instrument external probes heating systems alert" ;
	o:idAmendedBy1 "Amendment 16;" ;
	o:idSection1 "SUBPART F – EQUIPMENT" ;
	o:idSubsection1 "INSTRUMENTS: INSTALLATION" ;
	o:ideRules1 "ERULES-1963177438-9997" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2015/008/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idReqIfChapterName1 "CS 25.1326.Amendment 16;" ;
	o:idApplicabilityDate1 "2015-03-13T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2015-03-13T00:00:00Z" ;
	cas:lists d:idSpecObject_-663336739_5 ,
		d:idSpecObject_-663336739_6 .

d:idSpecObject_1839006948_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1327(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Each magnetic direction indicator must be installed so that its accuracy is not excessively affected by the aeroplane’s vibration or magnetic fields.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
