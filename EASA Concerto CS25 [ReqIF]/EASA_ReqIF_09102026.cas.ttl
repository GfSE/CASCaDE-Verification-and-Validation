d:idSpecObject_714132880_5
	a o:idSpecObject1 ;
	rdfs:label "CS 25.788(a)(1).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) audio and visual ‘Return to seat’ indications, readily audible and visible to a shower-cubicle occupant, and activated at the same time as the signs required by CS 25.791(b), must be provided;</div>" ;
