	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_1062517513_8
	a o:idSpecObject1 ;
	rdfs:label "CS 25.843(b)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Tests of each door and emergency exit, to show that they operate properly after being subjected to the flight tests prescribed in sub-paragraph (b)(3) of this paragraph.</div>" ;
