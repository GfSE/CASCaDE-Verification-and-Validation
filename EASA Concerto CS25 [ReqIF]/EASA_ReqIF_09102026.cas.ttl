	a o:idSpecObject1 ;
	rdfs:label "CS 25.1351(d)(3).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(3) Failures, including junction box, control panel or wire bundle fires, which would result in the loss of the normal and alternate systems must be shown to be Extremely Improbable.</div>" ;
