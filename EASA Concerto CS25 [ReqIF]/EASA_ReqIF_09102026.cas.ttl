d:idSpecObject_-1515623790_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1123(a).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Exhaust piping must be heat and corrosion resistant, and must have provisions to prevent failure due to expansion by operating temperatures.</div>" ;
