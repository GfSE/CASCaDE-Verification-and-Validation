d:idSpecObject_1520688775_25
	a o:idSpecObject1 ;
	rdfs:label "CS 25.810(e)(2).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The aeroplane is in the normal ground attitude and in each of the attitudes corresponding to collapse of one or more legs of the landing gear.</div>" ;
