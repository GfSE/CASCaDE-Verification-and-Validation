d:idSpecObject_-2014239363_16
	a o:idSpecObject1 ;
	rdfs:label "CS 25.345(d).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(d) The aeroplane must be designed for a manoeuvring load factor of 1.5 g at the maximum take-off weight with the wing-flaps and similar high lift devices in the landing configurations.</div>" ;
