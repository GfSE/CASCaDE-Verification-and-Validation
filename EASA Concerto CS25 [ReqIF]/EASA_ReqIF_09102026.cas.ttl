d:idSpecObject_1082908761_13
	a o:idSpecObject1 ;
	rdfs:label "CS 25.1189(h).Amendment 1;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(h) Each shut-off valve must have a means to relieve excessive pressure accumulation unless a means for pressure relief is otherwise provided in the system.</div>" ;
