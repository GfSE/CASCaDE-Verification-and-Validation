d:idSpecObject_1575056278_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.479(a)(1).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) VL1 equal to VS0(TAS) at the appropriate landing weight and in standard sea-level conditions; and </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
