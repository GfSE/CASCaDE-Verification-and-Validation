	a o:idSpecObject1 ;
	rdfs:label "CS 25.1457(g)(2).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Have reflective tape affixed to its external surface to facilitate locating it;</div>" ;
