	o:idSubref1 "(a)" ;
	o:idTitle1 "Hinges" ;
	o:idAmendedBy1 "Initial issue;" ;
	o:idSection1 "SUBPART D – DESIGN AND CONSTRUCTION" ;
	o:idSubsection1 "CONTROL SURFACES" ;
	o:ideRules1 "ERULES-1963177438-8615" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2003/2/RM" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2003-10-17T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2003-10-17T00:00:00Z" .

d:idSpecObject_-1794407431_4
	a o:idSpecObject1 ;
	rdfs:label "CS 25.657(b).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(b) Hinges must have enough strength and rigidity for loads parallel to the hinge line.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
