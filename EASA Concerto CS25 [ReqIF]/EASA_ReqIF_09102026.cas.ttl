	a o:idSpecObject1 ;
	rdfs:label "CS 25.1411(d)(4).Amendment 5;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) The stowage provisions for each portable life raft must allow rapid detachment and removal of the raft for use at other than the intended exits.</div>" ;
