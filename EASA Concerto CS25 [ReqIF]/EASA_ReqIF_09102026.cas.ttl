	a o:idSpecObject1 ;
	rdfs:label "CS 25.147(a).Amendment 19;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Directional control; general. (See AMC 25.147(a).) It must be possible, with the wings level, to yaw into the operative engine and to safely make a reasonably sudden change in heading of up to 15° in the direction of the critical inoperative engine. This must be shown at 1·3 VSR1, for heading changes up to 15° (except that the heading change at which the rudder pedal force is 667 N (150 lbf) need not be exceeded), and with – </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
