d:idSpecObject_1187850300_19
	a o:idSpecObject1 ;
	rdfs:label "CS 25.807(f)(1).Amendment 26;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Each required passenger emergency exit must be accessible to the passengers and located where it will afford the most effective means of passenger evacuation.</div>" ;
