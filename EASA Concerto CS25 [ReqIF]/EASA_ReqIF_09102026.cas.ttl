d:idSpecObject_1783419709_23
	a o:idSpecObject1 ;
	rdfs:label "CS 25.729(e)(7).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) A clear indication or warning must be provided whenever the landing gear position is not consistent with the landing gear selector lever position.</div>" ;
