d:idSpecObject_1169978537_7
	a o:idSpecObject1 ;
	rdfs:label "CS 25.965(a)(4).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(4) Fluid pressures developed during the most adverse combination of aeroplane roll and fuel load.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
