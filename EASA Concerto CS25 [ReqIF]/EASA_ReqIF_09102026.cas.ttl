	a o:idSpecObject1 ;
	rdfs:label "CS 25.1165(f).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(f) Each ignition system must be independent of any electrical circuit not used for assisting, controlling, or analysing the operation of that system.</div>" ;
