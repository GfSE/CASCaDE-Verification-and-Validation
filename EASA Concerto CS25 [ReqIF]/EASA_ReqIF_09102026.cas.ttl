d:idSpecObject_387969350_9
	a o:idSpecObject1 ;
	rdfs:label "CS 25.832(c)(2).Initial issue;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) The aeroplane ventilation system, including any ozone control equipment, will maintain cabin ozone concentrations at or below the limits prescribed by sub-paragraph (a) of this paragraph.</div>" ;
