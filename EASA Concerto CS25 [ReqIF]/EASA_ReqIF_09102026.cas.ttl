	a o:idSpecObject1 ;
	rdfs:label "CS 25.967(a)(4)(ii).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(ii) That construction of the liner itself provides that protection.</div>" ;
