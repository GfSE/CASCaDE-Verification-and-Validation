d:idSpecObject_1789991084_65
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(d)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Level and centre the frame assembly to ensure alignment of the calorimeter and/or thermocouple rake with the burner cone. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
