d:idSpecObject_1789991084_81
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(1).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(1) Secure the two insulation blanket test specimens to the test frame. The insulation blankets should be attached to the test rig centre vertical former using four spring clamps positioned as shown in figure 7 (according to the criteria of paragraph (c)(3)(iv) of Part VII of this Appendix). </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
	o:idRef1 "Apdx F Part VII" ;
	o:idSubref1 "(f)(1)" ;
	o:idTitle1 "Test Method to Determine the Burnthrough Resistance of Thermal/Acoustic Insulation Materials" ;
	o:idAmendedBy1 "Amendment 6;" ;
	o:idSection1 "APPENDICES TO CS-25" ;
	o:idSubsection1 "Appendix F" ;
	o:ideRules1 "ERULES-1963177438-9590" ;
	SpecIF:Domain "Initial airworthiness;" ;
	o:idRegulatorySource1 "ED Decision 2009/010/R" ;
	o:idRegulatorySubject1 "CS-25;" ;
	o:idTypeOfContent1 "CS (Certification specification);" ;
	o:idApplicabilityDate1 "2009-07-06T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2009-07-06T00:00:00Z" .

d:idSpecObject_1789991084_82
	a o:idSpecObject1 ;
	rdfs:label "CS 25.Apdx F Part VII(f)(2).Amendment 6;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(2) Ensure that the vertical plane of the burner cone is at a distance of 102 ± 3 mm (4 ± 0.125 inch) from the outer surface of the horizontal stringers of the test specimen frame, and that the burner and test frame are both situated at a 30° angle with respect to vertical. </div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
	o:idType1 "Requirement" ;
	o:idLabel1 "CS 25" ;
