	a o:idSpecObject1 ;
	rdfs:label "CS 25.629(d)(7).Amendment 24;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(7) Any single propeller or rotating device capable of significant dynamic forces rotating at the highest likely overspeed.</div>" ;
	dcterms:modified "2026-02-24T16:47:22.4536074+01:00"^^xs:dateTime ;
