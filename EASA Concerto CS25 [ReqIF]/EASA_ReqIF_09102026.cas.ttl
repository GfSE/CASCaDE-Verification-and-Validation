	a o:idSpecObject1 ;
	rdfs:label "CS 25.1423(a).Amendment 2;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(a) Be powerable when the aircraft is in flight or stopped on the ground, after the shutdown or failure of all engines and auxiliary power units, or the disconnection or failure of all power sources dependent on their continued operation, for –</div>" ;
