	o:idApplicabilityDate1 "2016-06-24T00:00:00Z" ;
	o:idEntryIntoForceDate1 "2016-06-24T00:00:00Z" .

d:idSpecObject_-1280868577_6
	a o:idSpecObject1 ;
	rdfs:label "CS 25.J1195(c).Amendment 18;" ;
	rdfs:comment "<div xmlns=\"http://www.w3.org/1999/xhtml\">(c) The fire-extinguishing system for an APU compartment must be able to simultaneously protect each zone of the APU compartment for which protection is provided. </div>" ;
